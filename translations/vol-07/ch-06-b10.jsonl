{"segment_id": "YS-LN07/Text/chapter024.xhtml/p000001", "translation": "*Tại sao chứ?*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter024.xhtml/p000002", "translation": "*Đúng là ngu xuẩn.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter024.xhtml/p000003", "translation": "Than oán trong muôn tầng uất ức rối bời chẳng sao bật ra nổi thành lời cho trọn vẹn, Lergen lại hướng đôi mắt vằn tia máu về phía bức điện báo.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter024.xhtml/p000004", "translation": "Anh cảm thấy mình đã giành được mọi thứ có thể giành được rồi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter024.xhtml/p000005", "translation": "*Thế mà vẫn chưa đủ sao?!*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter024.xhtml/p000006", "translation": "*Các người bảo thế vẫn chưa đủ ư?!*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter024.xhtml/p000007", "translation": "“…Chưa bao giờ mình ngờ được sẽ có ngày bản thân thấu hiểu nỗi lòng của Trung tá von Degurechaff.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter024.xhtml/p000008", "translation": "Việc anh tôn trọng cô chẳng có gì đáng ngạc nhiên cả.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter024.xhtml/p000009", "translation": "Cô là một sĩ quan ma pháp xuất chúng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter024.xhtml/p000010", "translation": "Cô hội tụ trọn vẹn mọi phẩm chất của một sĩ quan, một người lính và một trí thức hiện đại, nên chừng đó hoàn toàn dễ hiểu. Dẫu bản tính cô có lệch lạc đi chăng nữa, anh vẫn không thể phủ nhận lòng tôn trọng mình dành cho cô.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter024.xhtml/p000011", "translation": "Điều khiến Lergen bàng hoàng chính là lời than đầy bức bối vừa rồi của anh, khi nhận ra mình đồng cảm với những nỗi bất bình và hoang mang của cô.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter024.xhtml/p000012", "translation": "“…Sao họ không thể cứ thế mà chấp nhận đi cơ chứ?!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter024.xhtml/p000013", "translation": "Đó là một tiếng thét.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter024.xhtml/p000014", "translation": "Đó là một lời ai oán.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter024.xhtml/p000015", "translation": "Và đó là một tiếng kêu than thống thiết.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter024.xhtml/p000016", "translation": "“Sao họ không thể bằng lòng với cục diện như thế này cơ chứ?!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter024.xhtml/p000017", "translation": "Đế quốc đã đổ quá nhiều sắt và máu vào cuộc chiến này rồi. Mọi sự đã đi đến mức hầu như bất kỳ ai có chút lẽ thường đều thấy rõ xung đột thêm nữa chỉ là vô nghĩa. Những tháng ngày qua quả thực là một cơn ác mộng—quá nhiều sinh mạng quý giá, quá nhiều nguồn lực tư bản đã tan biến chỉ trong chớp mắt.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter024.xhtml/p000018", "translation": "…Ấy vậy mà ánh sáng của một lối thoát đang ánh lên chỉ cách họ nửa bước chân.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter024.xhtml/p000019", "translation": "“Làm sao mình có thể thuyết phục họ đồng ý với những điều kiện này được cơ chứ?!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter024.xhtml/p000020", "translation": "Cơ hội đã ở ngay trước mắt rồi. Anh được điều chuyển từ tuyến tiền tiêu ở miền đông sang quốc gia trung lập Ildoa và thấp thỏm ngóng chờ tin thắng trận cũng chính vì thời cơ này!", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter024.xhtml/p000021", "translation": "Chính vì tại Ildoa, anh đã thoáng bắt gặp chút dư vị của cuộc sống bình thường mà bản quốc đã đánh mất, nên mới có thể khẳng định rằng dù còn đôi điều bất mãn thì cái giá đắt đỏ mà nước này đòi hỏi cho vai trò trung gian hòa giải vẫn đáng để cắn răng chấp nhận.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter024.xhtml/p000022", "translation": "Dù muốn hay không, anh cũng hiểu rõ tình hình chiến sự mà Đế quốc đang đối mặt bất thường đến mức nào. Vét sạch mọi tiềm lực quốc gia rồi đem rải khắp vùng đất cằn cỗi tựa đầm lầy kia ư?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter024.xhtml/p000023", "translation": "Làm thế thì được tích sự gì chứ?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter024.xhtml/p000024", "translation": "Anh không sợ chết vì tổ quốc, vì quê hương bản quán của mình. Nhưng rốt cuộc họ tính hy sinh bao nhiêu người lính chỉ để tranh giành đám bùn lầy của Liên bang đây?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter024.xhtml/p000025", "translation": "Lergen cảm thấy nôn nao đến mức mặt đất như chao đảo. Choáng váng, anh phải tựa người vào chiếc ghế bên cạnh.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter024.xhtml/p000026", "translation": "Thông điệp của bức điện báo đã quá rõ ràng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter024.xhtml/p000027", "translation": "*Chúng ta, Lục quân Đế quốc, đã giành chiến thắng ở mặt trận phía đông. Giữa lúc đàm phán đang diễn ra, chúng ta đã đánh bại Liên bang triệt để đến mức cả thế giới phải sững sờ; đó là một thắng lợi cả về mặt chiến thuật lẫn chiến dịch. Nhìn từ góc độ thuần túy quân sự, có lẽ nó cũng có thể được ca tụng là một chiến thắng mang tầm chiến lược.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter024.xhtml/p000028", "translation": "*Lục quân Đế quốc hiện đã ở vào thế có thể tung ra những đòn tấn công sắc bén nhắm vào các thành phố lớn của Liên bang.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter024.xhtml/p000029", "translation": "*Vậy nên giờ chính là lúc để chốt lại cuộc thảo luận.* Lergen đã nghĩ như vậy, và lẽ ra đó phải là tầm nhìn mà không chỉ những người trong đại sứ quán, mà bất kỳ ai trong quân đội nắm bắt được tình hình đều có thể chia sẻ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter024.xhtml/p000030", "translation": "Sau khi nhìn nhận kỹ cục diện chung ở mặt trận phía đông, ngay cả một đứa trẻ cũng thấy rằng họ chẳng thể tiếp tục chiến thắng thêm được bao lâu nữa. Chẳng cần phải là một con quái vật mang lốt bé gái mới hiểu được điều đó.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter024.xhtml/p000031", "translation": "Đó chỉ là phép tính số học đơn giản.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter024.xhtml/p000032", "translation": "Lục quân Đế quốc đã tung hàng triệu người vào mặt trận phía đông mà vẫn chưa đủ. *Với tình trạng hiện giờ thì cứ thử mở rộng chiến tuyến xem.* Ngay cả khi họ giao phó một số quân khu cho các tổ chức an ninh địa phương như Hội đồng Tự trị, thì sức của họ cũng chỉ có thể căng kéo đến một giới hạn nhất định mà thôi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter024.xhtml/p000033", "translation": "Trên bản đồ là những vùng lãnh thổ bị chiếm đóng mênh mông—thực sự quá đỗi mênh mông.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter024.xhtml/p000034", "translation": "Với tư cách một quốc gia, Đế quốc không đủ sức duy trì những vùng đất ấy, còn Lục quân Đế quốc thì chẳng hề có lấy một kế hoạch nào.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
