{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000264", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "*Họ thực sự làm được rồi.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000265", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "Chính Lergen cũng là một trong những người reo hò từ tận đáy lòng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000266", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "Tin chiến thắng—đó chỉ có thể là sự phù trợ của thần linh!", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000267", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "Anh xúc động đến mức suýt bất giác rơi nước mắt—họ đã làm quá đỗi xuất sắc. Chẳng biết tự lúc nào, anh đã với tay lấy chai rượu mà mình nâng niu suốt nhiều năm trời. Không những anh đã cất giữ nó từ trước khi chiến tranh bùng nổ, mà thời buổi này, ngay cả ở các quốc gia trung lập người ta cũng chẳng thể tìm được nguồn cung ổn định cho loại rượu mạnh của Khối Thịnh vượng chung ấy.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000268", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "Khi anh gỡ lớp niêm phong kín khít và rút nút bần ra, chào đón anh là hương thơm nồng đượm xứng tầm với tuổi đời của chai rượu.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000269", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "Chỉ riêng việc lấy đá từ tủ lạnh của đại sứ quán rồi chuẩn bị rót rượu vào chiếc ly pha lê vát cạnh của Ildoa thôi cũng đủ khiến lòng anh rộn ràng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000270", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "Sau khi cẩn thận rót ra rồi nhâm nhi cảm giác tương đối êm dịu—so với nồng độ 40 độ—ấy, suối nguồn sinh lực ấm áp kia liền thấm đượm cõi lòng anh.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000271", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "“Ngon thật.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000272", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "Lời cảm thán khe khẽ ấy gói trọn những cảm xúc sâu kín nhất của anh. Dù có xuất xứ từ quốc gia thù địch hay không thì rượu ngon vẫn cứ là rượu ngon. Anh đã quên bẵng hương vị này từ lâu rồi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000273", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "“Thấm thía thật đấy. Không lời nào tả xiết lòng biết ơn của tôi đối với tướng sĩ ngoài mặt trận vì đã mang lại cho tôi cơ hội được thưởng thức thứ tuyệt hảo nhường này.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000274", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "Men rượu ngấm vào người khiến anh trở nên nhiều lời—nhất là khi đang uống rượu mạnh lâu năm để mừng chiến thắng. Nó làm anh say chếnh choáng hơn hẳn thường ngày.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000275", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "Nhưng tuyệt nhiên không phải theo nghĩa xấu.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000276", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "Đó là cảm giác nhẹ nhõm xua tan cả nỗi âu lo về tương lai lẫn sự bức bối trong lòng anh. Cảm giác lan tỏa khắp cơ thể thậm chí còn đi kèm với sự dịu dàng tựa như một người bạn cũ. Tiếng đá va lanh canh mát lạnh, vui tai trong chiếc ly của anh cũng tuyệt diệu khôn cùng. Cảm giác ấy hệt như đang ngước nhìn bầu trời xanh trong vắt vậy.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000277", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "*Trên hết là bầu không khí này!*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000278", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "*Hôm nay dù mình có nốc cạn một ly ngay tại văn phòng tùy viên thì cũng chẳng ai thắc mắc gì đâu!*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000279", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "“Ồ, Đại tá von Lergen. Ngài sành thưởng thức đấy.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000280", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "Người vừa lên tiếng là ngài đại sứ vốn ngày thường rất nghiêm nghị. Thế nhưng hôm nay, tâm trạng chẳng thể nào che giấu lại hiện rõ mồn một trên gương mặt ông.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000281", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "“Chẳng phải ngài đại sứ của chúng ta đây sao! Còn ngài thì sao ạ? Chai rượu trên tay ngài là gì thế kia? Nếu tôi nhớ không lầm thì đó là loại nhãn X mà Bộ Ngoại giao vẫn khóa kỹ để dành riêng cho các dịp lễ tân ngoại giao cơ mà!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000282", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "Ngay cả trong tình cảnh bị phong tỏa, lễ nghi xã giao vẫn phải được duy trì, bằng không họ sẽ mất thể diện. Lergen từng rất ngạc nhiên khi biết rằng một phần công việc của các nhà ngoại giao thường trú ở nước ngoài là thu mua rượu vang.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000283", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "“Ha-ha-ha! Ngài nói đúng đấy. Đây là chai rượu quý mà tôi đã lén mang về qua ngả một nước trung lập trong túi bưu phẩm ngoại giao, nhưng hôm nay thì tiếc rẻ làm gì! Tôi sẽ xả láng luôn!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000284", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "Xem ra ngài đại sứ, người đáng lý phải đứng ra chấn chỉnh những kẻ vượt quá khuôn phép, lại chính là người đã chỉ thị mở tiệc ăn mừng chiến thắng và đang cao hứng đến mức tự tay bật nút bần những chai rượu vang vốn được ông mua để gửi về bản quốc phục vụ công tác ngoại giao.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000285", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "“Nào, nào, Đại tá. Mời ngài dùng một chút. Hy vọng ngài sẽ nâng ly chúc mừng cuộc chiến đấu ngoan cường của Lục quân Đế quốc.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000286", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "“Chà, nếu ngài đã có nhã ý…”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000287", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "Thông thường, từng chai rượu đều được kiểm kê vô cùng chặt chẽ. Nhưng chỉ riêng hôm nay, mọi quy tắc đều được dẹp sang một bên. Anh bày tỏ lòng cảm kích khi đón nhận chiếc ly rót đầy tràn, rồi trầm trồ trước vẻ sánh đậm của thứ chất lỏng màu đỏ ấy.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000288", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "Anh đã hoàn toàn quên mất mùi hương của rượu thứ thiệt.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000289", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "“Vì chiến thắng và cuộc chiến đấu gian khổ!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000290", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "“Vì các chiến hữu và sự hy sinh quên mình của họ!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000291", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "“Vinh quang thuộc về tổ quốc!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000292", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "Thật là những lời lẽ hào hùng để cùng nâng ly reo mừng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000293", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "“Thượng đế ở cùng chúng ta!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000294", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "Khoảnh khắc câu khẩu hiệu quen thuộc ấy vừa rời khỏi môi, khả năng đây thực sự là *hồng ân* bỗng lóe lên trong tâm trí Lergen. Tương lai của tổ quốc sẽ bắt đầu từ giây phút này. *Vậy nên biết đâu đấy*, anh không khỏi thầm nghĩ. Có lẽ những người thực dụng như anh cũng nên ngợi khen Chúa: *Cầu cho được như vậy.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000295", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "Thế là giữa bao người đàn ông đang tràn ngập xúc động ấy, chính anh cũng hòa giọng trao nhau những lời chúc mừng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000296", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "“Cầu cho Đế quốc muôn đời trường trị!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000297", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "“““Hoan hô!!!”””", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000298", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "Khoác vai nhau, những người đàn ông trong bộ đại lễ phục đồng thanh hô vang “*Prosit!*”, và tiếng hô ấy ắt hẳn đã rền vang cả ra bên ngoài đại sứ quán.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000299", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "*Chà, cứ để cho họ nghe thấy đi.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000300", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "Đó là tiếng reo khải hoàn của Đế quốc. *Một vòng nguyệt quế từ tận đáy lòng dâng tặng những người anh hùng nơi mặt trận phía đông, những người bảo vệ tổ quốc, Đế quốc của chúng ta.* Có thể gọi đó là một khúc hoan ca.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000301", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "*Hãy cất cao tiếng hát vì tình yêu dành cho Đế quốc!*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000302", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "*Hãy cứ buông mình theo cơn say mà hát vang hết cỡ—hãy để âm thanh ấy ngân vang khắp mảnh đất ngoại bang này!*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000303", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "*Có lẽ đây chẳng phải là cách xả hơi đứng đắn đối với một sĩ quan. Dù vậy thì cớ gì mình phải ngần ngại cơ chứ?*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000304", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "*Ai có thể* không *dùng lời lẽ để ăn mừng chiến thắng của đất nước mình cơ chứ? Bất kỳ con người nào đã lấy tư cách quân nhân để tuyên thệ trung thành với đất nước ắt hẳn đều không thể kìm lòng mà tán thưởng thắng lợi của tổ quốc.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000305", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "“Đ-Đại tá von Lergen?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000306", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "“Hửm? Ồ, người của nhóm trực ban đấy à. Vất vả cho các cậu quá. Tôi đã bảo nhà bếp làm chút đồ ăn cho các cậu rồi đấy. Không đủ chia cho mọi người sao?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000307", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "“Không ạ, chuyện này… chỉ có thể báo riêng với ngài thôi, thưa Đại tá. Phiền ngài đi theo tôi một lát được không ạ?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000308", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "Thái độ dè dặt đầy cung kính ấy ngầm báo hiệu rằng đây chẳng phải chuyện nhỏ. Dù Lergen đang khá lâng lâng trước chiến thắng của quân nhà, nhưng một khi đã lấy lại vẻ điềm tĩnh, không khó để anh nhận ra sự khẩn cấp trong đó.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000309", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "“Đi thôi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000310", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "Anh vừa lên tiếng xin lỗi vì đã khiến viên sĩ quan trực ban phải vất vả thêm, vừa dẫn cậu ta ra hành lang vắng người. Ngay cả trong chính đại sứ quán của mình, vẫn có thể có những đôi tai không nên nghe thấy chuyện này.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
