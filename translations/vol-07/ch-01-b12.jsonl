{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000436", "translation": "Tanya chuẩn bị nói chi tiết hơn về sự cần thiết phải kiểm tra xung quanh, nhưng rồi miệng nó khép lại. Một âm thanh chói gắt xé toạc tai nó. Ngay sau tiếng *vút* không thể nhầm lẫn của một vật thể bay là tiếng gầm trầm đục nối tiếp, và Tanya lập tức hét toáng lên.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000437", "translation": "“Pháo bắn tới!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000438", "translation": "Đó là âm thanh của đạn pháo đang trút xuống như mưa.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000439", "translation": "Một tiếng gầm quen thuộc.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000440", "translation": "Aaaa, lũ khốn đó chơi chúng tôi rồi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000441", "translation": "“Chết tiệt!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000442", "translation": "Quân địch đã cướp mất thế chủ động!", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000443", "translation": "“Địch tập kích! Bay lên…”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000444", "translation": "Trung úy Grantz vừa định cất cánh thì nó đã quát át đi đầy khiển trách.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000445", "translation": "“Không, tìm chỗ trú ẩn ngay! Chúng ghìm chân chúng ta rồi! Mau ẩn nấp dưới chiến hào!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000446", "translation": "Sau khi lao người xuống con hào sơ sài gần nhất, Tanya rít lên: “Khốn kiếp, không thể tin nổi là chúng ta lại chậm một bước!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000447", "translation": "Dàn pháo binh địch gần như đang tấu lên một khúc nhạc để rêu rao thế bất lợi của chúng tôi. Với bất kỳ ai từng trải qua sự khác biệt giữa những phát bắn cảnh cáo và một trận pháo kích thực thụ dưới chiến hào, đôi tai họ sẽ tự khắc ghi nhớ dẫu chẳng hề mong muốn. Một khi đã biết thì sẽ chẳng bao giờ quên nổi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000448", "translation": "Chui rúc dưới một cái hố để hứng chịu hỏa lực trọng pháo hoàn toàn chẳng dễ chịu chút nào. Giữa phông nền hỗn loạn quen thuộc của chiến trường, Tanya bất giác hét lên.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000449", "translation": "“Quá sớm! Chuyện này diễn ra quá mức sớm rồi!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000450", "translation": "Một đợt pháo kích toàn diện chóng vánh đến thế này ư? Đến nước này thì mình thấy bất an về tất cả mọi thứ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000451", "translation": "Chúng tôi đã kịp tìm chỗ ẩn nấp, nhưng đây chỉ là những con hào thô sơ nhất. Nếu mạng sống của mình phụ thuộc vào chuyện chúng có chịu nổi một phát đạn pháo cỡ lớn bắn trúng trực diện hay không, mình phải nói là khả năng đó cực kỳ mong manh. Mà cho dù bây giờ có muốn gia cố đi nữa, chúng tôi cũng chẳng thực sự có vật liệu hay công cụ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000452", "translation": "Vậy chúng tôi phải làm gì đây?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000453", "translation": "Chắc chắn không phải là *cầu nguyện* chứ?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000454", "translation": "Chuyện đó thật nực cười.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000455", "translation": "Hầu hết mọi người sẽ gọi đây là sự sỉ nhục tột cùng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000456", "translation": "“Khốn thật! Chắc đây chính là thứ người ta gọi là tồi tệ nhất đấy,” Tanya buông lời, thừa nhận nỗi uất ức đó.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000457", "translation": "Đây là một cuộc chiến nhắm vào tự do.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000458", "translation": "Lựa chọn của mình là hoặc khuất phục trước tên cặn bã mà lũ Cộng sản chướng mắt gọi là Thượng đế, hoặc tự tay rèn lấy vận mệnh của chính mình, xóa sổ cả Being X lẫn lũ Cộng sản đó cùng với hắn.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000459", "translation": "Được thôi, làm tới luôn đi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000460", "translation": "Câu trả lời rất đơn giản.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000461", "translation": "Là một người văn minh yêu tự do và sự hiện đại, bổn phận của mình đã rõ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000462", "translation": "“Các sĩ quan! Tập hợp quân lính!” Những cú va đập, những vụ nổ cùng tiếng rền vang kéo theo sau buộc Tanya phải cao giọng. Gào lên với âm lượng tưởng chừng có thể làm tổn thương dây thanh quản, nó hét át cả tiếng ồn để truyền đạt việc cần làm. “Chuẩn bị phản kích! Toàn tiểu đoàn, lập tức chuẩn bị xuất kích!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000463", "translation": "“Cái gì ạ?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000464", "translation": "“Đây là pháo kích chuẩn bị— Này!! Hành động ngay trước khi bộ binh địch xuất hiện! Đấm thẳng vào mũi chúng ngay khoảnh khắc chúng vừa mò tới!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000465", "translation": "Trên mặt trận Rhine lúc nào cũng như vậy cả.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000466", "translation": "Sau đạn pháo sẽ là con người tiến lên.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000467", "translation": "Chẳng có lý do gì để chuyện đó lại khác đi ở miền đông cả.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000468", "translation": "“Thiếu tá Weiss, tập hợp tiểu đoàn! Chúng ta có đường dây liên lạc với Đại tá Dirichlet không? Nếu đứt rồi thì cử một sĩ quan liên lạc đi ngay.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000469", "translation": "“Nhìn đằng kia kìa!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000470", "translation": "Khi Tanya đầy nghi hoặc quay đầu nhìn theo hướng ngón tay đang chỉ, nó nhận ra đó là hướng ngôi nhà dùng làm sở chỉ huy lâm thời, tòa nhà mà họ vừa mới rời đi ban nãy. Chỉ có điều giờ ngôi nhà ấy chẳng còn ở đó nữa.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000471", "translation": "*…Aaaa chết tiệt, lũ khốn kiếp đó.* Giờ thì chúng tôi phải nhắc đến sở chỉ huy ở thì quá khứ rồi!", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000472", "translation": "“…Giờ thì tôi hiểu rồi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000473", "translation": "Đã rõ lý do vì sao quân địch quyết định dốc toàn lực ngay từ loạt đạn đầu tiên, vì sao chúng có thể bắn tiêu diệt ngay tức khắc—pháo binh Quân đội Liên bang đã ngắm chuẩn tọa độ mục tiêu ngay từ đầu.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000474", "translation": "Chỉ cần suy luận một chút là nhìn thấu được âm mưu này. Ngôi nhà lẻ loi đó không phải chỉ tình cờ trụ vững. Công trình ấy đã được cố tình chừa lại nguyên vẹn để làm mục tiêu.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000475", "translation": "“Sở chỉ huy trung đoàn bị xóa sổ rồi!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000476", "translation": "“Tôi thấy rồi. Còn vị đại tá thì sao?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000477", "translation": "“…Tôi không nghĩ là ông ấy qua khỏi đâu ạ.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000478", "translation": "Câu trả lời của Weiss ngắn gọn và rõ ràng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000479", "translation": "*Lối suy nghĩ viển vông đã quay lại hại chính mình rồi.* Lòng Tanya tràn ngập nỗi hối hận. Hiếm hoi lắm mới có cảm giác như cuối cùng cũng tìm được một đồng nghiệp có năng lực để trấn giữ nơi này. Ai mà ngờ được rằng ông ấy cùng toàn bộ phần còn lại của sở chỉ huy lại bị thổi bay thành từng mảnh vụn cơ chứ?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000480", "translation": "*Mình đã không lường trước được chuyện đó.* Aaaa, đúng là một lời thú nhận sự bất tài tuyệt vời làm sao.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000481", "translation": "Đáng lẽ mình phải bị đem ra bắn bỏ vì đã chẳng hề tính đến khả năng đó dù chúng ta đang có chiến tranh. Thật là tắc trách! Bất cẩn! Thất bại!", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000482", "translation": "Đây chính là kiểu kém cỏi khiến mình phát bệnh.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000483", "translation": "“Được rồi, chúng ta sẽ chủ động hành động theo phán đoán của mình. Cứ cho là Đại tá Dirichlet đã tử trận và hệ thống chỉ huy hiện không rõ ràng. Chúng ta sẽ tạm thời xem vị trí này là sở chỉ huy.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000484", "translation": "“Chẳng phải chúng ta nên tìm phó chỉ huy của Trung đoàn 54 sao ạ?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000485", "translation": "“Chỉ tổ phí thời gian thôi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000486", "translation": "Đề xuất từ viên sĩ quan phụ tá của mình rất ổn trong hầu hết mọi trường hợp, nhưng lại sai lầm trong hoàn cảnh hiện tại.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000487", "translation": "Việc bàn giao quyền chỉ huy mà không có một cuộc họp bàn tử tế sẽ đẩy mọi thứ vào cảnh hỗn loạn. Làm gì có chuyện chúng tôi đủ xa xỉ để bỏ công sức vô ích vào một việc bất khả thi ngay lúc này, khi mà từng giây từng phút đều quý giá.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000488", "translation": "“Nh-nhưng mà—”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000489", "translation": "“Trung úy Serebryakov.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000490", "translation": "“Vâng ạ?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000491", "translation": "“Cô quên rồi sao? Thời gian là hữu hạn. Sự xa xỉ chính là kẻ thù.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000492", "translation": "Ngay lúc Tanya chuẩn bị tiếp tục bài giáo huấn, nó chợt ngậm miệng lại khi nhận thấy rõ ràng hỏa lực pháo binh đã dứt. Trên mặt trận Rhine, thời điểm đợt pháo kích kết thúc luôn là tín hiệu báo trước cho điều chắc chắn sẽ diễn ra tiếp theo…", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000493", "translation": "“Địch tập kích!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000494", "translation": "Những tiếng thét thất thanh rộ lên khắp tứ phía và tiếng súng quen thuộc bắt đầu nổ ran. Diễn biến đúng chuẩn sách giáo khoa này khiến mình chỉ muốn nguyền rủa quân địch. Thế nhưng có điều gì đó trong bầu không khí dường như rất lạ; mình có một linh cảm chẳng lành cứ thôi thúc đòi được lắng nghe. Khi mình lắng tai để tìm hiểu nguyên nhân gây ra cảm giác đó, câu trả lời rất đơn giản. Không có đủ âm thanh.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
