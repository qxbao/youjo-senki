{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000172", "translation": "Cứ thế, Tanya tiếp tục càn quét xuyên qua đội hình quân địch với tinh thần phấn chấn đến mức gần như say men chiến thắng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000173", "translation": "“Chúa ở cùng chúng ta! Không ngờ ta lại sống đến ngày được biến lũ Cộng sản thành trò hề đến mức này! Nào, nhào vào đây! Để ta xem các ngươi giãy giụa ra sao!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000174", "translation": "Cuộc cận chiến ở cự ly cực gần này về cơ bản chẳng khác nào một màn cận chiến quần vòng. Hai bên cứ thế rượt đuổi bám đuôi nhau. Trong thế gọng kìm giả lập đầy thú vị ấy, có lúc Tanya vồ lấy một tên địch từ phía sau, lúc khác nó lại xiên thủng những gã ngốc đang bị Weiss và đơn vị của anh làm cho phân tâm; thỉnh thoảng, nó còn nổ súng ở cự ly gần như dí sát họng súng để thổi bay những kẻ đang mải mê nhắm bắn lính của mình.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000175", "translation": "Đúng lúc cuộc vui bắt đầu nóng lên thì hứng thú tuyệt vời của nó lại bị dội một gáo nước lạnh—bởi một câu ngắn ngủi thốt ra từ miệng một tên lính địch.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000176", "translation": "“Ôi lạy Chúa…”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000177", "translation": "Dù hồi còn huấn luyện sĩ quan, Tanya có thể chỉ mới nắm được những phần cơ bản nhất của tiếng Liên bang, nhưng không đời nào nó nghe nhầm mấy từ đó được.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000178", "translation": "*Đó là lời nguyền của chiếc Elinium Type 95 ư?*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000179", "translation": "*Mình nghe thấy lời cầu nguyện đó rõ mồn một đến phát sợ.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000180", "translation": "“Ààà, chết tiệt.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000181", "translation": "*Thôi xong, hỏng bét cả rồi.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000182", "translation": "Chỉ câu cảm thán ngắn ngủi ấy thôi đã nói lên tất cả.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000183", "translation": "“Một tên Cộng sản mà không tìm ai khác lại đi tìm đến Chúa ư?!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000184", "translation": "*Thế tấm huy hiệu Đảng Cộng sản mà ngươi đeo cả trên quân phục kia chỉ là đồ làm cảnh thôi hả?!* Cơn thôi thúc muốn hét toáng lên dâng trào mãnh liệt.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000185", "translation": "Đó là sự *phản bội*.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000186", "translation": "Chuyện này chẳng khác nào phản bội lại những giá trị cách mạng của bọn chúng. Cau mày không giấu nổi vẻ thất vọng, Tanya quát lên: “Giờ mới làm thế thì hơi muộn rồi đấy, phải không hả, đồ vô thần?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000187", "translation": "Ánh mắt trừng trừng dữ dội mà tên lính đó bắn trả lại chỉ là để làm màu thôi sao? Cứ nhất thiết phải bấu víu vào một thứ thậm chí còn chẳng tồn tại ư?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000188", "translation": "Nỗi thất vọng thật không sao chịu thấu.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000189", "translation": "*“Gott mit uns!”*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000190", "translation": "Mình buột miệng đùa một câu ngay khi chuẩn bị thổi bay đầu tên địch, vừa vu vơ nghĩ rằng biết thế mình đã chuẩn bị sẵn một chiếc mũ chóp nhọn pickelhaube làm đạo cụ cho trò đùa khó hiểu này.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000191", "translation": "“Được lắm, Bạch Ngân Rỉ Sét. Ta thừa nhận ngươi mạnh… nhưng ta cũng đã thề trung thành với tổ quốc của mình rồi! Dù đây có là việc cuối cùng ta làm, ta cũng phải kéo ngươi chết chung!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000192", "translation": "Tên pháp sư Liên bang vừa lao tới vừa la hét điều gì đó lại làm dấu thánh giá ngay trước mắt Tanya. Khoảnh khắc ấy thế là hỏng bét.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000193", "translation": "Mình đến đây với kỳ vọng sẽ gặp lũ Cộng sản, vậy mà chúng thậm chí còn chẳng phải là những tên Cộng sản đúng nghĩa.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000194", "translation": "Đồ dối trá.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000195", "translation": "Đồ phản bội.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000196", "translation": "“Tỉnh ngộ lại và nhìn vào logic đi. Tội lỗi thì phải đền!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000197", "translation": "Trong lúc trút hết nỗi thất vọng tột cùng, Tanya sớm nhận ra tiếng giao tranh đã dứt.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000198", "translation": "Suy cho cùng, chiến tranh được chi phối bởi một phương trình công tâm không thiên vị. Có người có thể gọi đó là tàn nhẫn, nhưng phần nhiều đó chỉ là vấn đề quan điểm cá nhân mà thôi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000199", "translation": "Kẻ mạnh là kẻ chiến thắng. Ngay cả Ủy ban Thương mại Công bằng vốn nghiêm cấm độc quyền cũng chẳng quản lý chuyện chiến đấu.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000200", "translation": "*Thị trường tự do muôn năm*, Tanya suýt nữa thì lầu bầu như thế, nhưng rồi lại đưa tay lên ôm đầu.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000201", "translation": "“…Ui da. Đau thật đấy…”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000202", "translation": "Xem ra mình không thể vừa lạm dụng chiếc Type 95 lại vừa giữ vững ý chí của bản thân mà mong không gặp chút tác dụng phụ nào được. Rõ ràng là Being X chưa từng nghe nói đến tiêu chuẩn an toàn bao giờ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000203", "translation": "Hèn chi hắn lại có những tín đồ sẵn sàng thành tâm làm theo câu dạy: “*Nếu mắt ngươi khiến ngươi phạm tội, hãy móc nó ra mà ném đi*.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000204", "translation": "Điều đó thật đau lòng đối với một người có học thức theo chủ nghĩa cá nhân như mình. Là một con người văn minh, mình rất muốn tìm ra một giải pháp văn minh.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000205", "translation": "“02 gọi 01, chúng tôi đã kiểm soát gần như hoàn toàn vùng trời này.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000206", "translation": "“01 nghe rõ. Làm tốt lắm.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000207", "translation": "*À phải rồi.* Nó chợt nhớ ra phải nói thêm một câu.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000208", "translation": "“Đợt tấn công của các anh xuất sắc lắm.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000209", "translation": "“…Họ yếu trong cận chiến hơn nhiều so với dự kiến. Tôi đã tưởng sẽ phải tốn thêm chút công sức cơ.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000210", "translation": "“Đúng vậy. Tôi chắc rằng Quân đội Liên bang cũng có những nỗi khổ riêng. Hẳn là họ đang phải chật vật hơn nhiều so với những gì họ dự tính.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000211", "translation": "Chiến tranh cũng là câu chuyện về sự cân bằng. Dù vậy, việc cả hai bên có thể tiếp tục phớt lờ những tiếng kêu gào và lao vào đánh cược trước những tổn thất như thế cũng chỉ có giới hạn mà thôi. Sẽ còn kỳ lạ hơn nếu chẳng có bên nào bị phá sản.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000212", "translation": "Tanya lắc đầu. Dù họ đã đánh bại quân địch, nhưng đó mới chỉ là mối đe dọa trước mắt nhất mà thôi. Vấn đề nằm ở những gì sắp diễn ra tiếp theo.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000213", "translation": "“Tuy chúng ta đã thấm mệt, nhưng tổn thất vẫn nằm trong phạm vi chấp nhận được. Có điều, tôi thực sự tự hỏi liệu việc bảo vệ vùng trời này có còn ý nghĩa gì không.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000214", "translation": "“Tôi tin là nhận định đó hoàn toàn chính xác, nhưng nghe vậy cũng chẳng giúp ích được gì nhiều cho tinh thần của chúng ta.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000215", "translation": "“Đúng thế. Nhưng dù anh nghe câu đó có vô ích đi chăng nữa thì tôi biết làm sao được?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000216", "translation": "Lúc duy nhất một người chỉ huy nhồi nhét những lời tuyên truyền vào đầu các sĩ quan thuộc quyền là khi ngày tàn đã cận kề. Việc chỉ còn biết đặt niềm tin mù quáng rằng ắt phải có một lối thoát phía trước chính là bằng chứng của sự bất tài.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000217", "translation": "“Một chiến thắng chiến thuật tự thân nó hoàn toàn vô nghĩa. Cùng lắm thì chúng ta sẽ được trao huân chương. Xét từ góc độ của một người lao động cá nhân, có lẽ điều đó cũng chẳng đến nỗi tệ…”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000218", "translation": "Nếu công việc không có chế độ đãi ngộ khích lệ, hiệu suất sẽ lao dốc không phanh. Có những kẻ cố đem từ nhiệm màu *đáng giá về mặt tinh thần* ra dùng, nhưng rốt cuộc thứ duy nhất họ nhận lại cũng chẳng khác mấy một quả bóng bay bị bơm căng một cách vô nghĩa.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000219", "translation": "Chỉ một chấn động nhỏ nhất cũng đủ làm nó nổ tung, hoàn toàn vô dụng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter002.xhtml/p000220", "translation": "Chừng nào bạn còn là một bánh răng trong tổ chức, việc sử dụng người khác và bản thân bị sử dụng như một bánh răng là điều hoàn toàn hợp lý. Nhưng ngay cả khi các bánh răng đều có thể thay thế được, kẻ nào lơ là việc bảo dưỡng vẫn là một kẻ đần độn thiếu ý thức về chi phí.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
