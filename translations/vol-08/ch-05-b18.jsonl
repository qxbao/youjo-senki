{"segment_id": "YS-LN08/Text/chapter018.xhtml/p000636", "translation": "Ngay khi cô bắt đầu tự hỏi không biết cô ấy đang ở đâu, một giọng nói đứt quãng lọt vào tai cô.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter018.xhtml/p000637", "translation": "“Không… cắt đuôi được kẻ này…”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter018.xhtml/p000638", "translation": "Tiếng thở dốc nặng nhọc cho thấy rõ có chuyện chẳng lành. Sĩ quan phụ tá của Tanya không bao giờ mất bình tĩnh vì chuyện cỏn con.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter018.xhtml/p000639", "translation": "Cô tạm thời đổi ý, ra lệnh cho lực lượng của mình bắn hạ một tên địch duy nhất. Ngay khi xác nhận được vị trí và hoàn tất nhận diện, cô không chút do dự tung toàn lực tấn công.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter018.xhtml/p000640", "translation": "“Chi viện cho Trung úy Serebryakov! Ba loạt hỏa lực yểm trợ!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter018.xhtml/p000641", "translation": "Tanya ra lệnh cho lực lượng tương đương hai đại đội dưới quyền đồng loạt khai hỏa, tất cả cùng nã đạn theo cụm.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter018.xhtml/p000642", "translation": "“Đã phát hiện địch! Hắn vẫn chưa hề hấn gì!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter018.xhtml/p000643", "translation": "“Thoát khỏi đó ngay, Trung úy! Ba loạt thuật thức phát nổ! Ưu tiên chế áp!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter018.xhtml/p000644", "translation": "“Địch đang tăng tốc!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter018.xhtml/p000645", "translation": "“Giáng thuật thức thẳng lên đầu hắn! Chặn đường tiến của hắn lại!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter018.xhtml/p000646", "translation": "Thật khó lòng tin nổi, nhưng chừng đó vẫn chưa đủ. Tên pháp sư này vẫn bình yên vô sự sau khi hứng chịu hàng loạt đòn đánh trực diện—ắt hẳn kẻ đó phải có lớp vỏ phòng thủ và màn chắn bảo hộ dày đến mức kinh hoàng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter018.xhtml/p000647", "translation": "Và chẳng hiểu sao hắn vẫn nhanh đến thế! Hẳn là hắn đang dùng một mẫu khác với loại của Quân đội Liên bang. Kẻ địch vừa nhanh vừa lì đòn là loại tồi tệ nhất. Mà nếu trình độ của hắn cao đến mức khiến Serebryakov cũng phải chật vật không khuất phục nổi, thì kẻ này quả thực cực kỳ hiểm ác. Mình không thể cứ thế làm ngơ, nhưng thật bực mình khi các phương án đối phó với hắn lại hạn chế đến vậy.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter018.xhtml/p000648", "translation": "Tanya liếc nhìn quả cầu Elinium Type 95 mang theo để dự phòng mà lòng đầy bứt rứt. Mình chẳng muốn dùng đến nó đâu, nhưng có lẽ mình sẽ buộc phải dùng thôi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter018.xhtml/p000649", "translation": "Vấn đề nên để sức khỏe tinh thần của bản thân bị bào mòn đến mức nào nhằm bảo toàn nguồn nhân lực là bài toán tiến thoái lưỡng nan về đạo đức mà các nhà quản lý cùng giới chủ lao động luôn phải đối mặt.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter018.xhtml/p000650", "translation": "Với Tanya, đó cũng là một vấn đề vô cùng đau đầu.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter018.xhtml/p000651", "translation": "Xét đến khoản chi phí giao tiếp điều phối chắc chắn phải gánh chịu nếu mất đi sĩ quan phụ tá, việc chấp nhận hy sinh ở một chừng mực nào đó hẳn là hoàn toàn xứng đáng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter018.xhtml/p000652", "translation": "“Hỡi Chúa, nhân thánh danh ngài, xin hãy trục xuất kẻ thù của thần linh này và mang lại sự bình yên cho thế gian.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter018.xhtml/p000653", "translation": "Thốt xong câu niệm chú chướng tai ngập tràn vẻ thuần khiết ấy, Tanya triển khai một thuật thức bắn tỉa quang học với tốc độ thi triển nhanh đến khó tin. Chắc chắn chỉ một phát thôi cũng đủ xé toạc các mẫu mới của Liên bang, nhưng cô vẫn lồng ghép nhiều thuật thức chồng lớp lên nhau rồi mới khai hỏa.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter018.xhtml/p000654", "translation": "Đầu tiên, phát bắn tưởng chừng đã nắm chắc phần thắng ấy… lại trượt.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter018.xhtml/p000655", "translation": "“Mình bắn trư—Không, hắn né được sao?!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter018.xhtml/p000656", "translation": "Tanya vốn rất tự tin vào độ chính xác và uy lực của mình, nên cô cảm thấy như bị phản bội. *Elinium Type 95, chẳng lẽ ngươi chỉ là một món đồ phế thải chuyên gặm nhấm tâm trí ta mà chẳng mang lại được kết quả gì sao?!*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter018.xhtml/p000657", "translation": "“…Hỡi Chúa, nguyện cho kẻ thù của con rơi thẳng xuống mặt đất. Bằng quyền năng của ngài, xin hãy cho mảnh đất này được hưởng thái bình!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter018.xhtml/p000658", "translation": "Với sự bực dọc hòa lẫn trong giọng đọc, cô triển khai một thuật thức còn chuẩn xác và uy lực hơn nữa. Đòn này đang lao thẳng trên quỹ đạo để giáng một cú trúng đích trực diện.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter018.xhtml/p000659", "translation": "Và nó đã trúng đích.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter018.xhtml/p000660", "translation": "Hoặc đáng lý ra phải là như thế.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter018.xhtml/p000661", "translation": "“Vô lý! Đòn đó rõ ràng trúng đích trực diện mà!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter018.xhtml/p000662", "translation": "Thế nhưng, Tanya lại lắc đầu, phần nhiều vì hoang mang.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter018.xhtml/p000663", "translation": "Cảnh tượng bày ra trước mắt buộc cô phải hoài nghi từ tận gốc rễ xem liệu mình có thực sự bắn trúng trực diện tên địch hay không.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter018.xhtml/p000664", "translation": "Đó là thuật thức bắn tỉa chuyên dùng đạn bắn tỉa kháng ma năng. Lẽ ra nó phải xuyên qua lớp vỏ phòng thủ ngọt xớt như dao cắt bơ mới phải.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter018.xhtml/p000665", "translation": "Chắc chắn nó thừa sức thổi tung cả lớp vỏ phòng thủ của Type 97. Vậy mà thứ này vừa đánh bật một đòn trúng đích trực diện ư?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter018.xhtml/p000666", "translation": "“Ngươi mạnh đến mức nào được cơ chứ? Có muốn đùa thì cũng phải có giới hạn thôi!” Tanya rít lên. Nhưng trong thâm tâm, cô đã từ bỏ ý định một mình đối phó với đối thủ này rồi. Mối bận tâm duy nhất hiện giờ là cứu Serebryakov rồi nhanh chóng rút khỏi đây.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter018.xhtml/p000667", "translation": "Cô chẳng có lấy một giây dư dả nào để lãng phí vào những nỗ lực lẻ tẻ nữa.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter018.xhtml/p000668", "translation": "“Tấn công bão hòa! Kích nổ không gian! Hạ gục tên địch bằng ngộ độc khí carbon monoxide!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter018.xhtml/p000669", "translation": "“Cô ấy sẽ bị vạ lây mất!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter018.xhtml/p000670", "translation": "Chẳng muốn tốn thời gian giải thích cho một Weiss đang hoảng hốt, Tanya gọi thẳng cho sĩ quan phụ tá qua vô tuyến và nói toạc ra luôn.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter018.xhtml/p000671", "translation": "“Miễn không bị bắn trúng trực diện thì cô vẫn ổn, đúng chứ?! Visha, cô nghe thấy tôi nói không hả?! Tránh ra ngay!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter018.xhtml/p000672", "translation": "“Khoan đ—Đ-đã rõ!!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter018.xhtml/p000673", "translation": "Ngay khi lời đồng ý của Serebryakov vừa truyền tới, Tanya lập tức hành động.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter018.xhtml/p000674", "translation": "“Thuật thức phát nổ—đốt sạch dưỡng khí đi. Giảm uy lực, mở rộng phạm vi tác động. Chúng ta sẽ phá nát phổi của tên địch.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter018.xhtml/p000675", "translation": "Cảnh hai đại đội bắt đầu triển khai thuật thức không chút do dự chính là đỉnh cao của thứ bạo lực được kiểm soát chặt chẽ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter018.xhtml/p000676", "translation": "“Bắn!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter018.xhtml/p000677", "translation": "Thuật thức phát nổ của cả hai đại đội đồng loạt khai hỏa—và chỉ nhắm duy nhất vào việc triệt tiêu dưỡng khí.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter018.xhtml/p000678", "translation": "“Trung úy Serebryakov! Cô còn sống đấy chứ?!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter018.xhtml/p000679", "translation": "“T-t-tôi không sao ạ. Bằng cách nào đó thì vẫn ổn.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter018.xhtml/p000680", "translation": "Cô đã tận mắt xác nhận Serebryakov—người vừa chuyển sang rút lui—vẫn an toàn, nên hỏi vậy hẳn cũng thể hiện được đôi chút quan tâm rồi, đúng không? Thứ mà người ta vẫn gọi là chăm sóc hậu kỳ ấy.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter018.xhtml/p000681", "translation": "“Trung úy Serebryakov, hiện đang rút lui!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter018.xhtml/p000682", "translation": "“Vậy thì chẳng cần phải nương tay nữa—tốt lắm. Dùng thuật thức phát nổ làm màn khói ngụy trang và đan xen thuật thức bắn tỉa làm đòn tấn công thực sự. Lần này chúng ta sẽ hạ gục hắn…”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter018.xhtml/p000683", "translation": "“Pháp sư địch đang rút lui!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter018.xhtml/p000684", "translation": "Một thời gian sau, Tanya sẽ phải hối hận vì đã không hạ lệnh khai hỏa và đoạt mạng kẻ đó. Nhưng ít nhất vào khoảnh khắc này, cô đang nóng lòng đi tiếp, nên cô coi việc đẩy lùi được tên địch đã là một thành quả chấp nhận được.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter018.xhtml/p000685", "translation": "“Chúng ta có truy kích không ạ?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter018.xhtml/p000686", "translation": "“Chúng ta rút khỏi giao tranh! Ai hơi đâu mà lãng phí thời gian đuổi theo một kẻ địch đang rút lui chứ?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter018.xhtml/p000687", "translation": "“Đã rõ.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter018.xhtml/p000688", "translation": "Nụ cười gượng gạo của Weiss hẳn có nghĩa là ngay cả anh cũng chỉ hỏi cho có lệ; Tanya cười khổ, tập hợp binh sĩ rồi bắt đầu tăng tốc để thoát ly khỏi Quân đội Liên bang.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter018.xhtml/p000689", "translation": "“Mừng là cô bình an vô sự, Trung úy.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter018.xhtml/p000690", "translation": "“Cảm ơn Trung tá. Dù vậy, giá mà ngài tha cho tôi khỏi bị cuốn vào đòn tấn công vừa rồi thì tốt biết mấy.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
