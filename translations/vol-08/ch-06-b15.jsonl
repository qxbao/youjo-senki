{"id": "YS-LN08/Text/chapter022.xhtml/p000571", "segment_id": "YS-LN08/Text/chapter022.xhtml/p000571", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Đối với dây thần kinh giàu lương tri của Tanya, chuyện đó là điều không thể dung thứ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter022.xhtml/p000572", "segment_id": "YS-LN08/Text/chapter022.xhtml/p000572", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Thứ lỗi cho tôi, thưa ngài, nhưng xin ngài hãy lưu tâm đến khoảng cách quân hàm giữa chúng ta ạ.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter022.xhtml/p000573", "segment_id": "YS-LN08/Text/chapter022.xhtml/p000573", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Hửm?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter022.xhtml/p000574", "segment_id": "YS-LN08/Text/chapter022.xhtml/p000574", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Tôi chỉ đơn thuần là một thành viên của tổ chức quân sự có bổn phận tuân phục các mệnh lệnh hợp pháp.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter022.xhtml/p000575", "segment_id": "YS-LN08/Text/chapter022.xhtml/p000575", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Ngay cả khi vì công việc đi chăng nữa, mình cũng đời nào chịu vượt đèn đỏ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter022.xhtml/p000576", "segment_id": "YS-LN08/Text/chapter022.xhtml/p000576", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Tanya tôn sùng cuộc sống của một công dân tuân thủ pháp luật; cô chẳng hề có hứng thú đi chệch khỏi chuẩn mực, và càng nhất quyết không muốn bị lôi kéo làm đồng phạm cho ai đó để rồi biến thành một tên tội phạm thứ thiệt.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter022.xhtml/p000577", "segment_id": "YS-LN08/Text/chapter022.xhtml/p000577", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Pháp luật sinh ra là để khiến người khác phá luật, chứ không phải để chính bản thân bạn vi phạm.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter022.xhtml/p000578", "segment_id": "YS-LN08/Text/chapter022.xhtml/p000578", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Cô hiểu rằng một nhân vật tai to mặt lớn như Zettour đang ẩn ý đủ điều sau từng lời nói, nhưng một khi bạn đã dính vào cái phi vụ tội lỗi ấy, coi như đời bạn thế là xong. Ai chẳng biết kẻ đã một lần nhúng tay vào bùn đen sẽ mang vết nhơ suốt đời.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter022.xhtml/p000579", "segment_id": "YS-LN08/Text/chapter022.xhtml/p000579", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "À mà, cũng có thể cách vận hành ở đây hơi khác một chút so với các tập đoàn thuộc chỉ số Nikkei.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter022.xhtml/p000580", "segment_id": "YS-LN08/Text/chapter022.xhtml/p000580", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Biết đâu học thuyết nhân sự ở Đế quốc lại khoan dung hơn đối với những phi vụ ngầm… Nói cách khác, liệu cơ chế ở đây có được thiết lập sao cho người ta có thể nhận lệnh phớt lờ pháp luật khi cần thiết hay không?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter022.xhtml/p000581", "segment_id": "YS-LN08/Text/chapter022.xhtml/p000581", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Đối với một cá nhân luôn tự hào về lòng yêu chuộng công lý như Tanya, điều đó khiến thế giới này trở thành một nơi thật đáng buồn.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter022.xhtml/p000582", "segment_id": "YS-LN08/Text/chapter022.xhtml/p000582", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Thưa Tướng quân, xin phép cho tôi được nhắc lại một lần nữa: Tôi chẳng qua chỉ là một người lính bị ràng buộc bởi nghĩa vụ phục vụ hợp pháp. Bất kể xuất phát từ ý định gì, mọi hành vi đi chệch khỏi các chuẩn mực pháp lý đều đồng nghĩa với sự phản bội lại hoàng gia và Tổ quốc ạ.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter022.xhtml/p000583", "segment_id": "YS-LN08/Text/chapter022.xhtml/p000583", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Tất nhiên, điều đó chỉ áp dụng cho câu chữ trên mặt giấy của pháp luật, chứ không phải tinh thần của nó. Bất cứ thứ gì không được ghi thành văn bản đều coi như không tồn tại.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter022.xhtml/p000584", "segment_id": "YS-LN08/Text/chapter022.xhtml/p000584", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Tốt lắm. Nhân tiện, bổn phận của cô là bảo vệ Đế quốc, phải vậy không?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter022.xhtml/p000585", "segment_id": "YS-LN08/Text/chapter022.xhtml/p000585", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Đúng vậy, thưa Tướng quân.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter022.xhtml/p000586", "segment_id": "YS-LN08/Text/chapter022.xhtml/p000586", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Bổn phận trên danh nghĩa của cô…", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter022.xhtml/p000587", "segment_id": "YS-LN08/Text/chapter022.xhtml/p000587", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Đối với Tanya, đó đơn giản là tận tụy thực hiện phần việc của mình theo đúng hợp đồng. Có lẽ nên gọi đó là điều khoản cấm làm nghề tay trái, nhưng theo đuổi bất cứ thứ gì ngoài chiến thắng của Đế quốc đều sẽ mâu thuẫn với chính khái niệm hợp đồng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter022.xhtml/p000588", "segment_id": "YS-LN08/Text/chapter022.xhtml/p000588", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Vậy thì thứ lỗi nhé, nhưng tôi có một mệnh lệnh dành cho cô đây. Trung tá von Degurechaff, hãy tìm cách thực hiện điều mà cô cho là ‘tốt nhất’ đi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter022.xhtml/p000589", "segment_id": "YS-LN08/Text/chapter022.xhtml/p000589", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Nếu đó là ‘mệnh lệnh’ của ngài, thưa ngài…”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter022.xhtml/p000590", "segment_id": "YS-LN08/Text/chapter022.xhtml/p000590", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Tốt. Ừm, phải rồi. Tôi sẽ trực tiếp ra lệnh vậy.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter022.xhtml/p000591", "segment_id": "YS-LN08/Text/chapter022.xhtml/p000591", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Tự hỏi mệnh lệnh đó sẽ là gì, Tanya không khỏi hoang mang, nhưng Zettour lại mỉm cười để giúp cô thả lỏng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter022.xhtml/p000592", "segment_id": "YS-LN08/Text/chapter022.xhtml/p000592", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Đó là một sáng kiến hoàn toàn mới. Một lối thoát mới. Tuy không chính thống, nhưng có lẽ nó lại là tham vọng lớn nhất của đời binh nghiệp đấy.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter022.xhtml/p000593", "segment_id": "YS-LN08/Text/chapter022.xhtml/p000593", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Tôi sẽ rất cảm kích nếu ngài cho tôi biết cụ thể đó là gì ạ.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter022.xhtml/p000594", "segment_id": "YS-LN08/Text/chapter022.xhtml/p000594", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Được thôi.” Zettour hiền từ gật đầu. “Cô có ưa các biện pháp phẫu thuật phòng ngừa không, Trung tá?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter022.xhtml/p000595", "segment_id": "YS-LN08/Text/chapter022.xhtml/p000595", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Trong bối cảnh này…", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter022.xhtml/p000596", "segment_id": "YS-LN08/Text/chapter022.xhtml/p000596", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Trong cuộc trò chuyện này…", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter022.xhtml/p000597", "segment_id": "YS-LN08/Text/chapter022.xhtml/p000597", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "*Các biện pháp phòng ngừa.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter022.xhtml/p000598", "segment_id": "YS-LN08/Text/chapter022.xhtml/p000598", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "*Phẫu thuật ư?*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter022.xhtml/p000599", "segment_id": "YS-LN08/Text/chapter022.xhtml/p000599", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Trong chuỗi từ ngữ đầy ẩn ý sâu xa ấy, Tanya đã phát hiện ra nguồn cơn của bầu không khí nguy hiểm mà cô cảm nhận được từ Zettour ngay từ đầu.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter022.xhtml/p000600", "segment_id": "YS-LN08/Text/chapter022.xhtml/p000600", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Việc một sĩ quan cao cấp lại thẳng thừng nói toẹt điều này ra quả là cảnh tượng hiếm thấy.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter022.xhtml/p000601", "segment_id": "YS-LN08/Text/chapter022.xhtml/p000601", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“…Không phải tôi có ý hỗn xược đâu ạ, nhưng tôi là *một người lính Đế quốc*.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter022.xhtml/p000602", "segment_id": "YS-LN08/Text/chapter022.xhtml/p000602", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Lập trường chính thức thật tuyệt vời.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter022.xhtml/p000603", "segment_id": "YS-LN08/Text/chapter022.xhtml/p000603", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Lập trường chính thức thật an toàn.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter022.xhtml/p000604", "segment_id": "YS-LN08/Text/chapter022.xhtml/p000604", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Do đó, Tanya viện đến câu trả lời mẫu mực mà Trung tá Pháp sư Tanya von Degurechaff vốn dĩ phải đưa ra. Vừa nhấn mạnh rằng mình là một quân nhân và sẽ làm tròn bổn phận của một sĩ quan, cô đồng thời kiên quyết từ chối đi chệch khỏi khuôn khổ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter022.xhtml/p000605", "segment_id": "YS-LN08/Text/chapter022.xhtml/p000605", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Cô tuyệt vọng đến mức Zettour phải bật cười.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter022.xhtml/p000606", "segment_id": "YS-LN08/Text/chapter022.xhtml/p000606", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Tuyệt vời. Nếu cô mà trả lời khác đi, hẳn tôi đã phải bắn cô rồi. Nếu cô đã hiểu rõ đến mức ấy, thì tôi tin rằng cô sẽ có thể thực hiện biện pháp phẫu thuật thích hợp.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter022.xhtml/p000607", "segment_id": "YS-LN08/Text/chapter022.xhtml/p000607", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“…Rốt cuộc ngài đang định làm cái quái gì vậy ạ?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter022.xhtml/p000608", "segment_id": "YS-LN08/Text/chapter022.xhtml/p000608", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Cô chẳng muốn hỏi đâu, nhưng rủi ro của việc không biết còn lớn hơn nhiều.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter022.xhtml/p000609", "segment_id": "YS-LN08/Text/chapter022.xhtml/p000609", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Để có thể dồn toàn bộ sự chú ý sang miền đông, chúng ta cần phải giành chiến thắng trong cuộc chiến ở miền tây.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter022.xhtml/p000610", "segment_id": "YS-LN08/Text/chapter022.xhtml/p000610", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Ý ngài là cuộc không chiến ở miền tây sao ạ?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter022.xhtml/p000611", "segment_id": "YS-LN08/Text/chapter022.xhtml/p000611", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Cô nhận ra đó chỉ là suy nghĩ viển vông, nhưng đấy lại là niềm hy vọng mà cô chẳng thể dễ dàng từ bỏ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter022.xhtml/p000612", "segment_id": "YS-LN08/Text/chapter022.xhtml/p000612", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Lui về phía đông hơn chỗ đó một chút nữa.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter022.xhtml/p000613", "segment_id": "YS-LN08/Text/chapter022.xhtml/p000613", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "*Aaaa, khốn kiếp thật.* Cô đã hiểu ý ông. *Vậy là mọi chuyện đã đi đến nước đó rồi sao?*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter022.xhtml/p000614", "segment_id": "YS-LN08/Text/chapter022.xhtml/p000614", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Phía đông của miền tây thì chỉ có thể là chốn tươi đẹp mà Tanya đã hằng khao khát được quay về: bản quốc thân yêu. Theo thông lệ, rút về hậu phương là một chuyện đáng mừng; thế nhưng… trường hợp cụ thể này lại khiến cô phải ngần ngại.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter022.xhtml/p000615", "segment_id": "YS-LN08/Text/chapter022.xhtml/p000615", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Hãy vui lên đi, Trung tá. Đó là một kiểu chiến tranh hòa bình thôi. Chúng ta sẽ có một khoảng thời gian tuyệt vời ở quê nhà đấy.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter022.xhtml/p000616", "segment_id": "YS-LN08/Text/chapter022.xhtml/p000616", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Nếu đó là mệnh lệnh, thì tất nhiên tôi sẽ cố gắng làm chút việc mọn trong khả năng của mình ạ.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter022.xhtml/p000617", "segment_id": "YS-LN08/Text/chapter022.xhtml/p000617", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Tanya lặp lại rằng cô là một người lính, một thành viên của tổ chức. Ngầm cho cấp trên biết lập trường của mình là điều cốt yếu để tự bảo vệ bản thân. Dù mình cũng chẳng chắc cách đó sẽ hiệu quả đến đâu trong tình huống này.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter022.xhtml/p000618", "segment_id": "YS-LN08/Text/chapter022.xhtml/p000618", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Suy cho cùng, người đàn ông đang nhìn thẳng vào mặt cô, Zettour, lại là một chuyên gia về hành chính quân sự. Một khi bậc thầy về thủ tục giấy tờ đã nghiêm túc ra tay, họ sẽ tìm được cách thực hiện bất cứ điều gì cần thiết.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter022.xhtml/p000619", "segment_id": "YS-LN08/Text/chapter022.xhtml/p000619", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Tuyệt lắm.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter022.xhtml/p000620", "segment_id": "YS-LN08/Text/chapter022.xhtml/p000620", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Rõ, thưa ngài.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter022.xhtml/p000621", "segment_id": "YS-LN08/Text/chapter022.xhtml/p000621", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Hãy biến thời khắc này thành một kỷ nguyên hoàng kim cho Đế quốc… Ngay cả khi đó chỉ là ánh hoàng hôn, chúng ta cũng phải cho họ thấy rằng mặt trời sẽ lại mọc. Tôi trông cậy vào cô đấy, Trung tá.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter022.xhtml/p000622", "segment_id": "YS-LN08/Text/chapter022.xhtml/p000622", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Chúng ta sẽ… biến thời khắc này thành một kỷ nguyên hoàng kim cho Đế quốc ạ.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter022.xhtml/p000623", "segment_id": "YS-LN08/Text/chapter022.xhtml/p000623", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Tốt! Tốt lắm! Chúng ta hãy cùng trui rèn quyết tâm sắt đá nào. Xem chừng chúng ta cũng chẳng có mấy lựa chọn đâu.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter022.xhtml/p000624", "segment_id": "YS-LN08/Text/chapter022.xhtml/p000624", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“…Vâng, chúng ta hãy chuẩn bị tinh thần phòng khi bất trắc ạ.” Tanya lẩm bẩm đáp lời.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter024.xhtml/p000001", "segment_id": "YS-LN08/Text/chapter024.xhtml/p000001", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Mình dám chắc cái mệnh lệnh này sẽ kinh khủng lắm đây. Chắc chắn nó sẽ được biện minh là điều cần thiết, nhưng bị ép phải hùa theo nó thì thật sự vô cùng khó chịu.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter024.xhtml/p000002", "segment_id": "YS-LN08/Text/chapter024.xhtml/p000002", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Dẫu vậy, nếu bỏ chạy không phải là một phương án khả thi, thì chẳng còn lựa chọn nào khác—Tanya cần phải sẵn sàng ứng phó bất kể điều gì sắp sửa ập tới.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter024.xhtml/p000003", "segment_id": "YS-LN08/Text/chapter024.xhtml/p000003", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "*(Tanya Chiến Ký, Tập 8: In Omnia Paratus, Hết)*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
