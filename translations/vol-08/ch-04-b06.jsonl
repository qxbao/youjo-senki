{"id": "YS-LN08/Text/chapter014.xhtml/p000169", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“R-rõ… Chúng tôi sẽ cố gắng hết sức ạ.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000169"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000170", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Chẳng còn mấy thời gian để cân nhắc xem có nên đáp lại câu trả lời cứng nhắc của anh ta bằng vài lời động viên tùy hứng hay không trước khi cục diện chiến trường chuyển biến.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000170"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000171", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Bộ binh địch đang tiếp cận khu vực của chúng ta!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000171"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000172", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Là Tospan hay một hạ sĩ quan nào đó bên bộ binh đây? Dù sao đi nữa, lời cảnh báo từ một sĩ quan cấp dưới cũng khiến Tanya ngẩng đầu lên.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000172"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000173", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Nãy giờ cô vẫn bắt họ ghìm súng, nên việc quân địch tiến lên cũng là điều dễ hiểu. Chưa ai kịp nhận ra thì quân địch đã áp sát đến mức chúng tôi có thể nhìn rõ cả mặt chúng. Nếu Tanya bắt binh lính của mình chờ thêm nữa, họ sẽ có nguy cơ bị địch xung phong áp đảo. Đúng lúc cô đang nghĩ có lẽ họ nên dốc toàn lực đánh trả, một ý nghĩ chợt lóe lên.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000173"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000174", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Đó chỉ là một ý tưởng nhỏ, nhưng những ý tưởng nhỏ thường dẫn đến những thay đổi lớn lao. Chắc chắn thử một phen cũng chẳng hại gì.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000174"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000175", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Các pháp sư, khoan đã! Tôi muốn chỉ một mình bộ binh bắn trả thôi!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000175"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000176", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Hả?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000176"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000177", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Chẳng bận tâm đến đám pháp sư đang ngơ ngác, bộ binh bắt đầu nổ súng. Mỉm cười với Serebryakov bên cạnh, Tanya chỉ ra rằng họ đang bắt chước chiến thuật của kẻ địch.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000177"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000178", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Hãy ru chúng vào một giấc mộng ngọt ngào nào. Chúng ta sẽ giả vờ như mình không có pháp sư, hệt như cách đối thủ Liên bang của chúng ta đã giả vờ không có pháo binh vậy.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000178"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000179", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Trung tá nghĩ chúng sẽ mắc lừa sao ạ?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000179"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000180", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Tanya tự tin đáp lại sự hoài nghi của Serebryakov. “Tôi ghi nhận sự vất vả của cô, *Trung úy Pháp sư* ạ, nhưng hãy thử suy nghĩ như một người lính bộ binh xem.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000180"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000181", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Hửm?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000181"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000182", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Có vẻ như các sĩ quan ma pháp thường đánh giá thấp năng lực của chính mình vì coi đó là điều hiển nhiên. Do không phải là lính bộ binh nên Tanya chỉ có thể phỏng đoán, nhưng cô vẫn hình dung được bộ binh địch ắt hẳn phải khiếp sợ các pháp sư bay trên đầu đến nhường nào.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000182"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000183", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Chúng ta nên nhận ra rằng chúng lúc nào cũng nơm nớp ngước nhìn bầu trời để dè chừng pháp sư. Chúng còn thường có xu hướng tách thành từng tiểu đội chạy tìm chỗ ẩn nấp khi cố thoát khỏi làn đạn súng máy.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000183"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000184", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "…Vậy thì giờ đây, nếu đã đinh ninh rằng chẳng có pháp sư nào cả, chúng sẽ ngước nhìn bầu trời được mấy lần?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000184"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000185", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Trên cao… Chà, đúng là một ý hay. Tanya nhếch mép cười.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000185"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000186", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Có một chân lý phổ quát là rắc rối lúc nào cũng trút xuống từ trên đầu.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000186"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000187", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Tướng von Zettour cũng… thật sự quá đáng hết sức.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000187"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000188", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Quá đáng sao ạ, thưa Trung tá?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000188"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000189", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Tanya vốn chỉ đang lẩm bẩm một mình, nhưng thấy sĩ quan phụ tá lên tiếng đáp lời, cô đành nhún vai.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000189"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000190", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Cô đang khuyên cấp trên của mình làm lộ thông tin mật đấy à, Trung úy Serebryakov?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000190"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000191", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“K-không ạ.” Serebryakov lắc đầu, còn Tanya bảo cô ấy đó chỉ là một câu nói đùa. Việc phải liên tục nã đạn vào từng đợt lính Liên bang từ sau chỗ ẩn nấp chẳng thể nào tốt cho sức khỏe tinh thần của con người ta được.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000191"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000192", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Nhưng nghiêm túc mà nói, môi trường làm việc này rất có thể là tồi tệ nhất.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000192"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000193", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“…Chúng ta xả hơi một chút bằng cách chuẩn bị cho đợt phản kích này nhé?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000193"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000194", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Nhìn ra từ sau chỗ ẩn nấp, Tanya thấy lính địch đang nhanh chóng áp sát.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000194"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000195", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Về cơ bản, chúng đang dồn toàn bộ sự chú ý vào mặt đất, cố tình quên đi các mối đe dọa trên bầu trời trong lúc xung phong. Đó là một bước tiến hiệu quả, nhưng cho rằng chiến tranh chỉ diễn ra trong không gian hai chiều là lối tư duy đáng lẽ phải bị bỏ lại trong quá khứ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000195"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000196", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Dù sao thì thời đại này cũng là thời đại của không gian ba chiều. Cảm thấy may mắn vì không bị kẻ địch phóng thuật thức, đám lính bộ binh địch thở phào nhẹ nhõm và mặc nhiên cho rằng chẳng có pháp sư nào cả—một điểm yếu mà Tanya triệt để khai thác.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000196"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000197", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Dụ được chúng chưa? Dụ được chúng chưa? …Được rồi, lên thôi!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000197"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000198", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Như thể làm gương về cách dẫn đầu nơi tiền tuyến, Tanya vọt thẳng lên không trung.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000198"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000199", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Vút lên trời cao, cô dùng khẩu tiểu liên của mình nã đạn xuống quân địch bên dưới. Tất cả những gì cô cần làm là siết ngón tay đang đặt trên cò súng bất cứ khi nào nòng súng thẳng hàng với một tên lính Liên bang.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000199"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000200", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "*Pằng, pằng-pằng-pằng.* Tiếng súng nổ nghe thật êm tai khi cơn mưa đạn thuật thức trút xuống mặt đất bên dưới.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000200"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000201", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Cho dù bộ binh Liên bang có cố phản ứng thế nào đi nữa thì cũng đã quá muộn. Chúng chỉ vừa kịp ngước nhìn bầu trời, nhưng rất có thể… chúng thậm chí còn chẳng hiểu nổi chuyện gì đang xảy ra với mình.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000201"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000202", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Ma năng hiển hiện bên trong những viên đạn thuật thức, sẵn sàng can thiệp vào thế giới. Chúng tôi kiểm soát sự bùng nổ hết mức có thể nhằm hạn chế mảnh văng, để những thuật thức phát nổ mà chúng tôi đang rải xuống không làm hư hại các tòa nhà gần đó.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000202"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000203", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Đó chỉ là một đợt công kích duy nhất. Nhưng lại là một cuộc phục kích được tính toán kỹ lưỡng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000203"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000204", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Khi những viên đạn thuật thức phát nổ, các thành phần từng là lính Liên bang văng tung tóe khắp mặt đất; vào khoảnh khắc đó, nhiều tên trong số chúng đã đưa ra quyết định.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000204"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000205", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Quang đãng! Quang đãng! Lính địch đang mất ý chí chiến đấu rồi!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000205"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000206", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Chẳng ai muốn chết cả. Đối mặt với nỗi kinh hoàng của cái chết, bản năng của con người là tháo chạy. Bản năng đó chỉ có thể được kìm nén nhờ một mức độ huấn luyện và kỷ luật nhất định.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000206"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000207", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“01 gọi toàn đội! Đừng phá hủy quá nhiều chỗ ẩn nấp! Hãy nghĩ cho Trung úy Tospan nữa. Nếu chúng ta làm họ chẳng còn chỗ nào mà nấp, tôi sẽ là người phải đi xin lỗi đấy!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000207"}
