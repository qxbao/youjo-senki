{"id": "YS-LN08/Text/chapter014.xhtml/p000208", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Thưa Trung tá! Các pháp sư địch đang bắt đầu di chuyển! Có vẻ chúng đang làm nhiệm vụ phản ứng nhanh—chúng đang lao thẳng về phía chúng ta ạ!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000208"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000209", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Gật đầu cảm ơn Serebryakov, Tanya liền triệu tập phó chỉ huy của mình, người đang làm nhiệm vụ chống pháo kích.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000209"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000210", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Thiếu tá Weiss, quân địch tới rồi đây. Là các pháp sư địch đấy!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000210"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000211", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Vậy là cuối cùng chúng cũng chịu ló mặt ra rồi!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000211"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000212", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Cứ như lũ trẻ đi học muộn ấy! Đi đánh trận muộn cũng là chuyện thường tình của con người—một điều tốt đẹp đấy chứ. Tôi đoán chúng ta nên lấy làm biết ơn vì màn tự hủy hoại của chúng.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000212"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000213", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Trung tá nói chí phải! Chúng ta trừng phạt đám trẻ đi muộn đó nhé?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000213"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000214", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Ừ.” Cô gật đầu dứt khoát. “Chơi đùa với chúng cho vui vẻ vào.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000214"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000215", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Rõ, thưa Trung tá! Tôi có thể mượn Trung úy Serebryakov được không ạ?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000215"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000216", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Được thôi. Trung úy, đi yểm trợ cho anh ấy đi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000216"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000217", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Nếu đã điều sĩ quan phụ tá của mình đi, Tanya cần phải tìm một người phối hợp mới. May thay, việc phòng ngự trước bộ binh dưới mặt đất cũng chẳng phải là công việc gì quá khó nhằn.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000217"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000218", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "*Quá chuẩn*, cô nghĩ thầm rồi vỗ vai chàng trai trẻ đang sát cánh chiến đấu cùng bộ binh của Tospan. “Trung úy Wüstemann, xuống mặt đất chơi trò đuổi bắt với tôi nào. Hãy đánh tan đám lính bộ binh địch đi!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000218"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000219", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“R-rõ!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000219"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000220", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Được rồi. Với Wüstemann làm cộng sự mới, Tanya bắt tay vào việc truy quét tàn quân địch. Dù nói vậy, việc xua đuổi đám bộ binh vốn đã sụp đổ ý chí chiến đấu thực sự vô cùng đơn giản. Ngay cả một thiếu úy vừa mới ra trường cũng có thể làm tròn vai.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000220"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000221", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Tanya quan sát cách đơn vị của Wüstemann tác chiến để xem thực lực của họ ra sao, rồi thầm ghi nhận rằng họ vẫn còn non nớt lắm.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000221"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000222", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Xét về kỹ năng thì họ không tệ, nhưng họ chưa chú ý đúng mức đến việc hiệp đồng với bộ binh của Tospan. Cũng có thể châm chước đôi phần vì họ bị ghép cặp quá đột ngột và có lẽ chưa nắm tường tận năng lực của nhau, nhưng một khi đã thuộc cùng một Kampfgruppe thì đáng lẽ họ *phải* nắm được rồi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000222"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000223", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Nhưng đến nước này, phải thừa nhận rằng Tanya nên điều chỉnh lại đánh giá của mình một chút. Xét trên mức độ đào tạo và kinh nghiệm của họ… Mình đoán kết quả đạt được chỉ có thể đến thế này thôi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000223"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000224", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Không chỉ riêng Wüstemann; tất cả các sĩ quan ma pháp đều lạ lẫm với cách thức vận hành của bộ binh thông thường. Ở học viện cũng có dạy điều đó ở một mức độ nhất định, nhưng hầu hết sĩ quan ma pháp đều chỉ huy các trung đội và đại đội pháp sư chứ không phải bộ binh. Họ chỉ quen với lối tác chiến đó mà thôi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000224"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000225", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Vì lý do đó, cô điều chỉnh lại đánh giá trong đầu về Wüstemann thành *Gần đạt chuẩn*.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000225"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000226", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Ở đây xong xuôi cả rồi ạ. Chúng ta đã đánh đuổi được quân địch.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000226"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000227", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Làm tốt lắm.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000227"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000228", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Sau khi hoàn thành nhiệm vụ, Tanya đưa ra vài lời chỉ bảo cho vị trung úy dựa trên những điều cô vừa nhận thấy. “Anh đã rất nỗ lực, nhưng tôi muốn anh tìm hiểu thêm về bộ binh. Dù vẫn còn thiếu kinh nghiệm chỉ huy một đại đội pháp sư, anh đang dần tiến bộ đấy. Tuy nhiên, có vẻ như anh chưa hiểu cách các binh chủng khác vận hành, như vậy thì việc nằm trong một Kampfgruppe hỗn hợp chẳng còn ý nghĩa gì nữa.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000228"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000229", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Trung tá nói rất chí lý ạ.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000229"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000230", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Nói cho rõ thì tôi không trách anh đâu. Ý tôi là, tình hình hiện giờ chẳng mấy khả quan, nhưng… bất chấp việc thiếu kinh nghiệm, anh vẫn đang làm ổn đấy—điều đó thì chắc chắn.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000230"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000231", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Cách diễn đạt của Tanya có hơi khắt khe một chút, nhưng đó là một lời đánh giá hoàn toàn xác đáng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000231"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000232", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Xin cảm ơn lời khen nghiêm khắc của Trung tá ạ.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000232"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000233", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Wüstemann ngoan ngoãn gật đầu; có thể nói anh ta vẫn còn dư địa để phát triển. Nếu thứ duy nhất còn thiếu là kinh nghiệm, việc đào tạo có thể lấp đầy những khoảng trống đó. Một cá nhân biết tiếp thu ý kiến phản hồi và sẵn lòng học hỏi hoàn toàn có thể được chỉ dạy để đạt tới một trình độ nhất định.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000233"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000234", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Vô cùng ấn tượng trước sức mạnh của giáo dục, Tanya hướng sự tập trung trở lại công việc rồi sải bước về phía đơn vị bộ binh.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000234"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000235", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Trung úy Tospan đâu rồi?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000235"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000236", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Có mặt!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000236"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000237", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Một khuôn mặt lấm bồ hóng đội mũ sắt thò ra từ rìa chỗ ẩn nấp.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000237"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000238", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Ồ, anh cũng đang trực tiếp chỉ huy ở tuyến đầu đấy à?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000238"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000239", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Khi nói đến những kẻ thật thà thái quá và những tên ngốc nghiêm túc đến mức chẳng biết lười biếng là gì, tất cả đều quy về cách bạn sử dụng họ ra sao.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000239"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000240", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Dạo gần đây, Tanya cảm thấy cổ phiếu của Tospan đang lên giá vùn vụt. Chà, một phần nguyên nhân là do điểm xuất phát của anh ta vốn quá thấp.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000240"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000241", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Dù sao đi nữa, miễn là anh ta ở ngay cạnh mình thì mọi chuyện sẽ dễ dàng hơn nhiều.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000241"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000242", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Hai Trung úy, chúng ta có việc phải làm đây.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000242"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000243", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Rõ, thưa Trung tá!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000243"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000244", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Chỉ có một tiếng đáp lại.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000244"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000245", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Chỉ mỗi Tospan.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000245"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000246", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“…Trung úy Wüstemann?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000246"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000247", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Rõ, thưa Trung tá,” viên sĩ quan trẻ đáp lời, tràn ngập vẻ nhẹ nhõm vì công việc của mình đã xong. Thế là không ổn rồi. Bạn chỉ được phép lơ là cảnh giác một khi công việc đã hoàn tất và đang nhâm nhi tách cà phê của mình mà thôi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000247"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000248", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Mình vừa mới khen anh ta lúc nãy, nhưng có lẽ mình đã nói quá sớm. Đúng là tốn công rèn cặp. Tanya vỗ mạnh một cái vào lưng anh ta từ phía sau. “Vẫn còn quá sớm để thả lỏng đấy, Trung úy.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000248"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000249", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“H-hả? Vẫn còn quân địch quanh đây sao ạ?” Điệu bộ cứng đờ người lại của anh ta đã phơi bày sự thiếu kinh nghiệm. Chỉ có tay mơ hoàn toàn mới thay đổi mức độ cảnh giác dựa trên việc có hay không có sự hiện diện của quân địch.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000249"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000250", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Thế này lại vừa khéo. Đào tạo lại ngay tại chiến trường luôn. Đi kiếm đồ tiếp tế thôi nào.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000250"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000251", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Hả? Đồ tiếp tế sao ạ, thưa Trung tá?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000251"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000252", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Vẻ mặt ngơ ngác của anh ta cho thấy anh ta không hề ngờ tới điều đó, nhưng Tanya gật đầu. “Chúng ta sẽ đi thu gom đồ thất lạc—đến lúc thể hiện chút lòng tốt với môi trường bằng việc tái chế rồi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000252"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000253", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Bạn phải thân thiện với môi trường bằng cả cái tôi của mình—điều đó mới đảm bảo bạn sẽ duy trì việc đó lâu dài.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000253"}
{"id": "YS-LN08/Text/chapter014.xhtml/p000254", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Sống thân thiện với môi trường thật tuyệt vời, vì nó hoàn toàn hợp lý về mặt kinh tế. Việc đó vừa hợp pháp vừa mang lại lợi ích kinh tế, đồng thời biểu thị trạng thái cân bằng thị trường.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN08/Text/chapter014.xhtml/p000254"}
