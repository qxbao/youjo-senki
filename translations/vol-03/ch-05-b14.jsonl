{"segment_id": "YS-LN03/Text/chapter005_004.xhtml/p000236", "translation": "Chỉ cần nghe một câu ấy của cô, bất kỳ sĩ quan nào cũng sẽ hiểu vì sao Cụm tập đoàn quân phương Bắc và Cụm tập đoàn quân phương Tây không thể kiểm soát được cô.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter005_004.xhtml/p000237", "translation": "Việc một tiểu đoàn pháp sư tách khỏi cơ cấu chỉ huy cũng chẳng khác nào mất đi cả một sư đoàn. Thông thường, không một vị chỉ huy nào có thể chấp nhận một hệ thống chỉ huy tách biệt như thế.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter005_004.xhtml/p000238", "translation": "“Chuyện đó thì khỏi phải nói! Và Thiếu tá von Degurechaff, một khi cô đã nói đến mức ấy, hẳn là ta có thể kỳ vọng đơn vị của cô sẽ lập nên những chiến công lớn, phải không?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter005_004.xhtml/p000239", "translation": "Nhưng xem ra cô không mấy hài lòng trước phản ứng của Romel.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter005_004.xhtml/p000240", "translation": "Sự im lặng của cô thể hiện rõ thái độ phản đối việc ông nghi ngờ năng lực của họ. Đáp lại câu hỏi của một sĩ quan cấp trên bằng thái độ như thế, quả là xấc xược đến mức khó tin. *À.* Nhưng điều đó lại thực sự giúp Romel nhận ra vì sao cấp trên *của ông* từng ghẻ lạnh *ông*.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter005_004.xhtml/p000241", "translation": "Ngay cả Romel cũng chưa từng ngạo ngược đến mức này.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter005_004.xhtml/p000242", "translation": "“Sao, cô nghĩ thế nào?” Ông thúc ép cô trả lời, giọng bất giác đanh lại. Nếu giờ cô không trả lời, ông chẳng cần quan tâm Bộ Tổng tham mưu nói gì—ông sẽ trả cô về ngay.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter005_004.xhtml/p000243", "translation": "“Thưa Tướng von Romel, với tất cả sự kính trọng… tôi chỉ đơn thuần là lược bỏ công sức đáp lại một câu hỏi bất khả thi để trả lời mà thôi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter005_004.xhtml/p000244", "translation": "“…Cái gì?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter005_004.xhtml/p000245", "translation": "Nhưng câu trả lời ông nhận được lại khiến ông phải đáp lại bằng một câu hỏi khác. *Cô ta vừa nói gì cơ? Một câu hỏi bất khả thi để trả lời ư?*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter005_004.xhtml/p000246", "translation": "“Tôi là một người lính, không phải một kẻ khéo mồm khéo miệng. Tôi e là mình không thể giải thích năng lực quân sự của chúng tôi bằng lời nói được.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter005_004.xhtml/p000247", "translation": "Giọng cô đột ngột thay đổi. Bên cạnh thái độ tự cao tự đại, nó còn toát ra vẻ mỉa mai nặng nề.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter005_004.xhtml/p000248", "translation": "“Và ngay cả khi tôi có là người như thế, tôi cũng nghi ngờ liệu điều đó có làm ngài hài lòng hay không, thưa Tướng quân; do đó, tôi không thể trả lời được.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter005_004.xhtml/p000249", "translation": "Những lời ấy vang lên bên tai ông. Ông nghe thấy chúng; đó là ngôn ngữ chính thức của Đế quốc, được phát âm chuẩn xác theo lối Đế quốc tiêu chuẩn. Ông không gặp chút khó khăn nào để nghe rõ từng chữ; giọng cô trong trẻo như tiếng chuông ngân.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter005_004.xhtml/p000250", "translation": "Thế nhưng, trong một thoáng, ông không sao hiểu nổi ý đồ của cô. *Con bé trước mặt mình vừa mới nói ra một điều mà mình không tài nào hiểu nổi đấy ư?*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter005_004.xhtml/p000251", "translation": "Ông chật vật tìm cách thấu hiểu. Rồi một lát sau, cuối cùng ông cũng nắm bắt được ý nghĩa thực sự của chuỗi từ ngữ ấy.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter005_004.xhtml/p000252", "translation": "“…Nói cách khác, ý cô là ‘trăm nghe không bằng một thấy’. Đó là điều cô muốn nói, phải không?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter005_004.xhtml/p000253", "translation": "“Tôi xin kính cẩn nhường quyền diễn giải lại cho ngài. Thưa Tướng quân, xin hãy tin tưởng tôi và đơn vị của tôi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter005_004.xhtml/p000254", "translation": "Sự im lặng bao trùm.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter005_004.xhtml/p000255", "translation": "Trong ánh mắt cô là một lời thỉnh cầu tha thiết. Nếu đó chỉ là một màn kịch, thì quả là điên rồ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter005_004.xhtml/p000256", "translation": "Ông bất giác chết lặng. Cảm giác ấy chỉ có thể được miêu tả là nỗi bàng hoàng khi vừa chứng kiến một điều không thể tin nổi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter005_004.xhtml/p000257", "translation": "Một ý nghĩ duy nhất hiện lên trong tâm trí ông.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter005_004.xhtml/p000258", "translation": "*Hội chứng Tiền tuyến.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter005_004.xhtml/p000259", "translation": "Thiếu tá von Degurechaff mang vô số triệu chứng của nó. Cách cô cảnh cáo ông, dẫu chỉ gián tiếp: *Đừng có hỏi những câu ngu ngốc.* Cách cô đồng thời đe dọa ông: *Ông không hiểu tôi mạnh đến mức nào ư?* Nhưng đồng thời lại có cả tính hợp lý trong những câu trả lời chân thành của cô.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter005_004.xhtml/p000260", "translation": "Vậy là cô không chỉ kiêu ngạo, mà rõ ràng còn méo mó một cách khủng khiếp.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter005_004.xhtml/p000261", "translation": "*Cô ta chẳng tin vào bất cứ thứ gì. Không tin vào năng lực của giới lãnh đạo quân đội, không tin vào chiến lược, và có lẽ chẳng tin cả đồng đội của mình. Bất chấp điều đó, cô ta lại trung thành với Lục quân Đế quốc một cách đáng kinh ngạc. Thậm chí có thể gọi cô ta là một kẻ lập dị trung thành vô song, chỉ chăm chăm làm con chó canh gác cho quốc gia.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter005_004.xhtml/p000262", "translation": "*Ra là vậy…* Romel đã hiểu lý do cô từng bất tuân mệnh lệnh trong quá khứ. *Cô ta chỉ đơn giản là tự quyết định mình sẽ làm một người yêu nước nếu điều đó có lợi cho quốc gia. Tóm lại, cô ta là một kẻ điên có năng lực, nhưng tệ ở chỗ bản thân cô ta thậm chí còn chẳng nhận ra mình bị vặn vẹo.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter005_004.xhtml/p000263", "translation": "“…Thiếu tá, ta chưa có đủ bằng chứng để tin tưởng cô.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter005_004.xhtml/p000264", "translation": "*Cô ta điên rồi. Và có năng lực. Lại còn chân thành hơn bất kỳ ai mà mình từng biết.* Hiếm khi nào Romel lại gặp một người mà ông không thể phán đoán được như cô. Nhưng ông biết chắc một điều rằng cô sẽ không hề dễ đối phó.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter005_004.xhtml/p000265", "translation": "Đó là lý do ông hỏi làm sao ông có thể tin tưởng cô được.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter005_004.xhtml/p000266", "translation": "“Việc tôi tự liệt kê những chiến công của mình là hoàn toàn vô nghĩa. Tôi xin tùy ngài sai phái.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter005_004.xhtml/p000267", "translation": "Và câu trả lời của cô nêu ra một lẽ hiển nhiên. Thông thường thì Romel cũng đánh giá cao thái độ coi trọng hành động hơn lời nói.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter005_004.xhtml/p000268", "translation": "Cô không tự phụ về năng lực của mình; cũng chẳng phải kẻ nô lệ cho sức mạnh của bản thân. Cô nói năng hết sức điềm nhiên, thực tế. Có lẽ cô đủ khả năng phán đoán đâu là việc khả thi và đâu là việc sẽ gặp khó khăn.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter005_004.xhtml/p000269", "translation": "Nếu không, cô đã chẳng thể đùa với lửa ngay trước một kho đạn như lúc này. Tóm lại, sự điên rồ của cô được hậu thuẫn bởi năng lực vô hạn. Ông chỉ có thể kết luận rằng cô bị điên.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter005_004.xhtml/p000270", "translation": "“Ta muốn xem cô làm được gì. Không, đừng hiểu lầm. Ý ta là trên cương vị một nhà chiến lược kìa.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter005_004.xhtml/p000271", "translation": "*Mình sẽ gọi cô ta là một anh hùng, một kẻ điên, một người đồng đội.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter005_004.xhtml/p000272", "translation": "*Vậy nên cô ta cần phải chứng minh khả năng của mình. Cô ta chỉ đơn thuần là một con thú hoang nhuốm màu điên loạn? Hay là một con mãnh thú xảo quyệt sở hữu một trí tuệ điên rồ?*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter005_004.xhtml/p000273", "translation": "Romel chợt nhận ra ông muốn biết câu trả lời.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter005_004.xhtml/p000274", "translation": "“Ta sẽ cử cô đi thực hiện một nhiệm vụ cơ động ứng chiến. Ta muốn cô dẫn theo nhóm thứ hai. Nhân tiện, chủ trương ở đây là trao cho các cô, dưới danh nghĩa Kampfgruppe Bảy, thẩm quyền ngang hàng với các Kampfgruppe khác, dù các cô chỉ là một tiểu đoàn đơn lẻ. Đừng làm ta thất vọng.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter005_004.xhtml/p000275", "translation": "*Mình sẽ thử sức cô ta trong một nhiệm vụ có phần độc lập. Chà, mình cũng phần nào đoán được kết cục sẽ ra sao rồi, nhưng… hy vọng cô ta sẽ mang lại kết quả.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter005_004.xhtml/p000276", "translation": "“Rõ. Chúng tôi sẽ đáp ứng kỳ vọng của ngài.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter005_004.xhtml/p000277", "translation": "*Nhìn xem kìa.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter005_004.xhtml/p000278", "translation": "*Nụ cười nham hiểm đó.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter005_004.xhtml/p000279", "translation": "*Trông cô ta phấn khích chưa kìa.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter005_004.xhtml/p000280", "translation": "*Cô ta vui sướng biết bao khi có được một nơi để chiến đấu.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter005_004.xhtml/p000281", "translation": "*Không còn nghi ngờ gì nữa, rốt cuộc cô ta sẽ trở thành kẻ khủng khiếp nhất mà mình từng biết. Và có lẽ cô ta cũng sẽ là một trong những người bạn đáng tin cậy nhất của mình trên chiến trường.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
