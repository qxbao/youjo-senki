{"segment_id": "YS-LN05/Text/part0025.html/p000001", "translation": "NGÀY 10 THÁNG 10, NĂM THỐNG NHẤT 1926, LÃNH THỔ LIÊN BANG, CĂN CỨ HẢI QUÂN", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000002", "translation": "Trong tất cả các cơ sở y tế ở Liên bang, những cơ sở thuộc căn cứ hải quân là tân tiến nhất nhờ vẫn duy trì liên lạc với Phe Phương Tây. Ít nhất thì cũng có thể gọi đó là những bệnh viện đúng nghĩa. Nơi đây được biên chế đầy đủ đội ngũ nhân viên y tế qua đào tạo bài bản.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000003", "translation": "Và đương nhiên, họ chú trọng không chỉ về số lượng mà cả chất lượng nữa. Riêng về thuốc men, nơi đây dồi dào vượt trội hơn hẳn nhờ nguồn dược phẩm chuyển sang từ Phe Phương Tây.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000004", "translation": "Ít ra, khác hẳn với sự khốc liệt đến rợn người của môi trường cứu chữa ngoài tiền tuyến, nơi này có điều kiện tốt hơn không sao sánh xiết. Đây là một bệnh viện thực thụ với những tấm ga trải giường trắng tinh tươm, mùi cồn sát trùng nồng gắt và sàn vải dầu được lau chùi sạch bóng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000005", "translation": "Các sĩ quan quân y nơi tuyến đầu xa nhất, những người theo báo cáo là đang dần cạn kiệt thuốc men, thậm chí đã thôi mơ tưởng về những cơ sở vật chất như thế này.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000006", "translation": "Thế nhưng, cho dù cơ sở vật chất có được trang bị tốt đến đâu đi chăng nữa…", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000007", "translation": "“Này, này, cứu với! Làm ơn, tôi cần thuốc trợ tim! Nhanh lên!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000008", "translation": "“Thôi đi… Thomas! Jackson đã yên nghỉ rồi!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000009", "translation": "“Trung tá Drake! Không thể nào như thế được! Xin ngài đừng nói những lời điên rồ như vậy! Jackson! Này, Jackson! Tỉnh lại đi! Cậu sắp được về nhà rồi cơ mà, phải không?!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000010", "translation": "Bệnh viện thời chiến thì vẫn là… bệnh viện.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000011", "translation": "Chứng kiến viên sĩ quan thuộc cấp của mình gào thét, không sao chấp nhận nổi cái chết của người pháp sư trẻ đã tắt thở… ông đã quá quen với cảnh tượng này rồi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000012", "translation": "*Thật là một chuyện khốn nạn để mà quen dần*, Trung tá Drake than thở trong lòng; bước chân vào phòng, một góc nào đó nơi trái tim khô cằn của ông chỉ thèm một ly rượu mạnh.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000013", "translation": "“Này! Khám lại cho cậu ấy đi!” Thomas quát tháo nhân viên quân y Liên bang.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000014", "translation": "“Nh-nhưng mà…”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000015", "translation": "Drake thấu hiểu tâm trạng của Thomas đến đau lòng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000016", "translation": "Các đơn vị pháp sư vốn tự hào có mối gắn kết bền chặt như người một nhà. Không, tình cảm giữa họ còn đậm sâu hơn cả máu mủ. Có mấy sĩ quan giữ nổi bình tĩnh khi mất đi một người bạn từng cùng mình vào sinh ra tử, từng chia ngọt sẻ bùi cơ chứ?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000017", "translation": "“Đừng có chết ở nơi như thế này!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000018", "translation": "Chưa kể, ông còn nhớ Thiếu úy Jackson là đàn em khóa dưới của Trung úy Thomas một năm. *Họ là bạn bè từ thời học viện*—ông buộc phải đặt chuyện đó ở thì quá khứ. Đối với chính Drake, đây cũng là một điều vô cùng đáng tiếc.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000019", "translation": "“Trung úy Thomas!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000020", "translation": "“Thưa Trung tá, chắc chắn là—chắc chắn là có sự nhầm lẫn nào đó!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000021", "translation": "Dẫu vậy, chuyện này cũng chỉ có thể kéo dài đến thế mà thôi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000022", "translation": "“Cậu còn rất nhiều đồng đội khác đang cần được cứu chữa đấy. Giữ trật tự đi, Trung úy Thomas!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000023", "translation": "“Nhưng mà!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000024", "translation": "Ông sẽ không gọi đây là một cơn ăn vạ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000025", "translation": "Ông có thể hiểu được việc mất bình tĩnh đến mức khước từ cả lý lẽ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000026", "translation": "*…Chuyện này… thật chẳng dễ gì mà quen nổi.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000027", "translation": "Giá như ông không buộc phải chứng kiến cái chết của biết bao thuộc cấp đến mức gần như chai sạn đi, thì hẳn đã tốt đẹp biết nhường nào.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000028", "translation": "Đó là một công việc tồi tệ và một cương vị cũng tồi tệ chẳng kém. Nhưng trong chiến tranh, thương vong là điều không thể tránh khỏi. Chừng nào điều đó còn là bất khả kháng, người sĩ quan buộc phải chấp nhận thực tế ấy và làm những việc cần phải làm.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000029", "translation": "“Bình tĩnh lại đi!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000030", "translation": "Ông thụi cho Thomas một cú rồi nhân lúc cậu ta còn đang choáng váng mà lôi xềnh xệch ra khỏi phòng như thể đang tống cổ một kẻ gây rối. Có lẽ nên gọi là *may mắn* chăng? Vài người bạn của gã ngốc đó vì lo lắng cho cậu ta nên đã tới đỡ lấy.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000031", "translation": "Rượu và thời gian là hai thứ duy nhất ông có thể kê đơn để giải quyết vấn đề đó. Đêm nay, chẳng còn cách nào khác ngoài việc uống cho say mèm. *Mình sẽ cho chúng thời gian để cùng ôn lại kỷ niệm về người đã khuất và khóc một trận thật đã đời như những đấng nam nhi.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000032", "translation": "Drake khẽ nhăn mặt khi nhận ra mình đã uống nhiều đến mức nào kể từ lúc cuộc chiến bắt đầu. Ông lúc nào cũng uống theo cái kiểu tệ hại nhất, chẳng bao giờ là để thưởng thức; cứ thế thì thà uống cồn sát trùng luôn cho xong. Cứ đà này, ông cảm thấy mình sắp sửa quên mất cách nhấm nháp một ly rượu ngon mất rồi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000033", "translation": "*Nhưng mà*. Ông kéo tâm trí mình trở về với thực tại và cúi đầu. “Tôi xin lỗi vì sĩ quan của tôi đã làm cản trở công việc của các anh. Xin hãy tiếp tục khám cho những người bị thương khác.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000034", "translation": "“Không, chuyện đó là…”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000035", "translation": "“Dù có biện bạch thế nào đi nữa, sự thật vẫn là cậu ta đã gây phiền phức. Xin hãy để tôi được tạ lỗi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000036", "translation": "Drake đã dặn dò các pháp sư của mình một cách hết sức dứt khoát rằng họ phải giữ thái độ tôn trọng đối với các sĩ quan cũng như nhân viên quân y Liên bang.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000037", "translation": "Đồng minh đang dốc nguồn lực y tế hữu hạn để cứu chữa cho họ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000038", "translation": "Cúi đầu cảm ơn những nhân viên đã vất vả vì mình rồi ngay sau đó lại quay sang trút lời mắng nhiếc lên đầu họ là điều sai trái. Đó là lý do vì sao Drake không hề do dự. Ông cúi đầu thật sâu trước người quân y trẻ tuổi vừa bị Thomas làm phiền.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000039", "translation": "Đó là phận sự của ông trên cương vị người chịu trách nhiệm.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
