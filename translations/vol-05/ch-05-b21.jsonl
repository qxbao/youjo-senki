{"segment_id": "YS-LN05/Text/part0025.html/p000849", "translation": "Không thể phủ nhận rằng con người ai cũng có lúc mắc sai lầm. Ngay cả Tanya cũng chẳng ngại thừa nhận mình từng phạm phải không ít sai lầm.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000850", "translation": "Ưỡn ngực lên rồi tuyên bố rằng mọi hành động của mình đều không chê trách vào đâu được ư?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000851", "translation": "Mình chẳng muốn làm một kẻ ngu xuẩn như thế đâu.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000852", "translation": "Nhưng chính vì vậy…", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000853", "translation": "Thứ duy nhất mình có thể kê đơn cho những kẻ đần độn không biết nhận lỗi và sửa sai là một viên đạn. Cứ để mặc những kẻ như thế tiếp tục ở lại trong tổ chức thì rốt cuộc chúng sẽ gặm nhấm tổ chức từ bên trong.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000854", "translation": "“Đơn vị của Đại úy Ahrens đã đột phá thành công và bắt đầu càn quét tàn quân. Anh ấy đang yêu cầu bộ binh chi viện ạ.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000855", "translation": "“Được rồi, tôi đã nắm được.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000856", "translation": "Những suy tư và chiêm nghiệm xin khép lại tại đây.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000857", "translation": "Mình chẳng còn lựa chọn nào khác.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000858", "translation": "Đúng là một nguồn tài nguyên bao giờ cũng khan hiếm: thời gian để suy tính kỹ lưỡng! Một chỉ huy Kampfgruppe lúc nào cũng mỏi mòn khát khao nó và chẳng bao giờ ngớt than thở về sự thiếu hụt ấy.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000859", "translation": "“Vậy là trận truy kích đang diễn ra thuận lợi nhỉ? Thực ra còn nhanh hơn chúng ta nghĩ nữa?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000860", "translation": "Nó liếc nhìn đồng hồ cùng tấm bản đồ, nhận thấy đơn vị của Ahrens đã đột phá sớm hơn dự kiến.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000861", "translation": "Nó từng nghe nói anh ta rất giỏi. Nhưng tài năng của anh ta khi chỉ huy thứ công cụ bạo lực mang tên đơn vị thiết giáp bất chấp màn đêm quả thực đạt tới mức xuất sắc đáng khen ngợi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000862", "translation": "Và khi sực nhận ra mình đang nghĩ hẳn anh ta đã đích thân dẫn đầu đội hình, nó không sao nén nổi một nụ cười khổ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000863", "translation": "Một sĩ quan đi đầu dẫn dắt cả đội, thực thi chức trách của mình một cách chuẩn mực…", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000864", "translation": "Một sĩ quan lao lên tuyến đầu không phải lúc nào cũng là một sĩ quan giỏi. Nhưng một người biết rõ khi nào mình cần có mặt ở đó và không để thời khắc ấy vuột mất…", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000865", "translation": "Một sĩ quan như thế đáng giá cả một gia tài.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000866", "translation": "Đó là lý do vì sao, trên cương vị một sĩ quan cấp trên, Tanya không thể để mất một sĩ quan cấp dưới tận tụy như Đại úy Ahrens được.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000867", "translation": "“Hãy chuyển một bức điện giúp tôi. *Tôi đặt kỳ vọng rất lớn ở anh, nhưng tôi muốn chúng ta cùng nhau ăn mừng chiến thắng. Dù có làm gì đi nữa thì cũng đừng liều lĩnh quá sức.* Hãy đảm bảo chuyển đúng lời đó tới anh ta.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000868", "translation": "“Rõ, thưa Trung tá.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000869", "translation": "Một lính thông tin ghi lại lời nhắn của mình rồi truyền cho Đại úy Ahrens qua vô tuyến. Ahrens thực sự rất có triển vọng. Ra lệnh cho anh ta làm quá sức rồi để mất anh ta thì thật đáng tiếc vô cùng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000870", "translation": "Thú vị thật đấy, chỉ trong một trận đánh duy nhất, kết quả từ hành động của một con người đã chỉ rõ liệu kẻ đó nên bị đem đi xử tử hay nên được giữ mạng để tiếp tục tận dụng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000871", "translation": "“Và cho bộ binh khẩn trương xuất phát ngay đi. Một đại đội do Trung úy Grantz chỉ huy, đồng thời cho đơn vị pháp sư của Trung úy Wüstemann đi cùng họ.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000872", "translation": "“Rõ. Tôi sẽ thi hành ngay, thưa Trung tá!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000873", "translation": "Chúng ta sẽ ồ ạt đổ bộ binh vào lấp đầy lỗ thủng mà đơn vị thiết giáp vừa mở ra. Bộ binh là binh chủng giống như nước trong lực lượng vũ trang vậy. Hễ nơi nào có kẽ hở là nó sẽ thấm ngay vào đó.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000874", "translation": "Nhờ vậy.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000875", "translation": "Hoặc có lẽ nói là *như một lẽ đương nhiên* thì đúng hơn…", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000876", "translation": "Đến khi mặt trời mọc, Kampfgruppe Salamander đã đứng sừng sững trên chiến trường với tư cách kẻ chiến thắng. Cứ như thể triều đại của chúng ta sẽ trường tồn mãi mãi vậy.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000877", "translation": "Hơn thế nữa, những chiếc máy bay tiêm kích do Bộ Tư lệnh Hạm đội phái tới chi viện cho chúng ta cứ nối đuôi nhau càn quét mặt đất, gia tăng hơn nữa chiến quả của trận truy kích. Có thể họ đang phải giao chiến trong những trận không chiến ác liệt tới mức tổn thất toàn bộ binh lực trên khắp các phòng tuyến chính, nhưng tại vùng đông bắc này, ưu thế trên không của Đế quốc là không hề suy suyển.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000878", "translation": "Đối mặt với hạm đội Đế quốc cùng quyền kiểm soát bầu trời bao trùm toàn diện của nó, phía Liên bang hoàn toàn im tiếng. Họ nhận ra sự chênh lệch sức mạnh đến mức tuyệt vọng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000879", "translation": "Và cứ thế, đến khi mặt trời lại lặn xuống một lần nữa, quân Đế quốc đã hoàn toàn làm chủ chiến trường.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000880", "translation": "Đó là một chiến thắng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000881", "translation": "Dẫu chỉ là một trận đánh nhỏ, trung đoàn này đã đánh bại hai lữ đoàn bằng nỗ lực mãnh liệt.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000882", "translation": "Và ai đã làm nên chuyện đó? Chính là Kampfgruppe Salamander lâm thời vừa mới được thành lập. Điều này cũng chứng minh không chút nghi ngờ về tính linh hoạt trong tổ chức và vận hành Kampfgruppe trước Bộ Tổng tham mưu. Chà, dù sao đi nữa thì họ cũng sẽ không thể không đánh giá cao chúng ta.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000883", "translation": "Trong tâm trí Tanya, *họ sẽ không thể không đánh giá cao chúng ta* có nghĩa là đánh giá của họ về chúng ta sẽ không bị sụt giảm và chúng ta sẽ không bị bắt làm việc quá sức.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000884", "translation": "Nhưng Tanya tự tin rằng mình là một người tốt, biết điều.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000885", "translation": "Nó hiểu rất rõ rằng giữ một thái độ khác thường như thế khi đã giành chiến thắng là điều kỳ quặc. Trong hầu hết mọi trường hợp, chiến thắng được xã hội nhìn nhận là một kết quả đáng để ăn mừng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000886", "translation": "Chúng ta đã đẩy lùi một lượng lớn quân địch mà chỉ chịu thương vong rất ít.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000887", "translation": "Tanya đủ tâm lý để hiểu rằng binh lính dưới quyền mình sẽ muốn ăn mừng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000888", "translation": "Trong một căn phòng của tòa nhà đặt sở chỉ huy Kampfgruppe…", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000889", "translation": "Bàn ghế được bày biện tại nơi có vẻ trước đây từng là phòng ăn. Tại đây, Tanya cúi đầu trước những nhân tố chủ chốt làm nên chiến thắng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000890", "translation": "“Các anh đã làm tốt lắm.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000891", "translation": "Mở đầu bằng lời rào đón rằng chút đồ đem ra khoản đãi chẳng có gì đặc biệt, nó lấy mấy chai rượu từ kho dự trữ cá nhân của mình ra (thứ mà sĩ quan nào cũng nên giấu sẵn ở đâu đó). Đây là số rượu nó vẫn cất giữ để cảm ơn thuộc cấp của mình, và đích thân nó rót cho họ. Cuối cùng, nó nâng tách cà phê của mình lên và chúc rượu.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000892", "translation": "“Vì chiến thắng của chúng ta!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000893", "translation": "“““Vì chiến thắng!”””", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000894", "translation": "*Nào, giờ thì.* Tanya bắt tay vào làm những việc mình cần phải giải quyết xong trước khi các sĩ quan ngà ngà say. “Trước hết, Đại úy Meybert, tôi muốn bày tỏ lòng kính trọng trước kết quả công việc của anh. Tôi đã đánh giá sai về anh đôi chút. Hy vọng anh sẽ chấp nhận lời xin lỗi của tôi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000895", "translation": "Lời xin lỗi của một sĩ quan gửi tới thuộc cấp chính là khoảnh khắc người đó bộc lộ rằng nhận định của mình đã sai. Đó chẳng phải việc dễ dàng gì. Nhưng như thế vẫn tốt hơn là bị xem như một kẻ ngu xuẩn không biết nhận ra sai lầm của chính mình.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000896", "translation": "“Không đâu ạ, nhờ có công tác quan sát chuẩn xác mà chúng tôi mới đạt được kết quả đó. Phần lớn thành công của chúng tôi là nhờ vào tài năng của Thiếu tá Weiss ạ.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
