{"segment_id": "YS-LN05/Text/part0006.html/p000013", "translation": "Phác thảo Sơ bộ về Bối cảnh", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0006.html/p000014", "translation": "Lời bạt", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0006.html/p000015", "translation": "Bản tin Yen", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0014.html/p000001", "translation": "NGÀY 15 THÁNG 9 NĂM 1926, THỦ ĐÔ ĐẾ QUỐC BERUN, VĂN PHÒNG BỘ TỔNG THAM MƯU LỤC QUÂN ĐẾ QUỐC", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0014.html/p000002", "translation": "Ngay khi bước chân vào Văn phòng Bộ Tổng tham mưu, Trung tá Tanya von Degurechaff tiến thẳng tới phòng làm việc của Trung tướng von Zettour, người mà nó đã có hẹn trước.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0014.html/p000003", "translation": "Dù có châm chước đến mấy, bước chân của nó cũng khó lòng coi là nhẹ nhàng. Dĩ nhiên, chuyến bay đường dài từ miền đông về thủ đô vốn đã mệt mỏi. Nhưng ngay cả sự mệt mỏi thể xác do phải đổi giữa các máy bay vận tải và tự mình bay một chặng trên đường về cũng chẳng thấm tháp gì so với trạng thái tinh thần rệu rã của nó.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0014.html/p000004", "translation": "Ngoài cửa sổ, bầu trời u ám một màu.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0014.html/p000005", "translation": "Nếu Being X đang ác ý giật dây, thì hắn quả thực thấu hiểu tình cảnh của chúng ta một cách đáng sợ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0014.html/p000006", "translation": "Mình thực sự ghét những khi bầu trời như thế này. Nó phản ánh quá đỗi chính xác trạng thái tinh thần của mình.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0014.html/p000007", "translation": "Nhưng nếu bầu trời thể hiện cảm xúc hiện tại của mình, thì liệu rồi nó có quang đãng trở lại chăng?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0014.html/p000008", "translation": "Liệu ngày ấy rốt cuộc có đến không?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0014.html/p000009", "translation": "*Không, mình phải gạt những lời than vãn này sang một bên thôi.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0014.html/p000010", "translation": "Trung tá Tanya von Degurechaff phải thừa nhận sai lầm của mình đúng như sự thật đáng hổ thẹn vốn có. Thật nhục nhã và là một thất sách hoàn toàn, nhưng nó sẽ ngần ngại trước việc che giấu chuyện này.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0014.html/p000011", "translation": "Chỉ những kẻ thực sự bất tài mới che giấu sai lầm của mình.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0014.html/p000012", "translation": "*Một kẻ ngu xuẩn hết thuốc chữa. Thứ rác rưởi cồng kềnh. Đem ra xử bắn cũng chưa đủ để trừng phạt.* Dù mình có dùng từ ngữ nào đi nữa cũng không sao lột tả hết được.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0014.html/p000013", "translation": "Tai họa xảy ra khi những sai lầm nhỏ liên tục bị ém nhẹm. Một tổ chức chuyên che giấu những sai lầm nhỏ rốt cuộc sẽ bị đánh gục bởi một sự cố quá lớn không sao bưng bít nổi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0014.html/p000014", "translation": "Con người vốn là sinh vật phạm phải sai lầm.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0014.html/p000015", "translation": "Nếu bạn không thừa nhận sai lầm của mình, chính sai lầm ấy sẽ nghiền nát bạn.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0014.html/p000016", "translation": "Chính vì thế, hay đúng hơn là “do đó…” Cách duy nhất để xử lý lũ đần độn che giấu sai lầm là bắn bỏ chúng. Mình thực sự rất *muốn* bắn bỏ những kẻ làm việc kém cỏi, nhưng lũ đần độn che giấu sai lầm thì *ắt phải* bị bắn bỏ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0014.html/p000017", "translation": "Đó là một chân lý hiển nhiên.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0014.html/p000018", "translation": "Thay vì là một câu ngạn ngữ hay tiên đề, đó đúng hơn là điều con người đã chứng minh qua những kinh nghiệm mà xã hội tích lũy được.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0014.html/p000019", "translation": "Dẫu có thể chưa hoàn hảo, mình vẫn sở hữu tư duy của một người hiện đại. Thay vì làm kẻ vụng về che giấu sai lầm, mình buộc phải làm kẻ vụng về đứng ra báo cáo nó.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
