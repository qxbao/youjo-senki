{"segment_id": "YS-LN05/Text/part0025.html/p000219", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "translation": "Đó là thứ mà tôi chưa từng cảm nhận được ở nhà Bà… thứ ác ý này.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000220", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "translation": "Khi chiến tranh leo thang và thương vong tăng lên, tôi đã bắt đầu cảm nhận được nó ở Khối Thịnh vượng chung.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000221", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "translation": "Nếu bảo là tôi không lường trước việc sẽ cảm nhận được điều tương tự tại Liên bang, thì hẳn là tôi đang nói dối.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000222", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "translation": "“Cô không làm gì sai cả, nên nếu có bất kỳ đồng chí Liên bang nào của tôi nói gì… Không, nếu bất kỳ ai nói điều gì, hãy cho tôi biết. Đó là một phần lý do tôi có mặt ở đây.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000223", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "translation": "“Cảm ơn cô. Tôi nghĩ cô là người đầu tiên tôi có thể trò chuyện được đấy.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000224", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "translation": "“Sao cơ? Mary, thế còn Trung tá Drake thì sao? Ông ấy có vẻ là người tốt mà. Tôi chắc là ít nhất ông ấy cũng sẽ lắng nghe cô.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000225", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "translation": "“Vâng, nhưng… ông ấy là một người lính của Khối Thịnh vượng chung đến tận xương tủy. Ý tôi là, ông ấy rất chu đáo. Nhưng tôi nghĩ ông ấy sẽ nói dối nếu bảo rằng ông ấy không coi đây là một mớ hỗn độn do Liên minh Hiệp ước gây ra.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000226", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "translation": "Tôi hình dung cả hai chúng tôi đều cảm nhận được điều đó—bức tường ngăn cách giữa chúng tôi do lòng trung thành khác biệt.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000227", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "translation": "Trung tá Drake chiến đấu vì tổ quốc của ông ấy, còn tôi chiến đấu vì tổ quốc của mình. Khi hai con người chiến đấu vì hai tổ quốc khác nhau, ắt hẳn sẽ có một khoảng cách nhất định. Buồn thật đấy, nhưng đó là sự thật.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000228", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "translation": "“…Chắc là trước đây tôi chưa từng làm điều này bao giờ.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000229", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "translation": "“Chưa từng làm gì cơ?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000230", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "translation": "“Tôi không nghĩ mình từng tâm sự những chuyện như thế này với một người đến từ đất nước khác.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000231", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "translation": "Cho đến khi gặp Liliya, tôi chỉ có thể giãi bày những nỗi lo âu của mình với các thành viên khác trong đội quân tình nguyện… Và giờ đây, phần lớn những người đồng đội ấy đã ngã xuống.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000232", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "translation": "*Bổn phận của những người ở lại là giải phóng tổ quốc mà cha mình cùng những người đàn ông và phụ nữ ấy đã hằng tin tưởng. Nhưng…* Tôi quệt đi những giọt nước mắt chực trào rồi mỉm cười. “À, chắc là tôi thấy nhẹ lòng khi nhận ra một cuộc trò chuyện như thế này không phải là điều bất khả thi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000233", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "translation": "“Tôi chúc cô gặp nhiều may mắn trong cuộc sống, Mary ạ. Sẽ có những lúc gian nan, nhưng cũng sẽ có những điều tốt đẹp nữa. Cuộc đời còn dài mà.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000234", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "translation": "“Kỳ lạ thật đấy nhỉ? Nhưng vâng, chắc đó cũng là một cách nghĩ.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000235", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "translation": "“Đúng thế đấy, bạn của tôi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000236", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "translation": "Cô ấy nở một nụ cười rạng rỡ với tôi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000237", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "translation": "Đó là một nụ cười tuyệt đẹp.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000238", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "translation": "“Ồ, tôi thích từ đó đấy—cách gọi đó.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000239", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "translation": "Nụ cười của cô ấy chói lọi đến mức tôi cảm thấy choáng ngợp và hầu như không thể nhìn thẳng vào cô ấy.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000240", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "translation": "“Vậy thì, một lần nữa, rất vui được gặp cô, Mary.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000241", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "translation": "Tôi nắm lấy bàn tay cô ấy chìa ra.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000242", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "translation": "Bàn tay ấy thật ấm áp và dịu dàng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000243", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "translation": "Đó là lý do vì sao tôi cũng có thể mỉm cười.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000244", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "translation": "“Vâng, tôi cũng vậy. Cảm ơn cô, Liliya. Bạn của tôi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000245", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "translation": "*Rất vui được gặp cô, bạn của mình.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000246", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "translation": "NGÀY 16 THÁNG 10, NĂM THỐNG NHẤT 1926, KHU VỰC ĐÔNG BẮC CỦA MẶT TRẬN PHÍA ĐÔNG, DOANH TRẠI ĐỒN TRÚ CỦA KAMPFGRUPPE SALAMANDER", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000247", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "translation": "Tâm trạng của vị chỉ huy Kampfgruppe Salamander ở phương Đông, Trung tá Tanya von Degurechaff, đang tụt dốc không phanh như áp suất trong tâm bão.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000248", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "translation": "Một phần là vì nó vẫn đang thực hiện nhiệm vụ nghiên cứu và khảo sát nhằm thử nghiệm cách vận hành Kampfgruppe—đơn vị của nó được phân công tới một khu vực trên tiền tuyến cách rất xa vùng giao tranh chính.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000249", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "translation": "Trong khi lực lượng chủ lực tập hợp ở vùng Đông Nam để chuẩn bị cho một chiến dịch lớn, đội hình Salamander lại được lệnh tích lũy kinh nghiệm vượt qua mùa đông ở vùng Đông Bắc, kể ra cũng khá chu đáo. Có thể nói việc giao cho một nhiệm vụ tuần tra sườn kết hợp huấn luyện là một sự sắp xếp biết nghĩ cho cấp dưới.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000250", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "translation": "*Nhưng nếu đã biết nghĩ được đến thế, thì…* Những quân bài được chia vào tay khiến Tanya sầu não đến tận cùng và hoàn toàn bế tắc.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000251", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "translation": "“…Chiến tranh không nên bị kéo dài lê thê. Chúng ta sẽ tiêu hao hết số cựu binh quý giá của mình mất. Bộ họ thực sự nghĩ đám ô hợp này có khả năng giữ vững tiền tuyến sao?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000252", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "translation": "Các đơn vị mà nó tiếp nhận còn non nớt hơn cả dự tính.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000253", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "translation": "“Đa số đều là tân binh chứ không phải quân nhân chuyên nghiệp. Như thế là quá sức gánh vác đối với số cựu binh ít ỏi mà chúng ta hiện có… Ôi trời, đau đầu thật đấy.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000254", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "translation": "Nói đến mức đó rồi, nó mới nhận ra mình đang phát ngôn có phần vô trách nhiệm, nhưng nó chẳng thể dối lòng về cảm xúc thật của bản thân. Nó thực sự đang tuyệt vọng trước những quân bài trong tay mình.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000255", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "translation": "Trung tá Uger bên Cục Quân vụ đã nói thật khi bảo rằng nhân sự nòng cốt sẽ là các cựu binh. Quả thực anh ấy đã kiếm được cựu binh về cho bọn mình.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000256", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "translation": "Khi có một người bạn đồng môn đáng tin cậy từ thời trường đại học quân sự đứng về phía mình, mọi chuyện trở nên dễ dàng hơn hẳn.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000257", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "translation": "Dẫu vậy, ngay cả Uger cũng… chỉ là một sĩ quan tham mưu đơn lẻ. Anh ấy không ở vị trí có thể dàn xếp mọi thứ. Việc anh ấy xoay xở được một số cựu binh cho bọn mình đã là tốt lắm rồi… Chỉ tiếc là anh ấy không thể quán xuyến luôn cả chất lượng của đám tân binh.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000258", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "translation": "Tanya đã đánh giá quá cao mức độ huấn luyện mà họ từng được nhận, và nó hối hận không để đâu cho hết.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000259", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "translation": "Dù họ đang tiến hành huấn luyện song song với việc chuẩn bị trận địa—chủ yếu là tại ngôi làng nơi họ đồn trú qua mùa đông—nhưng việc kỳ vọng vào một kết quả khả quan là điều bất khả thi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000260", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "translation": "Họ không chỉ cần được rèn giũa bài bản về tác phong chiến trường—mà thậm chí còn chưa nắm vững những kiến thức cơ bản nhất mà một người lính cần có nơi tiền tuyến.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000261", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "translation": "Chuyện này chẳng khác nào ném một nhân viên kinh doanh mới vào thẳng tuyến đầu khi họ thậm chí còn chưa biết gì về sản phẩm của công ty. Tạm gác chuyện đang cố lấp đầy các vị trí trống sang một bên, làm thế chắc chắn sẽ gây ra hỗn loạn.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000262", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "translation": "Hơn nữa, đám lính mới thậm chí còn chưa phải là vấn đề duy nhất. Các sĩ quan được phân bổ cho bọn mình cũng còn xa mới đạt mức lý tưởng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN05/Text/part0025.html/p000263", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "translation": "Bọn mình đã trưng dụng một phần tòa nhà vốn hẳn là cơ sở của Đảng Cộng sản Liên bang để làm sở chỉ huy. Khi mình cho các sĩ quan đáng tin cậy đấu tập với nhóm sĩ quan mới, dù chỉ là trên sa bàn bản đồ, kết quả thu được vẫn thật thảm hại.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
