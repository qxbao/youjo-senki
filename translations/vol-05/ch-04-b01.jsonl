{"segment_id": "YS-LN05/Text/part0022.html/p000001", "translation": "NGÀY 7 THÁNG 10 NĂM THỐNG NHẤT 1926, CĂN CỨ LỤC QUÂN ĐẾ QUỐC", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0022.html/p000002", "translation": "Tiểu đoàn Pháp sư Trên không số 203 đã hứng chịu tổn thất nặng nề tại Norden. Tổn thất nặng nề đến mức phải nghiến răng. Đó là một sự lãng phí không thể tin nổi về nguồn nhân lực và vốn con người.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0022.html/p000003", "translation": "Nếu bạn giống như Being X, một thứ rác rưởi chỉ biết xem con người như những con số, thì có lẽ bạn sẽ bảo: *Chỉ có mười người thôi mà*.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0022.html/p000004", "translation": "Nhưng đối với một cá nhân tự do thời hiện đại như Trung tá Tanya von Degurechaff, khỏi phải nói cũng biết việc mất đi mười người lính tinh nhuệ là một tổn thất to lớn cho xã hội.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0022.html/p000005", "translation": "Biết bao tài nguyên và thời gian đã được đầu tư vào việc huấn luyện họ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0022.html/p000006", "translation": "“Chúng ta là quân đội. Mình hiểu thương vong là điều đương nhiên, nhưng…”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0022.html/p000007", "translation": "Xét về mặt logic, trong quân đội không có bánh răng nào là không thể thay thế.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0022.html/p000008", "translation": "Và các đơn vị chịu tổn thất sẽ được phân bổ nhân sự bổ sung. Nhưng sách vở và thực tế không phải lúc nào cũng ăn khớp với nhau.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0022.html/p000009", "translation": "Trên thực tế, ngoài thị trường có vô số loại bánh răng giá trị mà nguồn cung lại bị một công ty duy nhất độc quyền.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0022.html/p000010", "translation": "Và nếu nguồn cung quý giá đó đang chật vật trước nhu cầu quá lớn, thì dù bạn có yêu cầu một bánh răng thay thế, bạn cũng chẳng thể nào biết được bao giờ nó mới tới nơi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0022.html/p000011", "translation": "Ngay khi vừa giao lại các đại đội cho các chỉ huy—Trung úy Serebryakov, Thiếu tá Weiss và Trung úy Grantz—nó thầm nghĩ, *Dù vậy đi nữa*, rồi làm theo quy trình tiêu chuẩn, giải quyết đống giấy tờ để nộp đơn xin nhân sự bổ sung. Cho những bánh răng mới của mình.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0022.html/p000012", "translation": "Đó là một cuộc chiến đơn độc.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0022.html/p000013", "translation": "Chỉ có bút, giấy, mực và mình.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0022.html/p000014", "translation": "Thứ phát huy hiệu quả trong cuộc chiến văn thư chính là sức mạnh đánh lừa của ngôn từ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0022.html/p000015", "translation": "Thế nhưng ngoài thực tế, cứ như thể có một bức tường quan liêu đáng sợ đang ngáng đường vậy. Ngay cả Lục quân Đế quốc, một cỗ máy quân sự chuẩn xác, cũng không sao thoát khỏi nạn thủ tục rườm rà. Thật bực mình làm sao!", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0022.html/p000016", "translation": "“…Thứ chúng ta thực sự nên sợ chính là tệ quan liêu…”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0022.html/p000017", "translation": "Quy trình phức tạp đến mức vô nghĩa này khiến mình nghi rằng cấp trên đã quyết tâm bác bỏ các đơn xin bổ sung nhân sự. Nhưng công việc bàn giấy đòi hỏi sự kiên trì.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0022.html/p000018", "translation": "“Hừ, biểu mẫu của nhà nước lúc nào cũng phức tạp cả. Thôi được, mình sẽ đọc mấy văn bản hành chính này với sự cẩn trọng của một nhà chú giải kinh văn vậy.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0022.html/p000019", "translation": "Sau khi trở về nơi trú quân cùng lời lẩm bẩm đầy quyết tâm đó, Tanya giờ đã bị xích chặt vào bàn làm việc suốt hơn hai mươi tư tiếng đồng hồ để hoàn tất đống giấy tờ. Nó xử lý các văn kiện, nốc ừng ực cà phê của Trung tá Uger mà nó đã yêu cầu pha đặc quánh đến mức có vị như thứ nước bùn kinh khủng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0022.html/p000020", "translation": "Ngay cả tinh thần Anglo-Saxon thời Victoria vốn nổi tiếng về sự bền bỉ cũng chỉ là trò trẻ con nếu đem so với tính kỷ luật của một nhân viên công sở hiện đại như mình.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0022.html/p000021", "translation": "Nếu giấy tờ không được duyệt thì cũng chẳng sao.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0022.html/p000022", "translation": "Mình sẽ cứ nộp đi nộp lại cho đến khi nào được duyệt thì thôi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0022.html/p000023", "translation": "Thế là, khoảng hai ngày sau khi chuyển chiến trường sang bàn giấy…", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0022.html/p000024", "translation": "Trung tá Tanya von Degurechaff đã giành được một thắng lợi khiêm tốn.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0022.html/p000025", "translation": "Đúng nửa đêm ngày 6 tháng 10, nó bảo sĩ quan phụ tá Serebryakov gửi đống giấy tờ đi rồi rúc vào giường để ngủ nhiều nhất có thể.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0022.html/p000026", "translation": "Rồi khi mắt nó bật mở, trời đã sáng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0022.html/p000027", "translation": "Vừa nhai bữa sáng kèm tách cà phê do viên sĩ quan phụ tá chuẩn bị, nó cuối cùng cũng có đủ dư lực để bắt đầu suy tính về những việc tiếp theo.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0022.html/p000028", "translation": "“Dù vậy thì, chà…”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0022.html/p000029", "translation": "Một tiếng thở dài khe khẽ buột ra.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0022.html/p000030", "translation": "Nó có thể suy nghĩ mãi, nhưng suy nghĩ không thôi thì cũng chỉ giải quyết được đến thế.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0022.html/p000031", "translation": "Dù sao đi nữa, tình thế hiện tại của họ cũng hết sức mơ hồ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0022.html/p000032", "translation": "Theo mệnh lệnh chính thức, họ là một đơn vị hỗ trợ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0022.html/p000033", "translation": "Tiểu đoàn Pháp sư Trên không số 203 được cử đi làm lực lượng tuần tra trong khuôn khổ chiến dịch Biển Bắc. Do đó, thất bại của chiến dịch đánh chặn tàu RMS *Queen of Anjou* không đồng nghĩa với việc đợt điều động của họ đã kết thúc.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0022.html/p000034", "translation": "Về mặt lý thuyết, ngay cả lúc này nhiệm vụ của họ vẫn đang tiếp diễn. Nhưng mặt khác, tất cả chỉ có ý nghĩa đến thế mà thôi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0022.html/p000035", "translation": "Hơn nữa, vị thế của Tiểu đoàn Pháp sư Trên không số 203 với tư cách là một đơn vị trực thuộc Bộ Tổng tham mưu được điều động lên phía bắc lại rất đặc thù. *Kết quả là*, mình đoán vậy?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0022.html/p000036", "translation": "Sự đồng thuận mang tính quan liêu trong cỗ máy quân sự là Bộ Tổng tham mưu đã cho họ mượn đơn vị này để thực hiện nhiệm vụ đánh chặn tàu RMS *Queen of Anjou*. Vì lý do đó, ngay cả khi họ muốn chuyển hướng đơn vị sang một nhiệm vụ khác, lý lẽ của tổ chức cho rằng họ sẽ văng khỏi lộ trình thăng tiến nếu phá vỡ giao kèo.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0022.html/p000037", "translation": "Chắc quán tính của bộ máy quan liêu cũng đáng gờm thật đấy nhỉ? Trái ngược với mệnh lệnh chính thức, bọn mình thậm chí còn chẳng được đưa vào lịch luân phiên tuần tra.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0022.html/p000038", "translation": "Vì vậy, để không lãng phí thời gian, Tanya lại cầm bút lên. Nó viết những bức thư chia buồn gửi tới gia đình các tử sĩ vốn là bổn phận của một người chỉ huy.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
{"segment_id": "YS-LN05/Text/part0022.html/p000039", "translation": "Nhưng xét về dung lượng câu chữ, thư chia buồn lại chẳng dài là bao. Trung tá Tanya von Degurechaff bất ngờ rơi vào cảnh hết việc để làm ngay trước cả giờ ăn trưa.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "notes": []}
