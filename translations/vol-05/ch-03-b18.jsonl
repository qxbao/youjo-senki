{"segment_id": "YS-LN05/Text/part0020.html/p000310", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Chậc! Xem ra chỉ chừng này thôi thì chưa đủ để cắt đuôi rồi.”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000311", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Chẳng cần Weiss phải nhắc, mình cũng thừa biết mình không hề muốn bị cả một trung đoàn pháp sư hải quân đánh bộ rượt đuổi khắp nơi. Mình không có hứng thú với trò đuổi bắt sinh tử. Ngay cả vào những lúc thế này, mình vẫn muốn có quyền tự do lựa chọn bạn chơi.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000312", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“…Cứ đà này thì đường quay về sẽ chật vật lắm đây.”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000313", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Bọn mình đã phải bay đường dài, rồi vắt kiệt sức trong chiến đấu, vậy mà giờ lại còn phải đối phó với mấy kẻ biến thái định bám đuôi theo về tận nhà nữa ư?! Đây đúng là chặng rút lui tồi tệ nhất mà mình có thể nghĩ tới.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000314", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Chắc mình nên tự cười trước nỗi nhục khi không thể kết liễu nổi một con nhỏ đầu đất có lớp da chỉ dày hơn tân binh đôi chút… Đúng là họa vô đơn chí mà.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000315", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Hự?!”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000316", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Tanya vặn mình né một chùm tia nhiệt—sững sờ.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000317", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Nó suýt nữa đã hét lên: *Lại nữa hả?!* nhưng lần này thì khác.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000318", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Đó là thuật thức bắn tỉa quang học tầm xa. Thật không thể tin nổi đám khốn pháp sư hải quân đánh bộ của Khối Thịnh vượng chung lại có thể ngắm bắn chuẩn xác từ cự ly xa đến thế!", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000319", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Khi ngước nhìn lên, nó bực bội nhận ra quân địch đang bắt đầu lấy lại kỷ luật.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000320", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Bọn mình sẽ chẳng thể nào địch lại nổi một cơn mưa đạn bắn nhanh trút xuống một chiều từ trên cao. Thế thì chẳng khác nào làm bia tập bắn.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000321", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Nán lại đây lâu hơn nữa cũng chỉ tổ phí thời gian.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000322", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Tanya tăng tốc để tiếp tục rút lui, mặc kệ con nhỏ pháp sư địch đầu đất đang bám riết lấy nó. Nó bay zíc zắc, thực hiện các động tác cơ động né tránh ngẫu nhiên rồi hội quân với phần còn lại của tiểu đoàn.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000323", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“05 gọi 01. Trước khi rút đi, cho phép tôi nói một chút được không?”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000324", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Chuyện gì?”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000325", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Một phần để cầm chân chúng, tôi nghĩ có lẽ chúng ta có thể dùng các thuật thức tầm xa để phóng hỏa mặt boong tàu.”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000326", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Vì đang ở gần nhau, tín hiệu liên lạc nội bộ đơn vị truyền đến rất rõ ràng. Nghe đề xuất của Grantz, Tanya mỉm cười. *Chà, không tệ chút nào.*", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000327", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Khi đang tăng tốc bay ra xa, việc bắn tỉa hầu hết các mục tiêu di động là điều bất khả thi.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000328", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Nhưng một mục tiêu khổng lồ như con tàu này lại là chuyện khác.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000329", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "*Đám đó cứ bám sát chiếc RMS* Queen of Anjou*, nhưng giờ nhắc mới nhớ…* Đối với lực lượng hộ tống, con tàu này vô cùng quý giá. Vậy thì bọn mình nên trao cho chúng cơ hội để bảo vệ thứ quý giá của chúng. Hẳn là chúng sẽ sung sướng lắm đây.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000330", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“…Ý kiến hay đấy! Dùng thuật thức phát nổ tầm xa nhưng lược bỏ hiệu ứng nghiền ép!”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000331", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Bọn mình chỉ nhận lệnh chặn con tàu lại mà thôi. Con tàu đó chính là nàng công chúa. Ngay cả đám hiệp sĩ hải tặc chướng mắt này cũng chẳng thể nào bỏ mặc công chúa của chúng được.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000332", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Dồn toàn bộ ma lực vào ngọn lửa! Chuẩn bị hiển hiện thuật thức! Đồng loạt khai hỏa! Phục vụ ở vùng Biển Bắc chắc hẳn lạnh lẽo lắm; hãy sưởi ấm cho chúng nào!”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000333", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Rõ! Cứ giao cho chúng tôi!”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000334", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Đúng lúc chuẩn bị hô lớn: *Lên nào!* thì Tanya cảm nhận được một kẻ địch đang lao thẳng về phía nó bất chấp tất cả. *Cô ả nhất quyết không chịu bỏ cuộc!*", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000335", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Đ-đợi đã!”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000336", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Tôi rất cảm động vì cô nhớ nhung tôi đấy, nhưng mà…?”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000337", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Mình phải khẩn trương lên mới được. Mình không thể để bị cuốn vào dây dưa với kẻ bám đuôi nửa mùa ngoan cố này mà đánh mất cơ hội rút lui.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000338", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Tôi không có núm vú giả đâu, nên ngậm tạm thứ này đi!”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000339", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Món bảo bối mà mình lôi ra là một trong những quả lựu đạn chày được Lục quân Đế quốc dày công chế tạo.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000340", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Thông thường, chúng chỉ gây nổ trong phạm vi đường kính mười mét, nhưng quả này đã được gắn thêm một viên đạn thuật thức ở phần đầu.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000341", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Sau khi nạp thuật thức vào và nén lại đến mức không tưởng, Tanya thản nhiên ném quả lựu đạn.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000342", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Phải, thứ mà nó vừa quăng về phía kẻ truy đuổi *trông* chẳng khác gì một quả lựu đạn cầm tay thông thường.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000343", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Trò—”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000344", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "*—vô ích thôi!* Đúng khoảnh khắc con ngốc đó đánh giá quá cao màn chắn bảo hộ của mình…", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000345", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "…viên đạn thuật thức liền kích hoạt ở cự ly gần. Cộng thêm thuật thức phát nổ, phần đầu quả lựu đạn vỡ tung tóe.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000346", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Á…… Hự…!”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000347", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Ha! Đáng đời lắm!”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000348", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Hạ được một tên! Tuyệt vời!”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000349", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Ngay khi Tanya chuẩn bị gật đầu đáp *ừ*, nó chợt nhận ra một điều. Nữ pháp sư kia vốn đã bắt đầu rơi xuống, nhưng giờ cô ả lại chật vật lấy lại thăng bằng. *Chẳng lẽ điều đó có nghĩa là…*", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000350", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "*…cô ả đã gượng dậy được sao?*", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000351", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Ừm, không đâu, tính là một mục tiêu chưa xác nhận thôi.”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000352", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Trông cứ như Trung tá đã hạ được ả rồi chứ ạ.”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000353", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Có vẻ cô ả đã gượng lại được vào giây cuối cùng. Nếu không chắc chắn về một chiến công thì tốt nhất là đừng tính. Thà hài lòng với điểm số thấp hơn còn hơn là bị cười chê vì khai khống thành tích.”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000354", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Khó mà khẳng định chắc chắn rằng mình đã hạ được cô ả. Mà nếu cô ả có đáp xuống mặt nước thì xung quanh cũng đang có cả đống pháp sư địch bay lượn, nên khả năng cao là sẽ được giải cứu.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000355", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Ngay cả khi cô ả rơi xuống vùng biển giá buốt, khả năng sống sót cũng không hề thấp.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000356", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Trời ạ, cô ả dai như gián vậy! Mà sao cô ả lại dám chắc là tôi đã giết cha cô ả chứ? Bộ cô ả căm ghét lính Đế quốc đến mức nhìn ai trong chúng ta cũng giống nhau hết sao?”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000357", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Ha-ha-ha. Là bởi vì—Trung tá biết đấy. Hãy nhớ lại ngoại hình của mình xem, thưa Trung tá.”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000358", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Nhưng người ta vẫn bảo đừng đánh giá một cuốn sách qua trang bìa kia mà.”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000359", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Ước gì họ đừng nhìn mình chằm chằm với vẻ mặt như muốn nói điều gì đó thế kia. Mình thừa hiểu thực tế là thế nào mà.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000360", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Rồi, tôi biết, nhưng chuyện đang nói không phải là về cái đó.”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000361", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Hơn nữa, chẳng phải vẻ ngoài như một bé gái chính là đặc điểm nhận dạng của mình hay sao?", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000362", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Câu nói nổi tiếng về chuyện đừng đánh giá cuốn sách qua trang bìa chỉ mang hàm ý là không nên phỏng đoán về nội dung bên trong mà thôi. Còn khi xét đến việc nhận diện, ngoại hình lại là dữ liệu vô cùng hữu ích.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000363", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Mình chẳng thích bị chú ý trên chiến trường chỉ vì thân hình nhỏ nhắn chút nào.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000364", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Tôi từng bị đuổi khỏi câu lạc bộ sĩ quan vì còn quá nhỏ để hút thuốc và uống rượu—tôi hiểu mà.”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000365", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Xin Trung tá thứ lỗi, nhưng chuyện đó đúng là buồn cười không chịu được.”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000366", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Đúng thế thật. Trong lúc chờ Trung tá xuất hiện, tôi thực sự lo Thiếu tá Weiss sẽ đánh bài đến sạt nghiệp mất!”", "status": "reviewed", "translator": "argon-low", "notes": []}
