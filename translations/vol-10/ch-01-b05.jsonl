{"segment_id": "YS-LN10/Text/chapter004.xhtml/p000147", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "…Xét ở góc độ đó, nếu đấy là mẫu sĩ quan cấp tá mà Tham tán Conrad đã hình dung khi đến gặp Lergen, thì việc ông ta vốn dĩ kỳ vọng vào một người cứng rắn hơn cũng hoàn toàn dễ hiểu.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter004.xhtml/p000148", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Sau một thoáng tự nhìn nhận lại bản thân, Đại tá Lergen chợt nhận ra Tham tán Conrad đang đứng dậy với vẻ hài lòng trên gương mặt.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter004.xhtml/p000149", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Cảm ơn ông vì buổi trao đổi hôm nay, thưa Đại tá. Tôi rất mừng vì đã có dịp gặp ông. Tôi muốn thu xếp những việc cần thiết để xúc tiến mọi chuyện. Ngày mai tôi lại ghé qua có được không?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter004.xhtml/p000150", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Như người ta vẫn nói, rèn sắt phải nhân lúc còn nóng. Chúng ta hãy bắt tay vào việc ngay thôi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter004.xhtml/p000151", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "CÙNG NGÀY HÔM ĐÓ, TẠI CỤC TÁC CHIẾN THUỘC VĂN PHÒNG BỘ TỔNG THAM MƯU—VĂN PHÒNG CỤC TRƯỞNG", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter004.xhtml/p000152", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Tôi là Đại tá Lergen. Tôi xin phép vào.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter004.xhtml/p000153", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Chào anh, Đại tá. Vị khách từ Bộ Ngoại giao đã nói những gì?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter004.xhtml/p000154", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Có vẻ họ cũng đã bắt đầu lo ngại về kịch bản tồi tệ nhất. Xét trên phương diện đó, họ có cùng mục tiêu với chúng ta. Họ biết con đường đi tới chiến thắng sẽ đầy gập ghềnh… nhưng họ tin rằng nếu hai bên có thể hợp tác cùng nhau, thì có lẽ vẫn còn một lối thoát.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter004.xhtml/p000155", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Anh ngước nhìn gương mặt trắng bệch như không còn chút máu của Trung tướng Rudersdorf.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter004.xhtml/p000156", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Thế thì tốt, cứ cho là chúng ta trụ được đến lúc đó.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter004.xhtml/p000157", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Chúng ta bị giới hạn về thời gian sao ạ?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter004.xhtml/p000158", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Chuyện đó thì anh phải đi mà hỏi người Ildoa ấy. Họ sẽ bảo anh rằng chiếc đồng hồ cát của chúng ta vẫn còn sót lại chút cát đấy.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter004.xhtml/p000159", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Lergen chau mày trước lời nhận xét trắng trợn ấy. Chẳng cần ai phải nói toẹt ra thì anh cũng hiểu Đế quốc đang lâm vào cảnh ngặt nghèo.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter004.xhtml/p000160", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“…Tôi không ngờ ngài cũng là người thích mỉa mai đấy, thưa Tướng quân.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter004.xhtml/p000161", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Đại tá, anh đúng là một gã khờ vụng về.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter004.xhtml/p000162", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Lergen khẽ nấc lên một tiếng nhỏ. Thực tế mà nói, Lergen tự nhận thấy bản thân anh vốn chẳng phải mẫu người biết pha trò. Trung tướng Rudersdorf… có lẽ chỉ đang cằn nhằn đôi câu để giải tỏa bớt căng thẳng mà thôi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter004.xhtml/p000163", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Dẫu vậy, câu nói đó quả thực đã khiến Lergen bất ngờ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter004.xhtml/p000164", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Vị tướng đang phải chịu đựng áp lực khủng khiếp—bị giày vò bởi sự bế tắc không chút hy vọng của cuộc chiến. Có lẽ đó là một cơ chế tự vệ giúp ông tiếp tục gắng gượng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter004.xhtml/p000165", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Tuy nhiên, là người đã sát cánh bên ông suốt từng ấy năm, Đại tá Lergen không thể không nhận ra sự thay đổi này.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter004.xhtml/p000166", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Trung tướng Rudersdorf của trước kia hẳn sẽ nói lớn hơn nhiều, với giọng điệu đanh thép hơn. *Chẳng lẽ ông ấy đã kiệt sức đến mức sắp gục ngã rồi sao?*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter004.xhtml/p000167", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“…Cảm giác như tất cả mọi người đều đang chạy đôn chạy đáo mà chẳng biết phải làm gì. Sự hỗn loạn của chiến tranh thật khắc nghiệt. Chiến đấu vì một thắng lợi toàn diện đòi hỏi cái giá quá đắt.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter004.xhtml/p000168", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Chúng ta có thể sử dụng con đường ngoại giao để tìm kiếm một thỏa hiệp chấp nhận được. Tôi tin rằng xét theo lẽ thường, nếu chúng ta dồn nguồn lực vào hướng này, có thể sẽ mở ra một cách để biến điều đó thành hiện thực.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter004.xhtml/p000169", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Anh có coi đó là một chiến thắng không?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter004.xhtml/p000170", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Đại tá Lergen đáp lại câu hỏi bằng giọng kiên quyết.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter004.xhtml/p000171", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Đó là một chiến thắng.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter004.xhtml/p000172", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Trung tướng Rudersdorf nhìn anh chằm chằm với ánh mắt dữ dội và nghiêm nghị như muốn nói: *Nói tiếp đi*.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter004.xhtml/p000173", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Tôi tin rằng đó là cách lý tưởng để chúng ta chấm dứt cuộc chiến. Đó sẽ là phương thức giúp chúng ta buộc kẻ địch phải chấp nhận các yêu sách của mình. Chẳng phải có thể xem đó là một phương tiện khác để hướng tới cùng một mục đích hay sao?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter004.xhtml/p000174", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Đó không phải là một chiến thắng oanh liệt. Cuộc chiến trên thực tế sẽ khép lại bằng một hiệp định đình chiến sau khi biết bao sinh mạng đã ngã xuống.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter004.xhtml/p000175", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Chấm dứt giao tranh thì suy cho cùng vẫn là sự kết thúc. Đó chẳng phải điều gì đáng để tự hào khoe khoang, nhưng đôi khi thuốc tốt nhất lại là thứ thuốc đắng nhất. Chính vì thế mà Đại tá Lergen vẫn kiên định với đề xuất này, dẫu biết rõ nó chỉ được bọc đường bằng niềm hy vọng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter004.xhtml/p000176", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Xét trên phương diện quốc phòng, tôi tin rằng đây sẽ là một chiến thắng rõ ràng.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter004.xhtml/p000177", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Điều đó chỉ đúng nếu chúng ta có thể khép lại cuộc chiến với những điều khoản có lợi. Anh cũng như tất cả những người khác, chỉ toàn nói về tương lai—về những gì các anh hy vọng sẽ xảy ra. Nói về vụ thu hoạch thì chẳng sao cả, nhưng muốn có cái để gặt thì trước hết phải gieo hạt và đổ mồ hôi trên đồng ruộng đã.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter004.xhtml/p000178", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Ngài nói hoàn toàn chí lý, thưa Tướng quân. Đó chính xác là lý do vì sao ngay lúc này chúng ta cần phải cải tạo đất đai, dẫu việc đó có tiêu tốn của chúng ta thời gian quý báu.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter004.xhtml/p000179", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Ồ?” Trung tướng von Rudersdorf lộ vẻ hứng thú. “Anh không rành chuyện đồng áng sao, Đại tá? Đất đai là phải chuẩn bị xong xuôi từ mùa xuân. Nhìn vào tờ lịch của chúng ta xem, lẽ ra giờ này chúng ta phải chuẩn bị bước vào vụ thu hoạch rồi mới phải.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter004.xhtml/p000180", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Ông vừa bật cười nhẹ nhàng vừa chỉ ra rằng bây giờ đã là mùa hè, nhưng trong lập luận của ông lại có một kẽ hở.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter004.xhtml/p000181", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Nếu chúng ta đang nói về yến mạch thì ngài có lý… Nhưng thời điểm còn tùy thuộc vào giống cây mà người ta định canh tác nữa.” Lergen quyết tâm nhấn mạnh rằng mọi chuyện vẫn còn lâu mới là quá muộn.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter004.xhtml/p000182", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Ý anh là gì?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter004.xhtml/p000183", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Ánh mắt hướng về phía Lergen vô cùng uy nghiêm, nhưng Đại tá Lergen vẫn giữ vẻ điềm tĩnh và tiếp tục đáp lời bằng giọng thản nhiên.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter004.xhtml/p000184", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Tôi chỉ đơn giản là không muốn có bất kỳ sự xao nhãng nào. Chỉ vậy thôi. Tôi muốn giữ một tâm trí thật sáng suốt khi thời khắc gặt hái cho quê hương—Heimat—đến gần.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter004.xhtml/p000185", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Tôi hoàn toàn đồng tình với anh, Đại tá. Dạo gần đây có quá nhiều chi tiết vụn vặt cần phải mổ xẻ dù chúng ta đang thiếu ‘thời gian’. Thật đáng tiếc làm sao.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter004.xhtml/p000186", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Ông nhấn mạnh vào từ *thời gian* trong lúc mệt mỏi lắc đầu.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
