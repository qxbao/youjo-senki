{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000764", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Tanya quyết tâm cho cả chiến trường biết ai mới là kẻ chiến thắng. Cô lắc đầu để rũ bỏ lời cầu nguyện chết tiệt kia rồi hít một hơi thật sâu.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000765", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Sau khi lấy lại vẻ điềm tĩnh, cô đanh giọng quát ra những mệnh lệnh tiếp theo.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000766", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Tôi đã hạ gục chỉ huy địch! Giờ là lúc cho chúng thấy thế nào mới là bạo lực thực sự!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000767", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Tận dụng triệt để thời cơ mỗi khi xuất hiện là điều tối quan trọng. Bản năng cần thiết để làm được điều đó chính là thứ phân biệt những cựu binh dày dạn với đám lính tráng thông thường trên chiến trường.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000768", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Tất cả quy về bạo lực thuần túy.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000769", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Hoặc một đòn tấn công chuẩn xác.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000770", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Giống như Kellermann trong Trận Marengo, các pháp sư Đế quốc cần phải tận dụng tối đa thời cơ này.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000771", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Bắn loạt! Dùng ba thuật thức phát nổ!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000772", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Ba đại đội pháp sư, theo sát ngay sau là đại đội thứ tư còn hơi mất phương hướng, cùng hợp thành đội hình Tiểu đoàn Pháp sư Trên không số 203 rồi trút xuống một cơn mưa lửa địa ngục. Những người lính Khối Thịnh vượng chung chỉ còn biết trơ mắt đứng nhìn các pháp sư hải quân đánh bộ đồng minh của mình bị nhấn chìm trong biển lửa rực cháy.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000773", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Chúng ta đã tiêu diệt lực lượng địch! Đám tàu chiến bên dưới đang lộ sơ hở! Chúng ta đã mở đường cho quân mình rồi!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000774", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Trung úy Grantz nhìn về phía Tanya với đôi mắt ánh lên vẻ phấn khích; anh đang chờ đợi mệnh lệnh xung phong lao vào. Tuy nhiên, cô đáp lại anh bằng cái lắc đầu và báo cho anh biết giờ là lúc họ phải rút lui.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000775", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Đây không phải miền đông đâu, Trung úy.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000776", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Nhưng thưa Chỉ huy? Chẳng phải chúng ta nên…?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000777", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Hãy nhớ lại những nguyên tắc cơ bản từ Trận Không chiến phía Tây đi. Chúng ta càng nán lại lâu thì khả năng những vị khách không mời xuất hiện lại càng cao. Chúng ta không được phép ở lại quá lâu.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000778", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Giá như đây là mặt trận phía đông, nơi giao tranh trải rộng trên một vùng đất mênh mông hơn nhiều, có lẽ họ đã có thời gian thong thả nán lại để tàn phá triệt để kẻ địch… nhưng đây lại là vùng biển của Khối Thịnh vượng chung.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000779", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Trận đánh đang diễn ra quá gần căn cứ tác chiến của địch.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000780", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Tiểu đoàn pháp sư của họ đã đóng góp vượt xa phần trách nhiệm của mình để thực hiện chiến dịch này đến cùng. Họ đã bẻ gãy thành công nanh vuốt của lữ đoàn pháp sư vốn là lực lượng nòng cốt trong hệ thống phòng không của địch. Tất cả những điều đó đều được thực hiện trong khi vẫn giữ tổn thất của phía Đế quốc ở mức tối thiểu.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000781", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Chính việc họ vừa bị phục kích mới là điều thực sự thuyết phục Tanya chọn phương án hành động an toàn và thận trọng hơn. Cô cũng chẳng thấy có lý do gì để tiểu đoàn của mình phải liều lĩnh dấn thân thêm nữa vì kế hoạch này.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000782", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Chẳng có lý do gì để chúng ta phải liều mạng trong khi quân nhà đang rút lui sau một nỗ lực thất bại cả. Tôi không hề thích việc để mất thuộc cấp của mình một cách vô lý đâu.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000783", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Tôi cho là chúng ta đã làm đủ để yểm trợ cho cuộc rút lui của hải quân rồi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000784", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Đúng thế,” Tanya xác nhận. Cô rất mừng vì Trung úy Grantz là một người nhạy bén. Nếu quân địch đã không định truy kích Hải quân Đế quốc, thì việc họ rời đi lúc này hẳn là ổn thỏa. Tanya cùng tiểu đoàn của cô đã làm việc quá xứng đáng với đồng lương ngày hôm nay rồi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000785", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Giờ Trung úy Grantz cũng đã đồng tình, đã đến lúc chúng ta nối gót rút lui rồi. Xin hãy kìm nén sự thôi thúc gửi tặng kẻ địch bất kỳ món quà chia tay nào nhé.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000786", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Sao cơ ạ? Tôi cứ tưởng ngài sẽ gửi một bức thư chia tay khác để chế giễu chúng chứ…”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000787", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Sĩ quan phụ tá của Tanya có vẻ ngạc nhiên, nhưng vị trung tá của cô chỉ lắc đầu.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000788", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Kế hoạch của chúng ta đã kết thúc trong thất bại. Chúng ta chẳng ở vị thế có thể chế nhạo bất kỳ ai đâu.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000789", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Những tiếng thở dài vang lên khi các pháp sư nhanh chóng rút khỏi khu vực tác chiến.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000790", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Mọi chuyện vẫn cứ như mọi khi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000791", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Họ lại giành thêm một chiến thắng nhỏ nhoi nữa.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000792", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Đó là một chiến thắng quả cảm bị phủ bóng bởi tấm màn mỏng của một thất bại lớn hơn.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000793", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Thế nhưng tấm màn mỏng ấy lại quá đủ để che khuất hoàn toàn những chiến công của họ, bất kể chúng có tỏa sáng rực rỡ đến nhường nào đi chăng nữa.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000794", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Suy cho cùng, Lục quân Đế quốc đã thua trận này. Họ nện nắm đấm vào những bức tường gỗ của Khối Thịnh vượng chung, để rồi nắm đấm của họ chỉ bật ngược trở lại.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000795", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Sau khi mọi chuyện đã ngã ngũ, Tanya phải tính xem mình sẽ đi đâu tiếp theo.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000796", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Khốn kiếp thật. Lúc quay về mình nhất định phải xả cho Tướng Romel một trận ra trò mới được.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000797", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "CÙNG NGÀY HÔM ĐÓ, BỘ CHỈ HUY CỤM TẬP ĐOÀN QUÂN PHÍA TÂY CỦA LỤC QUÂN ĐẾ QUỐC", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000798", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Đúng vào khoảnh khắc này, tiếng quát tháo của một người đàn ông vọng ra từ góc trung tâm chỉ huy Cụm tập đoàn quân phía Tây, nơi hiếm hoi lắm mới có mặt chủ nhân của nó. Bản báo cáo đầu tiên ông nhận được… lại là tin tức tồi tệ nhất có thể tưởng tượng ra. Trung tướng Romel choáng váng trước sự khắc nghiệt của thực tại ngay trong văn phòng của chính mình.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000799", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Chết tiệt!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000800", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Ông chẳng mảy may bận tâm đến dòng máu đang chảy ra từ nắm đấm khi lại nện sầm nó xuống mặt bàn lần nữa.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000801", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Bản báo cáo cho ông biết quân của họ đã chạm trán lực lượng địch. Không những thế, kẻ đang phục sẵn chờ đợi lại chẳng phải ai khác ngoài hạm đội Khối Thịnh vượng chung hùng mạnh. Kế hoạch ban đầu của họ vốn là một cuộc tập kích bất ngờ nhằm đạt mục tiêu chính trị. Tướng Romel đã huy động chút binh lực ít ỏi mà ông còn có thể gom góp cho chiến dịch này. Ông thừa biết họ chẳng có cơ hội nào nếu vấp phải bất kỳ sự kháng cự đáng kể nào.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000802", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Điều này có nghĩa là kế hoạch đã thất bại.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000803", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Gạt thất bại của kế hoạch sang một bên, vẫn còn một câu hỏi lớn hơn đang giày vò tâm trí ông.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000804", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Tại sao?! Làm sao chúng biết được?!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000805", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Ông nhìn quanh căn phòng với đôi mắt hằn tia máu, van nài một câu trả lời vốn chẳng bao giờ tới.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000806", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Thất bại luôn là một khả năng có thể xảy ra ngay từ đầu. Trung tướng Romel vốn chỉ hy vọng rằng kế hoạch sẽ diễn ra chí ít được một nửa như dự tính mà thôi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
