{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000418", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Cấp trên của anh gật đầu tán đồng, khiến Đại tá Lergen càng thêm bất an. Dù không tài nào diễn tả rõ được bằng lời, anh biết chắc có điều gì đó đang ẩn giấu đằng sau sự đồng tình ấy của cấp trên.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000419", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Tuy nhiên, cấp trên của anh đã tiếp tục lên tiếng trước khi anh kịp đoán ra hàm ý ẩn giấu đó là gì.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000420", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Vấn đề lớn nhất của chúng ta là thời gian.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000421", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Cau mày bực dọc, vị tướng nhắc đến thách thức lớn nhất của họ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000422", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Đất nước chúng ta đang chảy máu đến cạn kiệt, chậm rãi nhưng chắc chắn. Chẳng bao lâu nữa chúng ta sẽ chết. Đó là tình cảnh mà chúng ta đang phải đối mặt lúc này. Nếu không sớm khâu miệng vết thương này lại, thứ duy nhất chờ đợi chúng ta sẽ là một cái chết kéo dài.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000423", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Tôi cảm thấy nếu người ta bắt một bệnh nhân đã kiệt sức phải lao lực vô ích, nhiều khả năng cú sốc đó chỉ càng khiến họ mất mạng sớm hơn mà thôi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000424", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Ý anh là sao? Sao nào, thế có nghĩa là anh định bỏ mặc bệnh nhân à?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000425", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Tôi cảm thấy nếu vết thương của họ đã ở mức nguy kịch, tốt nhất chỉ nên cân nhắc một ca phẫu thuật như thế sau một thời gian hạn chế vận động. Dù ca phẫu thuật có thành công đi chăng nữa, thì còn nghĩa lý gì nếu bệnh nhân lại tử vong?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000426", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Vị trung tướng khoanh tay trầm ngâm trước khi buông một câu đáp trả ngắn gọn.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000427", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“…Đại tá Lergen, anh đúng là một kẻ ngốc.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000428", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Xin ngài hãy chỉ giáo cho tôi về quan điểm của ngài trong vấn đề này, thưa Trung tướng.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000429", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Tôi chẳng muốn làm đau tay mình đâu—” ông vừa nói vừa thực sự giơ nắm đấm lên.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000430", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Biết trước câu chuyện đang đi về đâu, Lergen vội ngắt lời ông trước khi vị tướng quá sa đà vào một màn kịch *khác*.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000431", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Thưa ngài! Xin ngài đừng tự lừa dối bản thân nữa.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000432", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Ồ?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000433", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Một nắm đấm thì làm được gì chứ?! Ai cũng có thể tung một cú đấm! Thậm chí họ có thể trót lọt thêm lần thứ hai. Nhưng rồi tất cả những chuyện đó sẽ dẫn tới đâu?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000434", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Kẻ sống bằng gươm đao ắt sẽ chết bởi gươm đao—và Lục quân Đế quốc về bản chất chính là một thanh đại kiếm khổng lồ. Cứ vung kiếm quá đà thì rốt cuộc chính Đế quốc sẽ là kẻ phải gục ngã trong vũng máu của chính mình.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000435", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Đại tá Lergen hiểu rất rõ rằng đây cũng chỉ là giả thuyết từ phía cá nhân anh mà thôi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000436", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Vậy anh muốn tôi trông cậy vào giới quan chức hành chính ư? Anh muốn đặt hy vọng vào Tham tán Conrad rồi cầu nguyện rằng ông ta sẽ xoay xở êm thấm mọi chuyện giúp chúng ta sao?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000437", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Quân đội suy cho cùng cũng chẳng là gì khác ngoài đúng bản chất của nó—một đội quân.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000438", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Lergen nhớ lại ngày các cuộc đàm phán ngoại giao ở Ildoa đổ bể, chấm dứt hy vọng về một hiệp định đình chiến nhanh chóng của họ. Nếu một người lính đơn thuần có thể tạo nên sự khác biệt vào lúc ấy, anh đã ước gì hôm đó họ có mặt ở nơi ấy…", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000439", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Đứng trước tình cảnh hiện tại, anh cũng có chung cảm giác đó.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000440", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Trái lại, lý trí của Đại tá Lergen kịch liệt phủ nhận cảm giác *bàng hoàng* trong lòng anh.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000441", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Chúng ta là các sĩ quan tham mưu cao cấp. Huấn luyện tiêu chuẩn đã quy định rõ những gì chúng ta cần làm.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000442", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Huấn luyện tiêu chuẩn chẳng dạy cho anh điều gì khác ngoài một chuẩn mực duy nhất. Việc đánh giá lại xem chuẩn mực của chúng ta nên là gì chính là đặc quyền của chúng ta.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000443", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Ông buông lời ấy hết sức thản nhiên, nhưng sức nặng hàm chứa bên trong lại đủ khiến nét mặt vị sĩ quan tham mưu cao cấp đanh cứng lại.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000444", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Thưa Trung tướng, có phải ngài đang ám chỉ rằng ngài có thể định nghĩa lại các chuẩn mực ngay giữa một cuộc chiến như thế này không?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000445", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“…Chẳng có gì là khả thi nếu anh không bao giờ thử cả. Anh nghĩ đã có bao nhiêu thứ bị quy kết là bất khả thi mà chưa từng một lần được kiểm chứng?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000446", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Chúng ta là một nắm đấm, thưa ngài. Chúng ta chẳng qua chỉ là một nắm đấm đang mang thương tích mà thôi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000447", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Để tiện tranh luận, cứ cho là anh đúng đi. Vậy để tôi hỏi anh câu này. Anh thực sự tin rằng chúng ta sẽ chẳng bao giờ có thể trở thành thứ gì hơn một nắm đấm ư?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000448", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "*Vấn đề còn cơ bản hơn thế nhiều…* Điếu xì gà vẫn kẹp trên tay, Lergen tiếp lời bằng giọng khản đặc.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000449", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Chúng ta đánh trận, còn các chính khách điều hành đất nước. Chúng ta có giới quan chức hành chính để gắn kết đôi bên lại với nhau. Đó chính là nền tảng làm nên quốc gia của chúng ta.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000450", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Thật ức chế. Thật khó lòng chịu đựng nổi. Lergen suýt chút nữa đã muốn bùng nổ mỗi khi nghĩ về chuyện đó. Anh biết rõ đấy là trái cấm, ấy vậy mà… kế hoạch của Tướng Rudersdorf vẫn mang một sức quyến rũ đến mê hồn!", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000451", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Nhưng đó suy cho cùng cũng chỉ là cảm xúc cá nhân của riêng anh.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000452", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Nó chẳng qua chỉ là một phản ứng bản năng khởi nguồn từ những tâm tư chất chứa trong lòng anh mà thôi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000453", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Thưa ngài, trên tư cách cá nhân, quả thực kế hoạch của ngài có điểm khiến tôi thấy bị cám dỗ. Thế nhưng trên tư cách một đại tá, đó là điều mà tôi không bao giờ có thể ủng hộ.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000454", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Lergen có thể chia sẻ nhận thức về hoàn cảnh hiểm nghèo mà đất nước họ đang đối mặt—cả hai người đều có chung sự tỉnh táo trước vấn đề này. Tuy nhiên, với tư cách một chuyên gia quân sự, anh không thể kê đơn kế hoạch của vị tướng như một giải pháp được. Các kế hoạch dự phòng vốn chẳng khác nào bảo hiểm nhân thọ. Chúng không phải thứ có thể cưỡng ép đem ra thực thi!", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000455", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Đại tá Lergen ngồi đó chờ đợi lời khiển trách từ cấp trên.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000456", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Tuyệt vời. Đó mới chính là tư duy đúng đắn cần phải có.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000457", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Lergen có nằm mơ cũng không ngờ người đàn ông ấy lại tán thành với mình.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000458", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Phản ứng ấy thực sự khiến anh chưng hửng tột độ. Dù biết rõ không tài nào tránh khỏi việc rơi vào ổ phục kích, anh vẫn bước thẳng vào đó chẳng khác gì một gã khờ. Theo một nghĩa nào đó, đây có thể xem là một trải nghiệm chiến thuật hiếm có.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000459", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Thế nên, anh cần phải quẳng hết mọi lẽ thường qua cửa sổ đi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000460", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Sao cơ ạ?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000461", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Khả năng mặc cả vốn là thứ đã được rèn giũa ăn sâu vào máu các sĩ quan tham mưu cao cấp.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000462", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Dù chỉ là người chỉ huy trên danh nghĩa, Lergen cũng đã dành không ít công sức nghiên cứu tình hình ở mặt trận phía đông và luôn chú tâm đúc kết mọi bài học quan trọng từ tiền tuyến. Thế nhưng đòn tấn công chính diện toàn lực này—một ví dụ kinh điển của học thuyết tác chiến chiều sâu do Rudersdorf thực hiện—đã xuyên thấu qua những kẽ hở trong tâm trí đang rối bời của anh.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000463", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Người ta cứ nói về ba nhánh quyền lực, nhưng suy cho cùng thì tất cả đều quy về Bộ Tư lệnh Tối cao mà thôi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
