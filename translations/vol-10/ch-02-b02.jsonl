{"segment_id": "YS-LN10/Text/chapter008.xhtml/p000030", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Một chiến lược như thế hẳn phải bao gồm việc rút lui, tập hợp lại đội ngũ, rồi chuẩn bị cho một đòn phản công về sau.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter008.xhtml/p000031", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Giá như họ đang làm đúng ba bước ấy, sẽ chẳng có lấy một người lính nào thắc mắc về những đợt chuyển quân của họ dù chỉ một lần. Vấn đề nằm ở chỗ, họ hoàn toàn không hề tập hợp lại đội ngũ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter008.xhtml/p000032", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Theo những gì họ nhận thấy, toàn bộ mặt trận đang đều đặn nhường đất.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter008.xhtml/p000033", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Họ không sao rũ bỏ nổi cảm giác rằng mình đang phải nhượng bộ trước sức ép của địch ngoài tiền tuyến. Khả năng ấy có vẻ quá đỗi chân thực.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter008.xhtml/p000034", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Nếu biết mục tiêu cuối cùng của mình là gì, họ sẵn sàng lặng lẽ nghe theo. Dù vậy, việc cứ lùi bước trước sức ép ngày một gia tăng của kẻ địch vẫn vượt quá sức hiểu biết của họ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter008.xhtml/p000035", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Chuyện đó đủ khiến một số binh lính nổi giận, còn với những người bị mối hoài nghi dằn vặt—họ tự thuyết phục bản thân rằng ắt hẳn phải có một mưu kế nào đó lớn lao và được tính toán kỹ lưỡng hơn. Theo nghĩa đó, Lục quân Đế quốc là một tổ chức không chấp nhận sự im lặng. Mọi thứ đều bắt đầu từ sự phục tùng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter008.xhtml/p000036", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Việc đưa ra ý kiến bất đồng vừa là quyền lợi vừa là nghĩa vụ đối với bất kỳ ai có chính kiến như vậy.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter008.xhtml/p000037", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Và thế là các sĩ quan chỉ huy đã nêu những mối lo ngại của mình lên Văn phòng Bộ Tổng tham mưu.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter008.xhtml/p000038", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Lần nào họ cũng nhận lại đúng một câu trả lời: *Tất cả đều nằm trong kế hoạch*.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter008.xhtml/p000039", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Họ có thể chấp nhận lời giải thích ấy một lần.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter008.xhtml/p000040", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Họ cũng sẽ miễn cưỡng xuôi theo vào lần thứ hai.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter008.xhtml/p000041", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Nhưng đến lần thứ ba thì đã chạm tới giới hạn của họ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter008.xhtml/p000042", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Thời gian trôi qua, mối nghi ngờ trong họ chỉ càng thêm sâu sắc. Đến nước này, các sĩ quan cấp tá đã cùng đám binh lính thuộc quyền công khai hoài nghi chiến lược hiện tại.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter008.xhtml/p000043", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Chẳng một ai biết Trung tướng Zettour đang toan tính điều gì cho mặt trận phía đông. Việc khẽ hỏi nhau về ý đồ của ông đã trở thành một kiểu chào hỏi cửa miệng giữa những người lính.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter008.xhtml/p000044", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Anh nghĩ vị tướng ấy đang định làm gì?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter008.xhtml/p000045", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Chắc chúng ta chỉ định nhử quân địch vào sâu thôi. Rồi mình sẽ lại bao vây chúng như mọi khi ấy mà.” Nhóm những người lạc quan một cách dè dặt vừa trấn an đồng đội vừa thầm hy vọng sự thật đúng là như vậy.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter008.xhtml/p000046", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Rốt cuộc, cả những kẻ hoài nghi lẫn những người còn tin tưởng đều giữ im lặng và chấp hành mệnh lệnh.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter008.xhtml/p000047", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "CÙNG NGÀY HÔM ĐÓ, VĂN PHÒNG THANH TRA TẠI MẶT TRẬN PHÍA ĐÔNG", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter008.xhtml/p000048", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Người đàn ông đứng giữa tâm điểm của vũng lầy—đó là cách Trung tướng Zettour tự nhìn nhận bản thân.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter008.xhtml/p000049", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Cả bạn lẫn thù đều đang ráo riết tìm cách đoán ra ý đồ thực sự của ông. Người đàn ông ấy khẽ cười một tiếng đầy chua chát.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter008.xhtml/p000050", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Thú vị thật. Không biết đây có phải là một tật xấu của mình không nhỉ?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter008.xhtml/p000051", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Ông vươn người rồi thả lỏng hai vai lần đầu tiên sau một khoảng thời gian khá dài. Ông không ngại thừa nhận điều đó. Ở một chừng mực nào đó, với tư cách một quân nhân, ông đang cảm thấy thích thú.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter008.xhtml/p000052", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Tình cảnh hiện tại của ông gần như có thể mô tả là đầy khoái cảm.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter008.xhtml/p000053", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Đúng là nhiễm phải một thói quen tai hại… Mình đã ở ngoài chiến trường quá lâu rồi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter008.xhtml/p000054", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Trung tướng Zettour tiếp tục cười thầm một mình ở góc phòng chỉ huy. Trung tâm chỉ huy dạo này vắng vẻ hơn hẳn vì công việc thường nhật của họ giờ đã trở thành các hoạt động tác chiến rút lui.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter008.xhtml/p000055", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Vị tướng thậm chí còn có thời gian thưởng thức một điếu xì gà trong lúc thả cho tâm trí phiêu du. Ông vừa trầm ngâm đi lại quanh phòng vừa phóng tầm mắt nhìn khắp tấm bản đồ lớn trải rộng trước mặt.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter008.xhtml/p000056", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Đó là môi trường hoàn hảo để suy ngẫm.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter008.xhtml/p000057", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "…Ông bước đi quanh phòng theo đúng thói quen mọi khi ở văn phòng cục phó mỗi lúc vạch chiến lược. Vị tướng rít từng hơi từ điếu xì gà yêu thích trong khi phân tích hàng loạt kịch bản chiến tranh khác nhau.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter008.xhtml/p000058", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Khỏi phải nói, ông chưa bao giờ quên đi gánh nặng trên vai mình—dù chỉ một lần. Ông phải làm tròn bổn phận của một vị tướng. *Dẫu nói là vậy…* Ông khẽ cười thầm trước suy nghĩ riêng tư đó. Trung tướng Zettour suy cho cùng cũng chỉ là con người. Khi con người ta nhận ra bản chất thực sự trong công việc của mình, họ chỉ còn cách dấn thân theo nó.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter008.xhtml/p000059", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“…Mình không thể cưỡng lại bản năng của một nhà chiến lược trong lòng được.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter008.xhtml/p000060", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Dù là người làm tác chiến, ông lại chuyên sâu vào một lĩnh vực khác biệt so với các đồng liêu của mình. Trách nhiệm của ông bao quát gần như mọi khía cạnh của cuộc chiến. Đó là lý do ông không còn coi tác chiến là tối thượng nữa… hay ít nhất ông từng nghĩ vậy.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter008.xhtml/p000061", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Nhìn mình bây giờ xem.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter008.xhtml/p000062", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Một làn khói phả ra bên điếu xì gà ngậm trên môi khi ông than thở với sự pha trộn giữa vẻ tự giễu, kinh ngạc và hoài niệm.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter008.xhtml/p000063", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Xem ra vẫn còn một phần trong mình coi tác chiến là nhân tố quyết định của chiến tranh.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter008.xhtml/p000064", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "*Có lẽ chúng ta nên dồn toàn lực và đảm bảo giành thắng lợi ở miền đông chăng?*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter008.xhtml/p000065", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Ông vừa nghĩ như vậy, nhưng chẳng mấy chốc đã bắt đầu cảm thấy bực dọc trước chuyện chính trị, việc cố vấn và bài toán xoay xở hậu cần mà mình buộc phải gánh vác.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter008.xhtml/p000066", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Lẽ dĩ nhiên, những cảm xúc ấy là hoàn toàn vô lý.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter008.xhtml/p000067", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Cứ tưởng mình đã dứt khỏi giáo hội của sự tất yếu rồi chứ. Khá bất ngờ là tận sâu trong thâm tâm, mình vẫn bị những giáo điều của nó trói buộc. Xem chừng việc quên đi nơi mình xuất thân còn khó hơn mình tưởng.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
