{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000033", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Họ cần thêm thời gian.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000034", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Đáng buồn thay, chiếc đồng hồ cát của Đế quốc đã cạn sạch cát từ lâu. Cách duy nhất để họ có thêm thời gian là lật ngược cả chiếc đồng hồ cát lại.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000035", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Dẫu vậy, vấn đề thực sự lại là ngay từ đầu họ đã bị mắc kẹt bên trong một chiếc đồng hồ cát.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000036", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“…Lục quân cần phải tiến hành chiến tranh tổng lực dưới quyền một người chỉ huy duy nhất.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000037", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Thắng lợi của Zettour ở miền đông làm vang vọng điệp khúc đó hơn bất cứ điều gì khác.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000038", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Nó chứng minh rằng nhờ chiến lược được thực thi bài bản, Lục quân Đế quốc vẫn có thể duy trì vị thế của một siêu cường bất khả xâm phạm.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000039", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Thất bại của Tướng Romel ở miền tây cũng để lại một bài học quan trọng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000040", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Lục quân Đế quốc không có khả năng giành lấy chiến thắng trên một chiến trường xa lạ nếu thiếu đi sự phối hợp nhịp nhàng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000041", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Sự khác biệt về kết cục giữa hai trận đánh là quá lớn. Nó vẽ nên một bức tranh hết sức rõ ràng cho nhà chiến lược bên trong con người Rudersdorf.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000042", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Chúng ta cần một hệ thống chỉ huy duy nhất.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000043", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Lục quân cần nhiều hơn một Văn phòng Bộ Tổng tham mưu. Đất nước này cần một Bộ Tư lệnh Lục quân Tối cao kiểm soát toàn bộ cuộc chiến từ một đầu mối duy nhất. Cơ quan đó cần phải vận hành độc lập với Bộ Tư lệnh Tối cao, quốc hội, hoàng gia cũng như ý nguyện của người dân.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000044", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Chính những yếu tố này đang trói buộc chúng ta.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000045", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Ông lặng lẽ hút một điếu xì gà sau khi chuyển từ thuốc lá điếu sang để đổi gió, nhưng lại thấy mình bận tâm nhiều hơn đến một ý tưởng mới nhen nhóm nơi góc tâm trí.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000046", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Liệu họ có thể chiến thắng với một hệ thống chỉ huy duy nhất nắm quyền điều hành mọi thứ không? Điều đó chưa có gì chắc chắn. Dẫu vậy, đấy là cách để đẩy nhanh tiến độ—cách để chấm dứt cảnh đi trên dây này và cho phép lục quân vận dụng quỹ thời gian cùng nguồn lực hạn hẹp của mình…", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000047", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Câu hỏi về *tính tất yếu* vụt qua tâm trí Trung tướng Rudersdorf trước khi ông nhăn mặt và bật ra một tiếng cười gượng gạo đầy bất an.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000048", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Ta không nên vội tính quá xa…”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000049", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Ông suýt chút nữa đã bất cẩn đưa ra quyết định về một vấn đề đầy rắc rối.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000050", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Kế hoạch B vẫn chỉ là một kế hoạch dự phòng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000051", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Họ vẫn còn Tham tán Conrad để trông cậy cùng một con đường khả dĩ dẫn tới hòa bình thông qua Ildoa. Cho dù cơ hội có mong manh đến đâu, Kế hoạch B vẫn luôn phải xếp lại phía sau chừng nào Đế quốc còn cơ may rút chân ra khỏi toàn bộ mớ hỗn độn này.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000052", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Ta không thể để trí tưởng tượng của mình đi quá xa được. Ta biết Zettour cần đến trí tưởng tượng thái quá của lão để nghĩ ra mấy ngón đòn đó trên chiến trường. Nhưng đó là thứ mà ta từng nghĩ mình sẽ chẳng bao giờ phải tính đến.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000053", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Ông cố cười xòa để gạt bỏ ý nghĩ đó đi, nhưng nó vẫn ngoan cố đeo bám.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000054", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Ý tưởng đó đã cắm rễ trong tâm trí ông.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000055", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Một ý tưởng dành cho kịch bản tồi tệ nhất. Một kế hoạch định hình diện mạo đất nước dưới tình trạng thiết quân luật, nếu buộc phải đi đến bước đường đó. Một giải pháp khẩn cấp. Hơn nữa, lại là một giải pháp có triển vọng thành công khả quan.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000056", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Dẫu vậy… đó không phải là điều mà bất kỳ người lính tỉnh táo nào từng thề trung thành với hoàng gia và Tổ quốc có thể thực hiện đến cùng nếu không đánh mất sự tự chủ của bản thân.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000057", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Ông gần như chỉ muốn đọc một cuốn tiểu thuyết trinh thám, hay bất cứ thứ gì có thể giúp tâm trí ông tạm quên đi mọi chuyện.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000058", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "*Mặc dù vậy—nói đi thì cũng phải nói lại—dẫu sao chăng nữa…*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000059", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Trung tướng Rudersdorf trầm ngâm suy nghĩ về quả bom được gửi tới từ miền tây.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000060", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Có quá nhiều vấn đề phải giải quyết, bắt đầu từ bản báo cáo khẩn cấp của Tướng Romel.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000061", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Ông đã nhận được lời cảnh báo từ vị tướng ấy qua một bức thư niêm phong do một sĩ quan đích thân trao tận tay. Ngậm điếu xì gà trên miệng, ông suy nghĩ thật lâu và thật kỹ về vấn đề này, nhưng cũng như làn khói thuốc lơ lửng quanh ông, nó chẳng chịu tan biến.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000062", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Dù lời cảnh báo đó giống một linh cảm hơn, nhưng những căn cứ cho linh cảm của ông ta lại hết sức đáng ngại.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000063", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Lời cảnh báo nêu rõ rằng nhiều khả năng hệ thống mã hóa của họ đã bị phá giải. Một nhận định gây chấn động khôn lường nếu điều đó có dù chỉ một phần là sự thật.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000064", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Chỉ riêng nguy cơ xảy ra một sự cố như thế thôi cũng đã quá đủ để khiến vị tướng phải rùng mình. Ông cần phải rà soát lại các bộ mật mã… Việc kiểm tra xác nhận từng quân chủng, vốn mỗi bên có thông lệ riêng, sẽ đòi hỏi một khối lượng công việc khổng lồ, nhưng đó là việc dứt khoát phải làm.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000065", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Ông thậm chí chẳng muốn nghĩ tới khả năng có gián điệp trong lòng Đế quốc. Việc chỉ đơn thuần liệt kê đủ mọi khả năng chẳng giúp chỉ đích danh được bất kỳ vấn đề thực tế nào!", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000066", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Ta thực sự hy vọng không có kẻ phản bội nào giữa chúng ta. Dù ta cho rằng vấn đề sẽ còn nghiêm trọng hơn nhiều nếu chúng thực sự đã giải mã được mật mã của chúng ta. Đằng nào đi nữa, chuyện này cũng…”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000067", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Mối nghi ngại xoay quanh các thông tin tuyệt mật của họ là một bước lùi nghiêm trọng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000068", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Tệ hơn nữa, Trung tướng Rudersdorf không có cách nào biết được liệu các bộ mật mã của mình có thực sự đáng tin cậy hay không.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
