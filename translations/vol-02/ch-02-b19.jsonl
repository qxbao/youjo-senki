{"segment_id": "YS-LN02/Text/part0014.xhtml/p000513", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Rõ, thưa bà!”", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000514", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Câu đáp gọn lỏn hẳn có nghĩa là họ đã hiểu ý định của nó. Tanya hài lòng gật đầu.", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000515", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Nào, làm việc cho xứng với số tiền chúng ta được trả!”", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000516", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Đội ném bom tiêu rồi! Vẫn chưa có chi viện à?!”", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000517", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Ánh sáng—ánh sáng!! Áaaa!”", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000518", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Mất tín hiệu của đội trưởng đội hình rồi à?!”", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000519", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Tản ra! Chúng nhanh quá! Dựng màn đạn lên! Đừng để chúng áp sát!”", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000520", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Pixie 02 gọi tất cả các đại đội. Xung phong!”", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000521", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Khự! Chúng vượt qua đội tiên phong rồi à?! Ngừng bắn, chuẩn bị cận chiến!”", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000522", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Mayday! Mayday! Vẫn chưa có cứu viện à?!”", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000523", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Trung tâm Norland gọi tất cả đơn vị. Hủy chiến dịch! Hủy chiến dịch! Kể từ lúc này, hủy chiến dịch!”", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000524", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Đơn vị ném bom—!”", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000525", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Chết tiệt! Đội tiên phong bị xé nát rồi! Bọn kia là ai vậy?!”", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000526", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Đại đội trinh sát bị quét sạch rồi! Cứ thế này chúng ta sẽ bị bao vây mất!”", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000527", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Chúng vượt qua lực lượng yểm trợ gần của ta rồi à?!”", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000528", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Viper 02 gọi Pixie 01. Chúng tôi đang đến.”", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000529", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Rõ. Chưa thấy quân tiếp viện địch. Dự kiến sẽ bị truy kích ráo riết.”", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000530", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Viper 02, rõ.”", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000531", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Phát hiện quân tiếp viện địch! Quy mô cỡ một tiểu đoàn.”", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000532", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Quân tiếp viện à? Còn quân ta thì sao?!”", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000533", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Trung tâm Norland gọi tất cả đơn vị. Lập tức rút về điểm tập kết số hai. Nhắc lại, lập tức rút về điểm tập kết số hai.”", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000534", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Không được rồi! Không cắt đuôi được chúng!”", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000535", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Khốn kiếp, khốn kiếp, khốn kiếp!”", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000536", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Pixie 01 gọi toàn thể. Chuyển sang dọn dẹp.”", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000537", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Viper 02 gọi Tiểu đoàn Pixie. Đã nhìn thấy các anh.”", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000538", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Chúng tôi cũng thấy các anh. Có thể giao việc truy kích cho các anh không? Tôi muốn đội mình xử lý đám tụt lại.”", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000539", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Quân tiếp viện địch đã đến!”", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000540", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Chết tiệt! Đừng dừng lại! Chạy đi! Mau lên!”", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000541", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Rõ. Cảm ơn.”", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000542", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Khốn kiếp, đúng là địa ngục!”", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000543", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Ruột của tôi… Ai nhặt ruột tôi lên với!”", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000544", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Chúng là kẻ thù không đội trời chung của các anh. Không cần nương tay. Hết.”", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000545", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "*Tối qua mình đã uống cái quái gì vậy?*", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000546", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Câu hỏi đầu tiên nảy ra trong đầu anh ta thật ngớ ngẩn.", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000547", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Anh ta cảm nhận được có người đang lay mình, nhưng phải mất một lúc lâu đầu óc anh ta mới bắt đầu hoạt động.", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000548", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Trung úy Gunning không hiểu sao cả người mình lại nặng trĩu.", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000549", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "*Có người đang… gọi mình à?*", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000550", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Ừm…!”", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000551", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Ý thức anh ta đã trở lại, dù vẫn còn mơ hồ, và những đường nét bắt đầu hiện ra.", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000552", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Trung úy! Trung úy!”", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000553", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "*…Chà, thế này không ổn. Nếu họ không gọi tên mình thì chắc là sếp hoặc quân cảnh.*", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000554", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "*Nhưng mình vẫn còn choáng. Chóng mặt đến mức không chịu nổi.*", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000555", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "*Thật tình, mình đã uống cái gì vậy? Uống cả chai Scotch mình vẫn khỏe re, sao lần này…? Có ai pha vodka cho mình à?*", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000556", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Anh ta chỉ hé mắt, như thói quen.", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000557", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Một không gian trắng lóa. Có thứ gì đó đang nhấp nháy. *Không, có lẽ là một loại máy móc?*", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000558", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Ánh sáng vẫn làm anh ta khó chịu, nhưng cảm giác kỳ lạ rằng cơ thể này không phải của mình khiến anh ta bối rối. Anh ta mệt rã rời, cố thế nào cũng không nhúc nhích nổi.", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000559", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Khi nhìn chằm chằm lên trần nhà, cuối cùng đầu óc anh ta cũng tỉnh lại; suy nghĩ dần thông suốt, anh ta bắt đầu nhận ra xung quanh. Nhìn qua thì đây không giống phòng mình. *Vậy chuyện gì đang xảy ra?*", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000560", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Anh ta chẳng nhớ gì về nơi này. Một khoảng trắng tinh. *Hửm? Một căn phòng? Mình nghĩ mình biết nơi này. Hình như mình có chút ký ức về nó. Vậy mình đang ở đâu?*", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000561", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“…Ư… Ở đâu…?”", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000562", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Anh ta rên lên không hẳn để mong có người trả lời, nhưng dường như người vừa gọi anh ta đã nghe thấy. Có vẻ tiếng rên khiến mọi người xung quanh chú ý, rồi đột nhiên anh ta bị cuốn vào một cảnh náo loạn ầm ĩ. Chẳng hiểu sao anh ta cố ngồi dậy, nhưng suýt ngã nhào. Cơ thể không cử động theo ý muốn. Hình như có người đỡ anh ta lên, và anh ta lờ mờ hiểu rằng mình đang được dìu.", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000563", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Trung úy! Được rồi, anh tỉnh rồi phải không? Quân y! Mau gọi bác sĩ phẫu thuật!”", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000564", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Cái gì…?”", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000565", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Chỉ thốt ra câu hỏi thôi cũng khiến anh ta kiệt sức. *Có gì đó rất kỳ lạ.* Anh ta không thể diễn tả thành lời, nhưng có điều gì đó đã khác. *Rốt cuộc chuyện quái gì xảy ra với mình vậy?*", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000566", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Anh ta không còn lơ mơ nửa tỉnh nửa mê, nhưng dù ý thức ngày càng rõ, ánh sáng mờ đục trước mắt vẫn không tan đi. Mắt anh ta không những không lấy nét được mà còn không giữ yên nổi.", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000567", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "*Nếu là say rượu thì mình phải buồn nôn và đau đầu… nhưng không.* Khi thực tại dần trở về, anh ta bắt đầu nhận ra mình đang ở trong một tình cảnh kỳ lạ đến mức nào.", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000568", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Bình tĩnh. Anh nhớ được đến đâu?”", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000569", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“…Gì cơ? Anh đang nói gì vậy?”", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000570", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "*Không. Mình không muốn nhớ thêm chút nào nữa.*", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000571", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "*Mình* không được *nhớ lại.*", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000572", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "*Mình không thể… Gì cơ?*", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000573", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Đại úy, không ổn rồi. Anh ấy nát bét cả rồi.”", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000574", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Ở đây cũng vậy. Nhật ký bị phá hủy. Chúng tôi đã thu hồi được, nhưng tôi không nghĩ mấy thứ này còn hữu ích.”", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000575", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "*Nát bét?*", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000576", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "*Bị phá hủy?*", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000577", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "*Đồng đội của mình…*", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000578", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "*Còn anh em của mình thì sao…?*", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000579", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Chào mừng đến Đế quốc. Anh có hộ chiếu không?”", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000580", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Ha ha ha, Chỉ huy. Chúng tôi đâu có mang bó hoa chào mừng. Giờ tính sao đây?”", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000581", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Ôi trời, tôi phải làm gì với mấy cậu đây? Nhưng có mang pháo hoa đến chứ?”", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000582", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“À phải rồi. Mấy thứ đó trông cũng giống hoa nhỉ?”", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000583", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Tuyệt. Vậy có lẽ tôi sẽ hát một bài chào mừng.”", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000584", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Hửm? Anh biết hát à?”", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000585", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Ừ, một bài hay lắm.”", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000586", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Có cần tôi khâu miệng các cậu lại không?” đại úy quát.", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000587", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Ở đâu đó, có người vội vàng ngậm miệng lại, nhưng đã quá muộn.", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000588", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "*Hoa đỏ, đỏ thắm. Anh em của mình. Cấp trên của mình. Người của mình.*", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000589", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“…Áááááááááááá!”", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000590", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Quân y! Thuốc an thần! Mau!”", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
{"segment_id": "YS-LN02/Text/part0014.xhtml/p000591", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Lũ ngốc! Các cậu sẽ bị kỷ luật vì chuyện này!”", "status": "draft", "translator": "vol-02-ch-02-b19-translator", "notes": []}
