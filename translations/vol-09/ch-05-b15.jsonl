{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000464", "translation": "Nhưng chuyện này thì đúng là lần đầu tiên đối với anh.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000465", "translation": "Tuyên bố *Tôi đang hành động theo quyền tự quyết của mình* vốn là sở trường của Degurechaff chứ không phải của anh, ấy thế mà…", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000466", "translation": "“Một cấp trên như cô ấy quả nhiên chỉ tổ làm gương xấu mà.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000467", "translation": "“Mọi chuyện vẫn ổn chứ ạ?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000468", "translation": "“Tôi chỉ có đôi điều tâm tư thôi.” Meybert nhếch mép cười với thuộc cấp. “Khi thăng tiến lên cao hơn, các cậu sẽ dần thấu hiểu tâm trạng của cấp trên—và sẽ ghét cay ghét đắng cái cảm giác đó cho mà xem. Chắc là vì khi ấy các cậu bắt đầu nhìn nhận sự việc từ nhiều góc độ khác nhau rồi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000469", "translation": "Phải thể hiện sự kiên quyết cứng rắn trong giọng nói để đáp lại ý kiến của người khác… Khi đích thân rơi vào vị thế đó, Meybert thấy bức bối vô cùng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000470", "translation": "“…Thưa Đại úy, chúng tôi khai hỏa được chưa ạ?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000471", "translation": "“Cậu định ám chỉ là chúng ta nên để các khẩu pháo im tiếng ngay trước mặt quân địch ư? Không đời nào có chuyện đó.” Anh vừa định hất cằm ra hiệu cho họ tiến hành thì—*Ồ*—một ý nghĩ chợt lóe lên. Suýt chút nữa thì anh quên dặn thêm một điều cuối cùng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000472", "translation": "Mệnh lệnh thì phải được ban ra cho đàng hoàng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000473", "translation": "“Nếu có chuyện gì bất trắc xảy ra, tôi sẽ chịu trách nhiệm.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000474", "translation": "Đó chỉ là màn bắt chước vụng về của một kẻ mới tập làm sĩ quan cấp trên, nhưng anh cảm thấy cần phải nói thật rõ ràng vì những người lính của mình.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000475", "translation": "Anh đang tự mình quyết đoán mọi chuyện và kéo cả cấp dưới vào cuộc. Anh tin việc mình làm là cần thiết, nhưng nếu đã đi xa đến mức này mà rốt cuộc đó lại là một sai lầm, thì đời anh coi như xong.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000476", "translation": "Chẳng có ai ở cấp cao hơn đứng ra gánh vác trách nhiệm cả, nên anh phải làm tròn bổn phận của người sĩ quan có quân hàm cao nhất tại đây.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000477", "translation": "“Có ai phản đối không? Nếu không thì bắt đầu đi.” Anh đưa mắt nhìn quanh căn phòng, nhưng không có lấy một lời phản đối. “Tốt.” Anh khẽ gật đầu hài lòng. “Thông báo cho tất cả các khẩu đội pháo. Ngắm sát mục tiêu hết mức có thể nhưng tuyệt đối không được bắn trúng chúng.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000478", "translation": "“Bắn cảnh cáo sao, thưa Đại úy?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000479", "translation": "“Tôi dám thề có Chúa rằng chúng là quân địch, nhưng quân luật cứ buộc phải thế. Hãy cố hết sức đừng bắn trúng trực tiếp vào chúng. Dù vậy, cứ nã một loạt đạn cảnh cáo thật dữ dội vào. Đây cũng sẽ là cơ hội tốt để quan sát phản ứng của chúng, nên ta cứ dọa cho chúng một phen khiếp vía đi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000480", "translation": "Rồi anh hít một hơi sâu. Anh cảm thấy hồi hộp đến bứt rứt, khác hẳn với cảm giác khi hạ lệnh khai hỏa ở mặt trận phía đông. Nhưng anh đã đưa ra quyết định của mình. Đã đến lúc hành động.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000481", "translation": "“Các khẩu đội pháo, khai hỏa!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000482", "translation": "Anh đã dặn họ mọi điều cần nói. Đối với một cỗ máy chiến tranh vận hành chính xác, mệnh lệnh của anh thế là đã quá đủ. Mọi thứ diễn ra hết sức trơn tru.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000483", "translation": "“Rõ, thưa Đại úy! Bắt đầu bắn!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000484", "translation": "Kampfgruppe Lergen—tức Kampfgruppe Salamander—đã được huấn luyện vô cùng bài bản. Những người lính này có thể xem là lực lượng tinh nhuệ; mỗi khi chấp hành mệnh lệnh, họ liền chuyển sang một trạng thái hoàn toàn khác. Nói cách khác, mọi sự do dự mà họ có thể còn vương vấn mới vài giây trước đó đều bị đốt sạch làm nhiên liệu.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000485", "translation": "Một khi cấp trên đã phán đoán những con tàu đó là quân địch, thì chẳng còn lý do hợp lý nào để họ phải ôm giữ mối hoài nghi nữa. Khi lập tức thi hành mệnh lệnh, sự do dự sẽ chỉ tổ ngáng đường, nên nó đã bị gạt bỏ hoàn toàn.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000486", "translation": "Nhiệm vụ của những pháo thủ đã trải qua lễ rửa tội bằng thử thách sắt thép ở mặt trận phía đông vô cùng đơn giản và rõ ràng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000487", "translation": "Họ được lệnh bắn.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000488", "translation": "Thế là họ bắn.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000489", "translation": "Nhanh nhất có thể và với độ chính xác vô song.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000490", "translation": "Đối với những người lính pháo binh đã đạt tới đỉnh cao của xạ thuật, mọi suy tính thêm nữa đều hoàn toàn vô nghĩa.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000491", "translation": "Nếu có điều gì đe dọa làm chậm thao tác của họ, thì đó chỉ có thể là tốc độ hoặc độ chính xác. Nhưng chẳng có quy tắc nào cấm họ tham lam cả hai thứ đó.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000492", "translation": "Meybert coi việc đòi hỏi cấp dưới phải bền bỉ theo đuổi cả hai yếu tố ấy là điều hiển nhiên. Và cấp dưới của anh cũng coi yêu cầu đó là chuyện đương nhiên.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000493", "translation": "Thế là, cùng với lời cầu nguyện mong sao mọi sự đều diễn ra đúng như ý muốn, tiếng đại bác của pháo binh vang vọng khắp bến cảng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000494", "translation": "Một tiếng gầm của sắt thép.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000495", "translation": "Những dư chấn ngân dài làm rung chuyển bầu không khí theo sau âm thanh đinh tai nhức óc—đó mới chính là thứ mà các pháo thủ thực sự khao khát.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000496", "translation": "Và họ hoàn toàn có quyền tự hào về kết quả mình đạt được.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000497", "translation": "Kỹ năng điều khiển các khẩu pháo bờ biển điêu luyện của họ đã tạo ra một phát bắn sượt sát sạt ngay từ phát đạn đầu tiên.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000498", "translation": "Một cột nước khổng lồ dựng đứng lên ngay sát những con tàu đang tiến lại gần. Quá gần để nói là bắn trượt nhưng lại quá xa để bảo là đã bắn trúng; sự cân bằng ở đó vô cùng tinh tế.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000499", "translation": "Xét đến việc họ đã khai hỏa ngay tức khắc, phát bắn ấy gần như hoàn hảo.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000500", "translation": "Nếu đã quen thuộc với những đặc tính riêng của mấy khẩu pháo này, hẳn cột nước đã bùng lên gần hơn một chút nữa và thực sự khiến những con tàu khả nghi kia phải rúng động.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000501", "translation": "“Phát bắn hiệu chỉnh trông ổn đấy. Tốt lắm, tiếp tục theo dõi và chuẩn bị bắn tiêu diệ— À, khoan đã, đây là pháo bờ biển mà. Ngừng bắn. Chỉ cần giám sát chặt chẽ những con tàu chưa rõ danh tính đó thôi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000502", "translation": "*Họ đã làm rất tốt.* Meybert đầy tự hào về đội của mình khi cầm ống nhòm lên.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000503", "translation": "*Giờ chỉ còn việc chờ xem kết quả ra sao. Nếu chúng là quân địch thì sẽ phản ứng thế nào đây? Không, nhỡ đâu có khả năng hy hữu chúng là quân mình, liệu chúng ta có nhận được một bức điện tín thịnh nộ không? Hay một thông báo khẩn cấp phát toàn mạng? Hay cờ tín hiệu?*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000504", "translation": "Chuông điện thoại đột ngột reo vang.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000505", "translation": "Anh giật mình ngẩng phắt lên cùng một mối nghi hoặc trong lòng. Vẫn còn quá sớm để có phản ứng đáp lại loạt pháo vừa rồi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000506", "translation": "“Vâng, tôi là Đại úy Meybert bên pháo binh đây.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000507", "translation": "“Đại úy Meybert! Anh có biết mình đang làm cái gì không hả?! Dừng lại ngay lập tức! Anh có nghe thấy tôi nói không đấy?!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000508", "translation": "Đó là Trung tá Paul đang gào lên hết cỡ. Hẳn ông ta đang căng thẳng tột độ. Vẻ điềm tĩnh và tự tin mà ông ta duy trì cho tới tận vừa rồi đã hoàn toàn tan biến.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
