{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000073", "translation": "Một khả năng kinh hoàng. Ý nghĩ quá đỗi hợp lý ấy khiến một cơn ớn lạnh không tài nào chịu nổi chạy dọc sống lưng Tanya. Tình hình này quá nghiêm trọng để có thể cười xòa cho qua.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000074", "translation": "Không có tân binh mới.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000075", "translation": "Không có sinh viên mới tốt nghiệp.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000076", "translation": "Cảnh này chẳng khác nào một công ty không còn khả năng tuyển dụng đám trẻ vừa ra trường đại học vậy!", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000077", "translation": "Việc chúng ta phá sản chỉ còn là vấn đề thời gian. Nếu chuyện này xảy ra với kẻ khác, ý nghĩ đầu tiên nảy ra trong đầu mình sẽ là đây là cơ hội tuyệt vời để săn trộm vài nhân sự tài năng. Một ý nghĩ nực cười. Nhưng vì chuyện đó đang giáng xuống đầu mình, nên chẳng có gì đáng cười ở đây cả.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000078", "translation": "Như muốn xua tan bầu không khí ngượng ngập, Lergen lắc đầu rồi nghiêng người lại gần hơn. “Còn một điều cuối cùng, chuyện này vẫn chưa được quyết định chính thức đâu, nhưng tôi nghĩ mình nên báo trước cho cô biết.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000079", "translation": "“Chuyện gì vậy ạ, thưa Đại tá?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000080", "translation": "Nếu đó là điều có thể bù đắp cho tất cả những tin tức tồi tệ vừa rồi, thì biết đâu anh ta đã tìm ra giải pháp chăng…? Hai nắm tay Tanya siết chặt khi cô lắng nghe với vẻ điềm tĩnh giả tạo.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000081", "translation": "“…Tôi chỉ đang thăm dò ý cô thôi. Nên có lẽ cô hãy chuẩn bị tinh thần đi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000082", "translation": "Giọng Lergen rõ ràng là vô cùng u ám. Mọi tia hy vọng mà mình vừa bấu víu vào lập tức sụp đổ tan tành, và mình nhanh chóng điều chỉnh lại kỳ vọng của bản thân.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000083", "translation": "Chắc hẳn lại là tin xấu rồi. Điều kỳ lạ là quân đội chưa từng một lần bận tâm đến hoàn cảnh của Tanya khi quẳng những nhiệm vụ bất khả thi vào tay cô. Sao tự dưng bây giờ họ lại quan tâm đến suy nghĩ của cô cơ chứ?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000084", "translation": "Làm ra vẻ đây chỉ là một cuộc trò chuyện riêng tư và chẳng hề hay biết mình đang khơi dậy nỗi kinh hoàng nhường nào, Lergen vẫn nói tiếp.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000085", "translation": "“Tôi đã rào trước đến mức này rồi, nhưng quả thực vẫn thấy rất đắn đo. Cô ghé tai lại đây.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000086", "translation": "Do chênh lệch chiều cao, anh gần như phải ngồi xổm xuống khi nói câu này. Cảnh tượng đó trông có lẽ hơi dễ gây dị nghị một chút, nhưng… thôi kệ vậy.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000087", "translation": "Tanya lặng lẽ làm theo và nghiêng người lại gần hơn.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000088", "translation": "“Chúng tôi có thể sẽ giao cho cô nhiệm vụ ném bom thủ đô.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000089", "translation": "“…Ý ngài là một cuộc tấn công trực diện vào Londinium sao ạ?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000090", "translation": "À ra thế. Đó *đúng là* một chuyện hệ trọng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000091", "translation": "Đó là một nhiệm vụ tối quan trọng đòi hỏi sự bảo mật tuyệt đối, và chúng ta sẽ phải chuẩn bị tinh thần chấp nhận hy sinh. Nếu họ kỳ vọng chúng ta đạt được kết quả tương tự như đợt tập kích vào Moskva, thì họ cần phải nhận ra rằng tình thế đã thay đổi kể từ đầu cuộc chiến rồi…", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000092", "translation": "“Trung tá, ý tôi không phải vậy.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000093", "translation": "“Vậy thì… ở đâu ạ? Lại là Moskva sao?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000094", "translation": "Xét đến sức kháng cự điên cuồng từ lũ Cộng sản… mình thực sự nghi ngờ khả năng thành công của chuyện đó. Chẳng trách một chút hoài nghi lại buột ra trong giọng nói của Tanya. Nhưng xem ra, theo lời Lergen thì ngay cả cái nhìn bi quan ấy vẫn còn là quá lạc quan.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000095", "translation": "“Không, Trung tá Degurechaff.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000096", "translation": "Lergen đặt một bàn tay lên vai Tanya. Nếu không phải do mình tưởng tượng ra, thì người đàn ông này đang run rẩy. Rất khẽ thôi nhưng rõ ràng là đang run rẩy.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000097", "translation": "“Mục tiêu là… ở đây.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000098", "translation": "“Ở đây ạ?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000099", "translation": "Anh hạ thấp giọng, ngập ngừng dè chừng xung quanh, rồi cuối cùng chỉ tay xuống mặt đất và nhắc lại lời mình. “Ở đây. Ngoài chỗ này ra thì còn ở đâu được nữa? Tôi đang nói đến Berun. Đế đô Berun. Cụ thể là chúng tôi muốn cô thực hiện một đợt tập kích ban đêm vào Bộ Tư lệnh Tối cao.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000100", "translation": "“…Hả?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000101", "translation": "Có vẻ như khi con người nạp dữ liệu không thể tính toán nổi vào đầu, họ sẽ đứng hình.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000102", "translation": "Một mệnh lệnh ném bom chẳng phải điều gì xa lạ đối với Tanya. Tấn công mục tiêu vào ban đêm cũng là một yêu cầu khá đơn giản. Chắc chắn rồi, mình không phản đối chuyện đó.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000103", "translation": "Là một quân nhân chuyên nghiệp trong Lục quân Đế quốc, Trung tá Tanya von Degurechaff tự hào vì đã đích thân dẫn dắt một tiểu đoàn pháp sư trên không thực hiện không ít đợt tập kích ném bom hoàn hảo.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000104", "translation": "Dù nói là vậy!", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000105", "translation": "*Berun ư?!*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000106", "translation": "Một mệnh lệnh ném bom Berun ư?!", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000107", "translation": "Chuyện hai người vẫn đang ở nơi công cộng đã hoàn toàn bay biến khỏi tâm trí mình. Khi Tanya đáp lại, câu nói ấy gần như là một tiếng hét.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000108", "translation": "“Nh-nhưng đây là đế đô mà…?!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000109", "translation": "Dù đã dốc hết sức để kìm nén, giọng cô vẫn run rẩy. Vẫn đang ngồi xổm nhưng tránh né ánh mắt cô, bản thân Lergen trông cũng chẳng mấy bình tĩnh.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000110", "translation": "Sau một hơi thở sâu, anh mới thốt nên lời: “Chúng ta cần phải thức tỉnh đám chính khách. Chúng tôi sẽ không yêu cầu cô thực sự thả bom xuống đầu họ đâu. Bộ Tổng tham mưu chỉ đang rất muốn có một cuộc diễn tập nhằm gia tăng sức ép mà thôi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000111", "translation": "Anh vội vã bồi thêm lời giải thích về những… kỳ vọng của họ. Nhưng cho dù họ có cố ngụy biện rằng đó chỉ là một cuộc diễn tập đi chăng nữa, thì sức thuyết phục của cái cớ ấy cũng có giới hạn thôi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000112", "translation": "“Xin thứ lỗi, thưa Đại tá.” Tanya phải vất vả lắm mới giữ cho giọng mình không run lên. “Ngài muốn chúng tôi sắm cái vai kỳ quặc là một toán quân địch giả định nào đó sao ạ?” Dù có nhìn nhận theo cách nào đi nữa, chuyện này chỉ còn cách một cuộc đảo chính quân sự đúng một bước chân. Thực sự đấy, chỉ cần có bất kỳ sai sót nào xảy ra, nó hoàn toàn có thể châm ngòi cho một cuộc đảo chính thật sự. “Chúng tôi tuyệt đối không đời nào có thể nhắm mục tiêu vào Bộ Tư lệnh Tối cao được…”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000113", "translation": "“Nếu định tấn công thủ đô của Khối Thịnh vượng chung, đó chẳng phải là nơi chúng ta sẽ đánh vào hay sao? Cùng một logic cả thôi. Chúng ta cần một lý do để cả bên tấn công lẫn bên phòng thủ đều phải làm thật nghiêm túc.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000114", "translation": "“Vậy là chúng ta sẽ gây ra một sự hiểu lầm sao ạ?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000115", "translation": "“Chúng tôi đang thu xếp để quy việc đó thành sự cố truyền đạt thông tin. Bộ Tổng tham mưu đã cảnh báo hết lần này đến lần khác rằng lưới phòng không của thủ đô còn lâu mới kín kẽ, nên chúng tôi quyết định tổ chức một cuộc diễn tập để chứng minh, nhưng do sai sót trong khâu truyền đạt thông tin nên còi báo động mới rú lên. Ý tưởng là như vậy đấy.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000116", "translation": "Đó là một câu chuyện bình phong khá hợp lý. Vậy là họ sẽ kéo còi báo động ngay giữa màn hài kịch xen giữa của chúng ta. Nhưng liệu Bộ Tư lệnh Tối cao có thực sự mắc lừa không đây?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000117", "translation": "Chuyện này nghe cứ như một trò điên rồ vậy.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000118", "translation": "Có ai lại tự dưng tình nguyện gia nhập một đơn vị đảo chính cơ chứ? Chỉ cần sẩy chân một bước thôi là chúng ta sẽ phải ra tòa án quân sự với tội danh phản quốc ngay.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000119", "translation": "Tanya không thể gật đầu đồng ý với chuyện này, kể cả là để tỏ ra lịch sự xã giao đi chăng nữa.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
