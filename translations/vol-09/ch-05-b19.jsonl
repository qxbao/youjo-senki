{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000645", "translation": "“Quân tiếp viện! Cho bọn biệt kích ư?! Quân mình đang làm cái quái gì thế hả?!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000646", "translation": "“Cứu với! Là quân địch! Quân địch đang—!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000647", "translation": "“Dừng lại! Ngừng bắn ngay! Bắn trúng quân mình bây giờ!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000648", "translation": "“Chúng đang bắn về phía chúng ta! Chúng là quân địch đấy!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000649", "translation": "“Có cháy! Mau dập lửa đi!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000650", "translation": "“Ưu tiên tiêu diệt quân địch trước!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000651", "translation": "Một cảnh hỗn loạn không sao nắm bắt nổi. Hoặc có lẽ đây chính là kiểu hỗn loạn ngay trước khi vỡ trận. Ai nấy chỉ biết gào lên bất cứ điều gì nảy ra đầu tiên trong đầu. Mọi giọng nói vang lên trên kênh liên lạc đều cho thấy tình hình chẳng còn chút trật tự nào.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000652", "translation": "Đúng lúc anh đang băn khoăn chưa biết phải làm gì thì đường dây nối trực tiếp với Tospan đổ hồi chuông chói tai. *Đúng lúc lắm.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000653", "translation": "“Trung úy Tospan, chúng đang chọc thủng tuyến phòng thủ. Cứ đà này thì—”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000654", "translation": "“Đại úy! Không ổn rồi ạ! Chúng tôi sẽ không tới kịp mất!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000655", "translation": "“Cái gì?! Tại sao lại không kịp?” Chân mày anh chực nhíu lại—*Sao các cậu lại không tới kịp được cơ chứ?*—nhưng rồi anh chỉ biết chết sững vì sửng sốt.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000656", "translation": "“Chúng tôi đang bị bắn! Từ một chốt của quân mình!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000657", "translation": "“Ôi, mẹ kiếp thật chứ!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000658", "translation": "Lẽ *dĩ nhiên* là chuyện đó cứ phải xảy ra vào lúc này rồi. Hay là nó *chỉ* có thể xảy ra vào lúc này thôi? Đám lính gần như chẳng có chút kinh nghiệm thực chiến này đang hoảng loạn thực sự.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000659", "translation": "Tới nước này, có lẽ họ đang khiếp sợ bất cứ thứ gì nhúc nhích và cứ thấy bóng dáng nào là đinh ninh ngay đó là quân địch. Mà anh cũng chẳng thể trông mong các sĩ quan hay hạ sĩ quan kiểm soát được tình hình nếu bản thân họ cũng thiếu kinh nghiệm.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000660", "translation": "Thành ra không những khắp nơi đều rối loạn cả lên, mà ngay cả bản thân anh cũng chẳng chắc mình có thể liên lạc được với bất kỳ ai hay không.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000661", "translation": "Khi định nổ súng vào quân địch thì họ bị cản lại; khi định chặn đứng quân địch thì họ lại bị bắn. Loại chuyện thế này ở mặt trận phía đông có nằm mơ cũng chẳng thể nào tưởng tượng ra nổi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000662", "translation": "“Cuộc đời đúng là đầy rẫy những điều bất ngờ.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000663", "translation": "Anh chỉ còn biết càu nhàu như vậy. *Mấy gã bù nhìn khốn kiếp này hoàn toàn chẳng biết mình phải làm gì cả!*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000664", "translation": "*Rốt cuộc họ nghĩ chiến tranh là cái gì chứ? Phải bổ sung thêm một phụ lục vào quy chế mới được. Ừ, xem chừng cuốn sổ tay hướng dẫn cần phải quy định rõ rằng phải nhìn nhận chiến tranh một cách nghiêm túc.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000665", "translation": "“Trung úy, trước mắt hãy tập trung làm cho chốt của quân mình ngừng bắn đi đã. Cậu không liên lạc được với họ sao?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000666", "translation": "Giá như đó là chốt của địch thì họ đã có thể tùy ý nã đạn khói hay đạn xuyên giáp tới tấp rồi, đằng này người của phe mình lại đang ở dưới đó. Họ không thể nổ súng để chế áp riêng mỗi quân địch được.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000667", "translation": "*Lũ ngu xuẩn này!*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000668", "translation": "“Chúng tôi đang cố đây ạ, nhưng cờ hiệu không ăn thua, mà đèn tín hiệu cũng chẳng có tác dụng. Họ cứ— Aaaa, chết tiệt!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000669", "translation": "“Chuyện gì thế?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000670", "translation": "“Quân tiếp viện của địch! Lại có thêm quân kéo tới trên cầu cảng! Chúng vẫn đang tiếp tục đổ bộ lên bờ!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000671", "translation": "Tospan hét lên rằng địch lại đang kéo tới thêm. Cứ đà này thì không tài nào ghìm chân đám biệt kích địch ngay tại đầu cầu đổ bộ của chúng được nữa.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000672", "translation": "Phía Đế quốc đang lâm vào cảnh hỗn loạn. Trong khi đó, quân địch lại phối hợp vô cùng ăn ý. Chẳng ai muốn phải giao chiến với một lực lượng bộ binh có khả năng tự đưa ra quyết định ngay ở cấp tiểu đội để thực hiện nhiệm vụ mà không cần các sĩ quan phải thúc giục.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000673", "translation": "“Nhưng chúng ta nắm ưu thế áp đảo tuyệt đối về quân số. Bình tĩnh lại đi, Trung úy Tospan!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000674", "translation": "“…Xin lỗi Đại úy.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000675", "translation": "Chừng nào bên tấn công không thể lấy số lượng áp đảo bên phòng ngự, phía Đế quốc sẽ vẫn nắm lợi thế. Chỉ cần có đủ thời gian, cục diện sẽ xoay chuyển theo hướng có lợi cho họ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000676", "translation": "Ngay cả quân địch hẳn cũng phải nhận thức rõ điều đó.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000677", "translation": "“Chúng chỉ có một nhúm người thôi, đúng không?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000678", "translation": "“Kể cả khi tính thêm quân tiếp viện thì căng lắm chúng cũng chỉ có một tiểu đoàn là cùng. Quân số chẳng đông đến thế đâu ạ.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000679", "translation": "Nhận được báo cáo của Tospan, Meybert gật đầu ở đầu dây bên kia. “Chắc chúng là một đội tập kích mang nhiệm vụ phá hoại gì đó. Chúng không hề có ý định đánh chiếm và giữ đất… Chà, dù chỉ một trung đội thôi cũng sẽ… hửm?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000680", "translation": "Meybert chợt khựng lời, để đầu óc mình suy tính đôi chút.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000681", "translation": "Cho dù mục tiêu của chúng là phá hoại thì đây vẫn là một cuộc đột kích. Nếu tấn công vào trận địa mà thất bại, chúng sẽ rút lui. Ở mặt trận phía đông mọi chuyện vốn luôn diễn ra như vậy.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000682", "translation": "Nhưng đây lại là biển. Trong trường hợp đó, đường rút chạy của chúng sẽ là mấy chiếc xuồng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000683", "translation": "*Thay vì cố tìm cách chiếm lấy những con tàu dọc cầu cảng, chẳng phải cứ phá hủy quách chúng đi sẽ tốt hơn sao? Đằng nào thì kẻ địch của chúng ta cũng đâu phải hạng ngu xuẩn đến mức bỏ lại khóa giải mã mật mã của chúng trên xuồng.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000684", "translation": "Nhưng đó là một canh bạc lớn.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000685", "translation": "*Chỉ mang mỗi bộ binh mà dám xông vào đây thì cũng gan thật đấy. Hẳn chúng phải cực kỳ tự tin vào kế hoạch của mình, bao gồm cả phương án rút quân nào đó mà chúng có; bằng không thì hành động này chỉ tổ liều mạng mà thôi.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000686", "translation": "“Chúng đang giấu giếm thứ gì đó ư? Hay có khi nào… Không xong rồi!” Sự nhận thức chợt lóe lên khiến anh hét lớn. “Trung úy Tospan! Quay lại ngay lập tức!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000687", "translation": "“Cái gì ạ? Chúng tôi không cần đánh chặn nữa sao?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000688", "translation": "Anh đã phản ứng chậm mất một nhịp.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000689", "translation": "Sốt ruột đến mức chẳng kịp dành lấy một giây để giải thích, Meybert gào lên: “Không có gì đảm bảo chúng chỉ toàn là bộ binh đâu!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000690", "translation": "Thật là một sai lầm khủng khiếp. Anh đã quên bẵng đi khả năng có pháp sư. Làm gì có chuyện những kẻ đang bay trên mặt nước kia là toàn bộ số pháp sư mà chúng có chứ!", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000691", "translation": "Khi nhớ lại Soldim 528, điều đó mới hiển nhiên làm sao!", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000692", "translation": "*Dùng một bộ phận pháp sư làm mồi nhử để thu hút sự chú ý của địch. Khiến chúng tưởng rằng đó là toàn bộ số pháp sư mà mình có, kéo sự cảnh giác của chúng sang một hướng khác, rồi chờ đúng thời cơ giáng một đòn sấm sét từ bên sườn vào lũ ngốc đang mất cảnh giác.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000693", "translation": "Chính là mánh khóe từng mang lại hiệu quả mỹ mãn cho họ!", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000694", "translation": "“Hãy nhớ lại mặt trận phía đông đi! Kiểm tra toán biệt kích đó ngay! Trung tá chắc chắn sẽ—!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000695", "translation": "Trước khi anh kịp thốt ra cụm từ *trà trộn các pháp sư vào đó*, một báo cáo đã cắt ngang lời anh.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
