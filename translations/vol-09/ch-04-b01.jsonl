{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000001", "translation": "NGÀY 15 THÁNG 7 NĂM THỐNG NHẤT 1927, MẶT TRẬN NỘI HẢI", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000002", "translation": "Hiện tại, các tàu ngầm của Đế quốc thường hoạt động theo bầy.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000003", "translation": "Hai chiếc tàu ngầm tốt hơn một chiếc. Ba chiếc lại tốt hơn hai chiếc. Cốt lõi nằm ở ưu thế số lượng. Chiến thuật bầy sói này vốn được phát triển để đánh chặn tàu buôn, nhưng vẫn phát huy tác dụng rất tốt khi đối phó với thiết giáp hạm.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000004", "translation": "Khi có báo cáo phát hiện mục tiêu, cuộc săn đuổi liền bắt đầu.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000005", "translation": "Hải đội đã tiếp cận mục tiêu thành công.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000006", "translation": "“Có điện từ tàu bạn trong hải đội. Đã phát hiện tàu địch!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000007", "translation": "“Bắt được tín hiệu trên sonar rồi!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000008", "translation": "“Nguồn phát ra âm thanh là gì?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000009", "translation": "“Chắc chắn là chân vịt tàu địch.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000010", "translation": "“…Tiếng lớn quá. Đây là… Khoan đã. Không chỉ có một chiếc… Tàu thuộc lớp nào thế này? Khó phân biệt quá. Nhưng đó chắc chắn là một đoàn tàu có hộ tống.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000011", "translation": "“Chuẩn bị phóng ngư lôi! Đừng để tụt lại phía sau các tàu khác!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000012", "translation": "Mọi người trong phòng điều khiển đều tập trung cao độ và hết sức cảnh giác.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000013", "translation": "Từ Thuyền trưởng Barchet trở xuống, toàn bộ thủy thủ đoàn đều đang làm việc vô cùng ấn tượng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000014", "translation": "Ngay cả Tanya, người chỉ ngồi dự thính cho có lệ, cũng nhận ra những người lính tàu ngầm này hết sức nhạy bén.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000015", "translation": "Một lát sau, hẳn công việc đã tạm ổn thỏa. Barchet tiến lại gần và giải thích ngắn gọn. Rồi ông ngập ngừng nói thêm một câu.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000016", "translation": "“Trung tá Degurechaff này, ờm… mặt trời sắp lặn rồi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000017", "translation": "“Ngay trước lúc hoàng hôn—theo tôi thì đó là thời điểm hoàn hảo để tấn công đấy.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000018", "translation": "“Thông thường thì đúng là vậy. Nhưng”—ông có vẻ đang suy tính rồi nói ra mối băn khoăn của mình—“do đặc tính của V-2, tầm nhìn hạn chế vào lúc chập choạng tối hoàn toàn không mấy lý tưởng. Chúng ta có nên tránh giao chiến không?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000019", "translation": "Ông ấy nói có lý.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000020", "translation": "Mặt khác, đó cũng chỉ là một khía cạnh mà thôi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000021", "translation": "“Vấn đề ngài nêu ra rất xác đáng, nhưng biển cả mênh mông lắm. Nếu chúng ta rút lui bây giờ thì chẳng có gì đảm bảo sẽ tiếp cận lại được mục tiêu. Trái lại, tôi hình dung việc đó sẽ khá khó khăn đấy.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000022", "translation": "“Đó là phần việc của chúng tôi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000023", "translation": "Không có ý xúc phạm vị thuyền trưởng đang bảo rằng bọn mình cứ yên tâm trông cậy vào ông ấy đâu, nhưng mình chẳng phải hạng gà mờ trên cạn hoàn toàn mù tịt về cách thức hoạt động của tàu ngầm.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000024", "translation": "“Tôi đang nói dựa trên kinh nghiệm đấy.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000025", "translation": "“Ồ?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000026", "translation": "“Vâng.” Tanya gật đầu. “Chỉ một chút thôi. Gần đây nhất là ở ngoài khơi bờ biển Norden.” Sau lời rào đón lịch sự rằng sự cân nhắc của vị thuyền trưởng rất đáng trân trọng, hai bên đi thẳng vào vấn đề chính. “Tốc độ di chuyển dưới mặt nước của tàu ngầm có giới hạn. Tôi biết yêu cầu thế này là đòi hỏi nhiều, nhưng tôi muốn ngài cứ tiếp tục đẩy mạnh đợt tấn công.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000027", "translation": "“Xin đừng nói như thể chúng tôi là loài rùa chậm chạp vậy chứ.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000028", "translation": "“Tôi không có ý chê trách ngài hay thủy thủ đoàn. Tôi chỉ đang nêu ra thực tế thôi. Vấn đề về độ cơ động không phải… chuyện có thể giải quyết bằng cách nỗ lực hết sức.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000029", "translation": "Khi nó hỏi liệu mình nói vậy có sai không, vị thuyền trưởng thoáng nhăn mặt. Hẳn ông không ngờ mình lại phải nghe thuyết giảng về chiến thuật tàu ngầm từ một người mà ông vốn đinh ninh chỉ là một sĩ quan ma pháp đơn thuần.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000030", "translation": "Mà quả thật họ cũng là dân chuyên nghiệp.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000031", "translation": "Mình hiểu cái kiểu nói chuyện ra vẻ biết tuốt là chẳng lịch sự chút nào. Nhưng sự cấp thiết vốn là mẹ đẻ của phát minh, là người bảo trợ cho sự đổi mới bắt buộc, và suy cho cùng, chính là cái thứ cực kỳ gai góc mang tên mệnh lệnh từ sĩ quan cấp trên.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000032", "translation": "“Đằng nào thì chúng ta cũng phải thực hiện thôi. Và ngay lúc này, cơ hội đang ở ngay trước mắt.” Tanya nhếch mép cười. “Chẳng có gì đảm bảo Nữ thần May mắn sẽ để yên cho chúng ta túm tóc bà ta từ phía sau đâu. Vậy nên chúng ta cứ táng thẳng vào mặt bà ta rồi vơ lấy bất cứ thứ gì nắm được trong lúc còn cơ hội. Ngài có đồng ý không, Thuyền trưởng?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000033", "translation": "“Đúng như lời cô nói. Dù phải trả bất cứ giá nào… chúng ta cũng phải đưa Quân đoàn Viễn chinh Lục địa Phía nam trở về nhà an toàn.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000034", "translation": "Tạm biệt Barchet cùng quyết tâm vừa được củng cố của ông, Tanya buông một tiếng thở dài ngao ngán khi quay lại chỗ Trung úy Serebryakov, người cũng đi theo trong chuyến này.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000035", "translation": "“Có tin tức gì mới không, thưa Trung tá?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000036", "translation": "“Chuẩn bị xuất kích đi, Trung úy. Đến giờ cho tiết mục chính của mọi chiến dịch tàu ngầm rồi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000037", "translation": "Binh lính trên các tàu ngầm khác hẳn cũng đang cảm thấy căng thẳng. *Và đó là lý do…* Nó cười khẽ. “Đừng lo. Lần này sẽ không xóc nảy dữ dội như hồi dùng mẫu V-1 đâu. Chúng ta sẽ có thể điều khiển hướng đi đôi chút.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000038", "translation": "Giữa những tiếng cười ồn ào, Tanya quay về phía một người lính liên lạc đang chạy tới.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
