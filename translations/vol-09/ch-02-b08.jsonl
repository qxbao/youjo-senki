{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000279", "translation": "Ngày nào Drake và binh lính dưới quyền cũng xuất kích để yểm trợ cho cuộc tổng tiến quân. Nhiệm vụ chính của họ là tìm và diệt. Dù đã tản rộng đội hình để bao quát diện tích tối đa trong mỗi đợt xuất kích, các cuộc chạm trán vẫn chỉ diễn ra lẻ tẻ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000280", "translation": "Ông chỉ có thể kết luận rằng lực lượng mặt đất của Đế quốc đang nhường lại đất đai với sự thực dụng đến rợn người và vội vã rút lui.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000281", "translation": "Những báo cáo hiếm hoi gửi về đều xoay quanh các cuộc tiếp xúc với thứ có vẻ là máy bay trinh sát hoặc pháp sư trên không của Đế quốc.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000282", "translation": "“Tiền tuyến đang dịch chuyển nhanh hơn tôi tưởng.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000283", "translation": "Con mồi ít ỏi đến mức họ thường xuyên phải quay về tay trắng sau các đợt xuất kích.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000284", "translation": "*Đó là chuyện tốt mà*, ông vừa nghĩ thầm vừa tập hợp đại đội dưới quyền chỉ huy trực tiếp của mình, nhưng khi đáp xuống đất, ông liền bắt gặp hai gương mặt quen thuộc.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000285", "translation": "Đại tá Mikel và Trung úy Liliya Ivanova Tanechka đang đứng cạnh nhau, chiều cao chênh lệch khiến họ trông như một cặp đôi kỳ quặc. Một người là chiến hữu thân thiết của ông, còn người kia là một viên sĩ quan chính trị phiền phức.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000286", "translation": "Tạm gác người trước sang một bên, nếu kẻ sau có mặt ở đây để “đón” ông, ông chỉ có thể đoán rằng rắc rối đang chờ phía trước.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000287", "translation": "Rốt cuộc họ muốn gì ở ông đây?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000288", "translation": "“Trung tá Drake, ngài có rảnh một chút không?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000289", "translation": "Đúng như dự đoán, kẻ lên tiếng bắt chuyện với ông chính là con chó săn Cộng sản kia. Ông không tài nào chịu nổi việc phải nói chuyện với các sĩ quan chính trị.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000290", "translation": "Nếu có ai hỏi, hẳn Drake sẽ trả lời rằng trên đời này hầu như chẳng có thứ gì tồi tệ hơn thế. Trò chuyện với một con vẹt có lẽ còn bổ ích hơn.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000291", "translation": "“Vâng. Là việc của Đại tá Mikel hay của chính cô?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000292", "translation": "“Đồng chí Đại tá muốn trao đổi với ngài về tình hình chiến sự.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000293", "translation": "“Ồ, vậy là việc của Đại tá Mikel sao!” Lộ rõ vẻ mỉa mai, ông quay sang nhìn người phiên dịch, Tanechka. “Rốt cuộc vị đại tá muốn trao đổi với tôi về chuyện gì thế, Trung úy?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000294", "translation": "Thông thường, chỉ cần Drake và Mikel tự thảo luận với nhau là đủ—hoàn toàn chẳng cần Tanechka phải giải thích từng li từng tí cho Mikel bằng ngôn ngữ của Liên bang.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000295", "translation": "Viên trung úy này, vốn là một sĩ quan chính trị, có mặt ở đây chỉ để bảo đảm lợi ích của Đảng Cộng sản dưới vỏ bọc phiên dịch.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000296", "translation": "*Xem ra mình đành phải vờ quên đi sự thật rằng người bạn Đại tá Mikel của mình vốn thông thạo ngôn ngữ của Khối Thịnh vượng chung vậy.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000297", "translation": "*Mình đoán điều quan trọng của một vở kịch là nó phải được diễn tiếp đến cùng.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000298", "translation": "Đó hoàn toàn là một trò hề, nhưng hai diễn viên, Mikel và Drake, lại hết sức nghiêm túc. Khán giả của họ có thể chỉ là một viên sĩ quan chính trị duy nhất, nhưng khi tính mạng của Mikel cùng nhiều thứ khác nữa đều phụ thuộc vào việc họ diễn khéo đến đâu, Drake không được phép lơ là.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000299", "translation": "“Các trận không chiến ma pháp đang diễn ra thuận lợi. Khi quân ta tiến lên, tiền tuyến sẽ tiếp tục đẩy về phía trước. Vào thời điểm này, tôi muốn cân nhắc một chiến dịch mới.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000300", "translation": "“Một chiến dịch mới ngay lúc này ư?! Cô nhớ nói lại với ông ấy rằng: *Binh lính của Liên bang thật tràn đầy sức sống và đó quả là một điều tuyệt vời*, được chứ?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000301", "translation": "Khi ông nhìn chằm chằm vào cô ta, viên trung úy có vẻ ngập ngừng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000302", "translation": "*Ồ, ra vậy.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000303", "translation": "“Và vị đại tá trả lời thế nào?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000304", "translation": "“Ừmmm, xin thứ lỗi, nhưng ngài có thể nhắc lại những gì vừa nói được không?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000305", "translation": "“À, xin lỗi nhé, Trung úy Tanechka. Chắc là tôi nói hơi nhanh quá nhỉ?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000306", "translation": "Một cú châm chọc nho nhỏ đầy mỉa mai.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000307", "translation": "Chỉ là chút khiêu khích nhằm kìm bớt thái độ của cô ta.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000308", "translation": "Viên sĩ quan chính trị nói gì đó với Mikel, và ngay khi Mikel gật đầu vài cái, Drake liền chớp thời cơ đẩy trò nghịch ngợm trẻ con của mình đi xa hơn.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000309", "translation": "“Nhân tiện, chẳng lẽ chúng ta không nhận được chút quân tiếp viện nào từ phía nam sao? Mở một chiến dịch mới thì tốt thôi, nhưng chúng ta không thể làm ngơ trước vấn đề nhân lực được.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000310", "translation": "“Theo thông báo của Đảng, tình hình ở phía nam đang từng bước cải thiện, nhưng vẫn cần phải đề phòng một đợt phản công.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000311", "translation": "Viên sĩ quan chính trị lập tức đáp lời, nhưng cuộc trò chuyện này đáng lẽ phải diễn ra giữa Mikel và Drake, dù chỉ là trên danh nghĩa. Drake liền trút bớt nỗi bực dọc của mình lên Tanechka.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000312", "translation": "“Cảm ơn cô, Trung úy. Nhưng cô chỉ là một trung úy. Chúng ta không được để khoảng cách về cấp bậc trở thành khoảng cách về thông tin. Cô có thể hỏi Đại tá Mikel xem liệu chúng ta có kỳ vọng nhận được quân tiếp viện hay không, cho chắc chắn được chứ?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000313", "translation": "Giống như lần trước, cô ta nói liến thoắng với Mikel rồi cất giọng êm ái rót vào tai Drake một phiên bản đã được thêm thắt dài dòng từ câu trả lời thực dụng của vị đại tá.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000314", "translation": "“Đúng như tôi nghĩ, câu trả lời của đồng chí ấy cũng vậy. Tình hình ở phía nam đang cải thiện, nên đây sẽ là cơ hội tốt nhất để chúng ta nghiền nát lũ đế quốc tà ác kia.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000315", "translation": "“Rất tốt! Vậy chiến dịch mới đó là gì thế?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000316", "translation": "“Đó là một đề xuất được đưa trực tiếp từ Ủy ban Trung ương xuống.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000317", "translation": "“Ồ? Thú vị thật đấy. Là đề xuất kiểu gì vậy? Tôi nóng lòng muốn nghe lắm rồi đây.” Từng lời của Drake gần như nhỏ giọt vẻ khinh miệt ngầm. Phải nói chuyện với lũ chó canh chính trị này đúng là một cực hình—nó chỉ tổ bào mòn phẩm giá và lý trí của ông mà thôi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000318", "translation": "Thế nhưng những lời tiếp theo thốt ra từ miệng cô ta đã lập tức quét sạch những suy nghĩ vẩn vơ đó khỏi tâm trí Drake.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000319", "translation": "“Ban lãnh đạo Đảng đang cân nhắc chiến thuật chặt đầu chỉ huy.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000320", "translation": "*Chặt đầu chỉ huy!*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000321", "translation": "Xem chừng đây là thời điểm hoàn hảo để cho quân địch nếm mùi gậy ông đập lưng ông.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000322", "translation": "Có lẽ đó chính là đại ý của ý tưởng này.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000323", "translation": "“Mục tiêu là gì?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000324", "translation": "“Sở chỉ huy Cụm tập đoàn quân phía Đông. Tôi tin rằng họ đang nhắm vào tham mưu trưởng của địch, Trung tướng von Zettour.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000325", "translation": "“Chẳng phải ông ta là một thanh tra viên chứ không phải tham mưu trưởng sao?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000326", "translation": "“Nhưng theo lời khai từ tù binh, ông ta mới là người thực sự nắm quyền chỉ huy.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000327", "translation": "Drake rất hài lòng khi nhận được một câu trả lời thẳng thắn cho câu hỏi của mình.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000328", "translation": "Nếu có điều gì đáng phàn nàn, thì đó là việc một trung úy quèn, dù có là sĩ quan chính trị đi nữa, lại nắm rõ thông tin hơn cả ông, người chỉ huy lực lượng Khối Thịnh vượng chung.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000329", "translation": "Cứ thế này thì họ sẽ chẳng đi đến đâu được.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
