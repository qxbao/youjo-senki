{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000322", "translation": "Mọi thứ đều ngốn quá nhiều thời gian; anh chẳng tài nào quen nổi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000323", "translation": "Sau khi vắt óc suy nghĩ quá nhiều, anh định bụng nhìn ra biển một lát cho khuây khỏa, nhưng vừa hướng mắt ra xa, anh lại nhận thấy có thứ gì đó kỳ lạ nơi đường chân trời.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000324", "translation": "“Này, cái gì đằng kia thế?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000325", "translation": "Vài chấm nhỏ đang nhấp nhô trên mặt nước.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000326", "translation": "Anh chộp lấy chiếc ống nhòm quen thuộc rồi bật dậy, vừa lao ra cửa sổ vừa cất tiếng gọi người lính cần vụ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000327", "translation": "“Này! Giờ này có đoàn tàu có hộ tống nào đăng ký cập cảng không? Kiểm tra danh sách mau!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000328", "translation": "“Xin chờ một lát, thưa Đại úy. Tôi sẽ—”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000329", "translation": "“Khẩn trương lên!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000330", "translation": "Tuy lớn tiếng giục giã cấp dưới như thế… nhưng cũng chẳng phải vì anh lo lắng đến mức ấy. Đó đơn thuần chỉ là phản xạ có điều kiện nhằm giữ cho đầu óc luôn tỉnh táo và cảnh giác—ít nhất là ở thời điểm này.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000331", "translation": "Dù sao thì các đơn vị thuộc Kampfgruppe Lergen cũng chỉ là người ngoài. Chừng nào chưa có thông báo từ bộ chỉ huy cảng yêu cầu vào vị trí chiến đấu, thì việc họ tự mình cuống cuồng lên cũng chẳng có mấy ý nghĩa.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000332", "translation": "Dẫu vậy… ngay cả khi anh chỉ đơn thuần nhớ nhầm, việc không tài nào nhớ ra nổi bất kỳ lịch trình cập cảng nào vẫn thật kỳ lạ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000333", "translation": "Và chuyện đó lại càng khiến anh bứt rứt hơn bởi anh vừa mới bị phê bình vì thiếu chú ý đến tiểu tiết. Đây là trục trặc trong khâu liên lạc, hay là chuyện bản thân anh đã hoàn toàn quên bẵng đi mất? Nếu là vế sau, đó chẳng qua chỉ là sơ suất cá nhân của anh, nhưng nếu là vế trước thì lại là một vấn đề hệ trọng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000334", "translation": "Dù theo khả năng nào đi nữa, để ngăn vấn đề tái diễn, anh cũng cần phải làm rõ ngọn ngành.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000335", "translation": "“Thưa Đại úy, xin thứ lỗi vì sự chậm trễ. Trong danh sách ở đây có ghi là—”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000336", "translation": "“Cảm ơn, có những tàu nào dự kiến cập bến?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000337", "translation": "“Lạ thật. Danh sách từ bộ chỉ huy chỉ ghi có vài chiếc tàu ngầm…”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000338", "translation": "“Đưa đây xem nào.” Anh giật lấy tập tài liệu từ tay người lính cần vụ, rồi vừa liếc qua đã gắt lên: “Tôi dám chắc mười mươi mấy thứ kia đếch phải tàu ngầm đâu.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000339", "translation": "Đơn vị duy nhất dự kiến tiến vào cảng là một nhóm tàu ngầm. Kèm theo đó là dòng ghi chú nói rằng chúng *có thể* sẽ tới trong trường hợp khẩn cấp. Nếu là tình huống khẩn cấp, anh có thể hình dung ra viễn cảnh đám tàu ngầm ấy chạy nổi trên mặt biển.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000340", "translation": "Nhưng đây rõ ràng là một thứ hoàn toàn khác biệt.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000341", "translation": "“Có tín hiệu gì không?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000342", "translation": "“Không có gì trên sóng vô tuyến cả. Chúng ta có nên phát tín hiệu gọi họ không ạ?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000343", "translation": "“…Đó là việc của bộ chỉ huy. Quan sát thôi là đủ rồi. Cho đơn vị chuẩn bị sẵn sàng cơ động nếu cần.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000344", "translation": "Người lính dưới quyền chào theo điều lệnh rồi bắt tay vào việc. Dõi mắt nhìn anh ta rời đi, Meybert chợt nảy ra một ý nghĩ. Chẳng có lý nào anh lại có thể nhầm lẫn giữa tàu ngầm với bất kỳ loại tàu thuyền nào khác.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000345", "translation": "Tầm nhìn lúc này rất tốt. Không đời nào có chuyện anh nhận diện nhầm hình dáng của chúng. Hơn hết thảy, tàu ngầm vốn đâu có lớn đến mức ấy. Nếu chúng phát tín hiệu nhận dạng thì đã dễ nhận biết hơn, đằng này lại không hề có…", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000346", "translation": "“Ắt hẳn chúng phải là thứ gì khác. Tàu vận tải ư? Chết tiệt, mình vốn chẳng giỏi phân biệt tàu bè hải quân gì cho cam…” Ghé mắt nhìn qua ống nhòm, anh thoáng thấy thứ gì đó trông như cột buồm, rồi khẽ thở dài trước nỗi chật vật khi phải làm một công việc rõ ràng chẳng mấy quen thuộc. “Trông như phía sau cũng có cả tàu vận tải nữa. Quả đúng là trông giống một đoàn tàu có hộ tống thông thường thật. Nhưng… một đoàn tàu có hộ tống ư? Vào lúc này sao?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000347", "translation": "“Ồ, tôi biết rồi. Chẳng phải vị trung tá cùng những người khác đã được cử tới lục địa phía nam sao ạ? Biết đâu đó là đoàn tàu có hộ tống đang rút về từ đằng ấy…” Từ vị trí quan sát bên cạnh, Tospan nêu ra một khả năng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000348", "translation": "“Một đoàn tàu có hộ tống rút về từ lục địa phía nam ư?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000349", "translation": "“Vâng, thưa Đại úy. Nếu đó là tàu quân ta thì chẳng phải cũng có khả năng ấy sao ạ?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000350", "translation": "Viên sĩ quan cấp dưới đưa ra lời giải thích, nhưng Meybert chỉ lắc đầu; anh chẳng thấy có lý do gì để mà lạc quan cả.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000351", "translation": "“Mà không hề báo trước sao? Chuyện đó kỳ quặc lắm, Trung úy.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000352", "translation": "“À thì, chúng ta vốn là người ngoài mà…”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000353", "translation": "“Nhưng đây là một đơn vị đồn trú. Lẽ thường thì vẫn phải liên lạc chứ.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000354", "translation": "*Hừm.* Sau một hồi chống tay lên cằm suy nghĩ, anh đưa ra quyết định. Nếu chưa nắm rõ tình hình, anh cần phải hành động với sự cẩn trọng tối đa.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000355", "translation": "Nói cách khác, họ phải chuẩn bị cho chiến tranh.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000356", "translation": "“Trung úy Tospan, phiền cậu huy động cả bên bộ binh nữa. Cho họ vào vị trí đi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000357", "translation": "“Rõ, thưa Đại úy Meybert.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000358", "translation": "“Cảm ơn. Vậy việc đó tôi giao cho cậu nhé.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000359", "translation": "Một câu đáp dứt khoát. Nuốt lại mọi ý kiến phản đối cùng mối hoài nghi, anh ta hiểu rằng mình cần phải thực thi nhiệm vụ. Vững tâm trước chân lý căn bản ấy, Meybert có thể tự tin làm tròn vai trò của mình.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000360", "translation": "Tập hợp các hạ sĩ quan vừa ùa vào văn phòng đúng lúc Tospan rời đi, anh bắt đầu xử lý tình hình với tâm thế sẵn sàng cho khả năng xảy ra giao chiến.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000361", "translation": "“Không có tin gì từ bộ chỉ huy sao? Kiểm tra lại đi. Nhớ hỏi thử cả những nhân sự đang ngoài ca trực nữa. Không, khoan đã. Chúng ta không có thời gian đâu. Đưa tài liệu cho tôi xem nào.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000362", "translation": "“Của ngài đây ạ.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000363", "translation": "“…Vậy là thực sự chẳng có gì cả.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000364", "translation": "Anh không thấy bất kỳ thiếu sót nào trong danh sách tàu thuyền. Vẫn có khả năng sự việc bắt nguồn từ một văn bản bị thất lạc hay trục trặc nào đó trong khâu nhận tin từ phía Kampfgruppe, dù cơ may ấy là cực kỳ mong manh.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000365", "translation": "Dẫu vậy, chẳng người lính dạn dày khói lửa nào lại không thấu hiểu tầm quan trọng của thông tin liên lạc. Suốt thời gian ở mặt trận phía đông, Degurechaff đã quán triệt đến thuộc nằm lòng việc phải luôn duy trì báo cáo. Liệu đơn vị pháo binh từng chiến đấu kiên cường đến thế tại Soldim 528 lại có thể phạm sai lầm ngớ ngẩn trong một tình huống đơn giản nhường này sao?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000366", "translation": "Dự cảm chẳng lành trong lòng Meybert càng lúc càng thêm trĩu nặng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000367", "translation": "Nếu không có kế hoạch tiếp nhận những con tàu này, điều đó đồng nghĩa chúng là các đối tượng chưa rõ danh tính mà họ chưa từng được thông báo. Chỉ riêng điều đó thôi cũng đã quá đủ để Meybert hạ lệnh cho binh lính vào vị trí chiến đấu.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
