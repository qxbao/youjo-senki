{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000178", "translation": "“Cô có căn cứ nào để khẳng định điều đó không?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000179", "translation": "Dĩ nhiên là mình có.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000180", "translation": "Đế quốc Nhật Bản.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000181", "translation": "Khi người dân phát hiện ra họ đã thua cuộc, họ bàng hoàng đến mức không thể tin nổi. Có thể đã có một nhúm ngoại lệ tại Atsugi, những kẻ cố thủ ngoài tiền tuyến cùng một chiến dịch chống lũ Cộng sản ở trong nước, nhưng đại đa số đều chấp nhận thất bại.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000182", "translation": "Đế chế Thứ ba.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000183", "translation": "Giữa đống đổ nát của giấc mộng đế quốc, bị áp đảo hoàn toàn, họ buộc phải đối diện với thất bại.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000184", "translation": "Hoặc Chiến tranh Crete. Hoặc Chiến tranh Xô-viết – Afghanistan. Chiến đấu quyết liệt đến mức cạn sạch mọi lựa chọn đồng nghĩa với việc, theo đúng nghĩa đen, chẳng còn cách nào khác ngoài chấp nhận thất bại.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000185", "translation": "“Xin ngài hãy nhìn vào cựu Liên minh Hiệp ước cùng Công quốc Dacia để thấy ý chí kháng cự của họ khác biệt với phía Cộng hòa ra sao. Hai nước đầu đã bị giáng đòn cho gục hẳn, trong khi nước sau dù đã bại trận nhưng vẫn giữ được sức lực để kháng cự.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000186", "translation": "Dù chẳng phải là *élan vital*¹, nhưng sĩ khí đôi khi có thể biến thành một con quái vật.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000187", "translation": "Chuyện người ta có hành động liều lĩnh hay không là một vấn đề thuộc về tâm lý. Chiến tranh tâm lý ít nhất cũng xứng đáng được ghi nhận đôi phần.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000188", "translation": "“Nếu họ còn sót lại chút sức lực nào, họ sẽ rất dễ nổi dậy lần nữa, có lẽ lần này còn nghiêm trọng hơn.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000189", "translation": "“Cũng chẳng phải cô không biết tới vấn nạn quân du kích đang hoành hành của chúng ta. Dạo này bọn chúng thậm chí còn mọc lên ở cả Dacia. Trong hoàn cảnh hiện tại, kiểu quan điểm đó xem chừng khá táo bạo đấy.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000190", "translation": "“Thời gian là liều thuốc xoa dịu nỗi đau, còn sự lãng quên—nó dường như là một phương thuốc bổ cho tâm trí đang rối bời.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000191", "translation": "Con người rất hay có khả năng quên đi những điều bất tiện.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000192", "translation": "Nhờ bộ não tiện lợi của chúng ta, người Pháp tôn vinh huyền thoại kháng chiến của họ, người Đức rì rầm về những “người Đức lương thiện”, còn người Anh thì gọi Đế quốc của họ là “rộng lượng”. Người Nhật biến thành “nạn nhân của chủ nghĩa quân phiệt”, trong khi người Mỹ, những kẻ đứng trên đỉnh cao, lại chẳng mảy may nghi ngờ rằng chủ nghĩa ngoại lệ của họ là có thật.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000193", "translation": "Thế nhưng thực tế là gì?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000194", "translation": "“Được thôi. Tôi có thể nhượng bộ rằng vẫn có khả năng mọi chuyện sẽ khép lại mà không xảy ra một cuộc biến động lớn nào. Nhưng Trung tá này, kịch bản đó có quá nhiều vấn đề để chúng ta chấp nhận nó như kết cục có khả năng xảy ra cao nhất.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000195", "translation": "Khi ông chỉ ra điểm đó, mình hiểu rõ đến mức phát ốm.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000196", "translation": "Thất bại theo đúng nghĩa đen chính là bị ép buộc phải chấp nhận hòa bình. Đó không phải là điều Đế quốc có thể chịu đựng vào lúc này.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000197", "translation": "Một sự suy tàn chậm rãi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000198", "translation": "Một vũng lầy.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000199", "translation": "Một con đường phía trước mịt mờ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000200", "translation": "Dù những điều ấy là sự thật, Đế quốc vẫn tự hào còn đủ năng lực chiến đấu.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000201", "translation": "Xét đến vị thế trên bàn đàm phán, việc không thể cạnh tranh tiếp sẽ mang lại rủi ro quá lớn. Nếu để kẻ nào phát hiện ra điểm yếu của mình, chúng ta có thể sẽ rơi vào đúng cảnh ngộ mà nước Đức từng lâm vào trong Thế chiến thứ nhất.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000202", "translation": "Nhưng vậy thì chúng ta phải giải quyết mọi chuyện thế nào đây? Liệu có cách nào dàn xếp ổn thỏa trên mọi mặt trận không?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000203", "translation": "Dựa trên những hiểu biết lịch sử mà mình nắm được, nền hòa bình có vẻ… Chà, đó là sự thật đáng hổ thẹn.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000204", "translation": "Ngay cả sau chiến thắng quyết định trong Chiến tranh Nga – Nhật, vẫn nổ ra cuộc bạo loạn Hibiya.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000205", "translation": "Nhìn vào các tiền lệ lịch sử khác, thay vì chán nản và câm lặng, người dân lại nổi loạn phản đối dữ dội những điều khoản hòa bình hoàn toàn có thể chấp nhận được. Nếu không có một lời giải thích thỏa đáng mà công chúng sẵn lòng chấp nhận thì chuyện đó ắt sẽ xảy ra.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000206", "translation": "Rốt cuộc, nếu muốn tránh cảnh hỗn loạn ở hậu phương, chúng ta không thể xem nhẹ dư luận được.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000207", "translation": "May thay… tình hình chính trị hiện tại xét trong tương quan với tâm lý dân chúng cũng không đến nỗi quá tồi tệ. Và các cơ quan hành chính của Đế quốc lại vượt trội hơn bất kỳ đối thủ Cộng sản truyền kiếp nào của chúng ta. Bằng thứ mà một số người sẽ gọi là sự đàn áp quyết đoán và tàn nhẫn, lực lượng cảnh sát gần như đã xóa sổ hoàn toàn các phong trào bất đồng chính kiến có tổ chức, nên thực tế là những thành phần bất mãn trong xã hội chúng ta đã bị đánh gục và dồn vào chân tường từ khá lâu rồi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000208", "translation": "Nhưng đối thủ của chúng ta lại là lũ Cộng sản.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000209", "translation": "Chúng ta chắc chắn vẫn chưa quét sạch được mọi chân rết của chúng. Bọn chúng dai dẳng và có sức sống mãnh liệt đến kinh ngạc. Trò đập chuột chũi này chẳng biết bao giờ mới có hồi kết. Làm mình nhớ tới miền đông—chết tiệt thật.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000210", "translation": "“Tôi hiểu đó sẽ là một thử thách cam go. Một nhiệm vụ ngang ngửa với việc giành chiến thắng ở miền đông.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000211", "translation": "Khi bạn đang tìm kiếm một chiến lược hạ cánh mềm trong lúc viễn cảnh hạ cánh cứng cứ chập chờn ẩn hiện trước mắt, thật khó mà giữ bình tĩnh để bước tiếp.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000212", "translation": "Nhìn vào cách thế giới từng buộc phải đối đầu trực diện với mối đe dọa Cộng sản sau Thế chiến thứ hai, buông lỏng cảnh giác vào lúc này chẳng khác nào đang tính chuyện tự sát.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000213", "translation": "Thành thật mà nói thì đây thực sự là một thử thách đáng gờm. Nhưng Tanya vẫn lên tiếng đầy mạnh mẽ, gửi gắm cả quyết tâm và ý chí vào câu trả lời của mình. “Chẳng có gì khó khăn hơn việc đạt được một cái kết hòa bình, êm thấm cho cuộc chiến này, nhưng… chúng ta không được phép bỏ cuộc.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000214", "translation": "“Nói hay lắm.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000215", "translation": "“Vâng ạ. Chúng ta phải làm điều này—vì hòa bình.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000216", "translation": "Và vì chính mình nữa.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000217", "translation": "Chúng ta phải lập lại hòa bình.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000218", "translation": "Ít nhất là ở khu vực quanh mình, dù cho chẳng ở đâu khác đi nữa. Mình đâu có đòi hỏi thứ gì tham vọng tới mức hòa bình thế giới. Đạt được một môi trường nơi mình có thể an toàn theo đuổi tương lai của bản thân là đã đủ mãn nguyện lắm rồi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000219", "translation": "Môi trường đó đòi hỏi phải có hòa bình.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000220", "translation": "“Vì hòa bình ư?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000221", "translation": "“Vì hòa bình của Đế quốc. Vì một Heimat yên bình. Đó là một ước muốn vô cùng giản dị ạ.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000222", "translation": "Bản chất của người lính vốn là yêu chuộng hòa bình. Ai có thể thấu hiểu giá trị của hòa bình rõ hơn những người lính trong thời chiến chứ?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000223", "translation": "“Tôi không biết cô lại là người yêu chuộng hòa bình đến thế đấy.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000224", "translation": "“Vâng, thưa Tướng quân, tôi là một kẻ nhát gan mà.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000225", "translation": "Tanya nói ra sự thật cứ như thể đang nói đùa.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000226", "translation": "Lý do ông thấy điều đó không giống tính cách của cô hẳn là do hồ sơ chiến tích. Cô đã ở ngoài tiền tuyến lâu đến mức người ta mặc nhiên cho rằng cô thích thú với nơi đó cũng là điều dễ hiểu.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000227", "translation": "Nhưng mình thà được làm việc tại trụ sở chính của công ty còn hơn nhiều.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
