{"segment_id": "YS-LN09/Text/chapter016.xhtml/p000001", "translation": "*Đúng thế, hết thật rồi.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter016.xhtml/p000002", "translation": "*Đây là nơi chúng ta bỏ mạng.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter016.xhtml/p000003", "translation": "Họ không còn lựa chọn nào khác ngoài việc phải đối mặt với thực tại.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter016.xhtml/p000004", "translation": "Thời khắc cáo chung đang ập thẳng xuống đầu họ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter016.xhtml/p000005", "translation": "“Lũ ác quỷ…!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter016.xhtml/p000006", "translation": "Đúng lúc ai đó vừa buột miệng thốt lên câu ấy như thể đang nguyền rủa trời cao.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter016.xhtml/p000007", "translation": "Chúng đang ở ngay đó, đòn tấn công cuối cùng sắp sửa giáng xuống bất cứ lúc nào. Thế nhưng bất thình lình, đám hung đồ Đế quốc lại tản ra tứ phía, đội hình của chúng rơi vào cảnh rối loạn.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter016.xhtml/p000008", "translation": "Chỉ một thoáng sau, cả thế giới chìm ngập trong ánh sáng chói lòa.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter016.xhtml/p000009", "translation": "Bóng dáng thần chết hiện lên từ màn vũ đạo được dàn dựng tỉ mỉ kia đã tan tành, cái chết tưởng chừng không tài nào tránh khỏi bỗng chốc bị thổi bay mất dạng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter016.xhtml/p000010", "translation": "Quyền năng của Chúa ư? Phải chăng đó là một phép màu?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter016.xhtml/p000011", "translation": "Không, không, không phải.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter016.xhtml/p000012", "translation": "“Quân tiếp viện! Là quân tiếp viện từ hạm đội chủ lực!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter016.xhtml/p000013", "translation": "Đúng lúc sĩ quan thông tin hân hoan làm nhiệm vụ loan báo tin mừng, cả thế giới đã tràn ngập ánh sáng. Đó là một cơn mưa thuật thức bắn tỉa quang học đang trút xuống đơn vị pháp sư trên không của Đế quốc.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter016.xhtml/p000014", "translation": "“Họ đến rồi!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter016.xhtml/p000015", "translation": "“Chúng ta được cứu rồi!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter016.xhtml/p000016", "translation": "“Ôi lạy Chúa!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter016.xhtml/p000017", "translation": "Cầu mong tin tốt lành lúc nào cũng được như vậy.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter016.xhtml/p000018", "translation": "Đó không hẳn là niềm vui dâng trào mà giống một sự bùng nổ cảm xúc hơn. Tất cả những người còn sống sót đều phát cuồng lên trước cảnh tượng quân tiếp viện xuất hiện.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter016.xhtml/p000019", "translation": "Không phải kẻ thù mà là đồng minh! Các pháp sư trên không của quân đồng minh đã tới chi viện cho họ!", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter016.xhtml/p000020", "translation": "Họ đã thay đổi chỉ trong tích tắc. Mới một khắc trước thôi, những người thủy thủ này còn đang ném đủ mọi lời chửi rủa tục tĩu nhất của loài người về phía Chúa trên trời, vậy mà giờ đây họ lại ca ngợi vinh quang của ngài như thể vừa được tái sinh.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter016.xhtml/p000021", "translation": "Mà như thế thì có gì sai nào? Đó đều là những giá trị hoàn toàn tốt đẹp của Khối Thịnh vượng chung cả đấy.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter016.xhtml/p000022", "translation": "Về phần đám pháp sư Đế quốc… chúng đang nhanh chóng quay đầu, cụp đuôi tháo chạy tán loạn. Hình dung ra nỗi uất ức của chúng khi cuộc vui bị phá đám khiến các thủy thủ Khối Thịnh vượng chung cảm thấy khá hơn đôi chút bất chấp thất bại cay đắng của mình.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter016.xhtml/p000023", "translation": "Tổn thất là vô cùng nặng nề.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter016.xhtml/p000024", "translation": "Đau đớn đến mức chẳng dám nghĩ tới.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter016.xhtml/p000025", "translation": "Nhưng chính vì thế mà một người đến từ Khối Thịnh vượng chung mới buông lời nhạo báng kẻ thù của mình trong hoàn cảnh này. *Đáng đời lũ bây lắm!*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter016.xhtml/p000026", "translation": "CÙNG NGÀY HÔM ĐÓ, TIỂU ĐOÀN PHÁP SƯ TRÊN KHÔNG SỐ 203", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter016.xhtml/p000027", "translation": "Đúng là thiếu mất nét chấm phá hoàn thiện cuối cùng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter016.xhtml/p000028", "translation": "Chúng mình đã ở rất gần việc xóa sổ hoàn toàn bọn họ theo đúng nghĩa đen rồi! Vậy mà thay vào đó, chúng mình lại phạm phải một sai lầm rành rành.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter016.xhtml/p000029", "translation": "Chúng mình đã thực hiện trót lọt một cuộc tấn công rủi ro cao nhằm vào hạm đội địch trên những quả V-2! Muốn thu về cổ tức thì có gì là sai chứ?!", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter016.xhtml/p000030", "translation": "Cơ may mong manh đến thế, vậy mà chúng mình đã làm được—lực lượng tập kích của chúng mình đã giáng đòn đẫm máu vào thiết giáp hạm, tàu sân bay, và thậm chí cả các tàu tuần dương cùng tàu khu trục hộ tống của họ! Chúng mình đã tiến sát đến một chiến thắng áp đảo tuyệt đối rồi!", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter016.xhtml/p000031", "translation": "Chúng mình hoàn toàn xứng đáng được mang chiến lợi phẩm trong tay trở về nhà!", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter016.xhtml/p000032", "translation": "Thế mà vào đúng giây phút cuối cùng, chúng mình lại hứng chịu một đòn giáng tồi tệ từ đâu ập tới. Cú sốc ấy chẳng khác nào lúc phát hiện ra cậu bồi bàn lẽ ra phải mang món tráng miệng ra phục vụ lại biến mất tăm ngay giữa bữa ăn.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter016.xhtml/p000033", "translation": "À mà khoan đã. Hãy nhìn nhận lại chuyện này theo hướng tích cực hơn nào.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter016.xhtml/p000034", "translation": "Chúng mình thực sự đã được thưởng thức món chính rồi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter016.xhtml/p000035", "translation": "Chúng mình đã ngấu nghiến sạch hạm đội do Bộ Tổng tham mưu dọn sẵn khi chúng xuất hiện dọc theo tuyến đường rút lui. Chúng mình đã hoàn thành công việc một cách hoàn hảo. Chừng nào Tướng von Romel không đến muộn… cuộc triệt thoái hẳn sẽ không vấp phải bất kỳ vấn đề gì.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter016.xhtml/p000036", "translation": "Và ông ấy sẽ chẳng đời nào làm hỏng một pha cơ động chiến thuật đâu. Chắc chắn họ sẽ xoay xở triệt thoái an toàn thôi. Mà kể cả có chuyện gì xảy ra thật đi nữa thì đã sao nào?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter016.xhtml/p000037", "translation": "Nếu ai đó đến muộn, thì đấy là lỗi của chính họ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter016.xhtml/p000038", "translation": "Những quy tắc cơ bản của một người trưởng thành ngoài xã hội là điều tuyệt đối trong quân đội. Nếu bạn đến muộn, bạn sẽ bị bỏ lại phía sau. Đó là nguyên tắc căn bản khi hành động theo tập thể, không có chỗ cho bất kỳ sự nghi ngờ nào.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter016.xhtml/p000039", "translation": "Đó là lý do vì sao đối với Tanya, sự xuất hiện của đám pháp sư Khối Thịnh vượng chung đến trễ mà vẫn xoay xở xông bừa vào được là điều hết sức phi lý.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter016.xhtml/p000040", "translation": "Vì toàn đơn vị đã tản ra ngay khi bị tấn công nên chúng mình không chịu thiệt hại thực sự nào. Nhưng mình rất muốn đòi bồi thường cho cú tác động nghiêm trọng tới trạng thái tinh thần của mình đấy!", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter016.xhtml/p000041", "translation": "Lúc nào bọn họ cũng ngáng đường chúng mình vào đúng giây cuối cùng! Đã định đến muộn thì đừng có vác mặt tới luôn đi!", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter016.xhtml/p000042", "translation": "“Đó là một nhóm pháp sư quy mô cỡ lữ đoàn! Họ đang lao về phía chúng ta rất nhanh!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter016.xhtml/p000043", "translation": "“Chậc! Hết giờ rồi!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter016.xhtml/p000044", "translation": "Sự phối hợp ở trình độ cao cần thiết để có thể tản đội hình ngay tức khắc. Sức mạnh tổ chức cần có để duy trì sự gắn kết của đơn vị ngay cả khi hứng chịu một đòn chẳng khác nào tập kích bất ngờ. Hai điều này nói lên phẩm chất xuất sắc của đơn vị mình. Và đơn vị ấy, Tiểu đoàn Pháp sư Trên không số 203, rất muốn tránh rơi vào thế bị áp đảo về quân số.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter016.xhtml/p000045", "translation": "Đặc biệt là trong một trận đánh trên mặt nước. Nếu có thể tránh được thì mình muốn tránh nó.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter016.xhtml/p000046", "translation": "“Thưa Trung tá! Cho chúng tôi đánh thêm hai chiếc tàu nữa thôi thì sao ạ!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter016.xhtml/p000047", "translation": "“Thời gian quý giá hơn! Đừng có tham lam! Chúng ta rút lui!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter016.xhtml/p000048", "translation": "Tanya hô hào toàn đội thu quân, nhưng cơn khát chiến đấu của Thiếu tá Weiss mãnh liệt đến mức dường như anh ta chẳng thể nào kìm nén nổi ham muốn lao theo con mồi ngay trước mắt họ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter016.xhtml/p000049", "translation": "“Nếu ra tay ngay bây giờ thì chẳng tốn bao nhiêu thời gian đâu! Xin hãy để chúng tôi đi!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter016.xhtml/p000050", "translation": "Anh ta nài nỉ rằng mình có thể hạ gọn chúng chỉ bằng vài thuật thức.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter016.xhtml/p000051", "translation": "Anh ta nói nghiêm túc đến mức nào nhỉ? Chà, có lẽ anh ta làm được thật đấy. Vấn đề duy nhất là vào lúc này mình chẳng bận tâm đến chuyện đó.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter016.xhtml/p000052", "translation": "Khi quân tiếp viện của địch đang áp sát, luật chơi đã thay đổi rồi. Trước lúc bọn họ kéo tới, việc quét sạch số tàu chiến đó hẳn sẽ là phương án tối ưu, nhưng… lũ khốn này.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
