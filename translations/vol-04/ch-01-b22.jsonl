{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000315", "translation": "“Đó là một câu hỏi rất hay. Nhưng các chuyên gia đã thực hiện cuộc phân tích với thái độ nghiêm túc, trung lập. Ngay cả khi đánh giá theo tiêu chuẩn ngày nay, họ cũng tuân thủ tốt các nguyên tắc phân tích tâm lý. Ấn tượng chung của chúng tôi là họ đã làm việc rất bài bản.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000316", "translation": "Vậy là chúng ta có thể tin những gì họ nói sao? Thông tin đó có chính xác và khách quan không? Nếu có thể tin vào thông tin này, thì theo ông nó đáng tin cậy đến mức nào?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000317", "translation": "“Chắc chắn nó đáng tin cậy hơn những ghi chép chính thức của Liên bang.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000318", "translation": "Nghĩa là lý do Liên bang tham chiến lại là… chứng hoang tưởng ư? Đáng kinh ngạc thật!", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000319", "translation": "…Vậy là một cơn ảo tưởng tập thể đã làm thay đổi dòng chảy lịch sử. Điều đó thực sự khiến chúng ta cảm nhận được lịch sử trớ trêu, hay có lẽ kỳ lạ đến nhường nào.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000320", "translation": "Trên đây là chương trình của Andrew, phóng viên đặc biệt đài WTN, cùng Giáo sư Sherlock thuộc khoa Khoa học Chính trị, Đại học Londinium.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000321", "translation": "SÁCH GIÁO KHOA DÀNH CHO CÔNG DÂN NHỎ TUỔI: LỊCH SỬ NƯỚC TA", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000322", "translation": "Bác Josef nhân hậu đang lo lắng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000323", "translation": "Kỳ vọng của tất cả những ai đặt niềm tin vào bác đang đè nặng lên đôi vai bác.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000324", "translation": "Chỉ một lòng nghĩ đến hạnh phúc của nhân dân, bác cho rằng đã đến lúc phải ra sức phát triển Liên bang.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000325", "translation": "Thế nhưng…", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000326", "translation": "Các công dân của đất nước, vì được lòng tốt của bác nuông chiều, lại ngày càng sa sút.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000327", "translation": "Thật đáng buồn làm sao!", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000328", "translation": "Bác Josef phiền lòng lắm.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000329", "translation": "Bác quyết định nhờ người đồng chí thân tín của mình là Đồng chí Loria tìm cách giải quyết.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000330", "translation": "Đồng chí Loria tài năng lập tức bắt tay vào hành động.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000331", "translation": "Trước tiên, để giúp nhân dân hiểu được tầm quan trọng của lao động, đồng chí đã chủ động mở các đợt thanh tra.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000332", "translation": "Chẳng cần phải nói, Đồng chí Loria thấu hiểu trọn vẹn những chỉ thị của bác Josef.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000333", "translation": "Đồng chí bắt đầu tìm cách thuyết phục người dân mà không hề tỏ thái độ trịch thượng hay áp đặt. *Nếu công việc hiện tại quá khó, sao không thử một công việc dễ hơn xem?*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000334", "translation": "Những hoạt động của Đồng chí Loria thể hiện sự thấu hiểu tấm lòng nhân hậu của bác Josef; đồng chí đã cùng nhân dân suy nghĩ xem công việc nào sẽ phù hợp với từng người.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000335", "translation": "Tất nhiên, đồng chí tích cực khích lệ những người muốn thử sức với các công việc nặng nhọc hoặc khó khăn. Nhưng Đồng chí Loria cảm thấy nếu chỉ khích lệ họ thôi thì thật thiếu trách nhiệm.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000336", "translation": "Để họ không cảm thấy cô đơn, đồng chí đã cử người đến hỗ trợ họ. Và đồng chí quyết định tìm kiếm một công việc vừa sức cho những người không kham nổi công việc nặng nhọc, khó khăn.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000337", "translation": "Thực ra, đây chính là thử thách lớn nhất đối với Đồng chí Loria. Mỗi người một vẻ. Có những đồng chí chạy rất nhanh, trong khi những đồng chí khác tuy chậm chạp nhưng lại khỏe mạnh. Cũng có những đồng chí đầu óc rất nhạy bén nhưng tinh thần trách nhiệm lại yếu kém.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000338", "translation": "Việc nắm bắt sự đa dạng của người dân là vô cùng khó khăn. Đó chính xác là điểm mà người tiền nhiệm của đồng chí, Đồng chí Iezhov, đã thất bại.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000339", "translation": "Nhưng Đồng chí Loria không thể phụ lòng tin của bác Josef, người được toàn thể nhân dân kính trọng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000340", "translation": "Đồng chí đã cho người của mình đi khảo sát gần như khắp cả nước.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000341", "translation": "Đồng chí ưa chuộng hành động quyết liệt, mang tính cách mạng; thậm chí còn có câu chuyện kể về việc đồng chí cử các nhân viên của mình xuống tận những cánh đồng lúa mì ở một ngôi làng nông nghiệp. Họ vừa tiếp tục tìm kiếm công việc mới, vừa giúp những người dân đang rơi nước mắt thu hoạch mùa màng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000342", "translation": "Cuối cùng, ở mãi tận miền đông xa xôi, họ đã tìm ra một công việc đơn giản mà bất cứ ai biết đếm cũng có thể làm được. Đồng chí Loria rất hài lòng và hỏi người cấp dưới tìm ra nó xem có thể tuyển dụng bao nhiêu người theo cách đó. Câu trả lời thật lý tưởng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000343", "translation": "Toàn bộ người dân cả nước đều có thể được nhận vào làm mà vẫn còn dư chỗ! Điều này khiến Đồng chí Loria ngạc nhiên, nên đồng chí đã hỏi thêm một câu nữa.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000344", "translation": "*Rốt cuộc công việc này là gì thế?*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000345", "translation": "Câu trả lời là:", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000346", "translation": "Công việc đếm cây thân thiện với môi trường ở Sildberia.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000347", "translation": "Đó là công việc xoa dịu tâm hồn mệt mỏi của người dân bằng sức mạnh thiên nhiên, và chắc chắn cũng sẽ góp phần bảo vệ môi trường.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000348", "translation": "Người dân có thể tận hưởng cảm giác tắm rừng và ngước nhìn bầu trời đầy sao trong vắt, khi dành trọn những tháng ngày cống hiến cho nhiệm vụ cao cả này.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000349", "translation": "Đó quả thực là lao động do dân, vì dân.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000350", "translation": "Đồng chí Loria hân hoan quyết định báo cáo việc này lên bác Josef.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000351", "translation": "Tất nhiên, khi nghe tin, bác Josef gần như nhảy cẫng lên vì vui sướng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000352", "translation": "Rót thứ rượu vang Georziya quý giá của mình mời Đồng chí Loria, bác cảm ơn đồng chí vì đã không phụ niềm tin của bác.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000353", "translation": "Hai người nhìn thẳng vào mắt nhau, và bác Josef bày tỏ lòng biết ơn chân thành trước sự tận tụy của Đồng chí Loria. Rồi bác khen ngợi đồng chí, nói rằng bản thân đất nước hẳn phải hạnh phúc lắm khi có được một người đồng chí ưu tú đến vậy.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000354", "translation": "Chẳng cần phải nói, Đồng chí Loria vô cùng xúc động. Đồng chí hứa sẽ làm việc chăm chỉ hơn nữa vì bác Josef—và đồng chí đã trung thành giữ trọn lời hứa ấy, đến mức không một ngày nào trôi qua mà nhân dân không nhắc tới những nỗ lực không ngừng nghỉ của Đồng chí Loria. Tưởng chừng mọi chuyện sẽ cứ thế tiếp diễn mãi mãi, nhưng rồi một ngày nọ, Đồng chí Loria đã mơ thấy một giấc mộng tựa như thiên khải.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000355", "translation": "Giấc mơ ấy gần như báo trước tương lai.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000356", "translation": "Tất nhiên, Đồng chí Loria là một người Cộng sản có tư duy logic, nên đồng chí không hề nao núng trước những chuyện phản khoa học như thế. Đồng chí vẫn tiếp tục nghiêm túc thực hiện nhiệm vụ của mình hết ngày này qua ngày khác.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000357", "translation": "Nhưng hầu như đêm nào đồng chí cũng bị giấc mơ đó giày vò.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000358", "translation": "Đến mức ấy, ngay cả Đồng chí Loria cũng phải tự hỏi liệu có phải mình đã kiệt sức vì làm việc quá độ hay không.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000359", "translation": "Đồng chí quyết định xin lời khuyên từ bác Josef, người mà đồng chí luôn tin cậy và kính trọng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000360", "translation": "Và thật bất ngờ làm sao—bác Josef cũng mơ thấy đúng giấc mơ ấy! *Rốt cuộc điều đó có ý nghĩa gì cơ chứ?*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000361", "translation": "Sau một hồi suy ngẫm, bác Josef đi đến kết luận hợp logic rằng cả hai người họ đều đang mang cùng một nỗi trăn trở. Suy cho cùng, tương lai của đất nước đang đặt trên vai họ. Cho dù sức nặng đối với mỗi người có khác nhau, cả hai đều cảm nhận được điều đó.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
