{"segment_id": "YS-LN05/Text/part0020.html/p000258", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Chúng ta sẽ đánh tan đám địch phía trước trên đường rút lui! Làm một pha đánh rồi rút gọn lẹ nào!”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000259", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "*Được rồi.* Tanya quyết tâm thực hiện đúng kế hoạch ban đầu của nó là chỉ tung một đòn tấn công duy nhất.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000260", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Yêu cầu từ bên Tình báo về việc phá hủy động cơ của chiếc RMS *Queen of Anjou* giờ đây gần như bất khả thi. Ráng bỏ chút công sức thực hiện một đòn đánh rồi rút tiện đường đi, gọi là cho phải đạo, đã là giới hạn tối đa mà họ có thể làm được.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000261", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Chỉ cần hoàn thành phận sự tối thiểu, việc duy nhất còn lại là RTB.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000262", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Đã đến lúc bọn mình phải cắt lỗ rồi.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000263", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Chỉ có kẻ ngu mới tiếp tục đổ tài nguyên vào cái dự án vô vọng này.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000264", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Mà chuyện hành động vì nghĩa vụ với sở chỉ huy và bên Tình báo cũng chỉ có giới hạn thôi. Mình sẽ không để họ bào mòn nguồn lực hữu hạn và không thể thay thế của mình—những thuộc hạ do chính tay mình huấn luyện—thêm nữa đâu.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000265", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Toàn quân! Ai trúng đạn thì ưu tiên rút lui trước! Những người còn lại, chúng ta sẽ nện con tàu đó một cú rồi biến khỏi đây ngay! Chẳng có lý do gì để nán lại cả!”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000266", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“““Rõ!”””", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000267", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Quân của mình hưởng ứng đầy nhiệt huyết; nhuệ khí đang lên rất cao.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000268", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Một đại đội pháp sư địch đang nhanh chóng tiếp cận từ phía trước! Chúng ta nên duy trì cự ly giao chiến và—”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000269", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Không cần. Chém gục chúng đi!”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000270", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Ý định của Serebryakov khi cô hét lên cảnh báo không tệ, nhưng Tanya cắt ngang lời cô.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000271", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Thưa Trung tá?”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000272", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Việc Serebryakov thắc mắc trước những chỉ thị đi ngược lại lý thuyết là hoàn toàn tự nhiên, nhưng Tanya trấn an cô. “Đám địch này đến muộn. Chúng thuộc một nhánh chỉ huy khác. Tôi đoán chúng chỉ là quân tuyến hai được cử đến để cầm chân chúng ta thôi. Ưu tiên của chúng ta là đột phá xuyên qua. Đừng dùng thuật thức phát nổ, vì có thể bắn nhầm vào quân mình. Hãy chuẩn bị tinh thần cho một trận hỗn chiến ngay khi lao vào. Quét sạch chúng bằng bắn tỉa và cận chiến—mục đích của chúng ta là nghiền nát chúng!”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000273", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Ngay trước khi giao chiến, Tanya chỉ thị cho binh lính chuyển từ thuật thức phát nổ sang thuật thức bắn tỉa.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000274", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Thế rồi… có lẽ do dè chừng các đòn tấn công diện rộng chăng? Đại đội địch tản ra một cách trật tự đúng chuẩn sách giáo khoa, còn Tiểu đoàn Pháp sư Trên không số 203 với đội hình tương đối dày đặc thì lao thẳng vào xung phong.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000275", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Tình thế này chẳng khác nào dùng một nắm đấm rắn chắc đấm gục từng tên địch đang tản mát.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000276", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Thiệt tình.”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000277", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Nó nhún vai trong lúc cả đội đánh một trận đơn giản để càn quét đám pháp sư địch đang liều lĩnh lao vào giao chiến. *Mấy kẻ này chẳng bao giờ chừa cả.* Nó thầm bật cười.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000278", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Thế rồi, đúng lúc nó rút khẩu tiểu liên ra để hạ một pháp sư địch.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000279", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Cảm nhận được một luồng ớn lạnh tột độ, nó đột ngột tăng tốc. Khoảnh khắc tiếp theo, nó hít mạnh một hơi khi suýt bị thiêu đốt bởi sức nóng bức xạ.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000280", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "*Một chùm tia nhiệt ư?*", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000281", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Nó thậm chí còn chẳng kịp hét lên: *Cái quái—?!*", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000282", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Đòn này là trả thù cho cha tao!” Nữ pháp sư địch lao tới như thể muốn đọ kiếm. Đôi mắt cô ả báo hiệu rắc rối to—một sự pha trộn giữa địch ý thuần túy và lòng căm thù.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000283", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Mình chỉ muốn hét lên: *Tôi đã làm cái gì chứ?*", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000284", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Mà thực tế, Tanya đã hét lên thật. “Tôi đã làm cái gì chứ?!”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000285", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Đ-đ-đừng có mà đùa giỡn với tao!”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000286", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Chẳng có lý do gì để mình bị buộc tội là đang đùa giỡn cả. Mình luôn thực hiện công việc một cách *hết sức nghiêm túc*. Mình có thể tự hào tuyên bố điều đó với bất kỳ ai.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000287", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "*Mình đâu phải hạng người đem chuyện chiến tranh ra làm trò đùa.*", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000288", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "*Ngược lại hoàn toàn ấy chứ.* Tanya quát trả: “Tôi thậm chí còn chẳng thể tin nổi mình đang phải đánh nhau với một kẻ nực cười đến thế này. Chúng ta đang đánh trận trên chiến trường đấy, cô biết không hả! Vậy mà cô lại mang tư thù vào đây ư? Thật phi lý hết sức!”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000289", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Nh-nh-nhưng chính mày!”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000290", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Trên gương mặt đang giận dữ của nữ pháp sư địch là một vẻ nhăn nhó dữ tợn đến khó coi. Giá mà mỉm cười thì hẳn cô ả sẽ có gương mặt tươi như hoa, nhưng cô ả lại vặn vẹo nét mặt vì lòng căm thù để trút hết sự thù địch về phía mình.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000291", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "*Mình không nhớ gương mặt cô ả, nhưng chẳng lẽ bọn mình từng giao chiến ở đâu đó trước đây rồi sao?*", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000292", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "*Kệ đi.* Tanya ngừng suy nghĩ tại đó và bắn ra ba thuật thức để cầm chân đối phương. Xem chừng kẻ địch cũng không ngu ngốc đến mức lao vào tấn công khi điều đó là bất khả thi. Khi né tránh, cô ả vẫn đủ bình tĩnh để tung ra vài thuật thức quang học trong lúc kéo giãn khoảng cách.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000293", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Thưa Trung tá, đám pháp sư hải quân đánh bộ địch đang bám sát nút phía sau. Chúng ta nên rút lui thôi!”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000294", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Rõ. Tình trạng tàu địch thế nào rồi?”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000295", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Chúng tôi đang càn quét mặt boong. Chắc hẳn chúng tôi cũng đã bắn trúng trực diện vào động cơ được vài phát rồi, nhưng…”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000296", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Chỉ cần đảm bảo là chúng ta có tư liệu hình ảnh ghi lại. Chắc chắn thứ đó sẽ có ích đấy.”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000297", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Tiểu đoàn của mình hoàn thành gọn gàng mọi nhiệm vụ cần làm—họ thật tuyệt vời. Khi liếc nhìn về phía con tàu, mình thấy những thuộc hạ quả cảm của mình đang oanh kích nó bằng các thuật thức.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000298", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Nhưng hành động đó lại châm ngòi khiến các trung đoàn địch nhanh chóng ập về phía bọn mình.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000299", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Được rồi, dây dưa thêm nữa chỉ tổ phí thời gian. Chúng ta rút quân! Rút lui!” Ngay khi nó chuẩn bị hét lên: *Đi thôi!*, nó chỉ vừa kịp né thoát một đòn tấn công khác trong gang tấc.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000300", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Kẻ sát nhân vừa bắn thuật thức bắn tỉa quang học đó chính là nữ pháp sư ban nãy. Đáng kinh ngạc là dù cô ả không thể hiện kỹ năng gì mấy trong việc cấu trúc thuật thức, nhưng đòn đánh ấy lại có uy lực và tốc độ khác thường.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000301", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Xem ra cô ả đang hiển hiện thuật thức với tốc độ cực nhanh bằng cách cưỡng ép dồn thêm ma lực vào đó.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000302", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Mày định bỏ chạy đấy à?!”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000303", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Bớt sủa nhặng lên đi! Bọn tôi đang vội.”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000304", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Năng lượng cho một chuyến bay đường dài, một trận đánh, và giờ là cuộc rút lui. Xét đủ mọi bề, mình chẳng có thời gian đâu mà dây dưa vô bổ với một đối thủ dai dẳng.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000305", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Trung tá, nhanh lên!”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000306", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Tôi biết rồi, Thiếu tá! Tôi tới ngay đây!”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000307", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Để kìm chân kẻ địch, mình bắn thêm ba thuật thức phát nổ nữa. Đó là đòn tấn công ưu tiên phạm vi tác động hơn là uy lực, nên hiển nhiên là thiếu hụt về mặt uy lực.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000308", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Con nhỏ đầu đất đang bám đuôi mình bị thổi bay phấp phới như diều đứt dây, nhưng cô ả vẫn còn đang bay, đồng nghĩa với việc mình chưa bắn hạ được ả… Cô ả lì đòn đáng kinh ngạc so với một tân binh đấy. Chắc phải gọi cô ả là kẻ có số sống sót cao mới được.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000309", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Không, hơn thế nữa, lớp vỏ phòng thủ của cô ả còn bền chắc hơn mình tưởng… Phiền phức thật. Xét đến những chuyện có thể xảy ra về sau, mình thực sự muốn kết liễu cô ả ngay tại đây.", "status": "reviewed", "translator": "argon-low", "notes": []}
