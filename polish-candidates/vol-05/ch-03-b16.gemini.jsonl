{"segment_id": "YS-LN05/Text/part0020.html/p000194", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Thật hoài niệm quá. Làm tôi nhớ tới mặt trận Rhine.”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000195", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Cô nói phải đấy, Trung úy Serebryakov. Hoàn toàn chính xác. Làm tôi nhớ tới những trận đánh chiến hào! Được rồi, toàn quân, đến lúc chơi một trò từ ngày xưa rồi: trò đuổi bắt!”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000196", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Trong lúc quân địch đang truy kích phía sau, bọn mình tung đòn đánh vào mục tiêu. Tình thế này chẳng khác nào những cuộc tập kích ban đêm cấp đại đội dưới chiến hào ngày trước, nơi mà một khi viện binh địch đuổi kịp bọn mình thì coi như xong đời.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000197", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Mục tiêu lần này của bọn mình là chiếc RMS *Queen of Anjou* đang thong thả lướt sóng ngay bên dưới. Thứ duy nhất chắn giữa tiểu đoàn và con tàu chỉ là một đơn vị phòng thủ nhỏ nhoi.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000198", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Trung tá Tanya von Degurechaff chợt nảy ra một ý nghĩ: *Mình nghĩ bọn mình làm được.*", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000199", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Mary Sue có lẽ sẽ chẳng bao giờ quên được khoảnh khắc ấy.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000200", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Chuyện đó lúc nào cũng ập đến chẳng chút báo trước.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000201", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "…Đột nhiên, hồi còi báo động chiến đấu vang lên khắp boong tàu.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000202", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Cảnh báo, địch đang tiếp cận! Chúng tôi cũng đã nhận diện thành công bước sóng của chúng! Đó là một đơn vị Pháp sư Định danh!”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000203", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Tình trạng của chúng thế nào?!”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000204", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Chính là đơn vị chúng ta từng xác nhận ở mặt trận Rhine!”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000205", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Ở Rhine ư?! Lũ đó sao?”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000206", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "*Lũ đó.*", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000207", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "*Đó là…*", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000208", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "*…Kẻ đã giết cha mình.*", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000209", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "*Và cả bạn bè mình nữa.*", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000210", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "*Kẻ thù của mình… của chúng mình.*", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000211", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "*Đó là lý do mình lao vụt đi. Tay nắm chặt khẩu súng trường và quả cầu phép thuật, mình chạy thẳng lên boong tàu. Những người bạn chạy theo sau mình cũng đang mang cùng một suy nghĩ trong đầu.*", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000212", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "*Báo thù.*", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000213", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "*Cơn giận của chúng mình, cơn giận của bạn bè, cơn giận của gia đình chúng mình.*", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000214", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "*Trên hết thảy, chúng mình không muốn đánh mất thêm bất cứ thứ gì nữa. Để bảo vệ, chúng mình phải chiến đấu. Sức mạnh để làm điều đó, vũ khí của mình, đang nằm ngay trong đôi bàn tay này.*", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000215", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Tất cả pháp sư hải quân đánh bộ, chuẩn bị đánh chặn! Bay lên đó mau!”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000216", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "*Tin tưởng vào điều đó, mình nói với vị sĩ quan chỉ huy là Trung tá Drake:* “Chúng tôi cũng sẽ lên đó!”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000217", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "*Và khi xin được góp một phần sức, thứ mình nhận lại là… một lời khước từ lạnh lùng.*", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000218", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Xin lỗi nhé, Trung úy Sue. Đơn vị của cô đang làm nhiệm vụ yểm trợ trực tiếp cho tàu RMS *Queen of Anjou* để canh chừng tàu ngầm. Hãy bám sát ở đây và đừng để chúng tiếp cận con tàu!”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000219", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "*Lý trí của mình có thể hiểu được những lời kiên quyết của vị chỉ huy quân Khối Thịnh vượng chung. Chúng mình, đội quân tình nguyện… không phải là không có thiếu sót.*", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000220", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Nhưng…” *Mình cố bày tỏ nỗi lòng với ông ấy, song chẳng còn thời gian nữa.* “…Thưa Trung tá Drake, chúng tôi làm được mà. Xin hãy để chúng tôi báo thù cho bạn bè mình.”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000221", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Đây là quyết định của chúng tôi sau khi đã cân nhắc tình hình hiện tại cũng như trình độ huấn luyện của đơn vị cô. Không có thời gian để tranh cãi đâu. Tôi không chấp nhận ý kiến phản đối.”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000222", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "*Thế là họ bay vút lên cao.*", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000223", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "*Tất cả những gì chúng mình có thể làm khi dõi theo bóng họ rời đi là hy vọng họ sẽ giành chiến thắng. Trong lúc bạn bè, trong lúc tất cả mọi người đang chiến đấu, chúng mình lại bị bỏ lại phía sau trên con tàu này.*", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000224", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "*Mình biết việc chốt giữ tại chỗ là một nhiệm vụ quan trọng.*", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000225", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "*…Thế nhưng…*", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000226", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“…Tức thật đấy. Mình không ngờ việc chẳng thể làm gì lại khó chịu đến thế này.”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000227", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "*Một lời thì thầm thật khẽ, thật nhỏ nhoi.*", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000228", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "*Việc mình, việc chúng mình—đội quân tình nguyện—có thể làm hay không thể làm gì cũng chẳng quan trọng. Đây chỉ đơn giản là một tình cảnh gây ức chế đến phát điên.*", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000229", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "*Ngước nhìn lên bầu trời, mình thấy bạn bè đang giao chiến với kẻ thù của mình và đổ máu.*", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000230", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Xin hãy chiến thắng.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000231", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Cầu cho tất cả mọi người đều bình an.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000232", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "*Chỉ với những lời cầu nguyện duy nhất ấy trong lòng, chúng mình đứng đó dõi theo… và rồi mọi thứ thay đổi ngay trước mắt chúng mình.*", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000233", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Khẩn cấp! Quân địch đã chọc thủng phòng tuyến!”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000234", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Cái gì?! Bất chấp mức chênh lệch chiến lực đến thế ư?!”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000235", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Sự bàng hoàng và hỗn loạn vang vọng qua vô tuyến. Nhưng Mary và chỉ một mình Mary biết rõ điều đó, ở một góc nào đó trong tâm trí cô. *Aaa.*", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000236", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "*Còn trông mong gì nữa chứ? Bọn chúng chẳng khác nào ác quỷ.*", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000237", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Đơn vị yểm trợ trực tiếp, lập tức đánh chặn! Trung úy Sue, cô sẵn sàng bay lên rồi chứ?!”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000238", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“R-rõ, thưa Trung tá!”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000239", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Một cơ hội, kẻ thù của cô, đang lao thẳng về phía cô.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000240", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "*Mình phải bảo vệ.*", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000241", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "*Mình không thể để chúng cướp đi thêm bất cứ thứ gì nữa.*", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000242", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Nung nấu quyết tâm trong lồng ngực, Mary khẽ hít một hơi rồi trừng mắt nhìn lên đám quân địch đang bổ nhào xuống.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000243", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "*Lần này chúng mình có thể làm được.*", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000244", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "*Chúng mình sẽ không để bọn ngươi thoát tội đâu.*", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000245", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Xét theo diễn biến hiện tại, việc hoàn thành xuất sắc nhiệm vụ không phải là bất khả thi. Nhưng sau khi cân nhắc thấu đáo mọi mặt, Tanya đi đến kết luận rằng họ nên cắt lỗ tại đây.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000246", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Nó từng nghĩ việc đó nằm trong tầm tay và suýt chút nữa đã quyết tâm thực hiện đến cùng. Thế nhưng thứ dội gáo nước lạnh vào sự hăng hái của nó lại là những tổn thất của tiểu đoàn. Nó không muốn nói rằng nhiệm vụ này vô nghĩa, nhưng họ đang ở một nơi đồng không mông quạnh… thành thử để nguồn nhân lực của mình bị tiêu hao một cách không cần thiết chính là kịch bản tồi tệ nhất.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000247", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Ai đó cho cậu ấy mượn bờ vai tựa vào đi! Đỡ cậu ấy dậy!”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000248", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Trung úy Grantz, tôi không sao đâu…”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000249", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Tôi thà bị Trung tá thuyết giáo một trận còn hơn làm cái thứ trung úy bỏ mặc cấp dưới lại phía sau!”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000250", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Các tín hiệu liên lạc đan chéo nhau trong mạng nội bộ toàn là tiếng la hét và gào thét báo hiệu tổn thất. Tiểu đoàn vẫn đang duy trì kỷ luật và vận hành như một tổ chức, nhưng nó không thể làm ngơ trước sự thật rằng họ đã có thương vong.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000251", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Nói cách khác, binh lính chỉ đang gắng gượng trụ vững để khỏi sụp đổ mà thôi. Ngay cả tiểu đoàn có sức mạnh vô song của mình suy cho cùng cũng là một tập hợp những con người bằng xương bằng thịt. Mình không muốn bắt họ phải gồng mình quá sức hơn mức cần thiết. Nếu có thể thắng một cuộc chiến chỉ bằng tinh thần duy ý chí, thì lũ cuồng vọng tự đại đã trở thành lực lượng mạnh nhất thế gian rồi.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000252", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Nói cách khác, mình cần phải đánh giá lại những quân bài trong tay.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000253", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Bọn mình đã hứng chịu thương vong liên tiếp. Bọn mình chỉ vừa vặn chọc thủng được phòng tuyến để tiếp cận con tàu, nhưng… quân địch đang bắt đầu phản ứng lại. Đáng kinh ngạc thay, bọn mình đã phải hứng chịu hỏa lực tầm xa.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000254", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Đám người Khối Thịnh vượng chung này… đáng ngạc nhiên là hẳn chúng đã chấp nhận chuyện bắn trượt một số phát, bởi chúng đã bắt đầu chĩa một lượng thuật thức bắn tỉa tầm xa nhiều đến phát tởm về phía bọn mình.", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000255", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Trung tá?”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000256", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "“Rút lui! Chúng ta rút lui!”", "status": "reviewed", "translator": "argon-low", "notes": []}
{"segment_id": "YS-LN05/Text/part0020.html/p000257", "source_sha256": "494fbc70fbd1e8324426441839ccf91319082ac0150ba1089dc77b6c3d605004", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "translation": "Ngay cả viên phó chỉ huy của mình, dẫu vẫn cười nói qua vô tuyến, cũng chẳng thể nào thản nhiên trước việc hy sinh thuộc hạ được. Đến chính mình cũng không hoan nghênh sự tiêu hao nhân lực.", "status": "reviewed", "translator": "argon-low", "notes": []}
