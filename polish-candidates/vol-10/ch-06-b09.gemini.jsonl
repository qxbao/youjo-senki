{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000265", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Trong thâm tâm, Tanya khấp khởi mừng trước ý nghĩ được tạm gác chuyện công việc sang một bên suốt cả một ngày.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000266", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Nhân tiện, cô thấy sao nếu tôi đãi cô một chầu cà phê?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000267", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Tôi rất hân hạnh được đi cùng ngài, thưa Trung tá.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000268", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Phụ tá này, đây là dịp đặc biệt. Sao cô không dành luôn ngày hôm nay cho bản thân mình đi?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000269", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Thế nhưng, đáp lại lời mời của Tanya, Visha lại thốt ra một câu cho thấy cô ấy đã thấm nhuần văn hóa làm việc của Lục quân Đế quốc sâu sắc đến nhường nào.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000270", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Tháp tùng ngài thì nghĩa là việc này cũng nằm trong phận sự công vụ của tôi, đúng không ạ?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000271", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Ý cô là sao?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000272", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Tôi sẽ bỏ vị trí trực để đi cùng ngài ạ.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000273", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "*Biết ngay mà*, Tanya thầm nghĩ rồi bật cười khanh khách. Không ngờ đây lại chính là vị sĩ quan phụ tá từng bật khóc nức nở ngay trước mặt cô ở mặt trận Rhine ngày nào. Tanya chưa bao giờ tưởng tượng được rằng cô ấy sẽ nói ra một câu như thế này.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000274", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Tôi đoán bổn phận của người lính là phải luôn nhạy bén và chuẩn chỉnh trong mọi tình huống. Cô đã trở thành một sĩ quan phụ tá vô cùng đáng tin cậy rồi đấy.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000275", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“À, tôi rời khỏi vị trí trực thế này liệu có thật sự ổn không ạ…?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000276", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Tất nhiên là không rồi. Tôi sẽ phê chuẩn việc đó cho cô.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000277", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Một người biết sử dụng quyền lợi của mình một cách thỏa đáng hoàn toàn xứng đáng được ghi nhận và tán dương. Tanya tôn sùng nguyên lý bất tổn hại từ tận đáy lòng. Gần như ngang ngửa với niềm tin của cô vào tính bất khả xâm phạm của tài sản tư nhân.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000278", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Trong lúc hai người đang rảo bước về phía phòng sinh hoạt chung, Trung úy Serebryakov chợt vỗ tay một cái như thể vừa nhớ ra chuyện gì đó hệ trọng lắm.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000279", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Ồ, phải rồi ạ. Đại úy Meybert đã chuẩn bị một món quà cho chúng ta khi ta thu xếp cuộc gặp đó với anh ấy trước trận đánh! Mình mang ra thưởng thức cùng cà phê đi ạ! Để tôi đi lấy!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000280", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Sĩ quan phụ tá của Tanya vội vã chạy đi rồi chẳng mấy chốc đã quay lại với vài chiếc hộp thiếc dán nhãn *Dứa Hải quân Đế quốc*.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000281", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Đây là… khẩu phần đóng hộp của hải quân sao?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000282", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Anh ấy bảo cứ xem đây như một kiểu quà bịt miệng từ Bộ Tư lệnh Hạm đội Tàu ngầm ạ. Anh ấy muốn chúng ta giữ kín chuyện sai sót mà các chỉ huy ở bến cảng nọ đã mắc phải.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000283", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "*Ồ, vụ đó à.* Tanya thừa biết vị đại úy muốn cô giữ kín miệng về chuyện gì. Đó là cái lần mà gã nhân sự hải quân nghiệp dư nọ đã thất bại trong việc bảo vệ chính bến cảng của mình. Đại tá Lergen đã giận tím mặt khi gã đó tìm cách thoái thác trách nhiệm về vụ việc.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000284", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Hối lộ ư? Thật đáng hổ thẹn.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000285", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Cô cầm một hộp lên và xác nhận rằng những miếng dứa bên trong được ngâm trong thứ nước đường thơm ngon tuyệt hảo.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000286", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Tốt hơn hết là chúng ta nên tiêu hủy toàn bộ tang vật trước khi có ai đó phát hiện ra.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000287", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Rõ!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000288", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Và thế là hai người họ gom góp mọi món quà vặt có thể tìm thấy trước khi tụ họp tại phòng sinh hoạt chung, nơi Tanya cùng Trung úy Serebryakov tận hưởng một buổi nghỉ giải lao uống cà phê nho nhỏ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000289", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Họ bày bộ sưu tập đồ ăn thức uống của mình ra bàn trong phòng sinh hoạt chung. Đó quả là một bộ sưu tập những vật phẩm văn hóa đích thực.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000290", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Tanya thong thả chọn ra những hạt cà phê thượng hạng nhất mà cô có để mang ra đãi rồi tự tay rang chúng trên một chiếc chảo rán. Trung úy Serebryakov khéo léo xay số hạt đó bằng cối xay. Sau đó, họ châm nước sôi để ủ phần bột cà phê vừa xay trước khi sĩ quan phụ tá của Tanya điêu luyện rót thứ chất lỏng màu đen đầy mê hoặc ấy vào tách của hai người.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000291", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Món dứa của Hải quân Đế quốc giờ đã được khui khỏi hộp cũng ngon đến mức khó tin.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000292", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Tanya nở một nụ cười thật tươi trên môi, tận hưởng trọn vẹn khoảnh khắc này. Sĩ quan phụ tá của cô, người đang ngồi thoải mái bên cạnh, chợt lộ vẻ mặt hơi nghiêm túc trước khi nêu lên một câu hỏi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000293", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Tôi hỏi ngài một chuyện có được không ạ?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000294", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Chuyện gì thế?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000295", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Dạ… tôi muốn hỏi là cuộc chiến này rồi sẽ đi về đâu ạ.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000296", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Câu hỏi ấy khiến Tanya bất ngờ không kịp trở tay. Cô thoáng cau mày như thể miếng dứa ngọt lịm trong miệng vừa đột ngột hóa chua loét.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000297", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Chiến tranh là chủ đề cuối cùng mà cô muốn bàn tới trong khoảng thời gian nghỉ ngơi quý giá của mình.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000298", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Đó là một câu hỏi khá kỳ lạ đấy.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000299", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Dạ, vì không có nhiều cơ hội để hỏi riêng ngài những câu như thế này khi chỉ có hai người, nên là…”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000300", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Tanya chẳng thể khiển trách người phụ nữ trẻ khi cô ấy lễ phép hỏi xin ý kiến của mình như vậy. Đây là dịp để hai sĩ quan chia sẻ suy nghĩ của bản thân mà không có cánh lính trơn nào dõi theo.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000301", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Cô cảm thấy có lẽ tốt hơn hết là nên thẳng thắn với cô ấy, chí ít là ở một chừng mực nhất định.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000302", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Tôi khuyên cô đừng nên bận tâm quá nhiều về chuyện đó… Ngay lúc này, ưu tiên cao nhất của chúng ta là đảm bảo tất cả mọi người đều sống sót trở về.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000303", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Đó là suy nghĩ của ngài sao, thưa Trung tá?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000304", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Một cuộc chiến chỉ có thể chấm dứt thông qua chiến thắng. Theo như tôi thấy, hiện giờ chẳng có ai đang chiến đấu mà lại có ý định chịu thua cả. Tuy nhiên…”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000305", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Tanya hít một hơi, rồi nhấp một ngụm cà phê Ildoa thơm ngon tuyệt hảo trước khi nói ra điều cần phải nói.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000306", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Chúng ta là những người lính. Chà, trong trường hợp của cô, lẽ ra cô vốn là lính nghĩa vụ trước khi rốt cuộc lại tự nguyện tòng quân… Và dĩ nhiên là có những hoàn cảnh nhất định đã dẫn tới quyết định đó của cô…”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000307", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Tôi là một sĩ quan, thưa Trung tá. Tôi nhập ngũ cũng vì những lý do giống như bao người khác thôi ạ.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter028.xhtml/p000308", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Trung úy Serebryakov gật đầu với Tanya. Xét về phương diện này thì cả hai người họ đều giống nhau. Với tư cách là những công chức nhà nước, họ là công cụ thực thi chủ quyền của quốc gia mình. Giá mà họ có thể làm ít hưởng nhiều hoặc ngồi mát ăn bát vàng như đám công chức quèn thông thường thì tốt biết mấy, nhưng đáng tiếc là họ lại phải cày cuốc xứng đáng tới từng đồng lương được nhận. Dù Tanya vốn phản đối chế độ nô lệ, nhưng nếu xét đến khối lượng giờ làm thêm không lương khổng lồ mà cô và Visha đã đổ vào công việc của mình, thì về bản chất hai người họ đích thị là một cặp công bộc mẫu mực.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
