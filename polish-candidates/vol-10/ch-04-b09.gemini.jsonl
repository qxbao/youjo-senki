{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000083", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Cả hai quân nhân đều phải kìm nén thôi thúc nói ra mong mỏi rằng giới lãnh đạo cũng có được sự khiêm tốn tương tự.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000084", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Giá như họ có lấy một mảy may đức tính này thôi, thì cuộc chiến đã diễn ra khác đi nhiều rồi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000085", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Dưới góc nhìn của một chuyên gia, chẳng còn gì tệ hại hơn một kẻ có trí tuệ làng nhàng nhưng lại tưởng mình thông tỏ mọi thứ về bất kỳ chủ đề nào được nhắc tới.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000086", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Tanya lục tìm trong những ngóc ngách sâu thẳm của tâm trí để chọn ra từ ngữ thích hợp. Cô đưa ra một cụm từ mà một nhà ngoại giao sẽ dùng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000087", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Giảng hòa là lối thoát duy nhất của chúng ta khỏi tình cảnh này. Và chuyện đó cần phải diễn ra thật nhanh chóng.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000088", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Cô nhìn thẳng vào mắt Tham tán Conrad.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000089", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Đôi mắt xanh lam của ông ta nhìn thẳng lại, và có vẻ như những lời cô nói đã phát huy tác dụng. Sự kiên quyết của Tanya thể hiện rõ trong lời đề nghị ấy, và họ nhìn nhau chằm chằm trong một thoáng ngắn ngủi nhưng căng thẳng trước khi nhà ngoại giao ấy dịu xuống.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000090", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Ông ta thở dài rồi lại ngước nhìn lên trần nhà.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000091", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Có thể bản thân ông ta không nhận ra, nhưng nãy giờ ông ta vẫn cứ rung đùi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000092", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Giảng hòa, giảng hòa, giảng hòa…”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000093", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Ông ta lặp lại từ đó ba lần trước khi châm một điếu xì gà. Vẫn với ánh mắt trống rỗng ấy, ông ta vừa gãi đầu vừa rít một hơi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000094", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Một làn khói đặc quánh phả ra từ miệng ông ta.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000095", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Đúng lúc làn khói bắt đầu khiến Tanya khó chịu, Tham tán Conrad cuối cùng cũng lên tiếng trở lại.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000096", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Nếu một sĩ quan cấp tá đã có cảm nhận mãnh liệt đến vậy về chuyện đó, thì ắt hẳn nó phải là sự thật.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000097", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Ý ông là…?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000098", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Tôi hiểu mong muốn giải quyết cuộc chiến bằng con đường giảng hòa của bên lục quân. Xét theo hoàn cảnh hiện tại… đó là một ý kiến khôn ngoan. Đó chính xác là việc chúng ta nên làm.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000099", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Ngay cả trong những lúc thuận lợi nhất, cánh nhà ngoại giao này vốn đã khó hiểu rồi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000100", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Lúc nào họ cũng mơ hồ và tối nghĩa, lúc nào cũng vòng vo tam quốc, lúc nào cũng cẩn trọng từng lời từng chữ nhưng lại chẳng bao giờ nói ra điều gì thực chất. Sự rõ ràng và ngắn gọn—thiếu một trong hai thứ đó thì không thể làm một người lính được.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000101", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Đại tá Lergen lắc đầu bên cạnh một Tanya đang ngơ ngác.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000102", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Thưa Tham tán, vấn đề mấu chốt ở đây là kẻ địch của chúng ta. Họ sẽ đón nhận một lời đề nghị như vậy ra sao?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000103", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Điều gì khiến ông hỏi vậy?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000104", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Vị tham tán nhìn chằm chằm đầy bối rối với vẻ mặt ngơ ngác.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000105", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Đại tá Lergen ngập ngừng đáp: “Bởi vì chúng ta không ở vào vị thế có thể đưa ra yêu sách?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000106", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Thưa Đại tá, đó chính là điều tôi đang không hiểu đấy. Chẳng phải vì thế nên chúng ta mới cần giảng hòa sao?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000107", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Đúng là vậy. Nhưng xét cho cùng, đây chính là lúc cần đến những người bên phía ông mà…”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000108", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Tham tán Conrad vỗ hai bàn tay vào nhau đánh bốp một tiếng, cắt ngang lời Đại tá Lergen. Ông ta chỉnh lại điếu xì gà, rít vài hơi rồi lại bắt đầu lên tiếng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000109", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Đại tá Lergen, các ông cần phải thống nhất hơn trong việc trao đổi thông tin nội bộ quân đội đấy. Theo tôi thấy thì… Không, khoan đã.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000110", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Và khi nói vậy, ý ông là sao?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000111", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Tham tán Conrad nhìn vượt qua một Đại tá Lergen đang hoang mang để hướng về phía Tanya, người vẫn giữ im lặng cho đến tận giây phút đó.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000112", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Trên môi ông ta nở một nụ cười ranh mãnh.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000113", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Tanya không thể nào bỏ lỡ biểu cảm đó. Nhà ngoại giao ấy ắt hẳn đã nhận ra sự vênh nhau. Sự khác biệt giữa phương án *giảng hòa có điều kiện* do Đại tá Lergen đề xuất và *lá cờ trắng* do Tanya đề xuất.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000114", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Con tiểu quỷ ngồi cạnh ông đang gợi ý rằng chúng ta nên cầu hòa đấy. Tôi nói có sai không?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000115", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Ý thức được việc cô đang bị săm soi, mình bật ra một tiếng cười sắc lạnh trong lòng. Giá như Tanya không phải là một người lính, cô đã hét toáng lên: *Ông nói chuẩn quá đi chứ!*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000116", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Nhưng mình là một người chuyên nghiệp. Mình hoàn toàn hiểu rõ điều nhà ngoại giao ấy đang nhắm tới. Và hơn hết, mình cảm thấy rất bình tĩnh.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000117", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Mình gần như khâm phục nhà ngoại giao Conrad. Làm thế quái nào mà Đế quốc lại tự đẩy mình vào cảnh khốn cùng đến mức này khi sở hữu một nhà ngoại giao tài năng nhường ấy chứ?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000118", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Vừa thầm bày tỏ sự kính trọng dành cho ông ta, mình vừa lên tiếng đề cập trực tiếp tới vấn đề nhạy cảm mà ai cũng đang né tránh.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000119", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Tôi không ở vào vị thế có thể bác bỏ cách Bộ Ngoại giao đáng kính đây gọi tên hoạt động ngoại giao của mình.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000120", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Tanya không có thẩm quyền gì ở đây. Điều đó có nghĩa là cô cũng chẳng phải gánh bất kỳ trách nhiệm nào. Chuyện đó thì khỏi phải nói. Là một người lính, Tanya chỉ có thể hy vọng và cầu nguyện rằng giới quan chức hành chính sẽ vận dụng năng lực của họ—chính cái tiêu chuẩn do chế độ trọng dụng nhân tài tự xưng của họ đặt ra.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000121", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Và điều tương tự cũng có thể nói về Tanya, bởi ánh mắt của nhà ngoại giao ấy cho thấy rõ rằng ông ta cũng đã đi đến cùng một kết luận như cô.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000122", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Phi thường thật. Thực sự rất ấn tượng đấy, Đại tá Lergen.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000123", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Những chuyện thế này suy cho cùng luôn nằm ở chỗ có thể hiểu được cùng một thứ ngôn ngữ—một ngôn ngữ chung.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000124", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Thật thú vị biết bao khi có thể trân trọng cùng những giá trị như nhau.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000125", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Còn tuyệt vời hơn nữa khi ông ta đã chuẩn bị sẵn một lời mời. Tham tán Conrad đang nhìn Tanya chằm chằm bằng ánh mắt tràn đầy nhiệt huyết đến mức có thể khiến ngay cả chuyên viên nhân sự lão luyện nhất cũng phải ghen tị.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000126", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Cô nghĩ sao về việc sang Bộ Ngoại giao làm việc sau khi rời quân ngũ? Tôi biết việc đó bị coi thường, nhưng tôi sẵn sàng viết một bức thư giới thiệu để bảo lãnh cho cô.” Một sự đánh giá chuẩn xác, một thái độ lịch thiệp và một lời đề nghị đàng hoàng. Những lời mời mọc chẳng thể nào tuyệt vời hơn thế này được nữa! Tham tán Conrad có thể thấy hai má Tanya đã căng phồng lên vì nụ cười chực chờ bung nở nên liền rèn sắt khi còn nóng để chốt hạ thỏa thuận. “Nếu đã vậy, tôi tin mình có thể thúc đẩy chuyện này trót lọt. Cô thấy sao, Trung tá Degurechaff? Quyết định nằm ở cô đấy…”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
