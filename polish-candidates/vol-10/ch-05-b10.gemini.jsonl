{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000327", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Mình lắc đầu.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000328", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Chúng ta đã lâm chiến quá lâu rồi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000329", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Thưa Trung tá?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000330", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Kẻ địch yếu đến mức này, vậy mà số quân bổ sung vẫn phải chật vật với chúng ư? Chuyện gì đã xảy ra với cánh quân bạn ở phương tây của chúng ta vậy? Cục diện ở đây hiện giờ đã tệ hại đến mức nào rồi?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000331", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Chỉ nghĩ tới thôi cũng đủ làm mình đau cả đầu.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000332", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Chúng ta đã chạm trán các pháp sư trên không của Khối Thịnh vượng chung rất nhiều lần, và kẻ ngáng đường Đế quốc lúc nào cũng là lực lượng pháp sư hải quân đánh bộ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000333", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Dù cũng có khả năng mình từng đụng độ họ không chính thức ở những nơi khác nữa.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000334", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "…Cũng rất có khả năng lực lượng pháp sư trên không của Khối Thịnh vượng chung đã tổn thất phần lớn nhân tài. Việc họ đã suy yếu đến mức này mà vẫn gây ra thách thức cho Đế quốc cũng phơi bày sự suy yếu của chính Đế quốc rõ ràng không kém.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000335", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Chiến tranh tạo ra sự thâm hụt khổng lồ về vốn con người.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000336", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Có gì đó không ổn với tất cả chuyện này…”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000337", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Mình lắc đầu gạt đi tạp niệm. Bận tâm đến tình hình nguồn nhân lực của chính quốc đâu phải việc của một chỉ huy chiến trường.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000338", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Đó là việc của cấp trên. Thực ra phải là một vị cấp trên có quân hàm cao hơn mình rất, rất nhiều.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000339", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Một người ở bậc lương của mình chỉ nên nghĩ cách tạo ra chiến quả lớn nhất với tổn thất thấp nhất trên chiến trường mà thôi. Nói cách khác, mình cần mang lại kết quả trên cương vị một người lính—không hơn, không kém.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000340", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Giết kẻ địch vì Tổ quốc thân yêu. Và giết chúng vì cả mảnh đất chúng yêu quý nữa. Chiến tranh cứ nên giữ cho đơn giản thôi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000341", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Mình ra lệnh cho cấp dưới tung thêm các thuật thức phát nổ rồi bật cười chua chát khi thấy bản thân bỗng dưng đa cảm khác thường. Có một phần con người hiện đại, văn minh hơn trong mình vốn chẳng thể nào chấp nhận nổi số sinh mạng mà chúng ta đang tước đoạt. Nhưng mình chẳng qua cũng chỉ là một bánh răng trong một cỗ máy lớn hơn rất nhiều. Chỉ có vậy thôi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000342", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Đó là lý do mình muốn kết thúc cuộc cận chiến quần vòng hiện tại càng nhanh càng tốt.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000343", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Bản thân quân số đã là một thứ vũ khí rồi. Xem ra sẽ tốn kha khá thời gian mới đánh gục được cả một lữ đoàn đủ biên chế đấy.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000344", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Đáng buồn là mọi chuyện lại chẳng diễn ra theo ý mình.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000345", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Dù đang áp đảo chiến trường, mức độ thiệt hại và hỗn loạn mà chúng ta có thể gây ra cho cả một lữ đoàn cũng chỉ có giới hạn. Mình bồi thêm các thuật thức của riêng mình chỗ này chỗ kia để cố đánh tan rã chúng… nhưng nhìn chung quân địch vẫn duy trì được sự gắn kết đội hình đơn vị.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000346", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Biết đâu chúng chỉ đang cố cầm chân chúng ta ở đây? Chí ít, xét về quân số biên chế cơ hữu, có quá nhiều binh lính chỉ hiện diện ở đó cho đủ đầu người. Dù vụng về và kém hiệu quả, hệ thống chỉ huy của chúng vẫn miễn cưỡng vận hành được. Việc điều hành một lữ đoàn như thế hẳn sẽ gây ra áp lực tinh thần khủng khiếp.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000347", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Có lẽ chúng sẽ chẳng trụ nổi qua một hai đợt tấn công nữa đâu.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000348", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Trung úy Grantz, bảo vệ Trung úy Wüstemann rồi đi kết bạn một chút đi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000349", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Ý ngài là kéo chúng ra khỏi chiến tuyến phải không ạ? Rõ!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000350", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Nhạy bén lắm, Trung úy Grantz.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000351", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Grantz đã học hỏi được rất nhiều dưới trướng Tướng Zettour. Giờ cậu ta dễ sử dụng hơn hẳn. Tất cả chuyện này đều là nhờ sự rèn giũa của một sĩ quan cao cấp sao? Mình sẽ phải hỏi vị tướng ấy về phương pháp giảng dạy của ông mới được.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000352", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Trước mắt, mình sẽ phải dựa vào những phương pháp đã qua kiểm chứng của bản thân. Thử thách qua lửa đạn thực chiến là kiểu đào tạo tại chỗ tốt nhất mà mình biết.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000353", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Wüstemann, không cần phải sợ. Cứ bám theo sự dẫn dắt của Grantz và quan sát từng động tác của cậu ấy!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000354", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“R-rõ!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000355", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Tanya trút một cơn mưa hỏa lực nghiền nát một pháp sư địch thành thịt băm trước khi vui vẻ lên tiếng với cấp dưới.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000356", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Thư giãn đi, Trung úy. Nhìn lại bản thân xem. Cậu cần thả lỏng ra.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000357", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Nhưng thưa Trung tá… ch-chẳng phải tôi nên cố giữ sự tập trung sao ạ?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000358", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Đó là câu trả lời nghiêm túc đúng kiểu lính mới non nớt, và nó chẳng lý tưởng chút nào.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000359", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Chắc chắn có những lúc sự tập trung mang tính sống còn, nhưng con người cũng giống như dây cao su vậy. Nếu cứ kéo căng hết cỡ, họ sẽ chỉ đánh mất độ đàn hồi mà thôi. Bảo toàn sức lực khi không cần dùng đến có thể coi là kỹ năng không thể thiếu để sống sót qua các trận đánh.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000360", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Trận chiến không phải thứ cậu có thể tận hưởng nếu cứ cứng nhắc và căng thẳng. Thả lỏng ra một chút rồi nương theo dòng chảy sẽ tốt hơn nhiều. Đó chính là chìa khóa để sống sót trở về đấy.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000361", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Phó chỉ huy của mình bất ngờ góp lời trong lúc thổi bay một toán địch khỏi bầu trời.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000362", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Chỉ vì tò mò thôi, thưa Trung tá, lúc chiến đấu thì ngài nghĩ về chuyện gì vậy ạ?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000363", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Tôi chẳng nghĩ ngợi gì cả. Đó là một bí quyết nghề nghiệp khác đấy. Cứ tùy ý vận dụng đi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000364", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Có một điều mình không thể phủ nhận khi quan sát tiểu đoàn của mình làm việc.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000365", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Ngoại trừ số quân bổ sung, phần lớn đơn vị đều là đám hiếu chiến. Tuy nhiên, họ hành động rất có kiểm soát. Mình sẽ nhắc lại điều này vì nó rất quan trọng: những người lính này vận hành như một cỗ máy được tra dầu trơn tru. Mỗi người trong số họ là một bánh răng bạo lực giữ cho cả tổng thể lớn hơn chạy êm ru.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000366", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Nói cách khác… mình chẳng câu nệ gì về niềm tin của binh lính dưới quyền, miễn sao nó giúp họ không hoảng loạn trên chiến trường.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000367", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Họ có tin vào quái vật mì Ý bay thì mình cũng chẳng bận tâm.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000368", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Chúng ta phải tận tâm và làm việc chăm chỉ suốt nhiều giờ liền. Bên nào làm được điều đó nhiều hơn sẽ giành chiến thắng trong trận đánh này.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000369", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Mình gạt cú vung chém của một pháp sư hải quân đánh bộ đang lao bổ tới rồi đâm xuyên lưỡi kiếm ma pháp qua lưng hắn, miệng lẩm bẩm một mình trước khi buông tiếng thở dài.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter024.xhtml/p000370", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Đến nước này thì kẻ địch của chúng ta đang điên tiết lắm rồi. Cứ làm như nổi giận sẽ giúp chúng đánh giỏi hơn không bằng. Nếu đúng là thế thì mình đã chẳng ngại ngần gì mà tổ chức các buổi kích động thù hận cho chính quân của mình rồi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
