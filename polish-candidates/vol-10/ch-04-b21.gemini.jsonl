{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000521", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Dĩ nhiên, đó chỉ là vì nghĩa vụ đối với công việc hiện tại của mình mà thôi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000522", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Dẫu vậy, thực tế là mình không thể phủ nhận bản thân đã trở nên hết sức chủ quan trước toàn bộ chuyện này. Nếu việc này là vì sự cấp thiết, thế thì tại sao giờ đây Tanya lại biến thành nô lệ của sự cấp thiết chứ?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000523", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Chiến tranh… Đúng là một cuộc kinh doanh điên rồ.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000524", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Làm sao có ai nuốt trôi nổi sự lãng phí tiền của khổng lồ này cơ chứ?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000525", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Đó là còn chưa kể nó đã làm kế hoạch sự nghiệp của mình trật bánh hoàn toàn.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000526", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Tanya von Degurechaff luôn tin tưởng sắt đá rằng mọi con người đều phải có quyền mưu cầu hạnh phúc. Điều đó là hiển nhiên. Đó là một trong những quyền tự nhiên từ lúc chào đời của chúng ta.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000527", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Khốn kiếp tên Being X kia. Làm sao hắn có thể tự xưng là một vị thần trong khi đến cả điều này mà hắn cũng không biết chứ?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000528", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Thế là một sự mâu thuẫn về mặt logic đã nảy sinh.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000529", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Mình không thể để bất kỳ ai cản đường hạnh phúc của mình được.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000530", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Lẽ ra mình chẳng việc gì phải để họ làm thế, và làm như vậy thì hoàn toàn phi lý.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000531", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Nếu họ sai, mình chỉ việc chấn chỉnh họ lại cho đúng.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000532", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Mình cần phải chiến thắng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000533", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Vì một chút bình yên, vì một tương lai khiêm nhường, và vì sự nghiệp của chính mình.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000534", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Và mình cần phải làm điều đó với tư cách một con người.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000535", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "CÙNG NGÀY HÔM ĐÓ, TRÊN BẦU TRỜI EO BIỂN", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000536", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Đêm hôm ấy, các binh sĩ phụ trách tuần tra vùng eo biển đã bị Nữ thần May mắn hoàn toàn ruồng bỏ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000537", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Họ là những người lính xuất sắc.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000538", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Đúng là xuất sắc thật—nhưng nhìn từ một góc độ khác, có thể coi họ là những kẻ làm nô lệ cho chính kỹ năng của mình.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000539", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Khi kết cục của Trận Không chiến Phương Tây đã nghiêng về phía có lợi cho Khối Thịnh vượng chung, các biện pháp đối phó của họ trước sự xuất hiện lẻ tẻ của máy bay trinh sát và những đợt ném bom quấy rối ban đêm từ phía Đế quốc vốn đã được xếp vào hạng mục *công việc thường nhật có độ căng thẳng cao*—một kiểu khái niệm tự mâu thuẫn.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000540", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Ngày nào cũng vẫn là chuyện cũ lặp đi lặp lại, khi họ vừa duy trì một mức độ cảnh giác vừa thả lỏng thần kinh.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000541", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Không may cho bộ phận phòng không, nhịp độ ấy đã bị đảo lộn hoàn toàn khi một biến động dữ dội và tàn bạo ập đến lúc họ không kịp trở tay.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000542", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Một trong những người sống sót qua đêm hôm ấy về sau đã giữ được mạng để kể lại câu chuyện của họ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000543", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Một câu chuyện về *một bóng ma đã giáng xuống vùng eo biển*.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000544", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Fairy 01 gọi tất cả các đơn vị. Bắt đầu tấn công.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000545", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Mệnh lệnh đơn giản được ban ra bằng phương ngữ Đế quốc chuẩn mực tan dần vào bầu trời đêm ngay trước khi một bầy quái vật lộ diện.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000546", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Người đầu tiên nhận ra sự hiện diện của chúng là một nhân viên tại đài kiểm soát không lưu. Các kiểm soát viên không lưu của Khối Thịnh vượng chung đang làm nhiệm vụ trực canh đêm hôm ấy phải trợn tròn đôi mắt ngái ngủ khi máy móc của họ phát hiện ra một tín hiệu ma pháp khổng lồ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000547", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Đã khá lâu rồi họ mới lại thấy một thứ như thế này. Nhưng cũng chưa lâu đến mức khiến họ quên mất điều đó có ý nghĩa gì: Kẻ địch đã tới.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000548", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Chẳng còn thời gian để bắc ấm pha trà nữa. Thay vào đó, giờ đây họ đang hoạt động hoàn toàn nhờ adrenaline. Những người đóng tại khu vực kiểm soát đánh chặn phía nam đã phải đối mặt với một cảnh tượng mà họ có nằm mơ cũng không bao giờ tưởng tượng nổi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000549", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Các tín hiệu ma lực đang tăng vọt! Cái quái gì thế này?! Chúng thậm chí còn chẳng thèm che giấu nó ư?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000550", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Mặc dù tấn công vào ban đêm, kẻ địch lại tự thắp sáng bản thân chẳng khác nào những ngọn hải đăng. Việc đó hoàn toàn đi ngược lại thông lệ trong học thuyết của pháp sư trên không là phải luôn ẩn mình.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000551", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Dẫu chuyện này kỳ lạ đến mức khó tin, có một điều vẫn hoàn toàn chắc chắn—chúng là kẻ địch. Những người lính Khối Thịnh vượng chung hiểu rõ điều đó có nghĩa là gì. Đã đến lúc nghênh đón những vị khách của họ rồi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000552", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Kéo còi báo động! Chuẩn bị chiến đấu!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000553", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Các sĩ quan trực ban lập tức hành động hết sức khẩn trương.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000554", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Chuẩn bị đánh chặn các đơn vị không quân địch! Cho đội phản ứng nhanh sẵn sàng càng sớm càng tốt! Liên lạc với cả các đơn vị khác nữa! Cho lực lượng dự bị cất cánh lên trời luôn đi! Chúng ta sẽ dốc toàn lực giáng vào chúng!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000555", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Nếu kẻ địch đã định nghênh ngang bước vào sân trước nhà họ, quân đội Khối Thịnh vượng chung sẽ dùng mọi nguồn lực sẵn có để nghiền nát chúng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000556", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Trong tiếng còi báo động inh ỏi, toàn bộ các pháp sư trên không đang trực chiến đều nhận lệnh bay lên bầu trời. Để chắc ăn hơn, họ còn cho xuất kích khẩn cấp cả các đơn vị dự bị. Họ cũng đánh thức Trung đoàn 3 dậy và cho dàn hàng trên đường băng, sẵn sàng xuất kích bất cứ lúc nào để phòng hờ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000557", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Đúng lúc các sĩ quan phụ trách bắt đầu cảm thấy nhẹ nhõm trước màn đáp trả có vẻ áp đảo của phe mình cũng như thoáng chút phấn khích khi nghĩ đến việc lập công, một tiếng hét bỗng vang lên xé toạc màn đêm.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000558", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Cái quái—?! Là con quái vật đó!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000559", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Người phụ trách kiểm tra tín hiệu ma lực của địch đã xác định được chính xác danh tính mục tiêu và hét lên đầy kinh hoàng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000560", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Khi trưởng đài kiểm soát không lưu quay sang xem kết quả, thứ đầu tiên đập vào mắt ông là gương mặt cắt không còn giọt máu vì khiếp sợ của nhân viên vận hành.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000561", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Theo cơ sở dữ liệu của chúng ta… đó là Á-Ác quỷ sông Rhine!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000562", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Ác quỷ sông Rhine ư?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000563", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Họ chẳng biết mình đang gặp may hay gặp họa nữa. Trong khi những người trong phòng kiểm soát chưa từng *trực tiếp* chạm trán Pháp sư Định danh kia chỉ biết trân trối nhìn trưởng đài kiểm soát không lưu, thì ông cùng các sĩ quan trực ban khác gần như đồng loạt đá văng ghế khi lao bổ tới chỗ máy bộ đàm vô tuyến.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000564", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Cảnh báo! Cảnh báo! Báo động khẩn cấp tới tất cả các đơn vị trong khu vực tác chiến!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000565", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "Một luồng ớn lạnh chạy dọc sống lưng tất cả bọn họ. Cảm giác ớn lạnh ấy giống như một lời báo hiệu lịch sự rằng thần chết sắp sửa ghé thăm. Họ cần phải hết sức cảnh giác, bằng không sẽ có rất nhiều người phải bỏ mạng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN10/Text/chapter022.xhtml/p000566", "source_sha256": "227b8883d5a8e3130cfe2f54b05e0c3323cf2f3e1c41a6f4c12d99b6452c8f96", "translation": "“Đã xác nhận danh tính quân địch đang tiến vào! Đó là Ác quỷ sông Rhine! Tôi nhắc lại, đó là Ác quỷ sông Rhine! Chúng ta đang đối mặt với các Pháp sư Định danh! Một trong những đơn vị Pháp sư Định danh nguy hiểm chết người nhất đang tiến về phía chúng ta!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
