{"segment_id": "YS-LN02/Text/part0022.xhtml/p000001", "translation": "“Anson…”", "status": "reviewed", "translator": "translator-ch04-b02", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "notes": []}
{"segment_id": "YS-LN02/Text/part0022.xhtml/p000002", "translation": "“Có lẽ cha đã không phải là một người cha tốt, nhưng cha mong một ngày nào đó con sẽ nghĩ về cha như một người cha đáng để con tự hào.”", "status": "reviewed", "translator": "translator-ch04-b02", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "notes": []}
{"segment_id": "YS-LN02/Text/part0022.xhtml/p000003", "translation": "“Không sao đâu. Cha là cha của con mà! À, nhưng cha nên cạo râu đi.”", "status": "reviewed", "translator": "translator-ch04-b02", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "notes": []}
{"segment_id": "YS-LN02/Text/part0022.xhtml/p000004", "translation": "Con bé thật ngoan. Ông bất giác ôm con bé vào lòng; thấy dáng con bé nhột, ông chỉ muốn bật cười.", "status": "reviewed", "translator": "translator-ch04-b02", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "notes": []}
{"segment_id": "YS-LN02/Text/part0022.xhtml/p000005", "translation": "“Con nói đúng. Cha nên ngoan ngoãn cạo râu mới được.”", "status": "reviewed", "translator": "translator-ch04-b02", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "notes": []}
{"segment_id": "YS-LN02/Text/part0022.xhtml/p000006", "translation": "“Chấn chỉnh lại đi, cha!”", "status": "reviewed", "translator": "translator-ch04-b02", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "notes": []}
{"segment_id": "YS-LN02/Text/part0022.xhtml/p000007", "translation": "“Ừ, con nói đúng. Cha phải chấn chỉnh lại mới được.”", "status": "reviewed", "translator": "translator-ch04-b02", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "notes": []}
{"segment_id": "YS-LN02/Text/part0022.xhtml/p000008", "translation": "Sue chỉ có thể cười gượng như thế, với tư cách một người cha. Khoảnh khắc con gái trách ông vì không chịu cạo râu thường xuyên — đó mới là cuộc sống bình thường. Là tinh túy của thế giới thường nhật quý giá đối với ông.", "status": "reviewed", "translator": "translator-ch04-b02", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "notes": []}
{"segment_id": "YS-LN02/Text/part0022.xhtml/p000009", "translation": "“Thế này không được rồi… Đừng lo cho tôi. Tôi muốn nhớ mọi người bằng nụ cười hơn.”", "status": "reviewed", "translator": "translator-ch04-b02", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "notes": []}
{"segment_id": "YS-LN02/Text/part0022.xhtml/p000010", "translation": "“Xin hãy giữ gìn an toàn.”", "status": "reviewed", "translator": "translator-ch04-b02", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "notes": []}
{"segment_id": "YS-LN02/Text/part0022.xhtml/p000011", "translation": "Vợ ông đã bật khóc, vậy mà vẫn can đảm chúc ông mọi điều tốt lành; điều đó khiến tim ông đau nhói. Ông muốn lên tàu cùng họ, sống trọn đời bên nhau. Nhưng ông là một người lính bị ràng buộc bởi bổn phận.", "status": "reviewed", "translator": "translator-ch04-b02", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "notes": []}
{"segment_id": "YS-LN02/Text/part0022.xhtml/p000012", "translation": "*Bổn phận. Agh, cái bổn phận cao cả đáng ghét. Ôi Tổ quốc, con xin hiến mình cho Người. Vậy nên, lạy Chúa, xin Người phù hộ mái nhà con, đất nước mà gia đình con yêu thương.*", "status": "reviewed", "translator": "translator-ch04-b02", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "notes": []}
{"segment_id": "YS-LN02/Text/part0022.xhtml/p000013", "translation": "“Cha à, còn hơi sớm, nhưng… Giáng sinh vui vẻ!”", "status": "reviewed", "translator": "translator-ch04-b02", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "notes": []}
{"segment_id": "YS-LN02/Text/part0022.xhtml/p000014", "translation": "Khi Sue còn đang chìm đắm trong cảm xúc, con gái ông chỉ vào chiếc hòm lớn trước khi lên tàu cùng mẹ, dặn ông nhớ giữ gìn nó cẩn thận.", "status": "reviewed", "translator": "translator-ch04-b02", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "notes": []}
{"segment_id": "YS-LN02/Text/part0022.xhtml/p000015", "translation": "Nhìn họ rời đi, lòng ông thoáng nhẹ nhõm, nhưng cũng buồn vì cuộc chia tay này rất có thể là lần cuối. Dù vậy, có một điều ông nhất quyết không muốn làm: hối tiếc khoảnh khắc này. Tiễn người thân mà rơi nước mắt thì chẳng may mắn chút nào. Ông gắng gượng mỉm cười, rồi chợt nhận ra chiếc hòm đã biến mất. Ông còn đang ngơ ngác thì thấy một người quen cũ đang chìa nó về phía mình, vẻ mặt thản nhiên.", "status": "reviewed", "translator": "translator-ch04-b02", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "notes": []}
{"segment_id": "YS-LN02/Text/part0022.xhtml/p000016", "translation": "“Sue, quà Giáng sinh của con gái cậu đấy. Mang theo đi.”", "status": "reviewed", "translator": "translator-ch04-b02", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "notes": []}
{"segment_id": "YS-LN02/Text/part0022.xhtml/p000017", "translation": "Câu nói kỳ quặc ấy là của Nghị viên Cazor, người có mặt để tiễn những người sơ tán. Tự hỏi sao nghị viên lại biết về món quà của con gái mình, Sue cầm lấy chiếc hòm, rồi ngạc nhiên vì nó nặng bất thường.", "status": "reviewed", "translator": "translator-ch04-b02", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "notes": []}
{"segment_id": "YS-LN02/Text/part0022.xhtml/p000018", "translation": "Bên trong không phải bánh quy hay áo len. Mà là một thứ nặng hơn nhiều.", "status": "reviewed", "translator": "translator-ch04-b02", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "notes": []}
{"segment_id": "YS-LN02/Text/part0022.xhtml/p000019", "translation": "“Nghị viên Cazor, đây là thứ gì vậy?”", "status": "reviewed", "translator": "translator-ch04-b02", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "notes": []}
{"segment_id": "YS-LN02/Text/part0022.xhtml/p000020", "translation": "“Cứ mở ra xem. Đây là một khẩu SMG của hãng A.S. Weapons thuộc Liên minh Waldstätte. Thân súng chắc chắn như LMG.”", "status": "reviewed", "translator": "translator-ch04-b02", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "notes": ["Giữ nguyên tên vũ khí và hãng theo chữ viết tắt/tên nguồn; loại súng được diễn đạt theo mô tả ở đoạn kế tiếp."]}
{"segment_id": "YS-LN02/Text/part0022.xhtml/p000021", "translation": "Theo lời nghị viên, Sue đi vào bóng râm rồi mở hòm. Trước mắt ông là một khẩu tiểu liên mới tinh — mẫu khá đắt tiền, có thể phối hợp tốt với quả cầu của ông. Băng đạn, đạn phép thuật, bộ dụng cụ bảo dưỡng — đầy đủ cả.", "status": "reviewed", "translator": "translator-ch04-b02", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "notes": ["“Quả cầu” theo đề xuất pending hiện có; “đạn phép thuật” là cách gọi mô tả, chưa chốt thuật ngữ."]}
{"segment_id": "YS-LN02/Text/part0022.xhtml/p000022", "translation": "“Sao con bé kiếm được thứ như thế này…?” Ông tiếp tục xem xét, trầm trồ trước kết cấu vừa chắc chắn vừa nhẹ. Khẩu súng dùng cùng cỡ đạn với súng trường của ông, tầm bắn ngắn hơn nhưng dễ thao tác hơn trong cận chiến. Nó sẽ hữu dụng khi đối phó với kẻ nào áp sát ông. Hơn nữa, tầm bắn hạn chế cũng đồng nghĩa nguy cơ vô tình bắn trúng đồng đội thấp hơn tương đối — quả là một ưu điểm lớn.", "status": "reviewed", "translator": "translator-ch04-b02", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "notes": []}
{"segment_id": "YS-LN02/Text/part0022.xhtml/p000023", "translation": "Bởi thế ông mới phải thắc mắc.", "status": "reviewed", "translator": "translator-ch04-b02", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "notes": []}
{"segment_id": "YS-LN02/Text/part0022.xhtml/p000024", "translation": "*Rốt cuộc con gái mình kiếm đâu ra thứ này vậy?*", "status": "reviewed", "translator": "translator-ch04-b02", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "notes": []}
{"segment_id": "YS-LN02/Text/part0022.xhtml/p000025", "translation": "“Quà riêng của một gã Khối Thịnh vượng chung khó ưa. Đồ ăn nước họ thì tệ hại, vậy mà lại gửi cho ta một người tốt bụng, cậu nói có phải không?”", "status": "reviewed", "translator": "translator-ch04-b02", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "notes": ["“Khối Thịnh vượng chung” là phương án pending đã dùng cho tên chính thể; “gã” giữ sắc thái suồng sã của câu nói."]}
{"segment_id": "YS-LN02/Text/part0022.xhtml/p000026", "translation": "“Sao cơ?”", "status": "reviewed", "translator": "translator-ch04-b02", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "notes": []}
{"segment_id": "YS-LN02/Text/part0022.xhtml/p000027", "translation": "“Nghe nói ông ta thấy con gái cậu khóc trong công viên. Ông ta khắc tên viết tắt của cậu lên đó.”", "status": "reviewed", "translator": "translator-ch04-b02", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "notes": []}
{"segment_id": "YS-LN02/Text/part0022.xhtml/p000028", "translation": "“Ồ, A.S. là tên viết tắt của tôi à?”", "status": "reviewed", "translator": "translator-ch04-b02", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "notes": []}
{"segment_id": "YS-LN02/Text/part0022.xhtml/p000029", "translation": "Ông cứ tưởng mấy chữ khắc kia là logo nhà máy; thấy người ta đã bỏ công đến vậy, ông mỉm cười.", "status": "reviewed", "translator": "translator-ch04-b02", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "notes": []}
{"segment_id": "YS-LN02/Text/part0022.xhtml/p000030", "translation": "*Không biết con gái mình tội lỗi hay được trời thương nữa, nhưng con bé đúng là đã mê hoặc được tay tình báo đó… Thỉnh thoảng mấy gã Albion ấy cũng làm được chuyện tử tế.*", "status": "reviewed", "translator": "translator-ch04-b02", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "notes": ["Giữ “Albion” như tên gọi trong nguồn vì ledger/canon chưa xác lập cách chuyển ngữ ở ngữ cảnh này."]}
{"segment_id": "YS-LN02/Text/part0022.xhtml/p000031", "translation": "“Chắc là chữ viết tắt của Arnold & Smith Weapons chứ.”", "status": "reviewed", "translator": "translator-ch04-b02", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "notes": []}
{"segment_id": "YS-LN02/Text/part0022.xhtml/p000032", "translation": "“Không, hình như tên đó được đóng ở mặt dưới.” Nghị viên Cazor giải thích, vẻ mặt dường như thích thú.", "status": "reviewed", "translator": "translator-ch04-b02", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "notes": []}
{"segment_id": "YS-LN02/Text/part0022.xhtml/p000033", "translation": "“Có lẽ gã Khối Thịnh vượng chung phiền phức kia cảm động trước nước mắt của con gái cậu nên giảm giá. Nghe đâu con bé mua được với giá đặc biệt là một trăm pount. Rẻ đến bất ngờ đấy, Đại tá.”", "status": "reviewed", "translator": "translator-ch04-b02", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "notes": ["Nguồn viết “pounts”; giữ dạng phiên âm “pount” thay vì tự sửa thành “pounds”. “Đại tá” theo đề xuất pending."]}
{"segment_id": "YS-LN02/Text/part0022.xhtml/p000034", "translation": "*Cảm ơn con đã tặng cha món quà tuyệt vời thế này, con yêu.* Ông muốn hôn con bé nếu có thể.", "status": "reviewed", "translator": "translator-ch04-b02", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "notes": []}
{"segment_id": "YS-LN02/Text/part0022.xhtml/p000035", "translation": "*…Thì ra sức mạnh của một trăm người là như thế này.*", "status": "reviewed", "translator": "translator-ch04-b02", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "notes": []}
{"segment_id": "YS-LN02/Text/part0022.xhtml/p000036", "translation": "“Tôi tự hào vì có một gia đình hạnh phúc như vậy.”", "status": "reviewed", "translator": "translator-ch04-b02", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "notes": []}
{"segment_id": "YS-LN02/Text/part0022.xhtml/p000037", "translation": "“Xin lỗi, Đại tá. E rằng chúng ta sắp phải đòi hỏi ở cậu quá nhiều.”", "status": "reviewed", "translator": "translator-ch04-b02", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "3ac53161b6e093ba07203f284a400049cf902a3b0f51c0d3e40200867c13ae0a", "notes": ["Dùng “ông” để giữ cách xưng hô trung tính, không suy diễn thêm quan hệ hay thân sơ."]}
