{"segment_id": "YS-LN08/Text/chapter012.xhtml/p000001", "translation": "Những diễn biến tiếp theo xảy ra chỉ trong chớp mắt.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter012.xhtml/p000002", "translation": "Tiểu đoàn Pháp sư Trên không số 203 phản ứng trước đòn tấn công mới đầy bất ngờ này bằng sự mau lẹ xứng tầm những cựu binh dày dạn.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter012.xhtml/p000003", "translation": "Từng pháp sư vừa thực hiện các động tác cơ động né tránh ngẫu nhiên, vừa bắn ra các thuật thức phát nổ để che khuất tầm nhìn của đám phi công tiêm kích địch.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter012.xhtml/p000004", "translation": "Đây có lẽ là tốc độ phản ứng lý tưởng nhất mà một đơn vị bị đánh bất ngờ có thể đạt được. Chẳng ai trở thành dự án cưng của Bộ Tổng tham mưu chỉ nhờ phô trương thanh thế cả. Điều đó đòi hỏi thực lực để cạy mở thách thức ngay khi chúng nảy sinh, ghìm chặt chúng xuống và phá vây đột phá.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter012.xhtml/p000005", "translation": "“Báo cáo thương vong!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter012.xhtml/p000006", "translation": "“Thương vong ở mức tối thiểu!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter012.xhtml/p000007", "translation": "Một câu trả lời thật êm tai từ Serebryakov.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter012.xhtml/p000008", "translation": "Cũng không phải việc quân địch giáng được một đòn vào chúng ta chẳng gây cay cú gì, nhưng việc chúng ta không chịu nhiều tổn thất đã phần nào bù trừ cho cảm giác đó. Mình có thể tự hào về những khoản đầu tư thành công vào giáo dục và vốn con người.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter012.xhtml/p000009", "translation": "Đôi gò má Tanya vừa định giãn ra thành một nụ cười khi cô đảo mắt quét khắp bầu trời, thì nét mặt cô lại đanh cứng trở lại.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter012.xhtml/p000010", "translation": "Đứng yên một chỗ sẽ biến mình thành mục tiêu hoàn hảo cho máy bay tiêm kích địch, nên tất cả đều phải dùng đến các động tác cơ động né tránh thất thường và triển khai thuật thức phát nổ. Tuy nhiên, việc này lại khiến toàn đơn vị bị tản ra quá rộng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter012.xhtml/p000011", "translation": "Đội hình đang tan rã!", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter012.xhtml/p000012", "translation": "“Bám sát người bay yểm trợ của mình! Địch đang lao tới rất nhanh!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter012.xhtml/p000013", "translation": "Cảnh tượng trước mắt khiến Tanya chỉ muốn tặc lưỡi. Các đơn vị khác đều ổn, nhưng đại đội của Wüstemann lại chậm chạp đến mức cô có thể tức chết đi được.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter012.xhtml/p000014", "translation": "“Coi chừng hỏa lực từ bên dưới! Khốn kiếp, cái quái gì thế này?! Đám Cộng sản đã trở nên thực sự sành sỏi trong khoản quấy rối người khác rồi đấy!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter012.xhtml/p000015", "translation": "“Ý tôi là, chúng là dân Cộng sản mà!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter012.xhtml/p000016", "translation": "“Thế thì sao nào?!” Tanya vặn lại mà không kịp nghĩ. Và câu đáp trả của viên sĩ quan phụ tá cực kỳ dí dỏm… hoặc biết đâu lại hoàn toàn nghiêm túc.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter012.xhtml/p000017", "translation": "“Chẳng phải chính Trung tá từng nói bản chất của chúng vốn là vậy sao ạ?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter012.xhtml/p000018", "translation": "“Ààà, ừ, cô nói đúng. Tôi đoán cũng hợp lý thôi khi ngay cả trong chiến tranh chúng cũng học được cách làm những chuyện khiến người ta ghét cay ghét đắng.” Nén lại cơn thôi thúc tặc lưỡi, Tanya thừa nhận trình độ của quân địch. Khi quân của cô tản ra, lấy độ cao nhằm xua đuổi đám pháp sư địch đang không cho họ có lấy một góc bắn tử tế nào, thì máy bay tiêm kích của Liên bang lại quay trở lại hiện trường.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter012.xhtml/p000019", "translation": "Phi cơ địch kiên trì bám sát chiến thuật đánh rồi rút, trút sạch đạn pháo tự động rồi nhanh chóng thoái lui.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter012.xhtml/p000020", "translation": "Độ cao và tốc độ của chúng quá khác biệt so với chúng ta đến mức việc phản kích gần như là bất khả thi. Đã thế, chúng ta còn có khách không mời từ bên dưới—và đó không chỉ là một đòn tấn công bồi thêm.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter012.xhtml/p000021", "translation": "Nhưng cũng chỉ có vậy mà thôi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter012.xhtml/p000022", "translation": "Theo những gì mình biết, chẳng có quy luật logic hay lý do nào khiến thất bại liên tiếp trở thành điều tất yếu cả. Mình không bao giờ bỏ cuộc. Sai lầm đơn giản là cần được khắc phục.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter012.xhtml/p000023", "translation": "Tanya hít một hơi khẽ nhưng sâu.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter012.xhtml/p000024", "translation": "Xốc lại quyết tâm, cô thét lớn: “Đúng là một lũ anh hùng rơm, dám mò tới thách chúng ta đánh cận chiến! Mấy gã Liên bang này hẳn phải mê lưỡi kiếm ma pháp lắm, vậy nên hãy nhồi đầy bụng chúng thứ đó cho đến khi chúng phát ngấy thì thôi!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter012.xhtml/p000025", "translation": "Dĩ nhiên chính Weiss, người dẫn đầu đội tiên phong dày dạn kinh nghiệm, đã xung phong đi đầu. “Xin phép tiến hành như thường lệ chứ ạ…?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter012.xhtml/p000026", "translation": "“Chuẩn y. Đi đi!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter012.xhtml/p000027", "translation": "Anh ta vừa dứt câu “Rõ, thưa Trung tá” là đã lao vút đi nghênh chiến. Thế mới đúng là tâm đầu ý hợp.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter012.xhtml/p000028", "translation": "“Toàn đại đội, theo tôi! Xung phong!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter012.xhtml/p000029", "translation": "“Yểm trợ cho họ!” Tanya thúc giục đại đội của Wüstemann di chuyển.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter012.xhtml/p000030", "translation": "“Bắn yểm trợ ba loạt!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter012.xhtml/p000031", "translation": "Việc họ vẫn xoay xở bắn được bài bản bất chấp tình thế gấp gáp có lẽ đồng nghĩa với việc cuối cùng họ cũng đang dần quen với thực chiến.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter012.xhtml/p000032", "translation": "Chừng nào mình còn có thể tin tưởng họ không bắn nhầm, thì việc để họ chuyên trách vai trò yểm trợ sẽ ổn cả thôi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter012.xhtml/p000033", "translation": "“Wüstemann! Cứ phát huy như thế! Nhưng không cần phải bắn vô cớ đâu!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter012.xhtml/p000034", "translation": "“Đã rõ!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter012.xhtml/p000035", "translation": "Chưa bàn đến chuyện khác, ít nhất thì cách anh ta đáp nhận lệnh cũng ở mức chấp nhận được.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter012.xhtml/p000036", "translation": "Không, cay nghiệt chỉ vì họ thiếu kinh nghiệm thì chẳng hay ho gì. Kinh nghiệm là thứ có thể tích lũy được. Không phân biệt được giữa thiếu năng lực và thiếu kinh nghiệm thì khó mà gọi là công bằng. Mà đối với Tanya, sự công bằng là điều hiển nhiên.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter012.xhtml/p000037", "translation": "Có lẽ việc ở trên chiến trường quá lâu đã khiến mình trở nên hiếu chiến. Cũng có thể đó là áp lực từ mệnh lệnh tử thủ vô lý của Tướng von Zettour.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter012.xhtml/p000038", "translation": "“Đây không phải chuyện mình cần bận tâm ngay lúc này.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter012.xhtml/p000039", "translation": "Tanya khẽ lắc đầu để gạt bỏ tạp niệm và tập trung trở lại vào trận đánh. Thời cơ thật hoàn hảo. Quân địch đang bận đối phó với đợt xung phong của Weiss… và phần còn lại của chúng ta đã vào đội hình tập kích.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter012.xhtml/p000040", "translation": "Đến lúc rồi. Tanya nhìn sang viên sĩ quan phụ tá của mình. “Trung úy Serebryakov, chúng ta sẽ nối gót Weiss mở đợt xung phong của riêng mình. Chuyện này cũng chẳng khác gì mọi khi, nhưng… hãy canh chừng hướng sáu giờ cho tôi. Đặc biệt cảnh giác với máy bay địch có thể lao bổ vào.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter012.xhtml/p000041", "translation": "“Rõ, thưa Trung tá.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter012.xhtml/p000042", "translation": "“Được rồi, đi thôi. Tất cả, theo tôi!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
{"segment_id": "YS-LN08/Text/chapter012.xhtml/p000043", "translation": "Tăng tốc, tăng tốc, và tăng tốc hơn nữa.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "notes": []}
