{"id": "YS-LN08/Text/chapter018.xhtml/p000055", "segment_id": "YS-LN08/Text/chapter018.xhtml/p000055", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "*Chuyện đó sẽ gay go đây…* Zettour nhăn mặt khi bắt gặp chính mình đang cân nhắc bài toán cân bằng tổng thể.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter018.xhtml/p000056", "segment_id": "YS-LN08/Text/chapter018.xhtml/p000056", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "*Lúc này đó đâu phải là phần việc của mình.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter018.xhtml/p000057", "segment_id": "YS-LN08/Text/chapter018.xhtml/p000057", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "*Dù tốt hay xấu, mình cũng đã bị nhổ khỏi vị trí cũ và chẳng còn lựa chọn nào khác ngoài việc phải kiếm sống ngay tại tiền tuyến này.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter018.xhtml/p000058", "segment_id": "YS-LN08/Text/chapter018.xhtml/p000058", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Hửm?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter018.xhtml/p000059", "segment_id": "YS-LN08/Text/chapter018.xhtml/p000059", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Đột nhiên, chiếc xe rung mạnh, và những giọng nói căng thẳng hét lên qua máy vô tuyến.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter018.xhtml/p000060", "segment_id": "YS-LN08/Text/chapter018.xhtml/p000060", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Phát hiện quân địch! Chúng ở hướng một giờ… là xe tăng địch!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter018.xhtml/p000061", "segment_id": "YS-LN08/Text/chapter018.xhtml/p000061", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Đã chạm trán địch. Mà lại là lực lượng thiết giáp rất khó lẩn tránh. Những kẻ địch có tốc độ cao lúc nào cũng khiến Zettour bực bội đến tận xương tủy.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter018.xhtml/p000062", "segment_id": "YS-LN08/Text/chapter018.xhtml/p000062", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Ông vốn đã chuẩn bị tinh thần cho một trận tao ngộ chiến nhưng vẫn hy vọng họ có thể tránh được nó. Nhìn từ một góc độ khác, họ có thể đụng độ với kẻ địch rắc rối nhất khi đang ở trạng thái ít suy yếu nhất—nhưng tốt nhất vẫn là làm việc đó sau khi đã đột phá tới được Soldim 528.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter018.xhtml/p000063", "segment_id": "YS-LN08/Text/chapter018.xhtml/p000063", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Chuẩn bị giao chiến! Coi chừng pháo chống tăng, bắn hạ hết bọn chúng đi!” Đó là lời khích lệ hào sảng của Cramm vang lên qua máy vô tuyến. Zettour sực tỉnh và nhìn chằm chằm về phía quân địch. Đó là một cụm xe tăng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter018.xhtml/p000064", "segment_id": "YS-LN08/Text/chapter018.xhtml/p000064", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Khi ông ngoái nhìn chiếc xe của Cramm để xem vị chỉ huy ấy định làm gì… có vẻ như ông ta hoàn toàn không có ý định lùi lại.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter018.xhtml/p000065", "segment_id": "YS-LN08/Text/chapter018.xhtml/p000065", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Mà tất nhiên là không rồi. Xe tăng chỉ huy nhất định phải đi đầu. Ngay khi trung đội vọt lên phía trước, trung đoàn xe tăng liền bắt đầu triển khai những đường cơ động phối hợp phức tạp nhằm bắn trả quân địch.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter018.xhtml/p000066", "segment_id": "YS-LN08/Text/chapter018.xhtml/p000066", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Xe tăng của Cramm đã tiến vào tầm bắn, và khẩu pháo chính của nó bắt đầu gầm vang. *Nào, để xem họ sẽ làm thế nào đây…?* Háo hức muốn tận mắt quan sát, Zettour cầm ống nhòm lên và mở sổ tay ra, nhưng đúng lúc đó, một bức điện không ngờ tới lại truyền đến.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter018.xhtml/p000067", "segment_id": "YS-LN08/Text/chapter018.xhtml/p000067", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Thưa Tướng quân, xin ngài hãy lùi về phía sau.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter018.xhtml/p000068", "segment_id": "YS-LN08/Text/chapter018.xhtml/p000068", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Ông không khỏi bối rối trước giọng nói của vị tư lệnh sư đoàn vọng ra từ ống nghe. Nếu phải gọi đúng tên, thì những lời ấy thật *thô lỗ*. Ông hoàn toàn chẳng thể hiểu nổi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter018.xhtml/p000069", "segment_id": "YS-LN08/Text/chapter018.xhtml/p000069", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Chỉ huy Cramm? Thứ lỗi cho tôi, nhưng tôi không hiểu ý ông.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter018.xhtml/p000070", "segment_id": "YS-LN08/Text/chapter018.xhtml/p000070", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Cái gì cơ?!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter018.xhtml/p000071", "segment_id": "YS-LN08/Text/chapter018.xhtml/p000071", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Tại sao ông lại gạt tôi ra ngoài? Xe của ông vẫn ở lại cơ mà, đúng không?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter018.xhtml/p000072", "segment_id": "YS-LN08/Text/chapter018.xhtml/p000072", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Máy vô tuyến lập tức quát vang. “Thưa Tướng quân! Tôi đang ngồi trong xe tăng! Nó có bọc giáp đấy!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter018.xhtml/p000073", "segment_id": "YS-LN08/Text/chapter018.xhtml/p000073", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Hẳn Cramm đang gào đến đỏ bừng cả mặt, nhưng… thế thì sao chứ? Nhận định của ông ta rằng ngồi trên một chiếc xe không bọc giáp là quá nguy hiểm thì, ừ, quả có xác đáng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter018.xhtml/p000074", "segment_id": "YS-LN08/Text/chapter018.xhtml/p000074", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Xác đáng thật đấy, nhưng điều đó chẳng có ý nghĩa gì cả.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter018.xhtml/p000075", "segment_id": "YS-LN08/Text/chapter018.xhtml/p000075", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Tôi rất cảm kích lời cảnh báo đó, Chỉ huy Cramm. Nhưng ông không cần phải lo đâu.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter018.xhtml/p000076", "segment_id": "YS-LN08/Text/chapter018.xhtml/p000076", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Hả?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter018.xhtml/p000077", "segment_id": "YS-LN08/Text/chapter018.xhtml/p000077", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Tôi đã bảo với ông là tôi mượn các pháp sư đi theo hộ tống rồi, đúng chứ? Họ sẽ lo liệu việc đó. Đừng bận tâm đến tôi; ông cứ tiếp tục đánh trận của mình đi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter018.xhtml/p000078", "segment_id": "YS-LN08/Text/chapter018.xhtml/p000078", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Nói đoạn, Zettour đưa ống nghe ra khỏi tai, và Grantz, giận đến gần như sùi bọt mép, hét lên với ông đầy vẻ không thể tin nổi. “Thưa Tướng quân!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter018.xhtml/p000079", "segment_id": "YS-LN08/Text/chapter018.xhtml/p000079", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Theo báo cáo của Trung tá von Degurechaff, đã có tiền lệ sử dụng pháp sư làm lớp giáp bảo vệ trong chiến thuật tùng thiết trên xe tăng—và chính anh là người đã thực hiện thành công việc đó đấy.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter018.xhtml/p000080", "segment_id": "YS-LN08/Text/chapter018.xhtml/p000080", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Nhưng lúc đó là ngồi trên *xe tăng*! Bản thân nó vốn đã có bọc giáp rồi!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter018.xhtml/p000081", "segment_id": "YS-LN08/Text/chapter018.xhtml/p000081", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "*Cramm, rồi cả Grantz nữa—bộ cả hai người họ chỉ biết lặp đi lặp lại mỗi ngần ấy lời thôi sao?* Zettour chau mày.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter018.xhtml/p000082", "segment_id": "YS-LN08/Text/chapter018.xhtml/p000082", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Có lẽ người ta thời nay quá câu nệ chuyện giáp trụ, nhưng… điều đó cũng khiến ông lo ngại về mô thức tư duy hiện tại.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter018.xhtml/p000083", "segment_id": "YS-LN08/Text/chapter018.xhtml/p000083", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Trung úy Grantz này, lớp giáp đúng là quan trọng, nhưng nó cũng chỉ là công nghệ. Mà xét đến cùng, công nghệ chỉ là công cụ, chứ không phải thứ chúng ta có thể để mặc cho nó chi phối mình.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter018.xhtml/p000084", "segment_id": "YS-LN08/Text/chapter018.xhtml/p000084", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Chỉ cần một phát đạn lạc găm trúng chiếc xe mui trần này thôi là ngài sẽ nói khác ngay đấy! Lớp giáp đâu phải chỉ để làm cảnh!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter018.xhtml/p000085", "segment_id": "YS-LN08/Text/chapter018.xhtml/p000085", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "*À.* Zettour khẽ gật đầu. Ý kiến của Grantz hoàn toàn xác đáng đối với một người ở vào vị trí của anh.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter018.xhtml/p000086", "segment_id": "YS-LN08/Text/chapter018.xhtml/p000086", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Việc hộ tống một chiếc xe đa dụng đương nhiên khó khăn hơn nhiều so với việc yểm trợ một chiếc xe tăng. Đáng tiếc là Zettour tuyệt đối không thể làm theo lời khuyên của anh được.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter018.xhtml/p000087", "segment_id": "YS-LN08/Text/chapter018.xhtml/p000087", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Vậy thì sao? Anh đang bảo tôi rằng nếu địch bắn về phía chúng ta, tôi nên kiếm lớp giáp nào đó mà nấp vào phía sau ư? Tôi biết phải làm gì với lời đề nghị ấy đây, Trung úy?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter018.xhtml/p000088", "segment_id": "YS-LN08/Text/chapter018.xhtml/p000088", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Khi gương mặt viên trung úy trẻ tuổi đanh lại vì không sao tin nổi, có lẽ ngay cả đôi chút khinh thường trước sự liều lĩnh của ông cũng thoáng hiện lên trong tâm trí anh.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter018.xhtml/p000089", "segment_id": "YS-LN08/Text/chapter018.xhtml/p000089", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Mà quả thực ông đang hành động thiếu thận trọng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter018.xhtml/p000090", "segment_id": "YS-LN08/Text/chapter018.xhtml/p000090", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Tham dự một trận đấu tăng trên một chiếc ô tô đơn thuần về cơ bản chẳng khác nào tự biến mình thành tấm bia ngon ăn. Ông thầm xin lỗi vì đã bắt mọi người phải gánh chịu rắc rối do mình gây ra. Nhưng điều đó là cần thiết.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter018.xhtml/p000091", "segment_id": "YS-LN08/Text/chapter018.xhtml/p000091", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Trong công việc nhà binh, chỉ riêng hai chữ—*cần thiết*—đã đủ để biện minh cho mọi thứ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter018.xhtml/p000092", "segment_id": "YS-LN08/Text/chapter018.xhtml/p000092", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Trung úy này, tôi đã ép bằng được để thông qua chiến dịch giải cứu Kampfgruppe Lergen. Nếu chính người đề xuất chiến dịch lại rút lui, điều đó có thể khiến người ta thấy cơ hội thành công là bất khả thi và quyết định đình chỉ toàn bộ kế hoạch. Nếu tôi viện cớ như vậy, cuộc giải cứu có lẽ sẽ chẳng thể diễn ra.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter018.xhtml/p000093", "segment_id": "YS-LN08/Text/chapter018.xhtml/p000093", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Với tất cả lòng kính trọng, thưa Tướng quân, đây là một hoạt động quân sự chính thức cơ mà!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter018.xhtml/p000094", "segment_id": "YS-LN08/Text/chapter018.xhtml/p000094", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Đó là một câu trả lời rất đúng mực của một quân nhân.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter018.xhtml/p000095", "segment_id": "YS-LN08/Text/chapter018.xhtml/p000095", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "*Đó là nếu như cậu ta thực sự tin vào điều ấy.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter018.xhtml/p000096", "segment_id": "YS-LN08/Text/chapter018.xhtml/p000096", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "Zettour không cho rằng bản thân Grantz nắm rõ mọi uẩn khúc, nhưng ông biết anh từng được trui rèn dưới trướng Degurechaff. Anh đã dày dạn kinh nghiệm đến mức được nhìn nhận như một sĩ quan thạo việc, và những người như thế đều hiểu rất rõ việc lời giải thích chính thức đi trệch khỏi thực tế ra sao.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"id": "YS-LN08/Text/chapter018.xhtml/p000097", "segment_id": "YS-LN08/Text/chapter018.xhtml/p000097", "source_sha256": "b5e55889614fa6fbd3f59c099ac5b761978d880d2feea29cd7355a432a65d2a4", "translation": "“Anh định nói rằng mình không biết chuyện gì sẽ xảy ra nếu chính người đề xuất chiến dịch lại bỏ chạy sao? Hiển nhiên là phản ứng của quân ta sẽ chững lại. Không có một đòn tấn công mạnh mẽ, tôi e rằng chúng ta chẳng thể phá vỡ được vòng vây đâu.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
