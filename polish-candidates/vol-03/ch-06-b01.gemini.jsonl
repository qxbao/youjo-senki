{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000002", "translation": "NGÀY 22 THÁNG 9, NĂM THỐNG NHẤT 1925, LỤC ĐỊA PHÍA NAM", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000003", "translation": "“Chúng tôi sẽ tiêu diệt toàn bộ pháo binh địch. Thiếu tá von Degurechaff, còn đơn vị của cô thì sao?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000004", "translation": "“Hả? Nối lại liên lạc cho tôi!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000005", "translation": "“Nối cho tôi gặp sở chỉ huy! Chúng ta đang bị gây nhiễu tín hiệu, 1105! Yêu cầu chuyển sang đường truyền vòng!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000006", "translation": "Sở chỉ huy dã chiến lâm thời đang náo loạn vì sự cố gián đoạn tín hiệu.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000007", "translation": "Trên mặt trận phía nam nơi giao tranh leo thang nhanh chóng, ai nấy đều đã mất bình tĩnh.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000008", "translation": "…Chà, ở mặt trận Rhine cũng từng y như vậy. Giữ được vẻ điềm tĩnh trên chiến trường mới là chuyện lạ. Và đây là Tanya, những tháng ngày của nó nơi vùng đất phương nam cũng chẳng khác gì những ngày ở phía tây.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000009", "translation": "Nó thừa biết phải thử nối máy tới sở chỉ huy qua đường dây hữu tuyến khi mạng vô tuyến không thể kết nối.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000010", "translation": "Nó gần như đã trải qua đủ mọi loại sự cố thông tin liên lạc trong chiến đấu có thể xảy ra ở cả chiến tranh chiến hào lẫn tác chiến cơ động cao. Vốn thông thạo các biện pháp đối phó, nó chẳng hề hoảng loạn trước rắc rối ở mức độ này mà lập tức rà soát theo danh mục các bước cần thực hiện. Các nhân viên điện đài tức tốc mở một đường dây hữu tuyến nối tới sở chỉ huy.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000011", "translation": "Hiệu suất làm việc của họ rất đáng khen ngợi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000012", "translation": "Bất chấp chuỗi chỉ huy bị gián đoạn chớp nhoáng, họ vẫn ứng phó không chút do dự.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000013", "translation": "Nhưng sau một cuộc trao đổi ngắn, mặt mày họ tái mét.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000014", "translation": "“Không phải bị gây nhiễu đâu ạ! Không có chút tạp âm nào cả! Chúng ta vẫn kết nối rõ ràng với các đơn vị trong khu vực! Vấn đề nằm ở sự cố máy móc bên phía Tiểu đoàn 44!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000015", "translation": "*A, chết tiệt thật.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000016", "translation": "Nó thầm rủa trong đầu vì biết rõ chuyện đó có ý nghĩa gì trên các phòng tuyến Rhine. Chắc chắn bất kỳ ai từng trải qua lửa đạn rửa tội trên mặt trận ấy cũng đều hiểu như vậy.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000017", "translation": "“Tiếp tục gọi đi! Sóng ngắn cũng được. Kiểm tra lại thiết bị của chúng ta thêm một lần nữa để phòng hờ! Nhanh lên!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000018", "translation": "Nó muốn gửi gắm hy vọng vào một khả năng mong manh, nhưng thực tâm không trông đợi gì.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000019", "translation": "Đôi khi trên chiến trường, thà làm một kẻ bi quan và lường trước tình huống tồi tệ nhất còn hơn là nuôi hy vọng. Hy vọng rất quan trọng, nhưng nếu phụ thuộc vào thứ thuốc giảm đau morphine đó trong chiến đấu thì cầm chắc sự hủy diệt.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000020", "translation": "Chắc có thể nói là mọi sự đang diễn ra đúng như dự tính nhỉ? Một nhân viên điện đài lập tức kiểm tra máy móc, nhưng thiết bị vẫn bình thường. Toàn bộ máy móc đều đang vận hành ổn định. Họ quả quyết rằng nếu mọi thứ ở đây đều ổn, thì tức là Tiểu đoàn Pháp sư 44 đang gặp sự cố máy móc.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000021", "translation": "Nếu đúng là vậy thì gay go rồi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000022", "translation": "Đây là trận tác chiến cơ động cao trên Sa mạc Barbad. Nếu họ không thể liên lạc với sở chỉ huy của Kampfgruppe Bảy, đội tiên phong ở cánh trái, hậu quả sẽ không chỉ dừng lại ở sự hỗn loạn trong chuỗi chỉ huy.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000023", "translation": "*Chuyện gì đang xảy ra thế này?* Các sĩ quan bắt đầu thấy bực bội, nhưng họ đủ tự chủ để không để lộ vẻ bực bội ra mặt.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000024", "translation": "Một nguyên lý hiển nhiên là nếu các sĩ quan dao động không cần thiết trước mặt binh lính dưới quyền, sự hỗn loạn sẽ gia tăng nhanh chóng. Ngay cả viên sĩ quan non nớt nhất là Thiếu úy Grantz cũng biết điều đó.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000025", "translation": "“Chúng tôi đã thiết lập được liên lạc! Trên tần số sóng ngắn!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000026", "translation": "“Mật mã xác nhận trùng khớp!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000027", "translation": "Trong một thoáng, bầu không khí nhẹ nhõm lan tỏa khắp sở chỉ huy dã chiến lâm thời.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000028", "translation": "Tanya không khỏi có cái nhìn tỉnh táo về chuyện đó. *Mình đoán các sĩ quan trẻ tuổi và những kẻ ít kinh nghiệm hơn không thể không suy nghĩ theo chiều hướng tích cực nhỉ?*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000029", "translation": "Ngay cả với một người có tư duy logic và đầu óc kinh tế, việc hình thành thói quen luôn lường trước tình huống tồi tệ nhất cũng chẳng hề dễ dàng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000030", "translation": "Điều đó thậm chí còn đúng trong cả những thương vụ tài chính vốn chẳng phải chuyện sinh tử. Logic của kinh tế học hành vi đã chỉ ra điều ấy một cách xuất sắc khi áp dụng vào các bong bóng kinh tế và khủng hoảng. *Ắt hẳn việc vừa giữ thái độ lạc quan vừa chuẩn bị cho tình huống tồi tệ nhất trên chiến trường là rất khó đối với những người chưa có đủ kinh nghiệm này*, Tanya thầm càu nhàu trong đầu.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000031", "translation": "“Thiếu tá von Leinburg đã tử trận!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000032", "translation": "Đó là tin tức tồi tệ nhất, nhưng chưa hẳn đã trở thành một thảm họa, nên nó cũng thấy nhẹ nhõm theo cách của riêng mình.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000033", "translation": "Nó kín đáo đưa mắt nhìn quanh sở chỉ huy, thấy các cựu binh đều nắm bắt tình hình rất tốt và đang vắt óc tìm cách kiểm soát cục diện. Xem chừng mọi chuyện sẽ không trượt dài thành một cơn hoảng loạn gây tổn hại.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000034", "translation": "*Không tệ.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000035", "translation": "Khi bị chỉ trích và điều tới phương nam vì định tự ý hành động và suýt chống lệnh, điểm sáng trong cái rủi là nó đã có thể mang theo tiểu đoàn của mình. Nhờ vậy, thời gian nó phải bỏ ra để huấn luyện được giảm đi một nửa.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000036", "translation": "Không, nếu giao phó một phần công việc đó cho các thuộc cấp, nó lại có thể giảm đi một nửa nữa.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000037", "translation": "Nói cách khác, thay vì phải tự mình huấn luyện tất cả mọi người, nó chỉ phải gánh 25 phần trăm gánh nặng thời gian và công sức mà thôi. Thế mới gọi là hiệu quả chứ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000038", "translation": "Dù sao đi nữa, bất kỳ tổ chức xuất sắc nào cũng được bảo dưỡng liên tục để các bánh răng của nó không bị hoen gỉ. Con người chính là bộ máy cốt lõi của một tổ chức. Và lẽ tự nhiên, quân đội luôn tính cả số ca tử trận vào quá trình hoạch định và duy trì tổ chức.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
