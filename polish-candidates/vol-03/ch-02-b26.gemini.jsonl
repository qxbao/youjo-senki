{"segment_id": "YS-LN03/Text/chapter002_004.xhtml/p000763", "translation": "Vì vậy, de Lugo muốn tập hợp toàn bộ binh lực còn lại nhằm chuẩn bị cho cuộc phản công. Ông muốn có được từng người lính mà mình có thể gom góp.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter002_004.xhtml/p000764", "translation": "Nhưng do bản chất của chiến dịch, ông đang phải đối mặt với nỗi ám ảnh muôn thuở của mọi vị chỉ huy: thời gian.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter002_004.xhtml/p000765", "translation": "Một mặt, càng mất nhiều thời gian thì nguy cơ kế hoạch bị rò rỉ càng cao. Nếu chuyện đó xảy ra, lực lượng vốn sẽ trở thành hạt nhân cho đạo quân kháng chiến của ông có thể bị tấn công.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter002_004.xhtml/p000766", "translation": "Mặt khác, xét đến tác động tâm lý của việc bỏ rơi các đồng minh đang cấp tốc kéo tới hội quân, ông không thể rời đi một cách dễ dàng như thế.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter002_004.xhtml/p000767", "translation": "Lẽ dĩ nhiên, quyết định này hết sức cấp bách.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter002_004.xhtml/p000768", "translation": "“…Còn đội đặc nhiệm thì sao? Khi nào họ sẽ tới đây?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter002_004.xhtml/p000769", "translation": "Chính trong hoàn cảnh ngặt nghèo đó mà de Lugo đang ngóng đợi đội đặc nhiệm tinh nhuệ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter002_004.xhtml/p000770", "translation": "Họ là một nhóm pháp sư được thành lập để thực hiện những nhiệm vụ đặc biệt. Tướng de Lugo kỳ vọng sức mạnh và kinh nghiệm của Trung tá Vianto cùng những người sống sót sau trận Arene sẽ là sự trợ giúp to lớn.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter002_004.xhtml/p000771", "translation": "Bộ Tổng tham mưu cũng biết rằng nếu những pháp sư đó xoay xở hội quân được với những người còn lại, số lượng phương án trong tay họ sẽ tăng lên đáng kể. Nhưng đúng là việc chờ đợi tiềm ẩn rủi ro.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter002_004.xhtml/p000772", "translation": "“Dự kiến họ sẽ đến nơi trong khoảng mười tiếng nữa. Tuy nhiên, vì họ xuất phát từ Parisii nên có khả năng họ đang bị truy kích…”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter002_004.xhtml/p000773", "translation": "*…Nếu họ đang bị bám đuôi, trong trường hợp tệ nhất, quân Đế quốc sẽ nhận ra chúng ta đang ở đây.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter002_004.xhtml/p000774", "translation": "*Nếu chúng nhận ra, mọi công sức của chúng ta từ trước đến giờ sẽ đổ sông đổ bể cả.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter002_004.xhtml/p000775", "translation": "Đó là một khả năng đáng sợ. Trong hoàn cảnh hiện tại của họ, điều đó là không thể chấp nhận được. *Chúng ta có nên bỏ họ lại không?* Một số sĩ quan tham mưu, đặc biệt là các sĩ quan thuộc hạm đội, có cùng quan điểm đó.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter002_004.xhtml/p000776", "translation": "“…Chúng ta sẽ khởi hành sau mười tiếng nữa. Các pháp sư hẳn có thể đuổi kịp chúng ta trên mặt biển, đúng chứ? Trước mắt, hãy bốc xếp lên tàu nhiều nhất có thể trong khoảng thời gian đó.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter002_004.xhtml/p000777", "translation": "“Rõ.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter002_004.xhtml/p000778", "translation": "Nhưng de Lugo quyết định chờ đợi đến tận giây phút cuối cùng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter002_004.xhtml/p000779", "translation": "Ông đang đánh một canh bạc, đẩy cả không gian khoang hàng lẫn thời gian tới tận giới hạn. Đúng vậy, việc này tiềm ẩn rủi ro rất cao. Nhưng những pháp sư đó là một tài sản quý giá. Nếu có thể xoay xở tiếp nhận họ, điều đó chắc chắn sẽ gia tăng đáng kể hỏa lực của lực lượng kháng chiến về sau.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter002_004.xhtml/p000780", "translation": "“Quan trọng hơn, còn tuyến hải trình thì sao?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter002_004.xhtml/p000781", "translation": "“Báo cáo liên lạc mới nhất từ Hạm đội Hộ tống số Hai cho biết toàn tuyến đều thông suốt và an toàn.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter002_004.xhtml/p000782", "translation": "Và tối quan trọng hơn cả là…", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter002_004.xhtml/p000783", "translation": "May mắn thay, vùng biển này vẫn chưa chịu ảnh hưởng của Đế quốc. Hải quân Đế quốc tự tin rằng họ đã chế áp được Hải quân Cộng hòa, nhưng điều đó chỉ miễn cưỡng đúng trong một số hoàn cảnh nhất định mà thôi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter002_004.xhtml/p000784", "translation": "Họ vẫn còn đủ thực lực để cho Đế quốc thấy rằng tấn công trực diện không phải là cách duy nhất để một lực lượng hải quân giao chiến.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter002_004.xhtml/p000785", "translation": "Hơn nữa, với mục tiêu kiềm chế hải quân của Khối Thịnh vượng chung và Cộng hòa, Hải quân Đế quốc thường có xu hướng rơi vào lối tư duy “hạm đội hiện hữu”. Thật khó hình dung cảnh họ kéo ra khơi đánh một trận quyết chiến.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter002_004.xhtml/p000786", "translation": "Suy cho cùng, khi có Hải quân của Khối Thịnh vượng chung đứng về phía mình, chính de Lugo cùng các đồng minh mới là bên giành phần thắng. Quân đội Đế quốc dường như không có nhiều sự linh hoạt về mặt chiến lược.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter002_004.xhtml/p000787", "translation": "“Điện báo từ Phân đội Tàu ngầm Độc lập số Mười Bốn. Không phát hiện địch. Tuyến hải trình thông suốt.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter002_004.xhtml/p000788", "translation": "Họ đã gặp may khi Lục quân Đế quốc vẫn chưa đánh hơi thấy chuyện gì. Nếu bị phát hiện, không đời nào những con tàu chất đầy vật tư tiếp tế lại được phép thoát đi. Chí ít thì hiện tại vẫn chưa có dấu hiệu cản trở nào.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter002_004.xhtml/p000789", "translation": "Xét theo cung cách hành sự của quân Đế quốc, rất có thể phải mất một lúc lâu nữa họ mới nhận ra. Dĩ nhiên, một khi chiến dịch rút thoát bắt đầu diễn ra, họ sẽ phát hiện ra thôi. Ông chắc chắn rằng cuộc truy kích của họ sẽ vô cùng quyết liệt.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter002_004.xhtml/p000790", "translation": "Vì vậy họ chỉ có một cơ hội duy nhất. Ông đang đặt cược tương lai của tổ quốc vào phi vụ mạo hiểm này.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter002_004.xhtml/p000791", "translation": "Khoảnh khắc lệnh ngừng bắn được ban bố—đó chính là cơ hội của họ. Sự thành bại của chiến dịch phụ thuộc vào việc Đế quốc có thấy những động thái di chuyển ấy đáng ngờ hay không, hoặc liệu họ có thể đánh lạc hướng Đế quốc bằng cách nào đó hay không.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter002_004.xhtml/p000792", "translation": "“Báo cáo từ đại sứ quán tại Khối Thịnh vượng chung. Chủ lực địch đang bận giám sát các cuộc ‘tập trận’ của Hải quân Khối Thịnh vượng chung.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter002_004.xhtml/p000793", "translation": "Bọn họ là lũ ngốc ư? Hay đó chỉ là chuyện thường tình như mọi khi?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter002_004.xhtml/p000794", "translation": "Hạm đội bản thổ của Khối Thịnh vượng chung đang tiến hành tập trận khẩn cấp dưới danh nghĩa “huấn luyện đột xuất” ngay sát rìa lãnh hải của họ, làm phân tán hoàn toàn sự chú ý của lực lượng Đế quốc. Hạm đội, không quân cùng các pháp sư của chúng đều đổ dồn sự chú ý vào các cuộc tập trận ấy, giúp de Lugo được rảnh tay hành động.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter002_004.xhtml/p000795", "translation": "Xét thấy không có rắc rối phát sinh nào gây tổn hại cho những con tàu đã tập hợp, hẳn là Đế quốc vẫn chưa nhận ra chuyện gì đang diễn ra. Cũng chẳng có bất kỳ báo cáo nào về trinh sát Đế quốc hay những kẻ khả nghi quanh khu vực căn cứ hải quân.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter002_004.xhtml/p000796", "translation": "Ông không muốn nói trước bước không qua, nhưng tình hình xem chừng không đến nỗi quá tuyệt vọng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter002_004.xhtml/p000797", "translation": "“…Thật tốt khi họ đã hỗ trợ.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter002_004.xhtml/p000798", "translation": "“Hãy vượt qua chuyện này rồi trả đũa.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter002_004.xhtml/p000799", "translation": "“Cho dù có phải nuốt thứ đồ ăn dở tệ của Khối Thịnh vượng chung đi nữa, tôi cũng sẽ chiến đấu tới cùng. Thật nóng lòng chờ đến cuộc phản công từ phương nam.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter002_004.xhtml/p000800", "translation": "Tinh thần của các thuộc cấp dưới quyền ông vẫn không hề suy suyển. Chí ít thì binh sĩ vẫn còn có thể chiến đấu. Ngay cả khi phải tạm thời nhượng lại tổ quốc cho Đế quốc, rốt cuộc họ sẽ giành lại mảnh đất đã nuôi dưỡng mình.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter002_004.xhtml/p000801", "translation": "“Chà, tất cả bắt đầu từ đây.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter002_004.xhtml/p000802", "translation": "Quyết tâm của ông vô cùng vững vàng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter002_004.xhtml/p000803", "translation": "Mặc dù đang kìm nén cảm xúc, giọng nói của ông vẫn tràn ngập khí thế quyết chiến với Đế quốc đến cùng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter002_004.xhtml/p000804", "translation": "Thiếu tướng de Lugo là một người yêu nước.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter002_004.xhtml/p000805", "translation": "Ông yêu đất nước mình. Ông yêu tổ quốc mình. Ông vững tin vào vinh quang của đất nước mình.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter002_004.xhtml/p000806", "translation": "Nếu Cộng hòa không còn vĩ đại nữa, thì đó không còn là Cộng hòa nữa.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
