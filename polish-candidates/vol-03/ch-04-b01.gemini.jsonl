{"segment_id": "YS-LN03/Text/chapter004_002.xhtml/p000002", "translation": "NGÀY 10 THÁNG 7, NĂM THỐNG NHẤT 1925, BREST DƯỚI QUYỀN QUÂN QUẢN ĐẾ QUỐC", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter004_002.xhtml/p000003", "translation": "“Xin phép báo cáo!” Thiếu úy Grantz chạy tới, vừa đến nơi liền cất lời bằng giọng điệu vẫn giữ được sự dứt khoát nhờ ý thức trách nhiệm, bất chấp bầu không khí căng thẳng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter004_002.xhtml/p000004", "translation": "Trung úy Weiss nhìn nét mặt cậu ta liền hiểu rằng công tác chuẩn bị đã hoàn tất, bèn lập tức đứng thẳng người quay sang đối diện với cậu ta; bản thân anh cũng cảm thấy khá căng thẳng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter004_002.xhtml/p000005", "translation": "“Thưa Trung úy Weiss, toàn bộ thành viên của tiểu đoàn đã có mặt đầy đủ!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter004_002.xhtml/p000006", "translation": "“Cảm ơn cậu, Thiếu úy Grantz. Khâu hậu cần có bị chậm trễ gì không?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter004_002.xhtml/p000007", "translation": "“Thưa ngài, hoàn toàn không có ạ! Chúng ta đã được trang bị đầy đủ cả nhu yếu phẩm lẫn dụng cụ!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter004_002.xhtml/p000008", "translation": "Điều đó có nghĩa là mọi thứ đã sẵn sàng. Đây là một báo cáo vô cùng hệ trọng, thế nhưng người nhận nó lại chẳng phải Thiếu tá von Degurechaff mà trớ trêu thay lại là viên phó chỉ huy.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter004_002.xhtml/p000009", "translation": "Anh đưa ra phán đoán ngay khi tiếp nhận báo cáo.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter004_002.xhtml/p000010", "translation": "Xét tầm quan trọng của sự việc, lẽ ra đích thân chỉ huy phải là người đưa ra quyết định, nhưng sĩ quan cấp cao nhất vào lúc này lại là Trung úy Weiss.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter004_002.xhtml/p000011", "translation": "Trách nhiệm và sự căng thẳng của người nắm quyền chỉ huy… Trên hết thảy là nỗi bất an khôn lường khi phải tiếp nhận vị trí này thay cho Thiếu tá von Degurechaff… *Thiếu tá từng bảo mình rằng có thể mình sẽ được thăng hàm trước khi hết năm nay. Thế giới này quả là một nơi kỳ lạ.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter004_002.xhtml/p000012", "translation": "“…Thưa ngài?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter004_002.xhtml/p000013", "translation": "“À, không có gì đâu, Thiếu úy.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter004_002.xhtml/p000014", "translation": "Nhưng giờ không phải lúc để do dự. Thời khắc này đòi hỏi ở anh một phán đoán dứt khoát trên cương vị chỉ huy. Là một sĩ quan, anh hiểu rõ rằng dội một gáo nước lạnh vào bầu không khí căng thẳng và đầy kỳ vọng này sẽ là một sai lầm không thể tha thứ. Điều mà chức trách đòi hỏi ở anh lúc này là phải hoàn thành trách nhiệm của mình.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter004_002.xhtml/p000015", "translation": "“Các đại đội trưởng, báo cáo tình hình!” anh hô lớn.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter004_002.xhtml/p000016", "translation": "Dù đang cố gắng giữ vẻ điềm tĩnh của một người chuyên nghiệp, anh vẫn không sao nén nổi hoàn toàn niềm háo hức mong chờ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter004_002.xhtml/p000017", "translation": "“Toàn bộ các đơn vị đã có mặt. Đã vào vị trí chiến đấu loại một!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter004_002.xhtml/p000018", "translation": "Đáp lại mệnh lệnh vang dội là lời báo cáo đã sẵn sàng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter004_002.xhtml/p000019", "translation": "“Tình hình bên các cậu thế nào?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter004_002.xhtml/p000020", "translation": "Giọng nói cho thấy thời khắc khai màn trận đánh đã cận kề.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter004_002.xhtml/p000021", "translation": "“Bia, đã sẵn sàng! Rượu vang, đã sẵn sàng!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter004_002.xhtml/p000022", "translation": "Câu trả lời vang lên đầy tự hào.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter004_002.xhtml/p000023", "translation": "“Thịt, cá, sẵn sàng, đã sẵn sàng!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter004_002.xhtml/p000024", "translation": "Khẩu phần bổ sung của họ hậu hĩnh đến mức tưởng như đống đồ ăn thức uống kia đang thách thức họ xử lý cho bằng hết. Toàn bộ sức chiến đấu của tiểu đoàn được dốc trọn không chút tiếc rẻ vào việc dọn sạch sành sanh mọi thứ mà họ đã chôm chỉa và tích trữ được.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter004_002.xhtml/p000025", "translation": "“Biển, đã sẵn sàng!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter004_002.xhtml/p000026", "translation": "Và Weiss có niềm tin không chút lay chuyển rằng anh đã chọn đúng địa điểm.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter004_002.xhtml/p000027", "translation": "“Tuyệt lắm, hỡi toàn quân, chiến dịch này chính thức bắt đầu!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter004_002.xhtml/p000028", "translation": "Làn nước trong vắt, bầu trời xanh thẳm cùng ánh nắng đầu hạ trong lành sảng khoái… Những vỉ nướng và bàn sơ chế được bày la liệt hàng núi thịt đủ loại. Lẽ dĩ nhiên, từng thùng bia chai ướp lạnh cũng đã được chuyển tới. Thậm chí còn có cả rượu vang và sâm panh kiếm từ tận đẩu tận đâu về.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter004_002.xhtml/p000029", "translation": "Trong ngày hôm nay, các pháp sư tinh nhuệ của Tiểu đoàn Pháp sư Trên không số 203 đã quyết tâm dốc trọn cả thể xác lẫn tâm hồn vào việc tận hưởng bãi biển.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter004_002.xhtml/p000030", "translation": "Mọi thứ đều là vì ngày hôm nay.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter004_002.xhtml/p000031", "translation": "“Vì chiến thắng!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter004_002.xhtml/p000032", "translation": "“Vì những người anh em chiến hữu của tôi!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter004_002.xhtml/p000033", "translation": "“Vì Reich!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter004_002.xhtml/p000034", "translation": "“““Cạn ly!”””", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter004_002.xhtml/p000035", "translation": "Ba lời chúc rượu cùng một tiếng hô sảng khoái vang dội.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter004_002.xhtml/p000036", "translation": "Thế là chỉ riêng trong ngày hôm nay, những người lính gác lại mọi lễ nghi quân kỷ. Các cuộc thi uống bia nối tiếp nhau diễn ra. Nút chai sâm panh thi nhau bật tung. Rồi họ bá vai khoác cổ nhau, cùng đồng thanh hát vang bài “Chúng ta là Reich, Vương miện của Thế giới”.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter004_002.xhtml/p000037", "translation": "Giọng hát của họ rền vang từ tận đáy bụng, lấp đầy cả khu nghỉ dưỡng của Cộng hòa. Bãi biển này chính là cơ hội tuyệt vời nhất để không ngừng cất cao những khúc ca ngợi thứ mật ngọt chiến thắng mát lạnh như băng trong tay họ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter004_004.xhtml/p000002", "translation": "“Vì Đế quốc,” họ hô vang rồi nốc cạn cốc bia, tận dụng triệt để cơ hội này để hát vang những lời ca tụng. Vài người lính vác xẻng ra bãi cát và bắt đầu nô đùa, chẳng màng tới chuyện mình đã là những gã đàn ông trưởng thành; chẳng mấy chốc, các trung đội đã quay sang thi đào cát với nhau. Những người khác thì nhảy thẳng xuống nước, trong khi một số khác lại lao thẳng một mạch về phía các vỉ nướng kèm theo tiếng reo “Trước tiên là thịt đã!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter004_004.xhtml/p000003", "translation": "Tất cả mọi người ở đó đều thực sự say ngất ngây—say trong chiến thắng, trong niềm vui sống sót và trong cảm giác thành tựu khi hoàn thành chức trách của mình.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter004_004.xhtml/p000004", "translation": "CÙNG LÚC ĐÓ, CĂN CỨ BREST CỦA LỤC QUÂN ĐẾ QUỐC", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter004_004.xhtml/p000005", "translation": "Đọc bức thông điệp mà sĩ quan phụ tá vừa đưa cho, nó day thái dương rồi rên lên một tiếng. Đoạn, bấu víu vào niềm hy vọng lạc quan thái quá rằng kết luận của mình sẽ thay đổi khi đọc lại lần thứ hai, Thiếu tá Ma pháp Tanya von Degurechaff thuộc Lục quân Đế quốc, sĩ quan Bộ Tổng tham mưu, lại nhìn vào tờ giấy một lần nữa.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter004_004.xhtml/p000006", "translation": "Nhưng dù nó có cố đọc kỹ ẩn ý giữa các dòng chữ đến đâu thì kết quả cũng chẳng thay đổi. Suy cho cùng, đây rõ ràng là một thông báo chính thức từ Bộ Tổng tham mưu.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter004_004.xhtml/p000007", "translation": "“…Xin lỗi nhé, Thiếu úy Serebryakov, tôi ra ngoài một lát.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter004_004.xhtml/p000008", "translation": "Thế là sau khi dặn lại một câu với viên phụ tá, Tanya bực bội đội mũ lên, chậm rãi đứng dậy rồi đi về phía tòa nhà sinh hoạt nằm cạnh sở chỉ huy tiểu đoàn.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter004_004.xhtml/p000009", "translation": "Ngước nhìn lên, nó thấy bầu trời quang đãng, trái ngược hẳn với tâm trạng của mình.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter004_004.xhtml/p000010", "translation": "“Sắp sang hè rồi nhỉ…?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter004_004.xhtml/p000011", "translation": "Trời vẫn chưa quá nóng, nhưng có lẽ mùa hè đã cận kề. Chính Tanya là người đã cho phép Trung úy Weiss cùng những người khác nghỉ phép để đi nghỉ mát. Cũng chính nó là người đã phê duyệt khoản chi từ quỹ của tiểu đoàn để ghi nhận công lao của thuộc cấp, cho họ một ngày mở tiệc nướng ngoài bãi biển.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
