{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000483", "translation": "…Đó là một kế hoạch hết sức hợp lý.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000484", "translation": "Nhưng đối thủ của họ lại chẳng có chút gì hợp lý cả. Chuyện xảy ra ngay khoảnh khắc đơn vị đó vừa được rút ra và điều sang.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000485", "translation": "“Tiểu đoàn Pháp sư 5 gọi sở chỉ huy! Pháp sư địch đang tiếp cận rất nhanh!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000486", "translation": "Tiếng thét cảnh báo vang lên từ đơn vị pháp sư đang yểm trợ trực tiếp—không phải cho cánh phải, mà là cho trung tâm.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000487", "translation": "“Vô lý! Chúng không đánh vào các khẩu đội pháo sao?!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000488", "translation": "Ông ta vừa điều Tiểu đoàn Pháp sư 2 cùng Trung đoàn Pháp sư Hỗn hợp 1 mới rút ra sang cánh phải.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000489", "translation": "Nhưng trong nỗi căm hận tột cùng, ông ta buộc phải nhận ra rằng đám pháp sư địch vốn đang hoành hành bên cánh phải đã đổi hướng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000490", "translation": "Pha cơ động ấy thậm chí chẳng nhắm tới việc chặn quân tiếp viện. Trong một thoáng, không ai dám chắc quân địch đang hướng về đâu.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000491", "translation": "Đó không phải nước đi nhằm đập tan vòng vây bên cánh phải vốn dường như đang hấp hối. Không. Đó thậm chí cũng chẳng phải nước đi đánh chặn lực lượng chi viện đang kéo tới.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000492", "translation": "Đó là một đợt xung kích thẳng vào lực lượng Cộng hòa ở trung tâm.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000493", "translation": "“Chúng cứ như lũ ác quỷ vậy…” Sự thật bật ra khỏi miệng Vianto như một lời than vãn.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000494", "translation": "Vianto am hiểu về các pháp sư hơn bất kỳ ai có mặt tại đây, và ông nắm rõ ý đồ của quân địch. Hoặc có lẽ đúng hơn là ông biết từ kinh nghiệm rằng mục tiêu tiếp theo chúng nhắm tới sẽ là gì.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000495", "translation": "Đánh vào cánh phải chỉ là một trong các mục tiêu của chúng. Nếu Lục quân Cộng hòa cứ mặc kệ cho chúng tự tung tự tác, hẳn chúng đã chọc thủng cánh phải rồi rút đi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000496", "translation": "*Nhưng chúng sẽ làm gì nếu Lục quân Cộng hòa hành động hợp lý và chi viện cho cánh phải?*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000497", "translation": "Đơn giản thôi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000498", "translation": "Chúng sẽ đánh vào nơi vừa mới bị rút bớt các đơn vị: trung tâm.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000499", "translation": "Chẳng đời nào người ta lại rút các đơn vị từ cánh trái để điều sang tận cánh phải. Để kiềm tỏa pháp sư địch ở cánh phải, các đơn vị sẽ được rút từ trung tâm. Giả sử đám pháp sư đó lao thẳng một mạch theo đường thẳng, tạp âm và nhiễu sóng sẽ lớn đến mức làm tê liệt tạm thời khả năng phát hiện địch của họ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000500", "translation": "*Vậy nếu Lục quân Đế quốc hành động dựa trên dấu hiệu có quân tiếp viện đang trên đường tới thì sao?*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000501", "translation": "Khoảnh khắc ấy, Vianto theo bản năng hiểu ra sự thật kinh hoàng và sống lưng ông lạnh toát.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000502", "translation": "Các pháp sư rốt cuộc cũng đang bảo vệ cánh phải. Đúng khoảnh khắc vừa tản đội hình ra xong, họ liền trở nên vô dụng. Họ chẳng thể đóng góp được gì vào thời khắc quyết định khi trung tâm bị tấn công. *Không, chính chúng ta* đã biến *họ thành vô dụng!*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000503", "translation": "Những pha cơ động của quân địch thoạt nhìn giống như bước đi quẩn quanh của một toán quân bị dồn vào chân tường, nhưng thực chất chúng còn quỷ quyệt hơn cả ác quỷ, sử dụng những chiến thuật tinh vi đến tột cùng và vô cùng hiểm độc. Đám pháp sư địch đang thực hiện những pha cơ động mà ngay cả về mặt lý thuyết Vianto cũng không dám chắc là khả thi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000504", "translation": "Ông cứ ngỡ mình đã tường tận nỗi kinh hoàng mang tên pháp sư Đế quốc.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000505", "translation": "“Thưa Tướng de Lugo, xin ngài hãy rút lui.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000506", "translation": "“Gì cơ?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000507", "translation": "“Quân địch đang tiến về phía này! Chết tiệt! Chúng định tái hiện những gì từng làm ở mặt trận Rhine!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000508", "translation": "Chúng sẽ triệt hạ sở chỉ huy bằng một “đòn tập kích chính xác”.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000509", "translation": "Bất cứ ai nghe thấy cũng sẽ cười xòa coi đó là một cơn ác mộng vô lý, nhưng Đế quốc đã thực thi nó ngay trên các phòng tuyến Rhine.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000510", "translation": "Chúng chọc thủng các tuyến phòng thủ chính của Cộng hòa—những trận địa được xây dựng với hệ thống phòng ngự kiên cố vô song—rồi triệt hạ sở chỉ huy vững chãi như pháo đài.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000511", "translation": "Cơn hoảng loạn bao trùm các đơn vị tiền tuyến vào thời điểm đó có quy mô gần như không sao tả xiết.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000512", "translation": "…Và Lục quân Cộng hòa hiện tại không có người thay thế cho de Lugo. Họ vừa mới đổi chiếc bình rượu cũ lấy chiếc bình mới, chẳng còn chiếc bình nào khác dự phòng sẵn cả.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000513", "translation": "Lục quân Cộng hòa Tự do, như người ta có thể nhận ra chỉ qua cái tên, đã phải tốn biết bao công sức khổng lồ mới gây dựng nên. Vậy nên nếu vị tướng đứng đầu Cộng hòa ngã xuống ngay lúc này, việc tiếp tục duy trì kháng cự có tổ chức sẽ gần như bất khả thi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000514", "translation": "Đối với Lục quân Đế quốc, ngay cả khi toàn bộ Quân đoàn Viễn chinh Phương Nam của chúng bị xóa sổ, chỉ cần kéo theo được de Lugo cùng chôn vùi thì đó vẫn sẽ là một chiến thắng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000515", "translation": "*Không, giờ thì khó mà tiêu diệt được Lục quân Đế quốc rồi. Cùng lắm chúng cũng chỉ bị bầm dập đôi chút mà thôi.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000516", "translation": "*Và chuyện gì sẽ xảy ra với hỏa lực cùng các đơn vị của chúng ta nếu ta cử họ ra đối đầu với đám pháp sư đó?*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000517", "translation": "*Chí ít thì chúng ta cũng sẽ không đạt được các mục tiêu ban đầu của mình.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000518", "translation": "“Các binh sĩ, hãy bảo vệ tướng quân. Đây là trận chiến cuối cùng của chúng ta.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000519", "translation": "Quân địch đã chọc thủng phòng tuyến ở mặt trận Rhine, nhưng tại đây Vianto không thể để chuyện đó tái diễn. Ông sẽ không dâng thêm một sở chỉ huy nào nữa cho Lục quân Đế quốc.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000520", "translation": "CÙNG NGÀY, DOANH TRẠI LỤC QUÂN ĐẾ QUỐC", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000521", "translation": "“Ha ha ha! Ha ha ha! Ha ha! Ha ha! Ha ha ha ha!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000522", "translation": "Nghe tiếng cười đó, những hạ sĩ quan xấu số đang ngồi chung trên chiếc xe bọc thép đều nhăn mặt.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000523", "translation": "Chà, bất cứ ai cũng có quyền nhăn mặt nếu vị chỉ huy cấp cao của mình bỗng phá lên cười sằng sặc giữa lúc đang bị bao vây.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000524", "translation": "*Nếu ông ấy phát điên rồi thì gay go to.* Cảm xúc của họ chẳng có gì quá đỗi kỳ lạ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000525", "translation": "Bình thường, Romel sẽ biết ý mà nén tiếng cười lại. Nhưng riêng hôm nay, ông cứ thế cười mãi không dứt, cười nhiều hơn mức người ta tưởng một con người có thể cười được.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000526", "translation": "“À, chuyện này quả thực quá đỗi thú vị. Làm khá lắm, Thiếu tá!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000527", "translation": "Chỉ riêng lần này thôi, Romel không sao ngừng cười được. Cảnh tượng trước mắt ông đã tạo nên một ấn tượng mãnh liệt hoàn toàn xứng đáng với phản ứng ấy.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
{"segment_id": "YS-LN03/Text/chapter006_002.xhtml/p000528", "translation": "Ông cứ ngỡ mình có thể dùng dây xích ghìm cô lại phần nào, nhưng thực chất, cô lại phát huy hiệu quả hơn hẳn khi được ông thả xích. *Ắt hẳn cô ta đã đánh hơi thấy điều gì đó—bởi vậy nên mới muốn đi trinh sát muộn đến thế!*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "74f557a5f02ccc0308519579028d46fc0a89698a81e15219feb3add22ffc96a4", "notes": []}
