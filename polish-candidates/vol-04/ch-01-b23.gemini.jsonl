{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000362", "translation": "Có lẽ giấc mơ ấy bắt nguồn từ một mối bận tâm chung nào đó giữa hai người.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000363", "translation": "Nói cách khác, có lẽ có một việc gì đó họ cần phải làm.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000364", "translation": "Bác Josef và Đồng chí Loria đã suy nghĩ rất nghiêm túc về ý kiến đó. Nhưng về mặt đối nội, bác Josef không hề mắc phải sai lầm cụ thể nào. Toàn thể nhân dân, những người đồng chí của bác, đều đang sống cuộc đời hạnh phúc.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000365", "translation": "Không chỉ vậy, bác còn nhận được báo cáo cho thấy nền kinh tế đang tăng trưởng tốt. Bác đã tìm đi tìm lại, nhưng dù có cố gắng tìm kỹ đến đâu, bác cũng chỉ thấy những báo cáo nói rằng niềm hạnh phúc của nhân dân đang ngày một lớn thêm.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000366", "translation": "Và đà khởi sắc ấy không hề có dấu hiệu chững lại.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000367", "translation": "Mọi chuyện tiến triển đến mức những người mắc sai lầm còn thi nhau xem ai được tham gia dự án đào kênh trước. Những người dân từng được lòng tốt của bác Josef nuông chiều cuối cùng cũng đang học được đạo đức lao động.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000368", "translation": "*Rốt cuộc còn chuyện gì đáng để lo lắng nữa chứ?*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000369", "translation": "Đó là câu hỏi thoáng qua trong tâm trí bác Josef.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000370", "translation": "Câu trả lời trở nên sáng tỏ khi bác Josef, người luôn ham học hỏi với trí tò mò tri thức mãnh liệt, đọc một tờ báo nước ngoài. Đau thương thay, cả thế giới đã chìm trong khói lửa chiến tranh!", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000371", "translation": "Vì đang sống ở một đất nước hòa bình, nên lẽ tự nhiên là cuộc chiến ấy chẳng hề liên quan gì đến bác.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000372", "translation": "Nhưng bác phải làm một điều gì đó.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000373", "translation": "Và chẳng cần nghĩ ngợi, bác cũng biết rằng nhân dân thế giới, những người chắc chắn đang phải chịu cảnh lầm than, cần có một giải pháp cuối cùng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000374", "translation": "Với trái tim nhân ái tuyệt vời của mình, bác Josef đã cố suy nghĩ xem bác có thể làm được gì.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000375", "translation": "Chắc hẳn ở đâu đó đang có những con người cần đến sự giúp đỡ của bác.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000376", "translation": "Là vị lãnh tụ của nhân dân, bác Josef kính yêu không thể chần chừ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000377", "translation": "Đồng chí Loria đã thuyết phục những phần tử xét lại còn đang lưỡng lự,⁸ và cuối cùng bác Josef cũng biết họ phải làm gì.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000378", "translation": "Dẫu vậy, ban đầu họ vẫn không từ bỏ con đường đối thoại bằng lời lẽ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000379", "translation": "Họ đã cố gắng trò chuyện với những kẻ đế quốc quân phiệt. Thế nhưng, vô cùng đáng buồn thay, lời nói và thiện chí của họ đã không đến được tai bọn chúng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000380", "translation": "Vì nhân dân các nước Cộng hòa và Khối Thịnh vượng chung, cũng như vì những người dân đang bị áp bức dưới ách của chính quyền đế quốc, bác Josef buộc phải hành động.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000381", "translation": "Cuộc chiến đấu của bác Josef và Đồng chí Loria đã bắt đầu như thế đấy.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000382", "translation": "Tất nhiên, đạo quân yêu chuộng hòa bình của bác Josef lại hết sức thiếu kinh nghiệm cần thiết để chiến đấu chống lại Lục quân Đế quốc khát máu. Thật không may, đã có không ít binh sĩ phải đến Sildberia để đếm cây.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000383", "translation": "Chắc chắn bác Josef không hề có ý định ép buộc người dân phải đổi việc. Bác luôn trao cho họ quyền tự do lựa chọn, dẫu vậy, rất nhiều người vẫn cảm thấy mình nên đáp lại lòng tốt của bác và đã tình nguyện gia nhập quân đội.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000384", "translation": "Và đó chính là cách Lục quân Liên bang rốt cuộc đã chiến đấu vì nhân dân trên toàn thế giới.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000385", "translation": "(trích từ cuốn sách giáo khoa do Bộ Dân ủy Giáo dục phê chuẩn, *Sách giáo khoa Nhân dân dành cho Học sinh*)", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000386", "translation": "NGÀY 17 THÁNG 1 NĂM THỐNG NHẤT 1926, THỦ ĐÔ MOSKVA CỦA LIÊN BANG", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000387", "translation": "Ông ta là một kẻ tẻ nhạt.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000388", "translation": "Bạn bè không thấy ông ta đáng để tranh luận cùng, và quả thực đúng là chẳng đáng thật. Khi bạn bè được thăng tiến, tổ chức cùng lắm chỉ giao cho ông ta các công việc hành chính.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000389", "translation": "Ông ta cũng hoàn toàn xa lạ với vinh quang quân sự. Đúng hơn là ông ta đã thất bại thảm hại, thậm chí còn cản trở thắng lợi của quân mình. Vì lý do đó, ông ta bị coi thường, và chẳng một ai từng xem ông ta là kẻ cần phải dè chừng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000390", "translation": "Thế rồi ông ta âm thầm gây dựng vị thế của mình ở một chức vụ hành chính mà ai nấy đều né tránh.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000391", "translation": "Nắm giữ quyền hạn hành chính trên thực tế đồng nghĩa với việc kiểm soát nhân sự. Từng chút một, ông ta cài cắm những kẻ dưới trướng mình vào các vị trí tuy không mấy nổi bật nhưng lại vô cùng trọng yếu.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000392", "translation": "Không ai xem ông ta là một mối đe dọa thực sự. Họ chỉ coi ông ta là một tên thuộc hạ đắc lực. Và đó là cách ông ta vươn lên đầy dứt khoát mà không vấp phải sự cản trở từ bất kỳ ai. Cho đến tận thời khắc quyết định, chẳng ai nhìn nhận ông ta là gì khác ngoài một gã bàn giấy.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000393", "translation": "Thế nhưng ông ta lại nắm giữ mọi quyền hành theo đúng nghĩa đen.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000394", "translation": "Đúng vậy, trên danh nghĩa, các bậc tiền bối lừng danh với sự nghiệp hiển hách của ông ta vẫn giữ những chức vụ cao hơn, nhưng ngay bên dưới mỗi người trong số họ đều là một tay chân của ông ta đang thực sự điều hành công việc.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000395", "translation": "Trong bí mật.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000396", "translation": "Đó chính là chiếc chìa khóa khiêm nhường nhưng mang tính sống còn cho tham vọng của ông ta. Không một ai hay biết, ông ta đã thâu tóm quyền kiểm soát bộ máy vận hành của chính quyền. Và với quyền lực ấy, bản thân ông ta nghiễm nhiên trở thành một thế lực trong chính quyền.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000397", "translation": "Mãi đến ngay trước lúc qua đời, những người tiền nhiệm của ông ta mới nhận ra ông ta nguy hiểm đến nhường nào, nhưng khi ấy thì đã quá muộn.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000398", "translation": "Họ đã phớt lờ lời cảnh báo. Tất cả những kẻ nhắm đến vị trí lãnh đạo chính quyền đều để lời cảnh báo ấy vào tai này rồi ra tai kia mà chẳng buồn cân nhắc nghiêm túc. Họ đã phải trả giá cho điều đó—cho thứ có thể mô tả là một sai lầm “chí mạng”—bằng mạng sống và tài sản của chính họ cùng gia đình.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000399", "translation": "Đó là cách người đàn ông tên Josef thâu tóm một trong những quốc gia hàng đầu thế giới, Liên bang.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000400", "translation": "Ông ta tin rằng mình là nhà lãnh đạo chính thống duy nhất của Liên bang và mang một sứ mệnh lịch sử, sứ mệnh khôi phục sức mạnh to lớn của Liên bang.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000401", "translation": "Ông ta là một kẻ toan tính với đầu óc xảo quyệt.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000402", "translation": "Đối với ông ta, Đế quốc là một mầm hỗn loạn có thể chấp nhận được. Nếu Đế quốc không tồn tại, mối căm ghét của giới tư sản thế giới đối với chủ nghĩa Cộng sản có lẽ đã thôi thúc họ lập nên một liên minh chống lại Liên bang.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000403", "translation": "Tuy nhiên, nếu có Đế quốc ở đó can thiệp vào lợi ích của họ, giai cấp tư sản sẽ dồn thời gian vào đối tượng căm ghét ở gần mình hơn. Ngay cả Lục quân Liên bang, dù miễn cưỡng, cũng phải thừa nhận chiến lược này là đúng đắn.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000404", "translation": "Thế nhưng đùng một cái, họ lại bước vào chiến tranh.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000405", "translation": "Chuyện đó diễn ra quá đỗi đột ngột đối với Liên bang, chứ chưa nói đến Đế quốc.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_d.xhtml/p000406", "translation": "Mọi người đều muốn biết ý đồ thực sự của tên độc tài là gì; trong khi đó, Josef vẫn đang một mình trầm tư.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
