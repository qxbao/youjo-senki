{"segment_id": "YS-LN04/Text/chapter001_v.xhtml/p000653", "translation": "Tỷ lệ đó chưa bao giờ khá hơn mức một đổi năm.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_v.xhtml/p000654", "translation": "Thế nhưng quy mô của Lục quân Liên bang lại hết sức áp đảo. Một khi đã lao vào cận chiến giằng co trong đô thị, tác chiến có tổ chức lẫn những trận đánh cơ động—tất cả những hành động mang tính kỷ luật vốn là sở trường của Lục quân Đế quốc—sẽ chỉ còn phát huy tác dụng hạn chế.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_v.xhtml/p000655", "translation": "Với ánh mắt thuần khiết của một nhà toán học, Loria tính toán cho chiến thắng của họ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_v.xhtml/p000656", "translation": "“Nếu chúng ta có thể kéo tỷ lệ tiêu hao về mức cân bằng hơn dù chỉ một chút, Đế quốc sẽ là kẻ phải đầu hàng.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_v.xhtml/p000657", "translation": "Chỉ cần họ giảm được tổn thất của mình xuống dù chỉ một chút, những con số toán học khô khan sẽ mang lại lợi thế áp đảo cho Liên bang. Họ cũng có thể làm tăng tổn thất của đối phương lên đôi chút.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_v.xhtml/p000658", "translation": "Nghĩ đến điểm đó, Loria nhếch mép cười khẩy.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_v.xhtml/p000659", "translation": "*Chà, đám quân nhân đúng là những sinh vật chướng mắt. Bọn họ cứ bị ám ảnh bởi danh dự và thể diện, lại thêm cả lòng kiêu hãnh nữa—thật quá sức chịu đựng.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_v.xhtml/p000660", "translation": "“Nhưng chừng nào chúng còn tiếp tục chiến thắng, tầm quan trọng của vùng đất đó sẽ tự khắc tăng lên.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_v.xhtml/p000661", "translation": "Sở dĩ Pyrrhus vĩ đại là bởi ông nhận ra chiến thắng của mình sẽ trở thành một chiến thắng kiểu Pyrrhus nên đã kịp thời rút quân. Hầu hết các tướng lĩnh đều sẽ bị thành công làm mờ mắt mà mở rộng chiến tuyến để mưu cầu thêm chiến quả.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_v.xhtml/p000662", "translation": "Lẽ tự nhiên, Lục quân Đế quốc sẽ xâm lược lãnh thổ Liên bang nhằm gia tăng chiến quả. Nhưng để làm được điều đó, chúng sẽ buộc phải lao vào những trận chiến giành giật các thành phố.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_v.xhtml/p000663", "translation": "“Một khi chuyện đó xảy ra, dù có muốn chúng cũng chẳng thể nào rút lui được nữa.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_v.xhtml/p000664", "translation": "Khi ấy, chúng sẽ phải tăng viện cho các đơn vị để thắt chặt phòng tuyến. Đúng vậy, chúng sẽ bị tê liệt. Những đơn vị cơ động vốn thiện nghệ chiến thuật bao vây sẽ mắc kẹt trong cảnh phải dồn ngày càng nhiều nhân lực để phòng thủ một cứ điểm cố định.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_v.xhtml/p000665", "translation": "“Đến lúc đó, tất cả những gì chúng ta cần làm chỉ là ập tới và giành lại phần lãnh thổ đã mất.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_v.xhtml/p000666", "translation": "Lục quân Liên bang sẽ chỉ việc dùng quân số của mình để bao vây *chúng*.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_v.xhtml/p000667", "translation": "Và biết đâu cài cắm thêm vài điệp viên thông qua một nước thứ ba nhằm kích động dư luận trong lòng Đế quốc cũng là ý hay.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_v.xhtml/p000668", "translation": "Khi ấy, chúng sẽ thực sự không tài nào rút chân ra được nữa.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_v.xhtml/p000669", "translation": "“Tất nhiên, để chúng ta có thể kháng cự đến cùng, Bộ Nội vụ dự định điều động các đội đốc chiến đứng chặn phía sau các đơn vị đang chiến đấu trong thành phố.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_v.xhtml/p000670", "translation": "Họ cũng cần một ít mồi sống để nhử chúng vào tròng. Ông ta sẽ gom tất cả những kẻ từng có phát ngôn chống Liên bang, cũng như đám theo chủ nghĩa dân tộc sắc tộc và phần tử phản động, rồi đem nghiền nát chúng đến không còn một mống trước Lục quân Đế quốc. Loria nói bằng giọng hết sức bình thản, nhưng trong thâm tâm chỉ muốn than trời trước sự ngu xuẩn của đám cán bộ lãnh đạo đảng đang ngồi im thin thít và run cầm cập kia.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_v.xhtml/p000671", "translation": "Khi đảo mắt nhìn quanh, ông ta bắt gặp vài gương mặt thất sắc vì kinh hoàng trong số họ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_v.xhtml/p000672", "translation": "*Lũ đạo đức giả các ngươi chỉ biết làm bộ thanh cao mà thôi. Ở cái chốn này làm quái gì có nổi một kẻ lương thiện chứ*, ông ta chỉ muốn buông lời chế giễu như vậy.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_v.xhtml/p000673", "translation": "“Tôi tin chắc rằng khi ấy chúng ta sẽ có thể nghiền nát quân Đế quốc bằng bức tường thường dân bị ép tình nguyện tòng quân cùng lũ ô hợp từ các trại tập trung.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_v.xhtml/p000674", "translation": "Họ sẽ bảo toàn được những binh sĩ trung thành với chế độ, đồng thời xử lý gọn những phần tử tiềm ẩn nguy cơ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_v.xhtml/p000675", "translation": "“Không, nếu diễn đạt theo một cách khác, toàn thể nhân dân Liên bang sẽ anh dũng kháng cự quân xâm lược.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_v.xhtml/p000676", "translation": "Và đó sẽ không phải là một cuộc thanh trừng, mà là sự hy sinh vì Tổ quốc. Kẻ thực hiện thanh trừng không phải người của chế độ, mà là Lục quân Đế quốc. Đảng chẳng việc gì phải tự làm bẩn tay mình.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_v.xhtml/p000677", "translation": "Loria tự thấy kinh ngạc trước sự sắc sảo của chính mình.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_v.xhtml/p000678", "translation": "*Khi hy vọng và ước mơ trở thành động lực, con người sẽ bộc lộ sức mạnh không tưởng cùng khả năng sáng tạo dồi dào.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_v.xhtml/p000679", "translation": "“Dưới sự lãnh đạo của Đồng chí Tổng Bí thư, toàn thể thường dân Liên bang sẽ vùng lên làm du kích. Đồng chí không thấy điều đó thật tuyệt vời sao?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_v.xhtml/p000680", "translation": "“…Ra vậy. Đúng là một đề xuất có thể mang lại hiệu quả đấy.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_v.xhtml/p000681", "translation": "Chí ít thì chừng đó ai nấy đều có thể hiểu được. Chẳng một ai đặt câu hỏi về các giá trị đạo đức, rằng ông ta đúng hay sai.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_v.xhtml/p000682", "translation": "Vì thế, ý tưởng đó đã được thông qua hết sức dễ dàng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_v.xhtml/p000683", "translation": "“Xin cảm ơn đồng chí.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_v.xhtml/p000684", "translation": "“Được rồi, tôi sẽ giao cho đồng chí phụ trách việc đó, Đồng chí Loria. Nhưng đồng chí biết thất bại là điều không thể chấp nhận được, phải không?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_v.xhtml/p000685", "translation": "“Tất nhiên rồi ạ. Xin đồng chí cứ giao mọi việc cho tôi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_v.xhtml/p000686", "translation": "*Thất bại là điều không thể chấp nhận được*—đi kèm lời cảnh cáo ấy là một ánh nhìn sắc lạnh. Một luồng ớn lạnh chạy dọc sống lưng Loria, nhưng ông ta không hề quay mắt đi. Ông ta vẫn kiên quyết nhìn thẳng lại.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_v.xhtml/p000687", "translation": "Đối với ông ta, đây là một phần trên con đường hiện thực hóa giấc mơ của mình.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_v.xhtml/p000688", "translation": "“…Thưa Đồng chí Tổng Bí thư, tôi rất ngại phải xin điều này để đổi lại, nhưng có một việc.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_v.xhtml/p000689", "translation": "“Nếu có vật tư gì đồng chí cần, tôi sẽ phê duyệt. Chuyện gì thế?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_v.xhtml/p000690", "translation": "“Là về kẻ tội phạm đã ném bom Moskva. Tôi muốn đích thân mình là người phán xét ả.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_v.xhtml/p000691", "translation": "*Nàng… nàng tiên đó. Mình muốn có con bé.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_v.xhtml/p000692", "translation": "*Bất kể phải trả giá ra sao—mình sẽ làm bất cứ điều gì.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_v.xhtml/p000693", "translation": "*Mình buộc phải có được con bé cho riêng mình.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_v.xhtml/p000694", "translation": "“Chúng ta phải tiến hành hết sức thận trọng—đúng thế, hết sức thận trọng đối với vấn đề đó. Tôi không thể hứa với đồng chí được, Đồng chí Loria.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_v.xhtml/p000695", "translation": "Loria lại đi nhắc tới tình cảnh đáng căm hận đó ngay trước mặt vị Tổng Bí thư, chứ chẳng phải ai khác. Chỉ riêng việc ấy thôi cũng đã là vuốt râu hùm rồi. Thực tế, bàn tay cầm bút của vị Tổng Bí thư đang run lên thấy rõ vì cơn thịnh nộ và nỗi nhục nhã.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_v.xhtml/p000696", "translation": "“Thưa Đồng chí Tổng Bí thư. Vậy ít nhất tôi muốn có được con bé đó.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_v.xhtml/p000697", "translation": "Ông ta biết làm vậy là liều lĩnh.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_v.xhtml/p000698", "translation": "Nhưng dẫu có thế đi nữa. Có những lúc một người đàn ông buộc phải hành động.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_v.xhtml/p000699", "translation": "“…Đồng chí Loria, con bé là gu của đồng chí sao?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_v.xhtml/p000700", "translation": "“Tất nhiên rồi ạ! À… diễn đạt như vậy thì không chuẩn xác cho lắm, nhưng…”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_v.xhtml/p000701", "translation": "Có những việc ông ta buộc phải làm, dẫu có phải đánh đổi bằng tất cả.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_v.xhtml/p000702", "translation": "Trong đời có những lúc người ta buộc phải lên tiếng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_v.xhtml/p000703", "translation": "“Sao cơ?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
{"segment_id": "YS-LN04/Text/chapter001_v.xhtml/p000704", "translation": "“Con bé có thể xem là hình mẫu lý tưởng của tôi. Tôi vô cùng—thực sự vô cùng—muốn bắt con bé phải thở hổn hển dưới thân mình.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "d753e588b788516ce336d1cf80988217124eba4e9a380a1881bc8efb45e4467f", "notes": []}
