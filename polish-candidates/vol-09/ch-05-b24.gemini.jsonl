{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000849", "translation": "Sự sốt sắng muốn tống khứ người của Đế quốc đi càng nhanh càng tốt ẩn hiện ngay dưới những nụ cười của họ, ngay cả khi họ trải thảm đỏ tiếp đón theo phép lịch sự.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000850", "translation": "Về bản chất, thông điệp đó chẳng khác nào: *Chúng tôi đã có lòng thu xếp cho các vị một chuyến tàu về nước rồi đấy, thế nên cút đi cho khuất mắt.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000851", "translation": "Chúng ta gần như bị nhét cứng những tấm vé vào tay. Đó là biểu hiện thiện chí tối thiểu hay là cách Đế quốc khẳng định sự hiện diện của mình đây? Toàn bộ nhân viên đại sứ quán Đế quốc đã ra tiễn chúng ta… nhưng họ lại ở vào vị thế đáng mơ ước là được tiếp tục lưu lại Ildoa. Cho dù trong thâm tâm có ghen tị, nhưng với tư cách một thành viên trưởng thành của xã hội, mình chẳng thể nào để lộ điều đó ra mặt được. Chí ít thì mình cũng phải nặn ra một nụ cười khi đến lúc nói lời tạm biệt trước khi lên tàu.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000852", "translation": "Và giờ đây mình lại ngồi trong một khoang trên chuyến tàu chạy êm ru đến lạ kỳ này. Nội thất của nó sang trọng đến mức phát ngấy. Còn người Ildoa thì khéo tiếp đãi khách khứa đến mức đã kịp nắm bắt khẩu vị của chúng ta trong suốt thời gian lưu trú.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000853", "translation": "Nhờ vậy, chúng ta mới có được niềm vui khó tin khi được tùy ý lựa chọn bữa sáng theo sở thích. Đó là lý do Tanya có thể thong thả nhâm nhi bữa sáng nhẹ nhàng do mình tự chọn cùng vị sĩ quan phụ tá.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000854", "translation": "Trái cây tươi, những món nguội đơn giản, cộng thêm bánh mì và thịt tử tế. Thật tình, đúng là xa xỉ hết sức.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000855", "translation": "“…Tiêu dùng phô trương. Lại thêm một chuyến tàu khách xa hoa đưa về nước. Nhưng sao nhân viên phục vụ lại mang đồ ăn tới tận phòng chúng ta thế nhỉ…? Họ không muốn chúng ta trò chuyện ở toa ăn sao?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000856", "translation": "“Chà, đây là chuyến tàu quốc tế mà ạ. Chắc không chỉ có mỗi chúng ta ở trên tàu đâu.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000857", "translation": "“Vậy là chưa đến mức bị cách ly, nhưng tôi đoán họ cũng có những nỗi lo riêng phải cân nhắc. Chà, dù sao đi nữa, được thưởng thức thịt nguội và phô mai ngon lành thế này thật tuyệt, nhỉ, Trung úy?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000858", "translation": "Bánh mì trắng cũng làm mình vui đấy, nhưng thịt nguội và phô mai lại cung cấp nguồn đạm chất lượng mà chúng ta rất hay thiếu hụt.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000859", "translation": "“Thưa Trung tá, mời ngài dùng thêm cà phê ạ.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000860", "translation": "“Ồồồ, cảm ơn nhé. Tôi rất cảm kích đấy, Trung úy Serebryakov.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000861", "translation": "Hương thơm của dòng chất lỏng màu đen mà cô ấy rót ra… Không thể nào nhầm lẫn đi đâu được.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000862", "translation": "“…Được thưởng thức hàng thật đúng nghĩa quả thực rất tuyệt.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000863", "translation": "“Đã lâu rồi tôi mới lại được ngửi thấy mùi hương này ạ.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000864", "translation": "Hai tách cà phê. Một bản song ca của những tầng hương ngân vang.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000865", "translation": "Cà phê ngon pha từ hạt cà phê chuẩn chỉnh được phục vụ trong tách sứ tử tế—những thứ ngày càng trở nên khó kiếm hơn theo thời gian. *Đây* mới thực sự là văn minh.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000866", "translation": "“Tôi đoán là cô chưa có dịp tích trữ thêm chút nào nhỉ?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000867", "translation": "“Không đâu ạ, tôi cũng gom được một ít rồi. Dù sao cũng là ghi vào hóa đơn của Ildoa mà ạ.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000868", "translation": "Vị sĩ quan phụ tá của mình bật cười bảo rằng cô ấy đã chẳng hề khách sáo—đúng là khôn ngoan hết chỗ nói. Mình dám chắc xấp hóa đơn tiêu xài kịch trần hạn mức giờ này hẳn đang được đặt lên mặt bàn của Đại tá Calandro rồi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000869", "translation": "Có lẽ chúng ta nên gửi một lời cảm tạ tới nhà quản lý quân chính nghe đâu rất nổi tiếng của Ildoa là Tướng Igor Gassman chăng? Tuy nói vậy, đó cũng là quỹ mật của một quốc gia khác. Nếu Tanya không đích thân dính líu vào chuyện này thì có lẽ chúng ta thậm chí còn chẳng bao giờ nghe nói tới nó.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000870", "translation": "“Tôi chỉ ước sao Bộ Tổng tham mưu của chúng ta cũng hào phóng được như vậy,” Tanya khẽ nhăn mặt buông một câu bâng quơ. “Dù chỉ cần nhìn qua phòng ăn của Bộ Tổng tham mưu thôi cũng đủ biết giấc mơ đó sẽ chẳng bao giờ thành hiện thực rồi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000871", "translation": "Đồ ăn dở tệ được bày trên những chiếc đĩa lộng lẫy.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000872", "translation": "Cho dù đĩa có đẹp đến mấy đi chăng nữa, nếu bạn không có quyền lựa chọn thứ đặt lên trên đó thì tất cả cũng đều trở nên vô nghĩa. Đế quốc có xu hướng quá chú trọng hình thức mà quên mất công năng thực chất.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000873", "translation": "“Được thưởng thức một bữa ăn đầy màu sắc thế này thật tuyệt vời ạ.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000874", "translation": "“Ừ, Ildoa thực sự—biết nói sao nhỉ? Tràn ngập sắc màu.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000875", "translation": "Vừa cùng Serebryakov nhấm nháp những món khai vị bắt mắt bày trên chiếc bàn trong khoang, Tanya vừa nở một nụ cười nhạt. “Chỉ nhìn qua một bữa ăn thôi cũng đủ nhận ra điều đó rồi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000876", "translation": "“Nó thực sự rất đẹp ạ.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000877", "translation": "“Đúng vậy, và đó cũng là lý do chuyện này thật đau đớn.” Những lời ấy đã buột khỏi miệng trước cả khi cô kịp nhận ra.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000878", "translation": "“Có chuyện gì không ổn sao ạ? Ngài thấy trong người khó chịu ở đâu à?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000879", "translation": "Đáp lại ánh mắt lo lắng của vị sĩ quan phụ tá, Tanya khẽ nhăn mặt tự giễu. “Không, chỉ là chút suy nghĩ vẩn vơ thôi. Có lẽ tôi cũng bị trúng độc mất rồi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000880", "translation": "“Thưa Trung tá?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000881", "translation": "Đó là một lời nhận xét khác thường. Chí ít thì nó cũng đi hơi xa hơn những gì một người lính yêu nước như mình vẫn thường nói. Nhưng mình cũng vừa nhận ra một điều.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000882", "translation": "Có lẽ chính tách cà phê đã làm mình buột miệng dễ dãi hơn.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000883", "translation": "“Không, ý tôi chỉ là… Ildoa yên bình quá. Tôi chẳng thể nào thư giãn nổi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000884", "translation": "“…Ra là vậy ạ.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000885", "translation": "“Ừ…”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000886", "translation": "*Thế này thì không ổn rồi.* Để xua tan bầu không khí nặng nề đến lạ lùng ấy, mình bèn thử chuyển chủ đề.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000887", "translation": "“Nhân tiện, Trung úy này, cô thích rượu vang đỏ hay vang trắng hơn?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000888", "translation": "“Hả? Rượu vang sao, thưa Trung tá?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000889", "translation": "Tanya gật đầu trước vẻ mặt ngơ ngác của vị sĩ quan phụ tá.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000890", "translation": "Trong thời gian lưu lại Ildoa, cô đã kiếm chắc được vài chai rượu làm quà biếu để dùng làm đạn dược—tất nhiên toàn bộ đều do tiền túi của Ildoa chi trả. Tính cả những chai cô sắm để tặng người khác khi trở về lẫn những món quà nhận được từ Calandro, Tanya đã có cho mình một bộ sưu tập nho nhỏ khá tươm tất.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000891", "translation": "Đáng buồn thay, dù số rượu vang đó là hàng thượng hạng… nhưng vì Tanya chẳng thể uống lấy một giọt, nên ngoài việc làm đạn dược cho các tình huống giao tế xã hội ra, chúng chẳng có mấy tác dụng. Tất nhiên, mình rất sẵn lòng tích trữ bất kỳ loại đạn dược nào mà mình có thể giúp cô chạm tay tới.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000892", "translation": "“Đó là những chai rượu tôi nhận được ở Ildoa. Sao cô không mang qua khui vài chai uống cùng Weiss và mọi người đi?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000893", "translation": "“Ngài nói thật chứ ạ?!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000894", "translation": "“Cho dù tôi có may mắn kiếm được chúng đến mấy thì tôi cũng đâu có uống được. Tôi không phiền nếu các vị cùng nhau thưởng thức chúng đâu.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000895", "translation": "Mình lục lọi túi hành lý lấy những chai rượu ra và bảo Serebryakov rằng cô ấy muốn lấy chai nào tùy thích.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000896", "translation": "“Xin cảm ơn Trung tá ạ!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000897", "translation": "“Nhớ nhắn lại với Thiếu tá Weiss rằng tôi rất cảm kích trước sự hỗ trợ của anh ấy nhé.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000898", "translation": "“Vâng ạ! Vậy tôi xin phép đi ngay đây ạ!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000899", "translation": "Vị sĩ quan phụ tá của mình trông thực sự vui vẻ khi lon ton bước đi. Nhìn vẻ mặt mãn nguyện của cô ấy, hẳn là cô ấy đang hoàn toàn thư thái.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000900", "translation": "Cô ấy quả là một sĩ quan phụ tá xuất sắc.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
