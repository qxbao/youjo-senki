{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000498", "translation": "“Họ đang nỗ lực hết sức đấy… Chỉ có thể dùng từ *can trường* để miêu tả mà thôi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000499", "translation": "Việc không tìm đến chợ đen hay thu mua nguyên liệu qua các kênh phi pháp khác chắc chắn rất đáng khen ngợi. Nhưng nó dở tệ. Dở tệ hại là đằng khác.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000500", "translation": "“Biết rõ nguồn gốc thức ăn của mình thì tuyệt đấy, miễn là nó cũng phải ngon miệng nữa.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000501", "translation": "Mình chẳng hề tự nhận là người sành ăn, nhưng khi mọi thứ đã xuống cấp thê thảm đến mức này thì không tài nào cứ thế cho qua mà không bình phẩm lời nào được.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000502", "translation": "Khi chuyện ăn uống là một trong số ít những điều chúng ta còn có thể mong chờ, thì thế này thật sự vượt quá sức chịu đựng rồi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000503", "translation": "Nó chẳng ngon lành gì. Nói ngắn gọn thì không thể có thứ gì nhạt nhẽo hơn thế được nữa. Với những bữa ăn kiểu này, sĩ khí dưới chiến hào sẽ vụn vỡ như thứ K-Brot kém phẩm chất vậy.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000504", "translation": "“Lời nhận xét đó khiến tôi phải đặt dấu hỏi về tinh thần thượng tôn pháp luật của chính cô đấy, Trung tá.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000505", "translation": "“Thứ lỗi cho tôi, Trung tá Uger, nhưng tôi là một pháp sư trên không. Nếu không nạp đủ calo đều đặn, rất có thể tôi sẽ chết đói trước cả khi kịp bay lên trời mất.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000506", "translation": "Việc phải tống thứ đồ ăn tồi tệ xuống cổ họng bào mòn tâm trí nhanh hơn người ta tưởng. Chiến tranh vốn đã căng thẳng tột độ rồi, nên giá mà có chút quan tâm đến sức khỏe tinh thần thì tốt biết mấy. Liệu cấp trên có thể ghi nhớ đôi chút trong đầu rằng ăn uống là một trong những niềm vui hiếm hoi có thể tìm thấy nơi chiến trường hay không?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000507", "translation": "Mình không có ý phủ nhận tầm quan trọng sống còn của việc phải lưu tâm đến tình hình tiếp vận, nhưng cứ để đám Cộng sản làm kẻ dựa dẫm vào lối sản xuất độc một mặt hàng triền miên đi. Sự dồi dào mới chính là thứ mang lại tính chính danh cho chủ nghĩa tư bản.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000508", "translation": "“Ý cô là cô khắt khe trong chuyện ăn uống vì đó là một phần chức trách của mình sao?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000509", "translation": "“Tôi là một cô bé đang tuổi ăn tuổi lớn mà.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000510", "translation": "“Ha, nói hay lắm. Trong trường hợp đó, nếu cô muốn thì tôi có thể đánh tiếng với nhà ăn ở Văn phòng Bộ Tổng tham mưu. Tôi có thể chiêu đãi cô ăn thỏa thích, có điều…”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000511", "translation": "“Anh đang ngỏ ý bao toàn bộ tiền ăn của tôi đấy à, Trung tá Uger?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000512", "translation": "“…Có lẽ chúng ta nên kiềm chế lại thì hơn, vì lợi ích của cả hai.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000513", "translation": "“Tình hình đã tệ đến mức đó rồi sao?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000514", "translation": "Điều đó khiến mình tự hỏi liệu đồ ăn phục vụ cho các sĩ quan tham mưu có còn kinh khủng như mọi khi hay không, nhưng Uger lại hơi nghiêng đầu.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000515", "translation": "Hừm, phản ứng đó lạ thật đấy.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000516", "translation": "“À thì… hừm. Phải diễn tả thế nào nhỉ? Nó tệ, nhưng cũng không phải là đặc biệt tệ.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000517", "translation": "“Tôi thậm chí chẳng thể đoán nổi ý anh là gì nữa.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000518", "translation": "Uger đổi cách diễn đạt. “Nếu phải nói theo hướng khác thì… Dạo gần đây, khoảng cách về chất lượng giữa nhà ăn ấy và các nhà hàng bên ngoài đã thu hẹp lại rồi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000519", "translation": "“Ý anh là nó đã cải thiện ư?! Thật sao? Chuyện đó mà cũng có thể xảy ra được sao?!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000520", "translation": "Đáp lại nỗi bàng hoàng tột độ của cô, anh lắc đầu đầy cảm thán. “Giá mà được thế thì tốt biết mấy. Chẳng qua là đồ ăn dở tệ đã trở thành chuyện thường tình mà thôi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000521", "translation": "“Nghĩa là…”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000522", "translation": "Anh ấy đang nói rằng xét một cách tương đối thì nó không còn quá tệ nữa. Nhưng đồng thời nó cũng vẫn kinh khủng y như từ trước đến nay. Lời giải thích duy nhất là đồ ăn ở khắp mọi nơi khác nhìn chung đều đã tệ đi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000523", "translation": "“Không phải đồ ăn của Văn phòng Bộ Tổng tham mưu được cải thiện, mà là đồ ăn ngoài dân sự đã xuống cấp trầm trọng. Kết quả là giờ đây, có những người khi eo hẹp thời gian đã tự nguyện dùng bữa ngay tại cơ quan.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000524", "translation": "“Chắc chắn là anh đang nói đùa rồi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000525", "translation": "“Không, chuyện đó nghe thật kinh khủng nhưng lại là sự thật đấy.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000526", "translation": "Anh trả lời với vẻ mặt hoàn toàn nghiêm túc, còn mình thì thực lòng có muốn cười cũng chẳng cười nổi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000527", "translation": "Tanya từng vài lần được Tướng von Zettour “chiêu đãi” các bữa ăn ở nhà ăn đó như một kiểu lạm quyền chèn ép… *Mọi chuyện đã tồi tệ đến mức người ta thực sự chủ động chọn ăn ở đó sao?*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000528", "translation": "Chuyện này còn có thể rùng rợn hơn được nữa sao?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000529", "translation": "Càng nghĩ về chuyện đó, thực trạng lương thực của Đế quốc lại càng hiện lên rõ nét. Nếu người ta thực sự chủ động chọn ăn ở nhà ăn của Văn phòng Bộ Tổng tham mưu, chẳng phải điều đó có nghĩa là bản thân nền văn minh đã bị đánh bại rồi sao?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000530", "translation": "“Chiến tranh tổng lực quả thực là một tai ương,” Tanya lẩm bẩm rồi hạ ánh mắt nhìn xuống đôi bàn tay mình.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000531", "translation": "Thứ nước nóng có màu đựng trong chiếc tách xinh xắn. Cảm giác thật thảm hại làm sao. Thứ đồ sứ thượng hạng lại chứa đựng món đồ thay thế đáng thất vọng nhất. Món đồ sứ đượm nồng hơi thở của nền văn minh ấy chỉ càng khiến sự tương phản đó thêm phần ảm đạm.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000532", "translation": "“Ngay cả đồ uống cũng trở thành nạn nhân rồi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000533", "translation": "Hai tiếng cười chua chát và hai gương mặt trầm ngâm.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000534", "translation": "Thứ nước âm ấm có màu này được cho là hồng trà. Ngay cả loại trà kém chất lượng nhất trông cũng bắt mắt và thơm hơn thứ này.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000535", "translation": "“Đó là một loại trà thảo mộc đang khá phổ biến dạo gần đây. Nghe nói nó rất tốt cho sức khỏe nếu cô cần một chế độ ăn giàu chất xơ đấy, Trung tá von Degurechaff.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000536", "translation": "“Tôi chẳng phản đối gì chuyện có ý thức giữ gìn sức khỏe, nhưng tôi thực sự hoài nghi về lợi ích của việc bị sụt cân ngoài ý muốn và nhồi nhét đầy bụng những thứ thực phẩm thay thế khó tiêu đấy. Thực lòng mà nói thì chuyện đó có vẻ chẳng dễ chịu chút nào. Dù phải nhắc lại, nhưng tôi *đúng là* một cô bé đang tuổi ăn tuổi lớn mà, anh biết đấy.” Giờ đây với vẻ mặt cau có, Tanya thể hiện rõ lập trường của mình về vấn đề này. “Hơn bất cứ điều gì, đây là vấn đề hương vị… Tôi không phản đối trà thảo mộc. Chỉ là tôi thà uống hồng trà hoặc cà phê còn hơn.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000537", "translation": "“Caffeine hả?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000538", "translation": "“Dù sao thì tôi cũng là một người văn minh mà.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000539", "translation": "Cà phê và hồng trà có lẽ là một trong những chất xúc tác vĩ đại nhất cho sự tiến bộ. Chúng tạo ra nhu cầu về nguồn nước đun sôi sạch sẽ cùng các mạng lưới giao thương vững mạnh để phân phối hàng hóa thương mại.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000540", "translation": "Thương mại là động lực tốt nhất thúc đẩy giao lưu văn hóa đa dạng và tiến bộ xã hội. Vì vậy, việc coi caffeine là người bạn tốt của công dân hiện đại chỉ là lẽ đương nhiên mà thôi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter006.xhtml/p000541", "translation": "“Nói thẳng ra, Trung tá Uger, những nguyên tắc xoay quanh đồ uống không nên bị xem nhẹ. Ngay cả tôi cũng thấy khó lòng hòa hợp với những người có gu thưởng trà tồi đấy.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
