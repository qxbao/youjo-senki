{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000120", "translation": "Thứ vũ khí ấy giúp các hoạt động chống tiếp cận khu vực bằng bom chìm trở nên khả thi, đồng thời tiếp thêm niềm tin cho các tàu khu trục rằng họ đang nắm ưu thế chiến thuật.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000121", "translation": "“Đừng để mất dấu chúng! Bảo cả tàu *Lewis* và tàu *Victor* nện cho chúng một trận nữa!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000122", "translation": "Cơn khát báo thù cùng nghĩa vụ bảo vệ những người đồng đội thủy thủ. Những cảm xúc ấy đẩy thủy thủ đoàn các tàu đến tận cùng giới hạn. Thủy thủ hối hả lao qua các lối đi trên boong và luồn lách dọc những hành lang chật hẹp, liều mạng tranh thủ từng giây một trong khi các hạ sĩ quan gào khản cả giọng đốc thúc họ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000123", "translation": "Họ được huấn luyện bài bản, và điều đó thể hiện rất rõ. Những người lính này tận tụy với Tổ quốc của mình đến tột cùng khả năng của một con người.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000124", "translation": "Đáng buồn thay…", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000125", "translation": "Chính vì những nỗ lực ấy là biện pháp cơ động chống ngầm tối ưu nhất nên chúng lại phản tác dụng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000126", "translation": "Lực lượng săn ngầm chuyên trách, gồm cả các tàu khu trục và tàu tuần dương hạng nhẹ, đã bày sẵn đạn dược trên mặt boong. Đúng khoảnh khắc họ bắt đầu khai hỏa xuống mặt nước…", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000127", "translation": "Đây chính là thời khắc lũ ác quỷ dưới làn nước đã chờ đợi bấy lâu.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000128", "translation": "Tai họa bám chặt trên lưng những quả ngư lôi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000129", "translation": "Kẻ thù đáng sợ nhất của Khối Thịnh vượng chung trồi lên từ mặt biển.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000130", "translation": "“P-pháp sư địch, bên mạn trái! Chúng đang lao tới rất nhanh!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000131", "translation": "Tiếng hét run rẩy của người lính cảnh giới đã quá muộn. Chuyện gì sẽ xảy ra nếu đạn cối chống ngầm Hedgehog cùng các loại chất nổ khác đang phơi lộ trên mặt boong trúng phải một thuật thức phát nổ?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000132", "translation": "“Chết tiệt! Tất cả mọi người, bám chặt chuẩn bị chịu—!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000133", "translation": "Lời cảnh báo không kịp nữa rồi. Vừa đột ngột xuất hiện, các pháp sư đã điềm tĩnh triển khai thuật thức. Ngay khi họ thi triển ma pháp, vị thuyền trưởng đang chỉ huy liền mất đi ý thức đúng lúc thân xác ông không còn trụ vững.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000134", "translation": "“Tàu *Bermuda* nổ tung rồi sao?!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000135", "translation": "Sống đáy của con tàu lộ rõ dưới ánh chớp của vụ nổ gầm vang. Chỉ một thoáng nhìn ấy cũng quá đủ để các tàu đồng hành hiểu được chuyện gì vừa xảy ra. Tàu *Bermuda* chìm xuống nhanh chóng là do số bom chìm cùng ngư lôi chất đầy trên mặt boong và trong thân các tàu khu trục đã bị kích nổ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000136", "translation": "Nhưng bằng cách nào?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000137", "translation": "Nguyên nhân đã rành rành trước mắt—những vụ nổ thứ cấp. Thứ vũ khí đáng lẽ phải đem lại lợi thế cho họ thì nay lại quay sang hại chính họ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000138", "translation": "Nhưng bằng cách nào?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000139", "translation": "Trong một thoáng, thủy thủ đoàn trên những con tàu còn lại hoàn toàn không tài nào hiểu nổi chuyện đó. Thứ kéo họ bừng tỉnh chính là tiếng hét thất thanh của người lính cảnh giới.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000140", "translation": "“Pháp sư ư?! Pháp sư Đế quốc!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000141", "translation": "*À, lũ chó đẻ đó.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000142", "translation": "Đến nước này thì ai nấy đều đã hiểu rõ chuyện gì vừa diễn ra.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000143", "translation": "Các vị chỉ huy của phần hạm đội còn sót lại hiểu quá rõ—và chỉ biết buông lời nguyền rủa trời xanh. Họ đã bị đợt tấn công bằng ngư lôi làm cho phân tâm, để rồi giờ đây một đơn vị pháp sư hải quân đánh bộ đang mặc sức tàn phá.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000144", "translation": "Ắt hẳn phải là như vậy.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000145", "translation": "Họ thấm thía hơn ai hết sự lợi hại của chiến thuật này. Dù sao thì quân Đế quốc cũng đã dùng đi dùng lại ngón đòn đó ở ngoài phương bắc rồi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000146", "translation": "Nó đã trở nên quen thuộc đến mức khiến họ phát ốm. Lực lượng Khối Thịnh vượng chung thậm chí từng thử gậy ông đập lưng ông với quân Đế quốc bằng cách triển khai các pháp sư hải quân đánh bộ từ chính tàu ngầm của mình trong chiến dịch tiến đánh Liên minh Hiệp ước cũ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000147", "translation": "Thế nhưng họ đã vô thức buông lỏng cảnh giác khi đinh ninh rằng chẳng có hạm đội tàu mặt nước nào có thể đánh bại được mình. Và chính điều đó đã dẫn tới thảm họa này.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000148", "translation": "Các sĩ quan của hạm đội hoàn toàn không hề bất tài; họ nắm rất chắc tình hình hiện tại—một mớ hỗn độn chết tiệt. Thông thường, các máy bay tiêm kích cùng lực lượng pháp sư hải quân đánh bộ sẽ ngăn không cho kẻ địch kịp tiếp cận.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000149", "translation": "“Tất cả vào vị trí chiến đấu! Bắn tự do!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000150", "translation": "Tàu khu trục *Lewis* lập tức nã đạn bằng mọi thứ vũ khí đang ở trạng thái sẵn sàng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000151", "translation": "“Vứt bỏ hết mọi thứ dễ cháy nổ xuống biển! Phóng toàn bộ số đạn cối chống ngầm Hedgehog đi!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000152", "translation": "Tàu khu trục *Victor* vừa nạp xong dàn cối chống ngầm Hedgehog liền phóng toàn bộ số đạn nổ về phía vị trí ước chừng của đám tàu ngầm địch. Họ vội vã trút bỏ đạn dược nhanh hết mức có thể, nhưng chỉ một thoáng sau, cả hai con tàu đều lập tức mất khả năng chiến đấu vì những vụ nổ thứ cấp.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000153", "translation": "“Tàu *Lewis* và tàu *Victor* tiêu đời rồi!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000154", "translation": "Họ đã thực hiện nhiệm vụ của mình cho đến tận giây phút bi thảm cuối cùng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000155", "translation": "Dẫu chỉ trong một khoảng thời gian ngắn ngủi, nhờ thu hút phần lớn quân Đế quốc tập trung vào cặp tàu khu trục ấy, những con tàu khác trong đội hình đã có được một phút xả hơi hiếm hoi mang cảm giác bất an chẳng khác nào một bản án treo.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000156", "translation": "“Đổi hướng! Tiến hết tốc lực!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000157", "translation": "Trong khi tiếp tục vứt bỏ bất cứ thứ gì có nguy cơ phát nổ, những con tàu kịp chuyển sang tư thế cơ động né tránh còn nổi được trên mặt nước đã là may mắn lắm rồi. Khốn nỗi, một cơn bão tai ương đang ập sát về phía họ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000158", "translation": "Bất công ư? Đúng vậy đấy.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000159", "translation": "Lực lượng tiên phong, bao gồm các chiến hạm và chiếc tàu sân bay, gần như đã bị xóa sổ hoàn toàn ngay từ đầu trận giao chiến. Sẽ là một nhẽ nếu họ bị một hạm đội hùng mạnh của địch tấn công và đánh trả kẻ thù một cách tương xứng. Đằng này lại bại trận dưới tay vài quả ngư lôi và một nhúm pháp sư chết tiệt ư?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
