{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000389", "translation": "Ngẫm lại thì mọi chuyện đều rõ như ban ngày.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000390", "translation": "Chuyện này tuyệt đối không thể là sự thật được.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000391", "translation": "Kể từ khi đặt chân trở lại thủ đô, sự tự chủ của Tanya đã bị thử thách hết lần này đến lần khác, nhưng đây đã là giới hạn rồi. Những lời tiếp theo buột ra khỏi miệng cô là một tiếng thét.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000392", "translation": "“C-có phải nghĩa là Bộ Tư lệnh Tối cao hoàn toàn không đề ra bất kỳ mục tiêu chiến lược nào hết sao ạ?!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000393", "translation": "“Đúng là như vậy.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000394", "translation": "Chuyện này không bình thường chút nào. Não bộ của họ có còn hoạt động không đấy?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000395", "translation": "Lý tính nhà nước biến đi đâu mất rồi?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000396", "translation": "Cú sốc lớn đến mức khả năng giữ vẻ ngoài điềm tĩnh của Tanya hoàn toàn bay biến; mọi cảm xúc đều hiện rõ mồn một trên gương mặt khi cô ngước mắt nhìn lên trần nhà. Ngay lúc này, dù Quân đội Liên bang có phá cửa xông vào tấn công đi chăng nữa, thì cũng chẳng thể gây chấn động bằng phát hiện này.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000397", "translation": "Toàn bộ thực trạng này thật không sao tưởng tượng nổi. Chẳng còn cách nào khác để mô tả tình cảnh hiện tại của chúng ta.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000398", "translation": "Cứ như thể đang bay giữa chừng thì được thông báo rằng tổ bay đã biến mất khỏi buồng lái vậy. Không, phải giống như nhận được thông báo ngay trong chuyến bay rằng chính cái buồng lái đã biến mất thì đúng hơn.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000399", "translation": "“…Thưa Tướng quân, tình hình ở thủ đô lại phức tạp và khó lường đến thế sao ạ? Tôi thực sự không sao hiểu nổi lý do đằng sau chuyện này.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000400", "translation": "“Chắc cô cũng ngán phải nghe điều này rồi, nhưng đúng là vậy đấy. Trung tá, dư luận ở thủ đô đã hóa thành một con quái vật rồi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000401", "translation": "Câu trả lời của ông suýt khiến Tanya phải kêu trời.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000402", "translation": "Nghe kể rằng trước đây, từng có một chính trị gia người Nhật nhận định tình hình châu Âu quá phức tạp và kỳ quái rồi lập tức từ chức. Trời ạ, mình ghen tị với việc ông ta có được lựa chọn đó biết bao. Sẽ tuyệt vời nhường nào nếu mình có thể ba chân bốn cẳng chạy biến khỏi nơi này.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000403", "translation": "Nếu mọi chuyện đã ra nông nỗi này, thì bao nỗi thống khổ mà Đế quốc, Lục quân Đế quốc và cá nhân mình phải cam chịu rốt cuộc có ý nghĩa gì chứ? Tại sao chúng ta lại đặt nặng đạo đức nghề nghiệp đến thế? Mình gần như muốn hét toáng lên.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000404", "translation": "Như thể chừng đó vẫn chưa đủ tồi tệ, tình hình lương thực thì kinh hoàng, còn chúng ta lại chẳng có thời gian lẫn nơi nào để tiêu tiền lương, đồng nghĩa với việc chúng ta đang phải gánh vác công việc vượt quá mức lương, bị thiếu hụt nguồn tiếp tế, và hứng chịu cảnh lạm phát chưa từng có tiền lệ cùng một lúc!", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000405", "translation": "Chiểu theo hiểu biết của mình về khế ước xã hội, đây không còn nghi ngờ gì nữa chính là một thất bại toàn diện trong việc mang lại những gì người dân đáng được hưởng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000406", "translation": "Bất kể tên đần độn nào chịu trách nhiệm cho chuyện này đều đáng bị thanh trừng. Ngay lập tức và không chút nương tay.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000407", "translation": "“Đột nhiên… tôi cảm thấy một tai nạn nổ tung biết đâu lại là một ý tưởng tuyệt vời đấy ạ.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000408", "translation": "“Kẹt một nỗi là nghe cũng khá cám dỗ đấy.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000409", "translation": "Nét mặt thoáng giãn ra của vị tướng khi ông cười khúc khích trông thật rợn người.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000410", "translation": "Chuyện này đáng cười sao? Đây là thứ khiến ông bật cười ư? Hầu như chẳng còn nghi ngờ gì nữa, chúng ta đang ở rất gần điểm sôi rồi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000411", "translation": "“Hãy điểm lại tình hình hiện tại của Đế quốc nào… Ta cho rằng có thể nói nó đang mắc một căn bệnh nan y ngay giữa độ sung sức nhất của cuộc đời. Đáng tiếc thay, ngoài bác sĩ ra thì chẳng một ai — có lẽ ngay cả chính bản thân con bệnh — biết được nó còn sống được bao lâu nữa.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000412", "translation": "“Không có cách nào để điều dưỡng cho nó bình phục sao ạ?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000413", "translation": "“…Nếu loại được Liên bang ra ngoài, thì có lẽ một cuộc chiến tranh trên bộ…”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000414", "translation": "Nghe gần như thể ông đang nói rằng chúng ta sẽ có cơ hội vậy.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000415", "translation": "Xét thấy mối đe dọa lớn nhất mà Đế quốc đang phải đối mặt hiện nằm ở miền đông, thì điều đó cũng hợp lý thôi. Tất nhiên, chính sự đeo bám dai dẳng của Liên bang mới là thứ đang đẩy chúng ta vào nỗi thống khổ tột cùng này.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000416", "translation": "Vậy là chúng ta cứ việc ngồi tưởng tượng xem mọi chuyện sẽ ra sao nếu có thể dùng phép màu để có được những điều kiện lý tưởng ư?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000417", "translation": "Có một vấn đề lớn ở đây.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000418", "translation": "“Ngài có nghĩ là *Kranke* chịu đựng nổi chuyện đó không ạ?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000419", "translation": "“Ta không biết.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000420", "translation": "“Sao cơ ạ?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000421", "translation": "Rõ rành rành là vẻ mặt ngơ ngác của Tanya khiến cô trông như kẻ mất não. Nhưng bất kỳ ai rơi vào cảnh này cũng sẽ hoang mang cả thôi. Vị tướng đã biến thành một thực thể hoàn toàn không thể đoán định.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000422", "translation": "Đây là một sự chệch hướng so với Rudersdorf trong ký ức gần đây.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000423", "translation": "Ai cũng có một hình dung khái quát về tính cách cấp trên của mình, và người đàn ông trước mặt mình lúc này đã khác xa so với những gì mình vẫn thường nghĩ về ông.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000424", "translation": "“Ta đã bảo là ta không biết. Ta không thể dám chắc là bất khả thi, nhưng cũng chẳng có gì bảo đảm là chuyện đó khả thi cả.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000425", "translation": "“Thưa Tướng quân, vậy trên phương diện quân đội thì…”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000426", "translation": "“Chúng ta là một đội quân được kỳ vọng có khả năng giành chiến thắng ngay cả khi không có lấy một định nghĩa về chiến thắng. Xét theo lẽ đó, chúng ta hẳn phải xử lý được cả những vấn đề hóc búa nhất. Cô không đồng ý sao, Trung tá?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000427", "translation": "Mình có nên đưa ông đi giám định tâm lý không nhỉ? Hôm nay Rudersdorf kỳ lạ đến mức một ý nghĩ vô bổ chợt lướt qua tâm trí mình.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000428", "translation": "Ông đang tuyệt vọng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000429", "translation": "Đó là một khả năng mà mình ước sao có thể bác bỏ ngay tức khắc, nhưng khi ông buông ra những lời mỉa mai chua chát như vậy, thật khó mà không cảm thấy u ám.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000430", "translation": "“Thưa Tướng quân, tôi muốn được nghe suy nghĩ của riêng ngài…”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000431", "translation": "Vị trung tướng đáp lại bằng một cái gật đầu lịch thiệp. “Lựa chọn duy nhất của chúng ta ở miền đông là thu hẹp chiến tuyến và củng cố lực lượng. Ở phía tây cũng tương tự. Nhìn chung, chúng ta đang trên đà lao dốc.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000432", "translation": "Ông đột ngột đưa ra phân tích của mình về tình hình hiện tại. Nghe thật khủng khiếp, nhưng đó chính là thực tế mà Đế quốc đang phải đối mặt. Ít nhất thì cũng thấy rõ là cấp trên của mình nắm được mức độ nghiêm trọng của thử thách trước mắt chúng ta.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000433", "translation": "“Làm gì đó để giải quyết mớ hỗn độn này là công việc của ta. Ta đoán mình sẽ bắt đầu bằng việc thanh lọc *Kranke* tùy theo mức độ cần thiết… Dù hiện giờ thậm chí còn chẳng rõ cần phải cắt bỏ phần nào hay bằng cách nào.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000434", "translation": "*Thanh lọc* là một từ vô cùng nguy hiểm. Ông đang ám chỉ điều gì đây?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000435", "translation": "Khốn nỗi, ngắt lời vào lúc này sẽ chẳng khác nào chọc vào ổ kiến lửa.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000436", "translation": "Khi vị tướng tự trả lời những câu hỏi của chính mình bằng giọng giễu cợt, Tanya chỉ mỉm cười trong sự im lặng đầy bất định, đúng như chuẩn mực xã giao. Suy cho cùng, giữ phép lịch sự là để bảo đảm an toàn cho bản thân.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
