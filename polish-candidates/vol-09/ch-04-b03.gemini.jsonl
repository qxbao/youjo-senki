{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000078", "translation": "*Cứ như thể chúng ta vừa cạy tung cánh cổng địa ngục ra vậy!* Nhưng thời khắc để hối hận đã qua rồi. Cái giá cho sự tắc trách của họ sẽ phải trả bằng mạng người.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000079", "translation": "“Tàu *Hood*! Chiến hạm *Hood Hùng mạnh* đang—!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000080", "translation": "Tiếng la thất thanh của đám thủy thủ vang lên. Chỉ cần nhìn thoáng qua cũng đủ để nhận ra chuyện gì đang xảy ra. Tiếng nổ ầm vang chấn động khắp vùng giao chiến, cột khói cuồn cuộn bốc lên.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000081", "translation": "Cảnh tượng kinh hoàng ấy thật chẳng nỡ nhìn.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000082", "translation": "Họ đang chứng kiến cơn giãy chết của một con tàu sắt từng nguy nga tráng lệ. Làn khói tuôn ra từ thân tàu đang nghiêng hẳn đi cùng thứ âm thanh ghê rợn kia cho thấy đã quá muộn để cứu tàu *Hood*.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000083", "translation": "Tàu *Hood*. Chiến hạm *Hood Hùng mạnh…*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000084", "translation": "Trước chiến tranh, nó là con tàu lớn nhất được bất kỳ cường quốc nào đưa vào biên chế và có thể coi là chiến hạm xuất sắc nhất của Khối Thịnh vượng chung. Chiến hạm *Hood Hùng mạnh* chính là niềm tự hào của hải quân.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000085", "translation": "Vậy mà chỉ một đòn đánh trúng đích duy nhất đã nhấn chìm nó.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000086", "translation": "*Chỉ một đòn mà đã hóa thành đống mảnh vỡ trôi nổi trên biển sao?* Ngay cả khi đã tận mắt chứng kiến cảnh đó, tất cả các thủy thủ đều muốn gào lên rằng đó không thể là sự thật.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000087", "translation": "*Lẽ ra chuyện không thể như thế này được!* họ gào khóc. Vị thuyền trưởng kiêu hãnh thề sẽ cùng chung số phận với con tàu của mình, trong khi thủy thủ đoàn thậm chí còn chẳng kịp quằn quại trong đau đớn.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000088", "translation": "Nhưng cùng lúc đó, những quân nhân tinh nhuệ này dẫu đau xót vẫn kiên cường nén lại và bắt tay vào nhiệm vụ. Ngay khi nhận ra tàu *Hood* vừa trúng ngư lôi, phần còn lại của hạm đội lập tức phá vỡ đội hình và bắt đầu thực hiện các động tác cơ động né tránh.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000089", "translation": "Những pha đổi hướng ấy được thực hiện với tốc độ và kỷ luật cao nhất mà bất kỳ ai có thể kỳ vọng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000090", "translation": "Quyết định mau lẹ tột cùng, phản ứng nhanh nhạy nhất có thể hình dung, và các chuyển động trật tự đến mức cả hải đội thậm chí còn phá vỡ đội hình một cách đồng bộ hoàn hảo.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000091", "translation": "Thế nhưng nỗ lực bẻ lái đầy quyết tâm của các thủy thủ rốt cuộc lại trở nên vô ích.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000092", "translation": "“T-tàu *Ark Royale*!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000093", "translation": "Một tiếng hét thất thanh run rẩy báo hiệu số phận nghiệt ngã vừa giáng xuống con tàu.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000094", "translation": "“Chuyện gì thế? Báo cáo đi!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000095", "translation": "“T-tàu *Ark Royale* trúng đòn rồi!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000096", "translation": "Một tiếng nổ rền vang như sấm kèm theo cột nước vọt lên ngay sát bên chiếc tàu sân bay. Ngay cả từ boong chiếc tàu khu trục ở xa tâm đội hình hạm đội nhất cũng không thể nào nhầm lẫn được chuyện gì đang xảy ra.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000097", "translation": "Trong ánh mắt sững sờ của các thủy thủ, chiếc tàu sân bay nhanh chóng bắt đầu nghiêng hẳn đi. Có phải là do chấn động từ vụ nổ không? Những chiếc máy bay đang cố cất cánh khỏi boong tàu *Ark Royale* đâm sầm vào nhau rồi bốc cháy ngùn ngụt. Thậm chí còn chưa kịp trôi qua đủ thời gian để bất kỳ ai cảm thấy bàng hoàng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000098", "translation": "“Khốn kiếp!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000099", "translation": "Các pháp sư hải quân đánh bộ và thủy thủ đoàn kịp thời thoát thân đã cố gắng dập tắt những đám cháy đang bùng lên, nhưng biển lửa chỉ càng lúc càng lan rộng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000100", "translation": "“Quan sát kỹ mặt nước! Tìm vệt rẽ nước của ngư lôi!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000101", "translation": "Át cả mớ mệnh lệnh hỗn loạn khác, thuyền trưởng chiếc tàu khu trục gầm lên với vẻ quyết tâm nghiệt ngã.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000102", "translation": "“Nếu cần thì lao thẳng vào đường đạn để chặn chúng lại! Đừng để chúng đánh trúng thêm bất kỳ phát nào nữa!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000103", "translation": "Các tàu hộ tống không thể để thêm bất kỳ quả ngư lôi nào lọt qua được nữa.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000104", "translation": "Để cứu thủy thủ đoàn của tàu *Hood*.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000105", "translation": "Để cứu tàu *Ark Royale*.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000106", "translation": "Khi tàu ngầm địch đang rình rập gần đó, họ thậm chí còn không thể dừng lại để ứng cứu. Cơn thịnh nộ cùng nỗi sốt ruột bừng cháy trong lồng ngực khiến tất cả các thủy thủ bất giác nghiến chặt răng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000107", "translation": "Thế nhưng chỉ một thoáng sau, thủy thủ đoàn của tàu khu trục *Bermuda* thuộc Khối Thịnh vượng chung thấy mình đang dốc hết tâm can nguyền rủa Thượng đế.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000108", "translation": "Ngay phía trước họ, chiếc tàu tuần dương *Yliastral* đang chạy hết tốc lực.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000109", "translation": "Nhưng rồi một âm thanh kinh hoàng vang lên. Cột nước đáng sợ lại dựng đứng lên.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000110", "translation": "“*Yliastral*! Tàu *Yliastral*!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000111", "translation": "Thân tàu đang chìm khuất dần đã bị xé toạc làm đôi. Chẳng còn cơ may nào cứu được con tàu ấy nữa. Để tránh bị con tàu đang chìm cuốn theo xuống đáy nước, tàu *Bermuda* buộc phải đổi hướng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000112", "translation": "Cùng lúc đó, vị thuyền trưởng tiếp nhận quyền chỉ huy và làm mọi cách trong khả năng của mình để che chắn cho con tàu đang chìm dần. Cuối cùng, nỗ lực bền bỉ của các trắc thủ sonar cũng đem lại kết quả.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000113", "translation": "“Tôi bắt được tín hiệu gì đó rồi! Là… tiếng chân vịt đẩy?! Tôi nghe thấy một tàu ngầm địch—Không, hai chiếc?! Khoan đã, còn nữa! Là cả một bầy sói săn mồi!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000114", "translation": "“Đổi hướng! Nhanh lên! Đã đến lúc chấm dứt toàn bộ chuyện này rồi!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000115", "translation": "“Rõ, thưa Thuyền trưởng!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000116", "translation": "“Chúng ta sẽ không để chúng rời khỏi đây lành lặn đâu! Chuẩn bị tác chiến chống ngầm! Bắt lũ khốn đó phải trả giá!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000117", "translation": "Các tàu tuần dương hạng nhẹ và tàu khu trục của Khối Thịnh vượng chung phản ứng không chút chậm trễ. Họ đồng loạt quyết định rằng cho dù việc đó có làm suy giảm khả năng dò tìm của hệ thống sonar, ưu tiên hàng đầu lúc này vẫn là ngăn chặn thêm các đợt tấn công bằng ngư lôi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000118", "translation": "Để nhanh chóng khóa họng đám tàu ngầm, họ tung ra dàn cối chống ngầm Hedgehog có khả năng rải hàng loạt đạn con. Đó là một loại vũ khí mới vừa được trang bị cho hạm đội.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter014.xhtml/p000119", "translation": "Thứ vũ khí này được phát triển chuyên biệt để tiễn đám tàu ngầm Đế quốc lấc cấc kia xuống đáy đại dương.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
