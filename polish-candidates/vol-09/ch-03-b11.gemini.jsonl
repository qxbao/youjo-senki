{"segment_id": "YS-LN09/Text/chapter010.xhtml/p000401", "translation": "“Đừng lo, Trung tá Degurechaff. Tôi đời nào lại đi cướp mất hào quang của người từng kề vai cầu nguyện cùng mình! Chúng ta đều là những người đồng đạo cầu xin vinh quang của Chúa, chẳng phải sao? Cô có thể tin ở tôi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter010.xhtml/p000402", "translation": "Lời ông ta nói chẳng đem lại nổi lấy một mảy may nhẹ nhõm. Đừng có nhìn mình bằng nụ cười bệnh hoạn như thể ông thấu hiểu mọi chuyện thế chứ!", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter010.xhtml/p000403", "translation": "“Tôi chỉ là một sĩ quan của Lục quân Đế quốc mà thôi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter010.xhtml/p000404", "translation": "Một lời phủ nhận vòng vo. Đáng buồn thay, hạng người này có nói gì đi nữa cũng chẳng chịu hiểu ẩn ý. Kỹ sư Schugel ngày trước—người hẳn sẽ hiểu ý nó muốn nói mình là một quân nhân chứ không phải một con chiên—giờ không còn ở đây với chúng ta nữa rồi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter010.xhtml/p000405", "translation": "Vị tiến sĩ, kẻ đã bị tẩy não đến mức sùng đạo vô song, sẽ chẳng lọt tai lời bất kỳ ai nói.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter010.xhtml/p000406", "translation": "Tanya lắc đầu. Mình không nghĩ ngay từ đầu ông ta đã chịu nghe lời ai.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter010.xhtml/p000407", "translation": "“Giống hệt như V-1, tất cả những gì các cô cần làm là đâm thứ này vào quân địch. Rồi thoát thân. Cô sẽ được chiêm ngưỡng cảnh tượng tuyệt đẹp khi lượng thuốc nổ dồi dào trên khoang thổi tung bất cứ rắc rối nào đang ngáng đường mình.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter010.xhtml/p000408", "translation": "Tức ý ông ta là bọn mình sẽ làm ngư lôi sống chứ gì.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter010.xhtml/p000409", "translation": "Chuyện ông ta học hỏi từ người Ý mà trang bị cho chúng một hệ thống thoát hiểm thì, ừm, gọi là có được chút điểm cộng cỏn con.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter010.xhtml/p000410", "translation": "Nhưng cái quái gì thế này?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter010.xhtml/p000411", "translation": "“Xem chừng sắp chẳng còn việc gì cho chúng tôi làm nữa rồi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter010.xhtml/p000412", "translation": "“Nó sẽ tung ra hỏa lực tập trung dưới hình thức các pháp sư. Chắc chắn đây là một phương án tối ưu để giải quyết vấn đề của cô rồi. Phải không?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter010.xhtml/p000413", "translation": "Dù đã rã rời vì toàn bộ chuyện này, Tanya vẫn cất lời bày tỏ một tia hy vọng nhỏ nhoi. “Thế còn sự bảo đảm cho việc chúng tôi sẽ không bị thổi bay theo là gì?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter010.xhtml/p000414", "translation": "“Phần đó hoàn toàn phụ thuộc vào tâm ý của Chúa trong chuyện này. Nói cách khác, tôi chắc chắn cô có thể kê cao gối mà ngủ.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter010.xhtml/p000415", "translation": "Vậy là mình phải phó mặc số phận cho hiện thân của ác ý mang tên Being X kia ư? *Chuyện này chẳng vui chút nào!* Tanya thầm nghĩ, và trước khi kịp nhận ra, nó đã tuôn ra đủ mọi lời nguyền rủa trong đầu. Chẳng công bằng chút nào hết.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter010.xhtml/p000416", "translation": "“Ồ, Trung tá Degurechaff, đừng lo. Tôi tin chắc Chúa đang che chở cho cô—hãy tin vào chính mình! Dù chẳng đáng là bao, nhưng tôi, một người đồng đạo, luôn đặt đức tin nơi cô.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter010.xhtml/p000417", "translation": "“Sao cơ?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter010.xhtml/p000418", "translation": "“Tôi phát triển thứ này là vì đã lắng nghe những đề xuất của cô đấy. Có thể gọi đây là một dự án chung được hiện thực hóa nhờ đức tin của những người đồng đạo. Tôi dám chắc mình chẳng thể nào tạo ra được một thứ thế này nếu thiếu đi hồng ân của Chúa,” ông ta vừa nói vừa nở nụ cười đầy cuốn hút. “Hãy tự hào lên, Trung tá.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter010.xhtml/p000419", "translation": "Vị tiến sĩ dang rộng hai tay như thể đang ban phước cho nó. Bộ ông ta đang trào dâng xúc động đấy à? Giơ hai tay lên trời, ông ta ngước nhìn trần nhà với nụ cười rạng rỡ rồi bắt đầu lẩm bẩm tạ ơn Chúa.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter010.xhtml/p000420", "translation": "Con người này đã thỏa mãn chưa vậy? Gật gù một mình như thể vừa ngộ ra điều gì đó, ông ta quay lại nhìn Tanya rồi cất lời với vẻ mặt hân hoan.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter010.xhtml/p000421", "translation": "“Thứ này về cơ bản chính là con của chúng ta đấy! Ha ha ha! Một quả ngư lôi tuyệt hảo phải không nào? Thật sự quá sức tuyệt vời.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter010.xhtml/p000422", "translation": "“C-con ư?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter010.xhtml/p000423", "translation": "“Cô đừng lo. Con bé là một đứa trẻ xinh đẹp. Tôi đã sinh ra nó, nhưng chính cô mới là người gieo hạt giống. Nếu không vướng mấy quy định đặt tên cứng nhắc vô vị kia thì tôi đã nhờ Tướng Zettour làm cha đỡ đầu rồi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter010.xhtml/p000424", "translation": "Ý ông là mình làm bố còn ông làm mẹ đấy hả?!", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter010.xhtml/p000425", "translation": "Đôi mắt ông ta ánh lên niềm tự hào tràn ngập khi vỗ nhẹ vào quả ngư lôi. Mù quách đi cho rồi, đồ *điên*!", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter010.xhtml/p000426", "translation": "“Thứ này hoàn toàn khác hẳn mấy con lươn mà lũ đần bên hải quân đã phát triển. Tôi tự hào khẳng định rằng mình đã dồn sự tỉ mỉ tột bậc vào toàn bộ linh kiện, cho đến tận từng ngòi nổ một.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter010.xhtml/p000427", "translation": "“Ý ông là sao, thưa Tiến sĩ?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter010.xhtml/p000428", "translation": "Ông ta chẳng hề mảy may biết nó cảm thấy thế nào—à thì, có lẽ ông ta cũng chẳng bao giờ có ý định tìm hiểu… Mình chỉ mong ông ta tự nhìn lại những “thành tựu” của bản thân một chút.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter010.xhtml/p000429", "translation": "“Đây là ngư lôi của tôi. Nói cách khác, nó là một quả ngư lôi hoạt động đàng hoàng.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter010.xhtml/p000430", "translation": "“…Ng-ngư lôi của ông ư, thưa Tiến sĩ?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter010.xhtml/p000431", "translation": "Cảm nhận thẳng thắn của mình về bất kỳ quả ngư lôi nào do vị tiến sĩ này phát triển chỉ gói gọn trong nỗi kinh hoàng tột độ. Theo đúng nghĩa đen, đây là một quả ngư lôi do một gã tiến sĩ điên chế tạo. Thứ duy nhất nó khơi dậy là nỗi sợ hãi. Nhưng chẳng phải điều đó hoàn toàn tự nhiên hay sao?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter010.xhtml/p000432", "translation": "Ai mà chẳng sợ đến hồn xiêu phách lạc cơ chứ?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter010.xhtml/p000433", "translation": "Điều đó có nghĩa vị tiến sĩ là người duy nhất hiểu lầm.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter010.xhtml/p000434", "translation": "Trong một thoáng, ông ta khoanh tay rồi chìm vào im lặng; thế rồi ông ta ngẩng phắt đầu lên với vẻ mặt hết sức chân thành. Ái chà, lại gì nữa đây? Mình biết thừa ông ta bất ổn về mặt cảm xúc, nhưng nếu chốc nữa ông ta định bùng nổ thì mình muốn lùi ra xa một chút, nên hy vọng ông ta sẽ đủ tâm lý mà chờ cho một giây.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter010.xhtml/p000435", "translation": "Đang tự hỏi chuyện gì sẽ xảy ra tiếp theo, Tanya vừa định lùi lại thì đột nhiên vị tiến sĩ cao lêu nghêu đã sấn sát tới ngay trước mặt nó.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter010.xhtml/p000436", "translation": "“…Tôi cứ ngỡ mình đã hiểu rõ điều đó về mặt lý trí, nhưng…”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter010.xhtml/p000437", "translation": "“Ý ông là sao?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter010.xhtml/p000438", "translation": "“Phải, vấn đề nằm ở đó đấy. Chính miệng tôi còn nói đây là một dự án chung cơ mà.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter010.xhtml/p000439", "translation": "Ngay lúc mình còn đang tự hỏi ông ta định nói cái gì thì đôi bàn tay ông ta bỗng nhiên lại bấu chặt lấy hai vai Tanya.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter010.xhtml/p000440", "translation": "“Tôi xin lỗi. Xin hãy cho phép tôi được tạ lỗi từ tận đáy lòng.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter010.xhtml/p000441", "translation": "Nhà khoa học rợn người kia khuỵu người xuống để nhìn thẳng vào mắt nó, và đáng kinh ngạc thay, trong ánh mắt ông ta lại hiện lên sự hối lỗi chân thành.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter010.xhtml/p000442", "translation": "Chuyện gì thế hả, Tiến sĩ?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter010.xhtml/p000443", "translation": "“Đó là quả ngư lôi của *chúng ta*. Tôi không cố ý…”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter010.xhtml/p000444", "translation": "Với gương mặt tái mét như một kẻ phạm tội, ông ta quỳ sụp xuống trước mặt nó. Rồi ông ta phủ phục xuống đất như thể đang xưng thú một trọng tội nào đó.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter010.xhtml/p000445", "translation": "“Tôi thực sự rất xin lỗi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter010.xhtml/p000446", "translation": "Xin đính chính. Mình muốn biết *chính xác* tại sao ông lại nghĩ thế đấy?!", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter010.xhtml/p000447", "translation": "“Xin hãy thứ lỗi cho tôi, Trung tá. Tôi suýt chút nữa đã sa vào thói ngạo mạn. Chính tình đoàn kết gắn bó, khiêm nhường của chúng ta—sự hợp tác giữa chúng ta—mới có thể làm nên phép màu, vậy mà chẳng hiểu sao tôi lại suýt quên mất điều đó. Tôi đã trở nên tự phụ rồi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
