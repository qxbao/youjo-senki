{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000207", "translation": "Dù nói là vậy, ngoài một điểm tích cực duy nhất đó ra, Đế quốc vẫn có vô số điều bất ổn.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000208", "translation": "*Chẳng hạn như…* Đôi chân Tanya gần như lê bước khi cô lên chiếc xe hơi mà Serebryakov đã gọi sẵn.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000209", "translation": "Cô không còn lựa chọn nào khác ngoài việc phải đến trình diện tại Văn phòng Bộ Tổng tham mưu. Tuyệt đối không được viện cớ hay bàn lùi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000210", "translation": "Chưa hết, một vị sĩ quan cấp trên đang âu lo lấy tay day trán lại ngồi ngay sát bên cạnh cô.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000211", "translation": "Chỉ cần viên sĩ quan phụ tá của mình làm hỏng việc một chút xíu thôi, biết đâu cuộc họp này sẽ có thể được hoãn sang một ngày khác. Visha ơi, ước gì cô có thể hiểu thấu được nỗi lòng của mình lúc này.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000212", "translation": "“…Haizzz,” Tanya thở dài.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000213", "translation": "“Có chuyện gì thế, Trung tá?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000214", "translation": "“Không có gì đâu, thưa Đại tá.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000215", "translation": "“Tốt.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000216", "translation": "Sau cuộc đối đáp chẳng đi đến đâu ấy, Tanya lịch sự giữ im lặng khi ngồi cạnh vị đại tá cũng trầm mặc không kém. Khung cảnh bên ngoài cửa sổ chiếc xe hơi đang lắc lư… có lẽ mình phải gọi đó là một sắc thái đơn điệu đến nhức mắt.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000217", "translation": "Ngay cả khi một vệt màu nhạt nhòa thoáng lọt vào tầm mắt, cũng dễ thấy đến đau lòng là nó nằm ngoài tầm với. Bao giờ, ôi đến bao giờ các sĩ quan mới được đi nghỉ phép đây?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000218", "translation": "Mình muốn cải cách luật lao động. Rất khao khát là đằng khác. Ngay bây giờ luôn. Cơ mà nghĩ lại thì…", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000219", "translation": "Mình khẽ lắc đầu.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000220", "translation": "Mong muốn lớn nhất của mình, thậm chí còn hơn cả bộ luật lao động ngoài tầm với kia, là một công cụ bạo lực có thể xóa sổ mọi rắc rối của mình; nếu được thì liên minh với một bên vừa có năng lực vừa đáng tin cậy sẽ tuyệt vời biết bao—một thứ có thể đóng vai trò làm lá chắn thịt nhằm bảo đảm an toàn cho Tanya.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000221", "translation": "Hội đồng Tự trị mà Zettour dựng lên ở miền đông… Chà, cũng không hẳn đó là một dự án vô bổ, nhưng… đáng tiếc là chẳng thể trông cậy vào nó cho bất cứ việc gì ngoài phòng ngự chiều sâu.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000222", "translation": "Mình cũng chẳng ưa gì thế bị động thuần túy phải chạy theo đối phó. Chuyện giới chóp bu lục quân và chính phủ đang bất đồng cũng rất đáng lo ngại. Liệu tình thế này có cứu vãn nổi không nếu có sẵn một chiếc tã lót trong tay?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000223", "translation": "*Haizzz.* Tanya nuốt ngược một tiếng thở dài nữa vào lòng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000224", "translation": "Mình thậm chí còn chưa từng nuôi con bao giờ, thế mà giờ đùng một cái lại phải lãnh phần việc thay tã sao?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000225", "translation": "Đây là công việc, nên chẳng có chỗ cho lời phàn nàn nào cả. Dựa trên nghĩa vụ và hợp đồng của Tanya, việc thu dọn bãi chiến trường này theo yêu cầu của Zettour đã là chuyện ván đóng thuyền rồi. Ước gì chí ít mình cũng có thể nộp hóa đơn đòi trả thêm thù lao.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000226", "translation": "Chẳng có chỗ cho lời phàn nàn nào, nhưng… khoan đã.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000227", "translation": "Đáng lẽ ở đây đâu cần đến dịch vụ hộ lý chăm sóc. Chẳng lẽ những nhà lãnh đạo ở hạt nhân trung tâm của Đế quốc lại rơi vào tình trạng tệ hại đến mức không những cần tới tã lót mà thậm chí còn chẳng tự mặc nổi cho mình sao?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000228", "translation": "Đúng là một câu hỏi kỳ quặc đến khó tin.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000229", "translation": "TỔNG HÀNH DINH BỘ TỔNG THAM MƯU, VĂN PHÒNG CỦA TRUNG TƯỚNG RUDERSDORF", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000230", "translation": "“…Ra là ngay cả chuyện nhảm nhí một khi đi đến mức cực đoan cũng trở thành một cú sốc.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000231", "translation": "Chủ nhân của căn phòng, Trung tướng Rudersdorf, nhăn mặt. Công bằng mà nói, ông đã dốc hết sức mình để cố nặn ra một nụ cười.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000232", "translation": "Kết quả thì sao?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000233", "translation": "Hai khóe miệng đang co giật tội nghiệp của ông đã nói lên tất cả.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000234", "translation": "“Các người muốn thắng cuộc chiến, nhưng lại không muốn chi tiền, và cũng chẳng muốn chịu hy sinh? Đòi hỏi thế là quá đáng lắm rồi. Ta cần các người phải nhượng bộ ít nhất một điểm.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000235", "translation": "Giá có một tấm gương trước mặt lúc này, hẳn ông sẽ thấy một bộ mặt sững sờ há hốc đến thảm hại. Gương mặt mà người bạn của ông thường chẳng nhịn được phải gọi là trơ trẽn giờ đây đang vặn vẹo vì thống khổ. Chẳng mấy chốc, nét đau đớn đã len lỏi vào biểu cảm của ông, hệt như thể bác sĩ vừa thông báo rằng ông mắc một căn bệnh nan y vô phương cứu chữa.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000236", "translation": "Và tệ hơn hết là thanh âm trong giọng nói của ông. Nó khác một trời một vực với giọng điệu ngạo mạn mà ông vẫn thể hiện trước mặt thuộc cấp. Yếu ớt đến khó tin.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000237", "translation": "Bản thân Rudersdorf cũng nhận thức rất rõ sự trớ trêu ấy.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000238", "translation": "“Chúng ta đang có chiến tranh.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000239", "translation": "*Ngay cả vào lúc này.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000240", "translation": "*Tại sao?* ông buộc phải tự chất vấn chính mình.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000241", "translation": "“…Thật kỳ lạ. Nếu không phải tại lũ ngốc đã chọn không dừng lại khi chúng ta còn cơ hội, thì chuyện này hẳn đã kết thúc từ đời nào rồi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000242", "translation": "Ông từng nhìn thấy cơ hội, hy vọng và có lẽ là cả một tương lai tươi sáng. Đáng lẽ Đế quốc đã có thể bước đi về phía ánh sáng đó.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000243", "translation": "“Nhưng con đường ấy đã khép lại với chúng ta rồi… Thật là một bi kịch…”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000244", "translation": "Cái kết mà ông từng trông thấy… *Tại sao chứ?* Ngay cả Rudersdorf, người vốn nổi danh là điềm tĩnh không gì lay chuyển nổi, cũng cảm thấy thôi thúc phải cầu nguyện. *Lạy Chúa, tại sao?*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000245", "translation": "“Hối tiếc và cầu nguyện cũng chẳng thay đổi được điều gì.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000246", "translation": "Ông không thể ngăn những lời tự giễu cứ thế tuôn ra khỏi miệng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000247", "translation": "Tất cả mọi thứ—tất cả mọi thứ—đều đã tuột khỏi tầm tay ông.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000248", "translation": "Khả thể đáng lẽ đã nằm gọn trong tầm với ấy từ lâu đã tan biến mất tăm. Tất cả những gì còn sót lại giờ đây chỉ là cặn bã của một giấc mơ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000249", "translation": "*Không.* Tới đó, người đàn ông mỉm cười cay đắng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000250", "translation": "“Ta không thể chịu khuất phục.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000251", "translation": "*Chuyện này vẫn chưa kết thúc. Vẫn còn quá sớm để bỏ cuộc. Ta vẫn còn ý chí chiến đấu.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000252", "translation": "*Chưa đâu, chưa đâu, chưa đâu* là tất cả những gì ông có thể vực dậy lúc này. Chẳng còn gì hơn nữa. Nhưng chỉ bấy nhiêu thôi cũng đã đáng nể lắm rồi. Vậy thì có gì để ông phải nản lòng cơ chứ?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000253", "translation": "Thứ ông cần vào thời khắc này là một phương thức cực kỳ đơn giản.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000254", "translation": "Ông cần giải quyết tình hình và ngăn không cho các vấn đề nảy sinh. Những biện pháp khẩn cấp để xử lý ổ nhiễm trùng. Nhiệm vụ của ông vô cùng rõ ràng và trực diện.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000255", "translation": "Những lời khẽ khàng buột ra khỏi môi khiến Rudersdorf phải tự hỏi chính mình. Mục tiêu là bảo vệ Đế quốc. Điều đó thì quá hiển nhiên rồi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000256", "translation": "Nhưng đối tượng nhắm tới nên là gì lại là một vấn đề mờ mịt hơn nhiều.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000257", "translation": "“Đó cần phải là một đòn tấn công phẫu thuật. Chúng ta có nên nhắm vào bộ phận đang cần đến nó nhất không?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter004.xhtml/p000258", "translation": "Họ chưa từng có tiền lệ thành công nào trong việc xóa sổ đạo quân dã chiến của địch. Tung một đòn tấn công phẫu thuật vào vị trí trọng yếu nhất đồng nghĩa với việc… thực hiện một biện pháp dường như không thể dung thứ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
