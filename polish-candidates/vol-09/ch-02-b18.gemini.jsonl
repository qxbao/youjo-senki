{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000001", "translation": "Ngoài tiền tuyến, chiều cao chẳng gây chút bất tiện nào cho mình. Đôi khi nó còn giúp cuộc sống của mình dễ thở hơn—chẳng hạn như mình không cần phải cúi người nhiều như những người khác. Thế nhưng nó lại chẳng mấy hữu ích khi mình đứng thẳng giữa một đám đông.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000002", "translation": "Sự chênh lệch chiều cao là điều không thể phủ nhận. Mình thừa nhận đấy—mình bé tí hon. Dĩ nhiên, vì tạo thành một mục tiêu nhỏ hơn trước mắt kẻ địch, nên điều đó chỉ có nghĩa là mình đã được tối ưu hóa cho chiến trường mà thôi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000003", "translation": "Thật bực mình làm sao khi mình lại không được tối ưu hóa cho một cảnh quan đô thị văn minh.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000004", "translation": "“Cô không nhìn thấy gì hết, hử?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000005", "translation": "“À… tiếc là từ chỗ này thì không ạ.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000006", "translation": "“Mà để tôi nhấc bổng cô lên ngồi trên vai thì lại chẳng phải phép chút nào.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000007", "translation": "Rõ mồn một là cấp trên của cô, với nụ cười hiền từ như một người ông nhân hậu của ai đó, đang lấy mình ra làm trò cười. Chính điểm này mới khiến đám sĩ quan tham mưu trở thành những kẻ xấu tính đến vậy.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000008", "translation": "Mình chẳng vui vẻ gì khi phải bộc lộ một điểm yếu kỳ quặc vào đúng thời điểm khác thường thế này… nhưng đành phải thừa nhận rằng Tanya khá thấp bé.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000009", "translation": "“Ý ngài là tôi có thể ngồi lên vai ngài sao?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000010", "translation": "“Hả? Cô muốn thế ư? Vậy thì tôi cho là mình cũng làm được thôi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000011", "translation": "Bất chấp nỗ lực hết sức của mình nhằm làm ông nao núng, hàng phòng ngự của vị tướng vẫn bất khả xâm phạm.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000012", "translation": "Dẫu có là động vật chính trị đi chăng nữa, với tư cách là động vật xã hội, vẫn có những ranh giới mà con người không được phép vượt qua. Và nói thật lòng, mình thà làm bất cứ việc gì khác còn hơn là phải ngồi lên vai ông.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000013", "translation": "“…Không, ờ…”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000014", "translation": "“Ồ, cô không cần phải lo cho tôi đâu. Tôi đủ sức mà.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000015", "translation": "Ông vừa cười vừa quả quyết với mình rằng ông thừa sức công kênh mình lên, khiến sống lưng mình gần như đông cứng lại.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000016", "translation": "Nếu ông mà đặt mình lên vai ngay tại đây, nỗi nhục này sẽ đeo bám mình suốt phần đời còn lại mất. Lỡ mà có ảnh chụp lưu lại nữa thì bao nhiêu danh dự và phẩm giá mình tích lũy được sẽ tan thành mây khói hết. Chính mình đã khơi mào chuyện này, nhưng chắc chắn lựa chọn duy nhất của mình là kính cẩn từ chối.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000017", "translation": "“Tôi rất vinh dự trước lời đề nghị của ngài, nhưng tôi cho rằng hoàn cảnh hiện tại đòi hỏi sự chừng mực nhất định. Có lẽ xin hẹn dịp khác vậy.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000018", "translation": "“Ra vậy.” Rudersdorf bật cười, hoàn toàn điềm nhiên. Chỉ là do mình tưởng tượng thôi, hay ông thực sự đang tận hưởng đám tang này hơi quá rồi đấy?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000019", "translation": "Điều đó khiến mình phải đặt dấu hỏi về nhân tính của ông. Ngay cả những người đến đây vì công việc như Tanya cũng đang giữ vẻ mặt trang nghiêm trầm mặc, thế mà ông lại ở đây giỡn cợt!", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000020", "translation": "Bộ ông vụng về trong giao tiếp xã hội hay gì sao?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000021", "translation": "Ở hậu phương, dù tốt hay xấu thì các phép tắc xã giao vẫn còn nguyên giá trị. Dù thực lòng chẳng muốn chút nào, nhưng nếu người ta nhìn thấy một đứa trẻ đang phải nhón chân, mình tin chắc các quý ông và quý bà xung quanh sẽ tự khắc nhường đường thôi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000022", "translation": "Cụ thể là chỉ cần một chút diễn xuất tệ hại cũng đủ để giải quyết đám đông. Mình đoán Rudersdorf hẳn thấy bản thân hơi giống Moses khi trưng ra vẻ mặt bi thương rồi kêu gọi những người đứng xung quanh bằng mấy câu đại loại như: “Làm ơn, cô bé này đang cố nhìn xem…”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000023", "translation": "Và thế là chẳng còn lựa chọn nào khác ngoài việc tham gia vào vở kịch gượng gạo này. Khẽ cúi đầu vẻ cáo lỗi, mình bước vào khoảng trống vừa được nhường ra ngay tức khắc.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000024", "translation": "Khi mình chen lên phía trước, tầm nhìn liền mở rộng ra.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000025", "translation": "Trò gợi ý ngồi lên vai hẳn là một đòn khích tướng. Đám sĩ quan tham mưu thường rất chủ động lợi dụng những điều mà người khác chán ghét.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000026", "translation": "Đúng vậy, vấn đề của giới sĩ quan tham mưu chính là ở chỗ đó.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000027", "translation": "Dẫu sao thì kết quả là giờ mình đã nhìn thấy được rồi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000028", "translation": "Quay đầu nhìn quanh, ánh mắt chăm chú của Tanya nhận thấy mọi thứ đều được bài trí hoàn toàn đúng chuẩn. Buổi lễ diễn ra hết sức bài bản theo quy thức, và dù cô có quan sát kỹ đến mấy cũng chẳng thấy nét gì mới lạ. Thú thật là mình đã phát ngấy khi phải nhìn những cảnh tượng này rồi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000029", "translation": "Suy cho cùng, miền đông là một trong những trung tâm gia công chính chuyên biến binh lính thành tử sĩ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000030", "translation": "Mặt trận phía đông biến đổi nguồn nguyên liệu thô được chuyên chở từ đế đô thành những cái xác rồi chuyển trả về quê nhà. Thủ đô xuất khẩu nguyên liệu thô và nhập khẩu tử sĩ—đó là một ngành thương mại gia công.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000031", "translation": "Tất nhiên, mình nhận ra sự khác biệt giữa các vùng miền. Điển hình như thủ đô là nơi cách xa tiền tuyến nhất có thể. Do đặc thù vị trí này, có thể thấy sự hiện diện rõ rệt của những bộ tang phục dân sự màu đen.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000032", "translation": "Nhưng chỉ có thế mà thôi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000033", "translation": "Chẳng có lý do thực sự nào để phải đứng đây nghiên cứu cảnh tượng này cả.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000034", "translation": "“…Nhìn họ kìa.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000035", "translation": "Nhìn theo ngón tay vừa chọc vào vai mình rồi chỉ ra đằng kia… Tanya nhận ra một nhóm người mặc trang phục hồ cứng phẳng phiu. Ở mặt trận phía đông, những người lính khác sẽ khiêng quan tài, nhưng tại đây họ có vẻ là đội tiêu binh danh dự.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000036", "translation": "“Hửm?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter008.xhtml/p000037", "translation": "Đúng lúc đó, Tanya nhận ra một điều. Trông họ vô cùng—biết nói sao nhỉ—họ khiến chiếc quan tài trông nặng nề đến lạ. Có lẽ họ không đến mức thở dốc, nhưng chỉ cần thoáng nhìn cũng thấy rõ là họ đang phải gồng mình hết sức.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
