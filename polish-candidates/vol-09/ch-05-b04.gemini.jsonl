{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000001", "translation": "Nói vậy thôi chứ mình chẳng có ác cảm gì với Calandro cả. Ngược lại chắc cũng thế.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000002", "translation": "Ildoa muốn duy trì một khoảng cách tế nhị với Đế quốc và các quốc gia tham chiến khác. Đế quốc lại muốn nhắn nhủ họ hãy tỏ rõ lập trường đứng về phía Đế quốc. Với tư cách đại diện cho quốc gia của mỗi bên, cả hai chỉ đang đối đáp qua lại đúng theo kịch bản, vẻ mặt chỉ nghiêm túc vừa đủ theo mức lương mà mình nhận được.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000003", "translation": "Nhưng suy cho cùng, ở đây chẳng có thù oán cá nhân nào hết. Một khi đã nói xong những lời cần nói, hẳn cả hai sẽ biết ý mà nương tay cho nhau thôi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000004", "translation": "“Ở ngoài chiến trường thì tôi chẳng trông mong gì một bữa ăn đủ món đâu. Nhưng nơi này đang là thời bình, nên nếu chúng tôi đãi ngộ kém hơn thế thì có lẽ cô sẽ nảy sinh nghi ngại hoặc dè dặt mất. Hy vọng lòng hiếu khách của chúng tôi không đến nỗi thiếu sót.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000005", "translation": "“…Không đâu, thưa Đại tá. Hiện giờ tôi đang cảm thấy vô cùng thoải mái rồi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000006", "translation": "“Đừng vội kết luận sớm thế. Bữa tiệc chào mừng thậm chí còn chưa bắt đầu kia mà!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000007", "translation": "Tanya lẳng lặng nhìn đi chỗ khác.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000008", "translation": "Đời nào cô có thể thú nhận rằng mình đang tận hưởng hương thơm của bánh mì cơ chứ. Có lẽ đây là lúc thích hợp để chuyển chủ đề rồi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000009", "translation": "“Tôi xem thực đơn được chứ?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000010", "translation": "“Tất nhiên rồi. Cô muốn dùng món gì?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000011", "translation": "“Tôi vừa mới từ chiến trường trở về. Cứ thứ gì ăn được là tôi ăn tất.” Mình nở nụ cười gượng gạo và quyết định hỏi một câu cho phải phép lịch sự. “Vả lại tôi vẫn giữ thói quen thu thập thông tin. Xin hỏi Đại tá có gợi ý món nào không ạ?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000012", "translation": "“Chắc chắn rồi. Tôi rất sẵn lòng gợi ý vài món.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000013", "translation": "“Cảm ơn ngài.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000014", "translation": "“Có gì đâu. Chà, tôi nên gợi ý món gì đây nhỉ…? Hải sản ở đây món nào cũng ngon cả. Mà cũng không phải là các món thịt bị dở đâu…” Ngẫm nghĩ một lát, ông ta đưa ra lời khẳng định. “Cá ở đây tuyệt hảo lắm. Theo quan điểm cá nhân của tôi thì rất hiếm loại cá nào thực sự ngon miệng, nên một khi có cơ hội là cô phải thưởng thức ngay.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000015", "translation": "“Ngài tiến cử nhiệt tình thật đấy. Món cá thực sự ngon đến vậy sao?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000016", "translation": "“Rất vui vì cô đã hỏi!” Calandro hào hứng đáp. “Đoàn tàu khởi hành từ quân cảng cũng không ngoại lệ đâu. Đơn vị nào cũng hết sức chăm chút cho khâu thu mua hải sản. Bọn họ đều thuộc hàng lợi hại cả đấy.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000017", "translation": "“Quân đội cũng hỗ trợ việc thu mua sao?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000018", "translation": "“Không, không phải theo kiểu đó đâu.” Ông ta hơi hạ giọng xuống và tiết lộ bằng giọng điệu thích thú, “Ở cấp độ cá nhân thôi… Bản thân cô cũng là một người lính ngoài chiến trường, chắc hẳn cô thừa hiểu mọi chuyện diễn ra thế nào rồi, Trung tá Degurechaff.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000019", "translation": "“Ý ngài là ăn cắp ư?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000020", "translation": "Tiếng vỗ tay của ông ta vang lên bộp một cái thật kêu. Rồi ông ta nở một nụ cười đầy ẩn ý. “Mấy gã tham ăn phụ trách nhà bếp có nhiều bạn bè lắm.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000021", "translation": "“Họ phải thân thiết với nhau lắm thì mới đem cả cá ra đãi bữa tối như thế.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000022", "translation": "“Họ là bậc thầy của ván cờ lớn đấy. Nhà bếp ở đây lúc nào cũng có cá ngon ngang ngửa, thậm chí là hơn cả loại cá mà cô có thể tìm thấy ngoài cảng.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000023", "translation": "Cá tươi bất cứ lúc nào.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000024", "translation": "Sự đảm bảo về một nguồn cung hàng hóa đáng mơ ước không bao giờ cạn, một mối quen biết tốt.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000025", "translation": "“Thật đáng trách quá đi mất.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000026", "translation": "“Bộ ở Đế quốc thì khác chắc?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000027", "translation": "“Ha-ha-ha!” Mình cười xòa cho qua câu nhận xét đó rồi cuối cùng cũng nhìn vào thực đơn. Đúng là ở Đế quốc cũng xảy ra chuyện tương tự thật. Chỉ cần bạn quen biết cá nhân với người phụ trách thì việc gì cũng có thể được giải quyết trơn tru.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000028", "translation": "Là một người có sự thấu hiểu lẫn nhau với các sĩ quan cấp cao trong Bộ Tổng tham mưu như Trung tá Uger hay Đại tá Lergen và nhờ đó mà được tiếp tế dễ dàng hơn, mình thực sự chẳng có tư cách gì để nói người khác.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000029", "translation": "“Thưa Đại tá, tuy phụng sự dưới hai lá cờ khác nhau, nhưng cả hai chúng ta đều là quân nhân cả.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000030", "translation": "“Chiếc dạ dày và quân đội—hai chủ đề chẳng thể nào dùng lời lẽ hoa mỹ suông được. Thực tế vốn chẳng vui vẻ gì, và cả hai đều phải tuân theo thực tế.” Tanya mỉm cười nhạt với Calandro. “Suy cho cùng thì tôi thà có ba bữa ăn đàng hoàng còn hơn là sự lãng mạn. Chuyện những kẻ no bụng giành phần thắng âu cũng là lẽ đương nhiên mà thôi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000031", "translation": "Cứ nhìn vào những bữa ăn nóng sốt mà xem. Việc chuẩn bị nguyên liệu giàu dinh dưỡng, kiếm chất đốt để hâm nóng chúng, rồi cung cấp cho binh lính mà không để xảy ra bất kỳ trục trặc nào—khó khăn biết nhường nào!", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000032", "translation": "Với hải sản tươi sống, việc đưa được chúng ra tới tiền tuyến sẽ là một công cuộc ngang ngửa với việc phóng tàu thăm dò lên mặt trăng. Đó là lý do đám người bên tài chính ở chính quốc bảo chúng ta cứ ăn tạm K-Brot cho xong.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000033", "translation": "“Tôi nghĩ mình sẽ tận dụng triệt để cơ hội hiếm có này để thử món ngâm xốt này vậy.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000034", "translation": "“Ồ, một thực khách thích khám phá ư? Cô đúng là người hiếm thấy đấy. Tôi nghe nói hầu hết người Đế quốc đều khá bảo thủ trong chuyện ăn uống.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000035", "translation": "“Thưởng thức hương vị của một vùng đất khác gần như là niềm vui duy nhất mà một người lính ngoài chiến trường có thể mong đợi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter020.xhtml/p000036", "translation": "“Với một sự nghiệp như của cô thì tôi cho rằng điều đó cũng đúng thôi. Hẳn là đi đến đâu cô cũng được thưởng thức đủ mọi hương vị khác nhau. Và tôi cá là cô có khẩu vị sành sỏi lắm đấy.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
