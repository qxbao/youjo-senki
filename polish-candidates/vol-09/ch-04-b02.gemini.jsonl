{"id": "YS-LN09/Text/chapter014.xhtml/p000039", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "translation": "“Thưa Trung tá, chúng ta vừa nhận được báo cáo tiếp theo.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN09/Text/chapter014.xhtml/p000039"}
{"id": "YS-LN09/Text/chapter014.xhtml/p000040", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "translation": "Vẻ mặt căng thẳng của người lính tín hiệu vừa mang tới tin tình báo mới nhất về vị trí quân địch lập tức gióng lên hồi chuông cảnh báo.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN09/Text/chapter014.xhtml/p000040"}
{"id": "YS-LN09/Text/chapter014.xhtml/p000041", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "translation": "Rốt cuộc là chuyện gì đây?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN09/Text/chapter014.xhtml/p000041"}
{"id": "YS-LN09/Text/chapter014.xhtml/p000042", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "translation": "“Một tàu ngầm khác vừa báo về. Họ phát hiện một tàu sân bay.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN09/Text/chapter014.xhtml/p000042"}
{"id": "YS-LN09/Text/chapter014.xhtml/p000043", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "translation": "“Một tàu sân bay ư? Vậy là *quả thực* có một chiếc.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN09/Text/chapter014.xhtml/p000043"}
{"id": "YS-LN09/Text/chapter014.xhtml/p000044", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "translation": "Nén một tiếng thở dài, Tanya lắc đầu. Thủy thủ đoàn tàu ngầm hẳn đang mừng rỡ vì vớ được một con mồi béo bở đến thế. Đáng buồn thay, mình lại thích chiếc tàu sân bay đó không có mặt ở đây hơn.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN09/Text/chapter014.xhtml/p000044"}
{"id": "YS-LN09/Text/chapter014.xhtml/p000045", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "translation": "“…Nếu trinh sát đường không của chúng ta không chính xác thì gay go rồi đây.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN09/Text/chapter014.xhtml/p000045"}
{"id": "YS-LN09/Text/chapter014.xhtml/p000046", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "translation": "Mình hiểu sương mù chiến tranh là một vấn đề rất thực tế. Nhưng việc không quân bỏ sót một thứ khổng lồ đến nhường ấy thì đúng là một pha tắc trách tệ hại.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN09/Text/chapter014.xhtml/p000046"}
{"id": "YS-LN09/Text/chapter014.xhtml/p000047", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "translation": "Khốn nỗi, một khi nó đã ở đó, chúng mình buộc phải khử nó. Nếu không, mọi chuyện về sau sẽ trở nên rất nguy hiểm. Không thể để một chiếc tàu sân bay rình rập săn lùng các tàu vận tải đang chạy về nước được.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN09/Text/chapter014.xhtml/p000047"}
{"id": "YS-LN09/Text/chapter014.xhtml/p000048", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "translation": "“Với V-2, hẳn chúng ta sẽ xoay xở được thôi. Dù sao đi nữa, chúng ta cũng chẳng còn lựa chọn nào khác ngoài việc đặt niềm tin vào mấy cỗ máy này.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN09/Text/chapter014.xhtml/p000048"}
{"id": "YS-LN09/Text/chapter014.xhtml/p000049", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "translation": "Bất cứ thứ gì được nhà khoa học đó chế tạo bằng cả tấm lòng nâng niu chăm chút chắc chắn đều mang uy lực kinh hồn. Còn về độ an toàn, chỉ riêng việc bận tâm nghĩ đến thôi cũng đã vô nghĩa rồi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN09/Text/chapter014.xhtml/p000049"}
{"id": "YS-LN09/Text/chapter014.xhtml/p000050", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "translation": "“Chúng ta sẽ giáng cho chúng một đòn hiệp đồng tác chiến. Tình thế lúc này không còn cho phép chỉ đánh vào các thiết giáp hạm là đủ. Chúng ta cần phải hạ gục cả chúng lẫn chiếc tàu sân bay cùng một lúc.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN09/Text/chapter014.xhtml/p000050"}
{"id": "YS-LN09/Text/chapter014.xhtml/p000051", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "translation": "Nhận thấy nhu cầu liên lạc thông suốt tuyệt đối, Barchet tay cầm ống nghe tiến lại gần Tanya để bàn kế hoạch, rồi vỗ ngực như thể muốn nói rằng cô có thể trông cậy vào ông.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN09/Text/chapter014.xhtml/p000051"}
{"id": "YS-LN09/Text/chapter014.xhtml/p000052", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "translation": "“Tính cả chiếc này và hai tàu ngầm kia thì chúng ta có mười hai quả V-2. Cô định nhắm vào những mục tiêu nào?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN09/Text/chapter014.xhtml/p000052"}
{"id": "YS-LN09/Text/chapter014.xhtml/p000053", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "translation": "“Các tàu chủ lực là mục tiêu chính. Chúng ta sẽ phóng sáu quả vào các thiết giáp hạm và bốn quả vào chiếc tàu sân bay. Với các tàu tuần dương, hai quả là đủ. Trong trường hợp xấu nhất, chúng ta sẽ quét sạch đám tàu khu trục bằng ngư lôi hoặc thủy lôi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN09/Text/chapter014.xhtml/p000053"}
{"id": "YS-LN09/Text/chapter014.xhtml/p000054", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "translation": "Vị thuyền trưởng gật đầu tỏ ý đã hiểu, và Tanya nhờ ông chuyển tiếp một thông điệp.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN09/Text/chapter014.xhtml/p000054"}
{"id": "YS-LN09/Text/chapter014.xhtml/p000055", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "translation": "“Sau khi các tổ lái thoát hiểm, chúng tôi sẽ ẩn mình dưới nước cho đến khi thuốc nổ phát nổ rồi mới bay vọt lên tấn công. Chúng tôi sẽ không cần các ông đón đâu. Xin hãy đảm bảo mọi người đều nắm rõ việc này.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN09/Text/chapter014.xhtml/p000055"}
{"id": "YS-LN09/Text/chapter014.xhtml/p000056", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "translation": "“Cô chắc chứ?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN09/Text/chapter014.xhtml/p000056"}
{"id": "YS-LN09/Text/chapter014.xhtml/p000057", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "translation": "Giọng ông nghe có vẻ lo lắng, nhưng Tanya xua tay. “Nếu các ông có thể chuẩn bị sẵn để phòng hờ thì cũng tốt, nhưng… tôi không muốn làm khó các ông ở vùng biển này.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN09/Text/chapter014.xhtml/p000057"}
{"id": "YS-LN09/Text/chapter014.xhtml/p000058", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "translation": "“Thưa Trung tá, đó là nhiệm vụ của họ mà.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN09/Text/chapter014.xhtml/p000058"}
{"id": "YS-LN09/Text/chapter014.xhtml/p000059", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "translation": "Viên sĩ quan phụ tá của mình xen vào bằng một lời nhận xét lạnh lùng. Có lẽ cô ấy không hẳn là bực bội mà chỉ đơn thuần lên tiếng vì tinh thần trách nhiệm, nhưng… Tanya gật đầu.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN09/Text/chapter014.xhtml/p000059"}
{"id": "YS-LN09/Text/chapter014.xhtml/p000060", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "translation": "“Cô nói đúng, Trung úy Serebryakov. Nhưng cô không nghĩ rằng để hợp tác cùng nhau, cả hai bên đều phải chuyên nghiệp hay sao?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN09/Text/chapter014.xhtml/p000060"}
{"id": "YS-LN09/Text/chapter014.xhtml/p000061", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "translation": "Dĩ nhiên, toàn bộ sự sắp xếp này đều dựa trên tiền đề rằng chúng mình sẽ là bên thực hiện đòn tấn công.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN09/Text/chapter014.xhtml/p000061"}
{"id": "YS-LN09/Text/chapter014.xhtml/p000062", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "translation": "Viên sĩ quan phụ tá của mình nhăn mặt rút lui; dạo gần đây cô nàng đã trở nên mạnh dạn biết bao.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN09/Text/chapter014.xhtml/p000062"}
{"id": "YS-LN09/Text/chapter014.xhtml/p000063", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "translation": "Rất khó tìm được những sĩ quan sẵn sàng làm bất cứ việc gì cần làm, cho dù chỉ vì họ cảm thấy buộc phải cho mọi người khác thấy thế nào mới là làm việc *thực thụ*.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN09/Text/chapter014.xhtml/p000063"}
{"id": "YS-LN09/Text/chapter014.xhtml/p000064", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "translation": "Mình rất đỗi vui lòng được dõi theo sự trưởng thành và phát triển không ngừng của cô ấy.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN09/Text/chapter014.xhtml/p000064"}
{"id": "YS-LN09/Text/chapter014.xhtml/p000065", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "translation": "Dường như ấn tượng trước màn đối đáp này, Barchet chào cô theo điều lệnh. “Tôi cầu chúc các cô thành công.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN09/Text/chapter014.xhtml/p000065"}
{"id": "YS-LN09/Text/chapter014.xhtml/p000066", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "translation": "“Đừng cầu nguyện cho chúng tôi, Thuyền trưởng Barchet. Chúng tôi chỉ lên đường làm những gì phải làm mà thôi. Hãy tin ở chúng tôi. Nếu chúng tôi thất bại, khi ấy ông muốn cầu xin Chúa, Phật, ác quỷ hay bất cứ ai khác tùy thích cũng được.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN09/Text/chapter014.xhtml/p000066"}
{"id": "YS-LN09/Text/chapter014.xhtml/p000067", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "translation": "“…Tôi xin lỗi, thưa Trung tá.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN09/Text/chapter014.xhtml/p000067"}
{"id": "YS-LN09/Text/chapter014.xhtml/p000068", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "translation": "“Hửm?” Tanya khẽ mỉm cười. “Dẫu sao chúng tôi cũng rất cảm kích trước thiện ý của ông. Vậy thì, đây là một cơ hội tốt đấy. Hãy tận hưởng hàng ghế đầu và chiêm ngưỡng cách Tiểu đoàn Pháp sư Trên không số 203 tác chiến nhé.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN09/Text/chapter014.xhtml/p000068"}
{"id": "YS-LN09/Text/chapter014.xhtml/p000069", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "translation": "NGOÀI KHƠI BỜ BIỂN DAKAR, HẠM ĐỘI BẢN THỔ CỦA KHỐI THỊNH VƯỢNG CHUNG, HẢI ĐỘI 2 (LỰC LƯỢNG TIÊN PHONG CỦA CHIẾN DỊCH AGREEMENT), T-13:25 TRƯỚC CHIẾN DỊCH AGREEMENT (KHOẢNG 19 GIỜ 00 THEO GIỜ ĐỊA PHƯƠNG)", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN09/Text/chapter014.xhtml/p000069"}
{"id": "YS-LN09/Text/chapter014.xhtml/p000070", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "translation": "Đây là một chiến dịch truy kích quân địch.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN09/Text/chapter014.xhtml/p000070"}
{"id": "YS-LN09/Text/chapter014.xhtml/p000071", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "translation": "Quân Đế quốc đang tìm cách tháo chạy trong đêm, nhưng lực lượng đặc nhiệm sẽ tiêu diệt sạch chúng chỉ bằng một đòn và đặt dấu chấm hết cho các hoạt động của chúng tại lục địa phía nam. Không giống như hầu hết các mặt trận đang bế tắc, trận đánh này có vẻ nắm chắc phần thắng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN09/Text/chapter014.xhtml/p000071"}
{"id": "YS-LN09/Text/chapter014.xhtml/p000072", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "translation": "Nói cách khác, họ không mấy dự liệu sẽ vấp phải sự kháng cự đáng kể nào.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN09/Text/chapter014.xhtml/p000072"}
{"id": "YS-LN09/Text/chapter014.xhtml/p000073", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "translation": "Cái thứ hải quân thảm hại chỉ đáng làm trò cười của Đế quốc thì làm sao đương đầu nổi với hạm đội của Khối Thịnh vượng chung? Đứa trẻ lên ba cũng biết kết cục sẽ ra sao. Đế quốc nắm ưu thế áp đảo không thể san lấp về số lượng ở cả tàu chủ lực lẫn các tàu hạng nhẹ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN09/Text/chapter014.xhtml/p000073"}
{"id": "YS-LN09/Text/chapter014.xhtml/p000074", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "translation": "Một quốc gia lục địa làm sao có thể hy vọng đọ sức với cường quốc hàng hải vĩ đại nhất thế giới cơ chứ?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN09/Text/chapter014.xhtml/p000074"}
{"id": "YS-LN09/Text/chapter014.xhtml/p000075", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "translation": "Không một ai trong hạm đội của Khối Thịnh vượng chung mảy may nghi ngờ dù chỉ một khoảnh khắc rằng trận chiến này coi như đã cầm chắc chiến thắng trong tay.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN09/Text/chapter014.xhtml/p000075"}
{"id": "YS-LN09/Text/chapter014.xhtml/p000076", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "translation": "Thế nhưng ngay khi trận đánh nổ ra, tất cả mọi người đều phải gào thét trong kinh hoàng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN09/Text/chapter014.xhtml/p000076"}
{"id": "YS-LN09/Text/chapter014.xhtml/p000077", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "translation": "“Chuyện quái gì đang diễn ra thế này?!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": [], "segment_id": "YS-LN09/Text/chapter014.xhtml/p000077"}
