{"segment_id": "YS-LN09/Text/chapter002.xhtml/p000097", "translation": "“Tôi không có ý kiến gì. Ngoài ra, nếu cần thiết thì hãy bắt đầu thu xếp việc giải quyết nghỉ phép cho binh lính luôn đi. Bao gồm cả việc cấp phát các giấy tờ liên quan nữa.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter002.xhtml/p000098", "translation": "Không nên lãng phí thời gian. Việc gì làm được lúc nào là phải tranh thủ làm ngay lúc đó.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter002.xhtml/p000099", "translation": "“Phần lớn thủ tục có lẽ phải thông qua Bộ Tổng tham mưu, nhưng ít nhất chúng ta cứ xác nhận trước với bên Reichsbahn xem có còn chỗ ngồi cho những người về quê không. Nói rằng còn đủ chỗ là một chuyện, nhưng thực sự biết chắc liệu có xếp hết được quân của chúng ta lên tàu hay không lại là chuyện khác.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter002.xhtml/p000100", "translation": "“Vậy tôi sẽ tìm hiểu các chuyến tàu đường dài trước ạ.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter002.xhtml/p000101", "translation": "“Ừm. Trước mắt có lẽ cứ để binh lính tự làm đơn xin phép. Hễ là chuyện nghỉ phép thì ngay cả những kẻ chúa ghét giấy tờ chắc cũng sẽ điền biểu mẫu đàng hoàng thôi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter002.xhtml/p000102", "translation": "Mình cũng muốn được nghỉ ngơi nữa. Mình phải nộp đơn xin nghỉ phép của bản thân mới được.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter002.xhtml/p000103", "translation": "Nếu Trung tá Degurechaff nộp xấp đơn đó lên Đại tá Lergen và đơn xin phép được phê duyệt dưới danh nghĩa của anh, thì ngay cả cô hẳn cũng sẽ kiếm được một kỳ nghỉ dưới hình thức nào đó.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter002.xhtml/p000104", "translation": "“Mình thực sự phải tính chuyện nghỉ phép của bản thân thôi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter002.xhtml/p000105", "translation": "Đúng lúc Tanya đang định hớn hở tính xem nên làm gì trong kỳ nghỉ của mình thì cô bị tập kích bất ngờ. Hiện thực chẳng bao giờ biết nương tay.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter002.xhtml/p000106", "translation": "“Ồ, cô đây rồi, Trung tá.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter002.xhtml/p000107", "translation": "Một giọng nói thản nhiên. Nhưng chủ nhân của nó lại cao hơn cô một bậc quân hàm—anh là một đại tá chính thức.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter002.xhtml/p000108", "translation": "“Đã khá lâu rồi kể từ lần cuối chúng ta gặp nhau nhỉ. Chà, nếu tính trên hồ sơ giấy tờ thì tôi cho là về mặt chính thức, chúng ta đã chạm mặt nhau không ít lần rồi, nhưng mà…”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter002.xhtml/p000109", "translation": "“Đại tá Lergen?!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter002.xhtml/p000110", "translation": "Lập tức giơ tay chào theo điều lệnh, Tanya trở lại ngay với trạng thái làm việc.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter002.xhtml/p000111", "translation": "Vị đại tá lẽ ra phải đang đi công cán ngoại giao ở Ildoa nay lại đích thân cất công tới gặp cô. Chuyện này chỉ có thể là điềm báo rắc rối mà thôi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter002.xhtml/p000112", "translation": "“Ngài đã trở về Đế quốc rồi sao, thưa Đại tá?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter002.xhtml/p000113", "translation": "“Kampfgruppe Lergen đang có mặt tại thủ đô để nghỉ phép. Việc tôi ở đây đâu có gì lạ.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter002.xhtml/p000114", "translation": "Anh nói ra lời giải thích chính thức một cách trôi chảy, nhưng sắc mặt anh lại tái nhợt hơn bất cứ lúc nào Tanya từng thấy.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter002.xhtml/p000115", "translation": "Quan trọng hơn cả là giọng điệu của anh ta…", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter002.xhtml/p000116", "translation": "Người đàn ông này trước đây vốn nghiêm túc hơn nhiều. Thậm chí còn cứng nhắc nữa là đằng khác… Sự thay đổi này thật đáng kinh ngạc.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter002.xhtml/p000117", "translation": "Phải chăng áp lực của chiến tranh đã gây ra thái độ châm biếm, cay độc này?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter002.xhtml/p000118", "translation": "Chiến tranh *quả thực* quá đỗi dã man để một người bình thường có thể chịu đựng mà không bị khuất phục.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter002.xhtml/p000119", "translation": "Dẫu vậy, mình không nên suy đoán lung tung.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter002.xhtml/p000120", "translation": "“Cô sẽ cần phải đến trình diện tại sở chỉ huy. Chúng ta phải đảm bảo hồ sơ chính thức hoàn toàn khớp nhau.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter002.xhtml/p000121", "translation": "“Tất nhiên rồi, thưa Đại tá.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter002.xhtml/p000122", "translation": "“Nhưng trước tiên, hãy để tôi báo một tin vui. Toàn thể Kampfgruppe! Cho kỳ nghỉ phép của các bạn… chúng tôi đã đặt sẵn một khu nghỉ dưỡng!” Thấy đã thu hút được sự chú ý của toàn bộ binh lính, anh cao giọng nói tiếp. “Bộ Tổng tham mưu đã kiên quyết yêu cầu như vậy. Và đối với những ai muốn về thăm nhà, chúng tôi sẽ cấp vé tàu hạng nhất. Tất cả các bạn đã hoàn thành xuất sắc nhiệm vụ! Tuy chỉ là một kỳ nghỉ ngắn ngủi, nhưng tôi hy vọng các bạn sẽ tận hưởng khoảng thời gian ở thủ đô!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter002.xhtml/p000123", "translation": "Một làn sóng reo hò và vỗ tay vang lên.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter002.xhtml/p000124", "translation": "Giữa tiếng reo mừng ồn ã, Lergen nắm lấy tay Tanya trong một cái bắt tay trang trọng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter002.xhtml/p000125", "translation": "“Cô cũng đã lập công xuất sắc vượt ngoài mong đợi đấy, Trung tá.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter002.xhtml/p000126", "translation": "“Cảm ơn Đại tá.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter002.xhtml/p000127", "translation": "Gật đầu như thể hài lòng với câu trả lời đó, anh lại cao giọng để những người khác cùng nghe thấy. “Xe tải vận chuyển đang tới muộn, nhưng chắc sẽ có mặt ở đây trong khoảng hai mươi phút nữa thôi. Có lẽ tôi hơi cầm đèn chạy trước ô tô một chút, nhưng tôi đã mang sẵn phiếu khẩu phần cho quân của cô ở đây rồi. Trong lúc chờ đợi, cô cứ phát luôn cho mọi người đi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter002.xhtml/p000128", "translation": "Nhận được ánh mắt ra hiệu bảo mình đứng ra thu xếp, Tanya lập tức giao lại phần việc đó cho vị phó chỉ huy của cô.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter002.xhtml/p000129", "translation": "“Thiếu tá Weiss. Việc đó tôi giao lại cho anh.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter002.xhtml/p000130", "translation": "“Rõ, thưa Trung tá!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter002.xhtml/p000131", "translation": "Weiss hành động nhanh gọn như thể đang làm nhiệm vụ tác chiến, tập hợp các sĩ quan lại để rà soát nguyện vọng của họ, để lại Tanya và Lergen gần như hoàn toàn riêng tư.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter002.xhtml/p000132", "translation": "Một khoảng trống nhỏ tách biệt mở ra ngay giữa nhà ga.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter002.xhtml/p000133", "translation": "“Trung úy Serebryakov phải không nhỉ? Xin lỗi, phiền cô tạm lánh mặt cho chúng tôi nói chuyện riêng. À, cô gọi giúp một chiếc xe hơi luôn được chứ?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter002.xhtml/p000134", "translation": "Tuy nhiên, có vẻ như Lergen sẽ không hài lòng với bất kỳ điều gì kém hơn sự riêng tư tuyệt đối.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter002.xhtml/p000135", "translation": "“Cứ làm theo lời Đại tá đi, Trung úy.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter002.xhtml/p000136", "translation": "“Rõ, thưa Trung tá!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter002.xhtml/p000137", "translation": "Viên sĩ quan phụ tá của mình sải bước rời đi đầy nhanh nhẹn. Chắc chắn cô ấy hiểu rõ chuyện gì đang diễn ra và sẽ quay lại đúng lúc một cách hoàn hảo.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter002.xhtml/p000138", "translation": "Dẫu vậy, ngay cả khi lấy cớ nhờ vả công việc thì cách anh ta đuổi khéo cô ấy đi cũng khá lộ liễu. Nếu anh ta đã kiên quyết cẩn trọng đến mức đó…", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter002.xhtml/p000139", "translation": "“Sĩ quan phụ tá của tôi rất đáng tin cậy…”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter002.xhtml/p000140", "translation": "“Tình thế bắt buộc phải vậy thôi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter002.xhtml/p000141", "translation": "Thật là một câu nói nghe chẳng lành chút nào.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter002.xhtml/p000142", "translation": "“Tôi tới đây để phổ biến sơ bộ cho cô trước khi cô đến trình diện tại Văn phòng Bộ Tổng tham mưu. Chỉ có ba việc ngắn gọn thôi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter002.xhtml/p000143", "translation": "“Vâng, thưa Đại tá.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter002.xhtml/p000144", "translation": "“Tốt.” Anh gật đầu rồi nói tiếp bằng giọng nghiêm trọng. “Thứ nhất: Một cuộc tranh luận dữ dội đang nổ ra giữa Bộ Tổng tham mưu và Bộ Tư lệnh Tối cao xoay quanh một chiến dịch lớn ở phía đông. Thực tế là chúng ta đã suýt thua trong cuộc tranh cãi đó rồi. Vị tướng của chúng ta chỉ đang cố cầm cự trong gang tấc mà thôi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter002.xhtml/p000145", "translation": "“Một chiến dịch lớn sao ạ?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
{"segment_id": "YS-LN09/Text/chapter002.xhtml/p000146", "translation": "Anh hạ thấp giọng trước khi nói tiếp, như thể muốn bảo: *Đúng vậy*. “Thất bại bước đầu của Chiến dịch Andromeda cho thấy bộ khung xương sống của Quân đội Liên bang vẫn vững vàng như trước. Vì thế khi đợt phản công tất yếu nổ ra, chúng ta sẽ vừa đối phó với nó vừa cố gắng thu hẹp và củng cố phòng tuyến. Đó là đề xuất ban đầu mà Bộ Tổng tham mưu đã đệ trình xin phê duyệt.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "6e752589ca5a3bd4200a77b72f89a3f7a99ab03d9c14717b32151e8e5f6cb549", "notes": []}
