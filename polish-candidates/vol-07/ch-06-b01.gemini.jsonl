{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000001", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "NGÀY 13 THÁNG 5 NĂM THỐNG NHẤT 1927, THỦ ĐÔ ĐẾ QUỐC BERUN, VĂN PHÒNG BỘ TỔNG THAM MƯU LỤC QUÂN ĐẾ QUỐC", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000002", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "*Từ: Lục quân Đế quốc, Sở chỉ huy Cụm tập đoàn quân phía Đông*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000003", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "*Kính gửi: Văn phòng Bộ Tổng tham mưu Lục quân Đế quốc*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000004", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "*Lực lượng Quân đội Liên bang tiến công đã bị đẩy lùi.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000005", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "*Hiện chúng tôi đang tiến hành thống kê sơ bộ chiến quả trên mặt trận phía đông.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000006", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "*Nhiều sư đoàn, bao gồm cả quân chủ lực của địch, đã bị tiêu diệt hoàn toàn.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000007", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "*Chúng tôi đang tiếp tục truy kích quân địch và phát huy chiến quả.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000008", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "*Tái bút: Đề nghị thu xếp phương tiện vận chuyển tù binh càng sớm càng tốt.*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000009", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "“Chúng ta thắng rồi nhỉ?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000010", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "“…Đúng là thắng thật rồi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000011", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "Chiến quả của Lục quân Đế quốc to lớn đến mức cả tảng đá lẫn cành liễu đều có thể giữ vẻ điềm nhiên. Và nếu có ai hoài nghi về kết cục của trận đánh cơ động quy mô lớn trên mặt trận phía đông, người đó chỉ cần liếc nhìn tấm bản đồ treo tường.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000012", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "Quả thực đã có thời điểm áp lực ở phía đông đè nặng khiến họ buộc phải rút lui một quãng khá xa. Sự rối loạn ở các đơn vị tiền tuyến, những tuyến tiếp vận chệch choạc, và cuối cùng là cảnh hỗn loạn tại Sở chỉ huy Cụm tập đoàn quân phía Đông—họ buộc phải thừa nhận rằng còn rất nhiều điều cần cải thiện.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000013", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "Dẫu vậy, kết quả đã hiện rõ rành rành trên bản đồ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000014", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "“…Có lẽ chúng ta thậm chí còn có thể tính cả Moskva và các thành phố phía nam vào các phương án tiến quân xâm lược.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000015", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "“Về mặt *lý thuyết* thôi, Rudersdorf.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000016", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "“Vậy là sẽ gay go đấy hả?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000017", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "*Nói thế còn là nhẹ chán.* Trung tướng von Zettour nhăn mặt và nói rõ cho người bạn đáng kính của mình hiểu. “Việc khôi phục mạng lưới đường sắt là bất khả thi. Ngay lúc này đây, chúng ta đã phải căng mình tới giới hạn khi tìm nguồn tiếp tế ngay tại thực địa rồi!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000018", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "Một trận đánh cơ động, vốn bao hàm việc tiến quân xâm lược trên quy mô lớn, luôn phải đối mặt với những giới hạn về hậu cần.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000019", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "Nếu họ áp dụng chiến lược nội tuyến ngay trên sân nhà, việc thu mua vật tư tiếp vận sẽ dễ dàng hơn. Ngay tại đất nước quen thuộc của mình, họ đã có thể nhận được sự hậu thuẫn từ các cơ quan tự quản cấp tỉnh và hành quân hết tốc lực—đó không chỉ là lý thuyết suông trên bàn giấy.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000020", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "Thế nhưng nơi đất khách quê người, ngay cả tổ chức tử tế nhất cũng toàn là người dưng nước lã, chẳng hạn như Hội đồng Tự trị. Chỉ riêng việc thiết lập một căn cứ chiến lược tại vùng hậu phương của họ rồi tiến quân xâm lược lãnh thổ kẻ địch vốn công khai thù địch đã là một cơn ác mộng về hậu cần.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000021", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "Việc thiết lập một căn cứ tiếp vận có khả năng duy trì một cuộc xâm lược quy mô lớn đã vượt quá quốc lực của Đế quốc.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000022", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "“Chúng ta thực sự may mắn khi chiếm được nguyên vẹn các kho tiếp vận của địch tại sở chỉ huy của chúng. Chúng ta chỉ vừa vặn xoay xở đủ nhờ những gì Hội đồng Tự trị cung cấp cộng với số vật tư thu giữ được—đúng là một phép màu.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000023", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "Bí quyết để luôn xoay xở cho đủ vốn rất đơn giản—nếu người ta áp dụng những chiến thuật từ cuốn sách cổ *Binh pháp Tôn Tử*, trong đó dạy rằng phải lấy lương thảo ngay trên đất địch.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000024", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "“Thế nhỡ nguồn đó đứt đoạn thì sao?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000025", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "“Thì lúc đó chúng ta sẽ thực sự phải thu mua toàn bộ mọi thứ trên lãnh thổ địch.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000026", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "Và Zettour thậm chí còn chẳng muốn tưởng tượng tới viễn cảnh đó. Thu giữ vật tư và trang bị quân sự của địch thì vẫn có thể xem là một hoạt động quân sự, nhưng có một ranh giới mong manh mà hệ trọng giữa việc thu giữ vật tư tiếp vận của địch ngoài chiến trường với việc cưỡng ép người dân phải giao nộp chúng cho mình.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000027", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "“Cụ thể là sao?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000028", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "Đã được hỏi thì ông đành phải trả lời.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000029", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "“Cướp bóc có tổ chức.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000030", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "“Cướp bóc ư? Thời nay đâu còn là thời đại của lính đánh thuê nữa. Ông nói thật đấy à, Zettour?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000031", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "“Tôi nói thật đấy.” Ông gật đầu với Rudersdorf. “Tình cảnh hiện giờ của chúng ta là vậy đó. Ít nhất thì, hừm, để giữ thể diện… Về mặt hình thức, đó sẽ là việc trưng thu theo đúng quân luật. Nhưng tôi tự hỏi quân phiếu sẽ giúp chúng ta đi được tới đâu trên lãnh thổ địch đây.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000032", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "“Phải rồi,” người bạn cũ của ông nhăn mặt đáp. Ngay cả ông ấy cũng biết rõ. Quân phiếu vốn mong manh chẳng khác nào ngọn nến trước gió. Bất kể ở trong nước nó vận hành ra sao, trên lãnh thổ địch, những người duy nhất tin vào nó là những kẻ đang ở vào thế buộc phải giả vờ tin mà thôi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000033", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "“Thậm chí có gì khác nhau… giữa việc trưng thu bằng quân phiếu với cướp bóc cơ chứ?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000034", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "“…Vậy là chúng ta đang đòi hỏi những thứ vốn chẳng tồn tại, và đó là lý do chúng ta phải trầy trật xoay xở đủ đường. Nhưng chúng ta cũng đâu thể dễ dàng từ bỏ chiến dịch chỉ vì vấn đề tiếp vận được.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000035", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "“Tôi thì mong ông từ bỏ lắm đấy.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000036", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "“Nghe chẳng giống phong thái của ông chút nào, Tướng von Zettour… Hãy nhớ rằng chúng ta là những người lính.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000037", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "Zettour buông một tiếng thở dài, còn Rudersdorf liền quăng thẳng một câu hỏi về phía ông.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000038", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "“Giả sử như chúng ta thực hiện thêm một đợt tiến quân nữa trong hoàn cảnh hiện tại, thì ông sẽ áp dụng những biện pháp hậu cần nào?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000039", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "“…Đàm phán ngừng bắn mới là ưu tiên cao hơn chứ, chẳng phải sao? Với kết cục thế này, ngay cả Liên bang cũng sẽ khó lòng từ chối ngồi vào bàn đàm phán.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000040", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "“Đàm phán chỉ khả thi khi phía bên kia cũng đồng thuận tham gia. Ông quên rồi ư?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000041", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "translation": "Zettour toan đáp rằng mình đâu có quên, nhưng rồi ông chợt hiểu ra điều Rudersdorf đang muốn nói. “…Tôi hiểu rồi. Ông cho rằng chúng ta cần phải lên kế hoạch dự phòng cho khả năng họ khước từ đàm phán ư?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
