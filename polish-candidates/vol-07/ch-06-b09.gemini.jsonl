{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000311", "translation": "Sĩ quan trực ban đảo mắt nhìn quanh, trông căng thẳng ra mặt.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000312", "translation": "“Có chuyện gì thế?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000313", "translation": "“Là tin từ Bộ Tổng tham mưu gửi tới ạ.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000314", "translation": "“…Hửm? Ý anh là… kết quả cuộc họp của Bộ Tư lệnh Tối cao sao?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000315", "translation": "“Vâng, có vẻ là vậy ạ. Tôi nghĩ mình nên báo cho ngài biết…”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000316", "translation": "Sĩ quan trực ban có vẻ băn khoăn không biết liệu có thực sự đáng để cắt ngang cuộc vui của cấp trên hay không, nhưng Lergen đã trấn an anh ta bằng một nụ cười chân thành. “Cảm ơn anh. Anh quyết định như vậy là rất đúng.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000317", "translation": "Đó là một bức điện từ bản quốc gửi tới.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000318", "translation": "*Nhanh đến thế sao*—anh không khỏi ấn tượng. Bức mật điện đến thật đúng lúc khiến tim anh đập rộn lên vì trông đợi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000319", "translation": "“Chắc tôi nên đọc bức điện này trong văn phòng của mình. Xin phép nhé.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000320", "translation": "Xúc động trước việc bản quốc đưa ra kết luận về cuộc đàm phán nhanh chóng đến vậy, Lergen quay trở lại văn phòng của mình.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000321", "translation": "Thật khó mà nén nổi nụ cười. *Mình đúng là dễ mủi lòng thật*, anh thầm nghĩ, trước khi nhận ra thực chất chẳng có quy định nào cấm anh bày tỏ niềm vui cả. Họa chăng là khi đang ngồi ngay giữa bàn đàm phán, chứ trong hoàn cảnh hiện tại của anh, việc được bộc lộ trọn vẹn mọi cung bậc cảm xúc là lẽ hoàn toàn tự nhiên.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000322", "translation": "“…Ha-ha-ha. Đã lâu lắm rồi…” *…mình mới lại mỉm cười thoải mái đến thế.* Anh cười gượng rồi rảo bước nhanh hơn. Một tay anh cầm ly rượu vang ủ lâu năm, tay kia cầm bức điện đã mã hóa mà xét theo thời điểm gửi tới thì hẳn sẽ làm sáng tỏ kế hoạch chấm dứt chiến tranh của họ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000323", "translation": "Nếu không dùng đến cuốn sách cất trong két sắt ở phòng mình, anh sẽ không thể nào đọc được bức điện ấy.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000324", "translation": "Mặc dù bản thân tín hiệu truyền đi cũng đã được mã hóa, nhưng nếu bị theo dõi đủ lâu, kẻ địch vẫn có nguy cơ giải mã được. Vì lẽ đó, họ trao đổi các bức điện được viết theo một quy cách hết sức đặc thù, buộc phải đối chiếu với bản mật mã chỉ Lergen và Bộ Tổng tham mưu nắm giữ thì mới hiểu được nội dung.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000325", "translation": "*Mình háo hức giải mã nó quá đi mất*, Lergen thầm nghĩ khi rảo những bước nhẹ tênh về phòng mình.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000326", "translation": "Đôi gò má vẫn còn ửng đỏ vì hơi men, tim anh đập rộn ràng theo cách chưa từng có trước đây khi lấy cuốn sổ mật mã ra khỏi két sắt.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000327", "translation": "Cảm giác lâng lâng dễ chịu đang lan tỏa trong anh không chỉ đơn thuần đến từ men rượu.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000328", "translation": "Người đàn ông nào có thể kìm nén được lòng mình cơ chứ? Anh đã có vinh dự được góp phần cứu vãn vận mệnh của đất nước mình. Sao anh lại không phấn khích cho được?", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000329", "translation": "“Được rồi, được rồi. Đến phần quan trọng rồi đây. Mình thực sự hy vọng là có một kế hoạch mạch lạc về cách thức chấm dứt chiến tranh…”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000330", "translation": "Trong niềm hân hoan, anh đặt cuốn sổ và bức điện báo cạnh nhau. Rồi anh cặm cụi đưa ngòi bút lông ngỗng giải mã một hồi. Khi đến đoạn được giải mã thành “chiến thắng ở mặt trận phía đông,” anh lật giở các trang sổ mật mã, biết chắc rằng phần tiếp theo chính là điều mình hằng mong đợi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000331", "translation": "“…? Hả?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000332", "translation": "Bối rối trước điều bất ngờ ấy, anh uống cạn ly rượu như để lấy lại tinh thần rồi rót thêm một chút.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000333", "translation": "“Ồ, mình ngớ ngẩn thật đấy… Chắc hẳn mình đã nhầm lẫn ở đâu đó rồi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000334", "translation": "Ý nghĩ đầu tiên của anh là mình đã uống hơi quá chén. Anh cười gượng nhìn chiếc ly trong tay rồi lắc đầu. Xem chừng anh đã đọc nhầm một cách tai hại.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000335", "translation": "“Vậy chữ này là… Còn chữ này… Hả? Không, nhưng mà…”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000336", "translation": "Mạch máu đang ấm nóng nhờ men rượu của anh bỗng co thắt lại, như thể anh vừa hứng trọn một loạt đạn đại bác ở cự ly gần.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000337", "translation": "Thậm chí chẳng nhận ra mình đã đánh rơi chiếc ly, Lergen trân trối nhìn bức điện báo trong nỗi kinh hoàng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000338", "translation": "“…Cái gì thế này?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000339", "translation": "Sau khi rà soát kỹ lưỡng từng từ, từng dấu câu, cẩn thận không bỏ sót bất kỳ dòng nào, anh vẫn hoàn toàn hoang mang. *Không phải là đọc nhầm sao?*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000340", "translation": "*Liệu có thể nào là đọc nhầm được không? Làm ơn đi mà…*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000341", "translation": "*Hay chỉ là do mình không hiểu đúng ý? Có lẽ… không phải vậy chứ?*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000342", "translation": "Anh cuống cuồng đọc đi đọc lại, nhưng nội dung bức điện vẫn tàn nhẫn không hề lay chuyển.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000343", "translation": "Một bức điện báo mã hóa luôn tuân theo biểu mẫu bằng ngôn ngữ công vụ không chừa chỗ cho bất kỳ sự hiểu lầm nào. Không hề có sai sót nào trong việc đọc, hiểu hay soạn thảo. Người chấp bút bức điện này ắt hẳn phải là một sĩ quan xuất sắc. Anh ta chắc chắn đã hoàn thành rất tốt công việc trau chuốt văn bản chính thức này.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000344", "translation": "“Xét chiến thắng ở mặt trận phía đông, chúng tôi thấy cần đàm phán lại và gây sức ép đòi những nhượng bộ lớn hơn nhiều.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000345", "translation": "Anh chỉ mong đó là một trò đùa.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000346", "translation": "Đó là cảm giác của anh khi vô thức buột miệng đọc thành tiếng những dòng chữ ấy, nhưng tâm trí anh vẫn ngoan cố chối từ việc thấu hiểu.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000347", "translation": "Chà, anh hiểu đấy; chỉ là anh không muốn hiểu mà thôi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000348", "translation": "Nếu anh hiểu nó, nếu anh chấp nhận nó…", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000349", "translation": "“‘X-xét chiến thắng ở mặt trận phía đông, chúng tôi thấy cần *đàm phán lại* và gây sức ép đòi *những nhượng bộ lớn hơn nhiều*’ ư?!”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000350", "translation": "Đây không phải là bức điện xác nhận việc thông qua phương án mà Lergen đã phải chật vật biết bao mới thu xếp được. Có thể nói việc bản quốc không chấp thuận là tin xấu, và quả đúng là như vậy.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000351", "translation": "Thực ra, anh cứ ngỡ mình đã chuẩn bị sẵn tinh thần đón nhận khả năng có tin xấu ngay từ đầu rồi. Nhưng chuyện này ư? Đây không phải là một trong những kịch bản anh từng hình dung. Tình huống tồi tệ nhất luôn là nỗi kinh hoàng mà người ta chẳng thể lường trước.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000352", "translation": "“…Nh-nhưng tôi đã đàm phán tất cả… tất cả *những điều này* cơ mà…”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000353", "translation": "Họ thậm chí chẳng buồn đoái hoài đến bao nhiêu va chạm và giằng co mà anh đã phải trải qua để đi đến kết quả này.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000354", "translation": "“Đ… đ-đ-đàm phán lại ư? Quay lại vạch xuất phát sao?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000355", "translation": "*Đây thực sự là ý định của bản quốc, của Bộ Tư lệnh Tối cao, của Đế quốc sao? Khi chúng ta đã vất vả biết bao mới tìm được một điểm chung mong manh, và mọi chuyện rốt cuộc mới chỉ vừa bắt đầu thành hình thôi ư?*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000356", "translation": "Anh khẽ rên lên một tiếng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
{"segment_id": "YS-LN07/Text/chapter022.xhtml/p000357", "translation": "*Sao lại thế được?*", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "source_sha256": "9d5e398041882d88fbe83ef5668c1a571176f140f13377b27bcc1516e7a84537", "notes": []}
