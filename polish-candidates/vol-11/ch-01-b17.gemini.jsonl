{"segment_id": "YS-LN11/Text/chapter004.xhtml/p000122", "source_sha256": "cd15973d244def654d022ae6e2886fd224767155d6126c656c2f70251cc3edc0", "translation": "“Ồ? Ngài có phiền nếu tôi hỏi lý do không ạ?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN11/Text/chapter004.xhtml/p000123", "source_sha256": "cd15973d244def654d022ae6e2886fd224767155d6126c656c2f70251cc3edc0", "translation": "Vị cấp trên của mình lộ nét cười chua chát.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN11/Text/chapter004.xhtml/p000124", "source_sha256": "cd15973d244def654d022ae6e2886fd224767155d6126c656c2f70251cc3edc0", "translation": "“Chúng ta phải lưu ý rằng Rudersdorf đang để Đại tá Lergen phụ trách xúc tiến một thỏa thuận hòa bình với Ildoa.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN11/Text/chapter004.xhtml/p000125", "source_sha256": "cd15973d244def654d022ae6e2886fd224767155d6126c656c2f70251cc3edc0", "translation": "“Chẳng phải điều đó là minh chứng cho sự tin tưởng của ông ta dành cho vị đại tá sao ạ?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN11/Text/chapter004.xhtml/p000126", "source_sha256": "cd15973d244def654d022ae6e2886fd224767155d6126c656c2f70251cc3edc0", "translation": "Vận mệnh của quốc gia chúng ta phụ thuộc vào các cuộc đàm phán đó. Việc ông ta giao công việc ấy cho người mà ông ta tin tưởng nhất là hoàn toàn hợp lý. Trực giác mách bảo mình rằng Tướng Rudersdorf đặt rất nhiều niềm tin vào Đại tá Lergen, nhưng xem ra Tướng Zettour lại không đồng tình.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN11/Text/chapter004.xhtml/p000127", "source_sha256": "cd15973d244def654d022ae6e2886fd224767155d6126c656c2f70251cc3edc0", "translation": "“Rudersdorf chỉ thuận theo các cuộc đàm phán như một sự thỏa hiệp mà thôi. Vấn đề không nằm ở năng lực của Đại tá Lergen… mà là ở chỗ cậu ta đứng về phía nào. Nếu thực sự tin tưởng vị đại tá, hẳn ông ta đã giao cho cậu ta phụ trách khâu chuẩn bị cho Kế hoạch B của ông ta rồi.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN11/Text/chapter004.xhtml/p000128", "source_sha256": "cd15973d244def654d022ae6e2886fd224767155d6126c656c2f70251cc3edc0", "translation": "“Tin tưởng rằng vị đại tá sẽ đứng về phe ông ta sao ạ?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN11/Text/chapter004.xhtml/p000129", "source_sha256": "cd15973d244def654d022ae6e2886fd224767155d6126c656c2f70251cc3edc0", "translation": "*Chính xác.* Tướng Zettour gật đầu, dúi thêm một mẩu thuốc lá nữa vào chiếc gạt tàn.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN11/Text/chapter004.xhtml/p000130", "source_sha256": "cd15973d244def654d022ae6e2886fd224767155d6126c656c2f70251cc3edc0", "translation": "“Tôi biết rõ điều đó vì chính tôi đã bị trút cả mặt trận phía đông lên đầu. Niềm tin của ông ta dành cho người khác tỷ lệ thuận với mức độ khắc nghiệt trong các nhiệm vụ mà ông ta giao phó. Ông ta chỉ giao những công việc tồi tệ nhất cho những người mà ông ta thực sự tin tưởng.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN11/Text/chapter004.xhtml/p000131", "source_sha256": "cd15973d244def654d022ae6e2886fd224767155d6126c656c2f70251cc3edc0", "translation": "Có một nét tự hào trong giọng điệu của ông ấy, và hướng đi của câu chuyện này đã rõ ràng đến mức nhức nhối.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN11/Text/chapter004.xhtml/p000132", "source_sha256": "cd15973d244def654d022ae6e2886fd224767155d6126c656c2f70251cc3edc0", "translation": "“Chà, vậy thì chuyện này dễ rồi. Thưa ngài, thứ lỗi cho tôi, nhưng…”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN11/Text/chapter004.xhtml/p000133", "source_sha256": "cd15973d244def654d022ae6e2886fd224767155d6126c656c2f70251cc3edc0", "translation": "“Cô không cần phải nói ra đâu.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN11/Text/chapter004.xhtml/p000134", "source_sha256": "cd15973d244def654d022ae6e2886fd224767155d6126c656c2f70251cc3edc0", "translation": "Vị cấp trên đang mỉm cười của mình dư sức giữ ngôi vị sĩ quan Đế quốc bị hành hạ nặng nề nhất, xét đến việc ông ấy bị buộc phải gánh vác cuộc chiến chống lại Liên bang.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN11/Text/chapter004.xhtml/p000135", "source_sha256": "cd15973d244def654d022ae6e2886fd224767155d6126c656c2f70251cc3edc0", "translation": "“Cô muốn tôi làm phần việc bẩn thỉu đó, đúng không?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN11/Text/chapter004.xhtml/p000136", "source_sha256": "cd15973d244def654d022ae6e2886fd224767155d6126c656c2f70251cc3edc0", "translation": "Mình lặng lẽ gật đầu xác nhận câu hỏi của Tướng Zettour, và ông ấy mỉm cười đáp lại. Đó là một nụ cười thật tươi, tràn đầy vẻ hứng khởi.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN11/Text/chapter004.xhtml/p000137", "source_sha256": "cd15973d244def654d022ae6e2886fd224767155d6126c656c2f70251cc3edc0", "translation": "Nói thẳng ra thì nụ cười ấy gần như tươi quá mức. Đối với một người sắp sửa giết chết một trong những người bạn thân nhất của ông ấy… cái cách ông ấy khẽ thì thầm “được thôi” ngay sau đó lại khá dịu dàng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN11/Text/chapter004.xhtml/p000138", "source_sha256": "cd15973d244def654d022ae6e2886fd224767155d6126c656c2f70251cc3edc0", "translation": "“Chúng ta sẽ thực hiện việc này như thế nào?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN11/Text/chapter004.xhtml/p000139", "source_sha256": "cd15973d244def654d022ae6e2886fd224767155d6126c656c2f70251cc3edc0", "translation": "Đó lại là phần dễ dàng.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN11/Text/chapter004.xhtml/p000140", "source_sha256": "cd15973d244def654d022ae6e2886fd224767155d6126c656c2f70251cc3edc0", "translation": "“Sẽ thế nào nếu chúng ta dàn xếp cho một vụ tai nạn xảy ra trong lúc ông ta đang ở miền đông ạ? Ngài nghĩ sao về một vụ rơi máy bay?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN11/Text/chapter004.xhtml/p000141", "source_sha256": "cd15973d244def654d022ae6e2886fd224767155d6126c656c2f70251cc3edc0", "translation": "“Những vụ như thế thi thoảng vẫn xảy ra.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN11/Text/chapter004.xhtml/p000142", "source_sha256": "cd15973d244def654d022ae6e2886fd224767155d6126c656c2f70251cc3edc0", "translation": "“Vâng. Sẽ thật đáng tiếc biết bao nếu xảy ra một sự cố bảo dưỡng.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN11/Text/chapter004.xhtml/p000143", "source_sha256": "cd15973d244def654d022ae6e2886fd224767155d6126c656c2f70251cc3edc0", "translation": "Rất khó để ngăn ngừa tai nạn trong một mạng lưới vận tải hàng không thường xuyên bị quá tải. Đây được xem là một vấn đề khá nan giải, và Đế quốc đã áp dụng nhiều biện pháp phòng ngừa nhằm nghiên cứu cách cải thiện độ tin cậy cho các chuyến bay của chúng ta. Tuy nhiên, trong thời chiến, tính cấp thiết thường được ưu tiên hơn sự an toàn, và những vụ tai nạn thi thoảng xảy ra chính là cái giá mà chúng ta phải trả.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN11/Text/chapter004.xhtml/p000144", "source_sha256": "cd15973d244def654d022ae6e2886fd224767155d6126c656c2f70251cc3edc0", "translation": "“Tôi sẽ lệnh cho quân của mình đảm bảo một vụ tai nạn sẽ xảy ra.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN11/Text/chapter004.xhtml/p000145", "source_sha256": "cd15973d244def654d022ae6e2886fd224767155d6126c656c2f70251cc3edc0", "translation": "Tướng Zettour đáp lại đề xuất này bằng một thoáng im lặng. Ông ấy ngậm chặt điếu thuốc tiếp theo trên môi mà không nói một lời trước khi châm lửa. Sau khi khẽ phủ một làn khói quanh cả hai, ông ấy vừa nhả thêm một hơi khói vừa nói ra mối bận tâm của ông ấy.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN11/Text/chapter004.xhtml/p000146", "source_sha256": "cd15973d244def654d022ae6e2886fd224767155d6126c656c2f70251cc3edc0", "translation": "“Nhìn chung đó là một kế hoạch tốt, nhưng tổ bay cũng sẽ bị cuốn vào vụ tai nạn đó.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN11/Text/chapter004.xhtml/p000147", "source_sha256": "cd15973d244def654d022ae6e2886fd224767155d6126c656c2f70251cc3edc0", "translation": "Ông ấy nện nắm đấm xuống mặt bàn trước khi nói tiếp.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN11/Text/chapter004.xhtml/p000148", "source_sha256": "cd15973d244def654d022ae6e2886fd224767155d6126c656c2f70251cc3edc0", "translation": "“Cô nói về chi phí tối thiểu, nhưng tổ bay lại chính là những người lính của chúng ta. Những người lính bị phân công lên nhầm chuyến bay, vào nhầm ngày.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN11/Text/chapter004.xhtml/p000149", "source_sha256": "cd15973d244def654d022ae6e2886fd224767155d6126c656c2f70251cc3edc0", "translation": "Những lời lẽ mới cao quý làm sao. Xét trên phương diện nhân đạo thì ông ấy hoàn toàn đúng. Mình đồng ý với ông ấy, thực sự đồng ý. Sinh mạng của người khác cần phải được trân trọng ở mức cao nhất. Ngay cả khi đây là một quy trình tất yếu… thì hãy thử nói điều đó với những người phải hy sinh mạng sống xem.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN11/Text/chapter004.xhtml/p000150", "source_sha256": "cd15973d244def654d022ae6e2886fd224767155d6126c656c2f70251cc3edc0", "translation": "Đáng lẽ mình phải cảm thấy xấu hổ trước lời chỉ trích của ông ấy—trước ánh mắt trừng trừng khiển trách ý tưởng của mình.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN11/Text/chapter004.xhtml/p000151", "source_sha256": "cd15973d244def654d022ae6e2886fd224767155d6126c656c2f70251cc3edc0", "translation": "Đáng lẽ phải vậy, nhưng mình lại chẳng hề thấy thế. Bởi người đưa ra nhận xét đó không ai khác chính là Tướng Zettour.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN11/Text/chapter004.xhtml/p000152", "source_sha256": "cd15973d244def654d022ae6e2886fd224767155d6126c656c2f70251cc3edc0", "translation": "“Thưa ngài, ngài có thể…”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN11/Text/chapter004.xhtml/p000153", "source_sha256": "cd15973d244def654d022ae6e2886fd224767155d6126c656c2f70251cc3edc0", "translation": "“Chuyện gì?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN11/Text/chapter004.xhtml/p000154", "source_sha256": "cd15973d244def654d022ae6e2886fd224767155d6126c656c2f70251cc3edc0", "translation": "Mình chẳng bận tâm đến ánh nhìn đầy vẻ ghê tởm đó. Ông cứ việc thoải mái đóng vai một con người có nguyên tắc đạo đức tốt đẹp nếu ông muốn. Thực tế, bản thân tâm niệm ấy rất đáng được tán dương. Nhưng tạm gác tất cả những chuyện đó sang một bên, mình e là mình buộc phải chỉ ra…", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN11/Text/chapter004.xhtml/p000155", "source_sha256": "cd15973d244def654d022ae6e2886fd224767155d6126c656c2f70251cc3edc0", "translation": "“Xin ngài vui lòng soi gương một chút được không ạ? Cơ hàm của ngài xem chừng đang giở chứng đấy ạ.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN11/Text/chapter004.xhtml/p000156", "source_sha256": "cd15973d244def654d022ae6e2886fd224767155d6126c656c2f70251cc3edc0", "translation": "“Ồ… hả?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN11/Text/chapter004.xhtml/p000157", "source_sha256": "cd15973d244def654d022ae6e2886fd224767155d6126c656c2f70251cc3edc0", "translation": "Tướng Zettour thoáng bối rối, bắt đầu đưa tay xoa dọc xương hàm. Mình đoán những gì đang xảy ra với ông ấy hoàn toàn là phản ứng vô thức.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN11/Text/chapter004.xhtml/p000158", "source_sha256": "cd15973d244def654d022ae6e2886fd224767155d6126c656c2f70251cc3edc0", "translation": "Thế nhưng, sự thay đổi thực sự chỉ diễn ra vào khoảnh khắc bàn tay ông ấy chạm lên miệng. Chỉ có thể mô tả đó là một sự biến chuyển đầy kịch tính… khi vẻ khinh miệt trong mắt ông ấy bừng sáng lên như một ngày nắng hạ.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN11/Text/chapter004.xhtml/p000159", "source_sha256": "cd15973d244def654d022ae6e2886fd224767155d6126c656c2f70251cc3edc0", "translation": "“Tôi không khỏi nhận thấy ngài có vẻ rất thích thú trước toàn bộ chuyện này.”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN11/Text/chapter004.xhtml/p000160", "source_sha256": "cd15973d244def654d022ae6e2886fd224767155d6126c656c2f70251cc3edc0", "translation": "“…Tôi đang trưng ra vẻ mặt như thế sao?”", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
{"segment_id": "YS-LN11/Text/chapter004.xhtml/p000161", "source_sha256": "cd15973d244def654d022ae6e2886fd224767155d6126c656c2f70251cc3edc0", "translation": "Thật lòng mà nói, trông ông ấy hệt như một kẻ giết người hàng loạt đang làm điều hắn yêu thích nhất: sát nhân. Niềm vui sướng gần như tuôn trào từ nụ cười ngoác rộng của ông ấy. Khó mà phủ nhận được rằng sếp của mình về bản chất là một kẻ cực kỳ tài năng, hoàn toàn tàn nhẫn… và thái nhân cách.", "status": "reviewed", "translator": "argon-low", "glossary_version": "sha256:d5f19d64d8d734e1a21400978b70a7c10daf776ba7f77eb58f01a39ac78f5a41", "notes": []}
